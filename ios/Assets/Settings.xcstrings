    "Could not find that exit server anymore. Try reconnecting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد العثور على خادم الخروج هذا ممكنًا. جرِّب إعادة الاتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den udgangsserver kan ikke længere findes. Prøv at oprette forbindelse igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Exit-Server konnte nicht mehr gefunden werden. Versuchen Sie, sich erneut zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find that exit server anymore. Try reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se encuentra ese servidor de salida. Prueba a volver a conectarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن سرور خروجی دیگر پیدا نشد. دوباره متصل شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyseistä lähtöpalvelinta ei enää löydy. Kokeile yhdistää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur de sortie est introuvable. Essayez de vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è più possibile trovare quel server di uscita. Prova a riconnetterti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その出口サーバーが見つからなくなりました。再接続してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 출구 서버를 더 이상 찾을 수 없습니다. 다시 연결해 보세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ထိုထွက်ပေါက်ဆာဗာကို ရှာမတွေ့တော့ပါ။ ပြန်လည်ချိတ်ဆက်ကြည့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner ikke den utgangsserveren lenger. Prøv å koble til på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die exitserver is niet meer te vinden. Probeer opnieuw verbinding te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można już znaleźć tego serwera wyjściowego. Spróbuj połączyć się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não é possível encontrar esse servidor de saída. Tenta voltar a ligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest server de ieșire nu mai poate fi găsit. Încercați să vă reconectați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот выходной сервер больше не найден. Попробуйте подключиться заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den utgångsservern hittas inte längre. Prova att återansluta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบเซิร์ฟเวอร์ทางออกนั้นอีกต่อไป ลองเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çıkış sunucusu artık bulunamıyor. Yeniden bağlanmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей вихідний сервер більше не знайдено. Спробуйте перепідключитися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已无法找到该出口服务器。请尝试重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找不到該出口伺服器。請嘗試重新連線。"
          }
        }
      }
    },
    "Could not save the new key. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذَّر حفظ المفتاح الجديد. يُرجى إعادة المحاولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nye nøgle kunne ikke gemmes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Schlüssel konnte nicht gespeichert werden. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the new key. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la nueva clave. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید جدید ذخیره نشد. لطفاً دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuden avaimen tallentaminen ei onnistunut. Yritä uudelleen."
          }
        },
