    "Your VPN traffic is indistinguishable from regular HTTPS browsing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تمييز حركة بيانات VPN لديك عن تصفح HTTPS العادي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din VPN-trafik er umulig at skelne fra almindelig HTTPS-browsing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr VPN-Traffic ist von normalem HTTPS-Browsing ununterscheidbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your VPN traffic is indistinguishable from regular HTTPS browsing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su tráfico VPN es indistinguible de la navegación HTTPS normal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترافیک VPN شما از وب‌گردی معمولی HTTPS قابل تشخیص نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-liikenteesi on erottamatonta tavallisesta HTTPS-selailusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trafic VPN est indissociable d'un trafic HTTPS classique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo traffico VPN è indistinguibile dalla normale navigazione HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのVPNトラフィックは通常のHTTPS閲覧と見分けがつきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 트래픽을 일반 HTTPS 브라우징과 구별할 수 없습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့် VPN ထရက်ဖစ်ကို ပုံမှန် HTTPS ဖွင့်ကြည့်ခြင်းနှင့် ခွဲခြားမရပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-trafikken din er umulig å skille fra vanlig HTTPS-surfing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je VPN-verkeer is niet te onderscheiden van gewoon HTTPS-browsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ruch VPN jest nieodróżnialny od zwykłego przeglądania HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu tráfego VPN é indistinguível da navegação HTTPS normal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traficul tău VPN este imposibil de distins de navigarea HTTPS obișnuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш VPN-трафик неотличим от обычного HTTPS-просмотра."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din VPN-trafik är omöjlig att skilja från vanlig HTTPS-surfning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทราฟฟิก VPN ของคุณแยกไม่ออกจากการท่องเว็บ HTTPS ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN trafiğiniz normal HTTPS taramasından ayırt edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш VPN-трафік невідрізнюваний від звичайного перегляду через HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
