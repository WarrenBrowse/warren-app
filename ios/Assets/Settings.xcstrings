    "This app uses the free Warren beta, here to help us validate Warren in real conditions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا التطبيق بيتا Warren المجانية، الموجودة لمساعدتنا على التحقق من Warren في ظروف حقيقية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne app bruger den gratis Warren-beta, som er her for at hjælpe os med at validere Warren under virkelige forhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App nutzt die kostenlose Warren-Beta, die uns hilft, Warren unter echten Bedingungen zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app uses the free Warren beta, here to help us validate Warren in real conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación usa la beta gratuita de Warren, que nos sirve para validar Warren en condiciones reales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این برنامه از بتای رایگان Warren استفاده می‌کند که برای اعتبارسنجی Warren در شرایط واقعی اینجاست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä sovellus käyttää ilmaista Warren-beetaa, joka auttaa meitä todentamaan Warrenin oikeissa oloissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application utilise la beta gratuite de Warren, qui nous sert à valider Warren en conditions réelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app usa la beta gratuita di Warren, qui per aiutarci a validare Warren in condizioni reali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは無料の Warren ベータを使っています。実環境で Warren を検証するためのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 무료 Warren 베타를 사용합니다. 실제 환경에서 Warren을 검증하기 위한 것입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအက်ပ်သည် အခမဲ့ Warren ဘီတာကို အသုံးပြုသည်။ ၎င်းသည် Warren ကို လက်တွေ့အခြေအနေတွင် စစ်ဆေးရန် ဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen bruker den gratis Warren-betaen, som er her for å hjelpe oss å validere Warren under virkelige forhold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app gebruikt de gratis Warren-beta, die ons helpt Warren onder echte omstandigheden te valideren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja korzysta z darmowej bety Warrena, która pomaga nam sprawdzić Warrena w rzeczywistych warunkach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicação usa a beta gratuita da Warren, que nos ajuda a validar a Warren em condições reais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această aplicație folosește beta gratuită Warren, care ne ajută să validăm Warren în condiții reale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение использует бесплатную бету Warren, которая помогает нам проверить Warren в реальных условиях."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appen använder den gratis Warren-betan, som hjälper oss att validera Warren under verkliga förhållanden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้ใช้เบต้าของ Warren แบบฟรี ซึ่งมีไว้ช่วยเราตรวจสอบ Warren ในสภาพการใช้งานจริง"
          }
