    "Requests an external port from the Warren exit relay via NAT-PMP so peer-to-peer apps (BitTorrent, video calls, self-hosted services) can receive incoming connections.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب منفذًا خارجيًا من مرحِّل خروج Warren عبر NAT-PMP لكي تتمكن تطبيقات الند للند (BitTorrent ومكالمات الفيديو والخدمات المستضافة ذاتيًا) من استقبال الاتصالات الواردة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmoder om en ekstern port fra Warren-udgangsrelæet via NAT-PMP, så peer-to-peer-apps (BitTorrent, videoopkald, selvhostede tjenester) kan modtage indgående forbindelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert über NAT-PMP einen externen Port vom Warren-Ausgangsrelais an, damit Peer-to-Peer-Apps (BitTorrent, Videoanrufe, selbst gehostete Dienste) eingehende Verbindungen empfangen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests an external port from the Warren exit relay via NAT-PMP so peer-to-peer apps (BitTorrent, video calls, self-hosted services) can receive incoming connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un puerto externo al relé de salida de Warren mediante NAT-PMP para que las aplicaciones entre pares (BitTorrent, videollamadas, servicios autoalojados) puedan recibir conexiones entrantes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از طریق NAT-PMP یک درگاه بیرونی از رلهٔ خروجی Warren درخواست می‌کند تا برنامه‌های همتابه‌همتا (BitTorrent، تماس تصویری، سرویس‌های خودمیزبان) بتوانند اتصال‌های ورودی دریافت کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyytää ulkoista porttia Warrenin ulostulorelelta NAT-PMP:n kautta, jotta vertaisverkkosovellukset (BitTorrent, videopuhelut, itse isännöidyt palvelut) voivat vastaanottaa saapuvia yhteyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au relais de sortie Warren un port externe via NAT-PMP, pour que les applications pair-à-pair (BitTorrent, appels vidéo, services auto-hébergés) puissent recevoir des connexions entrantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede una porta esterna al relè di uscita Warren tramite NAT-PMP, così le app peer-to-peer (BitTorrent, videochiamate, servizi self-hosted) possono ricevere connessioni in entrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NAT-PMP経由でWarrenの出口リレーに外部ポートを要求し、ピアツーピアアプリ（BitTorrent、ビデオ通話、セルフホスト型サービス）が着信接続を受け取れるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NAT-PMP를 통해 Warren 출구 릴레이에 외부 포트를 요청하여 P2P 앱(BitTorrent, 영상 통화, 자체 호스팅 서비스)이 수신 연결을 받을 수 있도록 합니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "peer-to-peer အက်ပ်များ (BitTorrent၊ ဗီဒီယိုခေါ်ဆိုမှုများ၊ ကိုယ်တိုင်လက်ခံသည့်ဝန်ဆောင်မှုများ) သည် အဝင်ချိတ်ဆက်မှုများ လက်ခံနိုင်ရန် NAT-PMP မှတစ်ဆင့် Warren ထွက်ပေါက်ရီလေးထံ ပြင်ပ port တစ်ခုကို တောင်းဆိုသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber om en ekstern port fra Warren-utgangsreléet via NAT-PMP, slik at node-til-node-apper (BitTorrent, videosamtaler, selvhostede tjenester) kan motta innkommende tilkoblinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt via NAT-PMP een externe poort aan bij het Warren-uitgangsrelais, zodat peer-to-peer-apps (BitTorrent, videogesprekken, zelfgehoste services) inkomende verbindingen kunnen ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żąda zewnętrznego portu od przekaźnika wyjściowego Warren przez NAT-PMP, aby aplikacje peer-to-peer (BitTorrent, połączenia wideo, usługi własne) mogły odbierać połączenia przychodzące."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita uma porta externa ao relé de saída do Warren através de NAT-PMP, para que as aplicações ponto a ponto (BitTorrent, videochamadas, serviços autoalojados) possam receber ligações de entrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicită un port extern de la releul de ieșire Warren prin NAT-PMP, astfel încât aplicațiile peer-to-peer (BitTorrent, apeluri video, servicii găzduite local) să poată primi conexiuni de intrare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает внешний порт у выходного ретранслятора Warren через NAT-PMP, чтобы одноранговые приложения (BitTorrent, видеозвонки, самостоятельно размещенные сервисы) могли принимать входящие подключения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begär en extern port från Warrens utgångsrelä via NAT-PMP så att peer-to-peer-appar (BitTorrent, videosamtal, egenvärdtjänster) kan ta emot inkommande anslutningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอพอร์ตภายนอกจากรีเลย์ทางออกของ Warren ผ่าน NAT-PMP เพื่อให้แอปแบบเพียร์ทูเพียร์ (BitTorrent วิดีโอคอล บริการที่โฮสต์เอง) สามารถรับการเชื่อมต่อขาเข้าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşler arası uygulamaların (BitTorrent, görüntülü aramalar, kendi barındırılan hizmetler) gelen bağlantıları alabilmesi için NAT-PMP aracılığıyla Warren çıkış aktarıcısından harici bir bağlantı noktası ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує зовнішній порт у вихідного ретранслятора Warren через NAT-PMP, щоб однорангові застосунки (BitTorrent, відеодзвінки, самостійно розміщені сервіси) могли приймати вхідні підключення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 NAT-PMP 向 Warren 出口中继请求一个外部端口，以便点对点应用（BitTorrent、视频通话、自托管服务）可以接收传入连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 NAT-PMP 向 Warren 出口中繼要求一個外部連接埠，以便點對點應用程式（BitTorrent、視訊通話、自架服務）可以接收傳入連線。"
          }
        }
      }
    },
