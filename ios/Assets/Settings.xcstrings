    "DAITA is experimental and may degrade throughput on high-bandwidth links.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DAITA is experimental and may degrade throughput on high-bandwidth links."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAITA est expérimental et peut réduire le débit sur les liaisons à haute vitesse."
          }
        }
      }
    },
    "Defense Against AI-Guided Traffic Analysis. Emits constant-rate cover traffic to make your VPN sessions indistinguishable to network observers. Adds ~10% bandwidth overhead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defense Against AI-Guided Traffic Analysis. Emits constant-rate cover traffic to make your VPN sessions indistinguishable to network observers. Adds ~10% bandwidth overhead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défense contre l'analyse de trafic guidée par IA. Émet un trafic de couverture à débit constant pour rendre vos sessions VPN indissociables pour un observateur réseau. Ajoute ~10 % de surcharge."
          }
        }
      }
    },
