    "Details, and how to contest a strike": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفاصيل وكيفية الاعتراض على مخالفة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaljer, og hvordan du bestrider en advarsel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details und wie man einen Verstoß anficht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details, and how to contest a strike"
          }
        },
        "es": {
