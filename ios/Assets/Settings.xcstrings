    "That port is already taken on this exit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المنفذ محجوز بالفعل على هذا المخرج."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den port er allerede optaget på denne exit-server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Port ist auf diesem Exit bereits vergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That port is already taken on this exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese puerto ya está ocupado en este servidor de salida."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پورت روی این خروجی از پیش گرفته شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portti on jo varattu tässä ulostulossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce port est déjà pris sur cette sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella porta è già occupata su questa uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このポートはこの出口サーバーでは使用中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 포트는 이 출구 서버에서 이미 사용 중입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤပို့တ်ကို ဤထွက်ပေါက်တွင် အသုံးပြုပြီးဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den porten er allerede opptatt på denne utgangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die poort is al bezet op deze exit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten port jest już zajęty na tym węźle wyjściowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa porta já está ocupada neste servidor de saída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portul este deja ocupat pe această ieșire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот порт уже занят на этом выходном узле."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten är redan upptagen på den här utgången."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พอร์ตนี้ถูกใช้งานอยู่แล้วบนเซิร์ฟเวอร์ทางออกนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı noktası bu çıkışta zaten kullanımda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей порт уже зайнятий на цьому вихідному вузлі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该端口在此出口节点上已被占用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該連接埠在此出口節點上已被占用。"
          }
        }
      }
    },
    "The exit is not handing out ports right now. Try again in %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المخرج لا يمنح منافذ الآن. أعد المحاولة بعد %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit-serveren uddeler ikke porte lige nu. Prøv igen om %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Exit vergibt gerade keine Ports. Versuche es in %@ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit is not handing out ports right now. Try again in %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de salida no está asignando puertos ahora mismo. Inténtalo de nuevo en %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خروجی در حال حاضر پورت نمی‌دهد. پس از %@ دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulostulo ei jaa portteja juuri nyt. Yritä uudelleen %@ kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie ne distribue pas de port en ce moment. Réessayez dans %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'uscita non sta assegnando porte in questo momento. Riprova tra %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口サーバーは現在ポートを割り当てていません。%@ 後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구 서버가 지금은 포트를 배정하지 않습니다. %@ 후에 다시 시도하세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ထွက်ပေါက်သည် ယခုအချိန်တွင် ပို့တ်များ မပေးပါ။ %@ အကြာတွင် ထပ်စမ်းပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen deler ikke ut porter nå. Prøv igjen om %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De exit deelt op dit moment geen poorten uit. Probeer het over %@ opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węzeł wyjściowy nie przydziela teraz portów. Spróbuj ponownie za %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de saída não está a atribuir portas neste momento. Tenta de novo daqui a %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieșirea nu distribuie porturi acum. Încearcă din nou peste %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходной узел сейчас не выдаёт порты. Повторите через %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången delar inte ut portar just nu. Försök igen om %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้เซิร์ฟเวอร์ทางออกไม่ได้แจกพอร์ต ลองใหม่ใน %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış şu anda bağlantı noktası dağıtmıyor. %@ sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідний вузол зараз не видає порти. Спробуйте за %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口节点当前不分配端口。请在 %@ 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出口節點目前不分配連接埠。請在 %@ 後重試。"
          }
        }
      }
    },
