{
  "sourceLanguage": "en",
  "strings": {
    "A sign-in code is 32 letters and digits, as shown on the forum page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sign-in code is 32 letters and digits, as shown on the forum page."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكون رمز تسجيل الدخول من 32 حرفًا ورقمًا، كما هو معروض في صفحة المنتدى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En loginkode består af 32 bogstaver og tal, som vist på forumsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anmeldecode besteht aus 32 Buchstaben und Ziffern, wie auf der Forumseite angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código de inicio de sesión tiene 32 letras y cifras, tal como aparece en la página del foro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد ورود از ۳۲ حرف و رقم تشکیل شده است، همان‌طور که در صفحهٔ انجمن نشان داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumiskoodissa on 32 kirjainta ja numeroa, kuten foorumisivulla näkyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code de connexion compte 32 lettres et chiffres, tel qu'affiché sur la page du forum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice di accesso è composto da 32 lettere e cifre, come mostrato nella pagina del forum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインコードは、フォーラムページに表示されている32文字の英数字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 코드는 포럼 페이지에 표시된 대로 32자의 영문자와 숫자입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဝင်ရောက်မှုကုဒ်သည် ဖိုရမ်စာမျက်နှာတွင် ပြထားသည့်အတိုင်း စာလုံးနှင့် ဂဏန်း ၃၂ လုံး ဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En innloggingskode består av 32 bokstaver og sifre, slik den vises på forumsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aanmeldcode bestaat uit 32 letters en cijfers, zoals op de forumpagina staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod logowania składa się z 32 liter i cyfr, tak jak na stronie forum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um código de início de sessão tem 32 letras e algarismos, tal como aparece na página do fórum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cod de autentificare are 32 de litere și cifre, așa cum apare pe pagina forumului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код входа состоит из 32 букв и цифр, как показано на странице форума."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En inloggningskod består av 32 bokstäver och siffror, som på forumsidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสลงชื่อเข้าใช้ประกอบด้วยตัวอักษรและตัวเลข 32 ตัว ตามที่แสดงบนหน้าฟอรัม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir giriş kodu, forum sayfasında gösterildiği gibi 32 harf ve rakamdan oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код входу складається з 32 літер і цифр, як показано на сторінці форуму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录代码由 32 个字母和数字组成，与论坛页面上显示的一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入代碼由 32 個字母和數字組成，與論壇頁面上顯示的一致。"
          }
        }
      }
    },
    "Checking the code, please wait.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the code, please wait."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق من الرمز، يُرجى الانتظار."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer koden, vent venligst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code wird geprüft, bitte warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando el código, espera un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال بررسی کد، لطفاً صبر کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan koodia, odota hetki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du code, veuillez patienter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica del codice in corso, attendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを確認しています。しばらくお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 확인하는 중입니다. 잠시 기다려 주세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကုဒ်ကို စစ်ဆေးနေသည်၊ ခဏစောင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer koden, vent litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code wordt gecontroleerd, even geduld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie kodu, proszę czekać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificar o código, aguarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se verifică codul, te rugăm să aștepți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем код, подождите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar koden, vänta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบรหัส โปรดรอสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kontrol ediliyor, lütfen bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряємо код, зачекайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查代码，请稍候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查代碼，請稍候。"
          }
        }
      }
    },
    "Connect to the VPN to request a port.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بشبكة VPN لطلب منفذ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til VPN for at anmode om en port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich mit dem VPN, um einen Port anzufordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the VPN to request a port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctese a la VPN para solicitar un puerto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای درخواست پورت به VPN متصل شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä VPN:ään pyytääksesi porttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au VPN pour demander un port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti alla VPN per richiedere una porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートをリクエストするには、VPNに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 요청하려면 VPN에 연결하세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Port တစ်ခုတောင်းဆိုရန် VPN သို့ ချိတ်ဆက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til VPN for å be om en port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met de VPN om een poort aan te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z VPN, aby poprosić o port."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se à VPN para pedir uma porta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la VPN pentru a solicita un port."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к VPN, чтобы запросить порт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till VPN för att begära en port."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ VPN เพื่อขอพอร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı noktası istemek için VPN'e bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до VPN, щоб запитати порт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 VPN 以请求端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線 VPN 以要求連接埠。"
          }
        }
      }
    },
