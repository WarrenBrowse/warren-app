    "Route traffic through an entry relay before the exit relay. Adds latency (~30-50 ms) and bandwidth overhead. OFF by default.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send trafik gennem et indgangsrelæ før udgangsrelæet. Tilføjer forsinkelse (~30-50 ms) og båndbredde-overhead. Slået fra som standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet den Traffic vor dem Ausgangsrelais durch ein Eingangsrelais. Fügt Latenz (~30-50 ms) und Bandbreiten-Overhead hinzu. Standardmäßig AUS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route traffic through an entry relay before the exit relay. Adds latency (~30-50 ms) and bandwidth overhead. OFF by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enruta el tráfico a través de un relé de entrada antes del relé de salida. Añade latencia (~30-50 ms) y sobrecarga de ancho de banda. Desactivado de forma predeterminada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa liikenteen sisääntulorelen kautta ennen ulostulorelettä. Lisää viivettä (~30-50 ms) ja kaistanleveyden lisäkuormaa. Oletuksena pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achemine le trafic via un relais d'entrée avant le relais de sortie. Ajoute de la latence (~30-50 ms) et de la surcharge de bande passante. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrada il traffico attraverso un relè di ingresso prima del relè di uscita. Aggiunge latenza (~30-50 ms) e overhead di banda. Disattivato per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口リレーの前に入口リレーを通してトラフィックをルーティングします。遅延（約30-50 ms）と帯域幅オーバーヘッドが増えます。既定ではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구 릴레이 앞의 입구 릴레이를 통해 트래픽을 라우팅합니다. 지연(약 30-50 ms)과 대역폭 오버헤드가 추가됩니다. 기본값은 꺼짐입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ထွက်ပေါက်ရီလေးမတိုင်မီ ဝင်ပေါက်ရီလေးတစ်ခုမှတစ်ဆင့် ထရက်ဖစ်ကို လမ်းကြောင်းသတ်မှတ်သည်။ နှောင့်နှေးချိန် (~30-50 ms) နှင့် ဘန်းဝစ်ဒ်ပိုသုံးမှု ထပ်တိုးသည်။ ပုံသေအားဖြင့် ပိတ်ထားသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruter trafikk gjennom et inngangsrelé før utgangsreléet. Legger til forsinkelse (~30-50 ms) og båndbredde-overhead. Av som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Routeert verkeer via een ingangsrelais vóór het uitgangsrelais. Voegt latentie (~30-50 ms) en bandbreedte-overhead toe. Standaard UIT."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kieruje ruch przez przekaźnik wejściowy przed przekaźnikiem wyjściowym. Dodaje opóźnienie (~30-50 ms) i narzut przepustowości. Domyślnie wyłączone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminha o tráfego através de um relé de entrada antes do relé de saída. Adiciona latência (~30-50 ms) e sobrecarga de largura de banda. Desativado por predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляет трафик через входной ретранслятор перед выходным. Добавляет задержку (~30-50 мс) и нагрузку на канал. По умолчанию выключено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigerar trafik genom ett ingångsrelä före utgångsreläet. Lägger till fördröjning (~30-50 ms) och bandbreddsbelastning. Av som standard."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดเส้นทางทราฟฟิกผ่านรีเลย์ทางเข้าก่อนรีเลย์ทางออก เพิ่มความหน่วง (~30-50 มิลลิวินาที) และโอเวอร์เฮดแบนด์วิดท์ ปิดอยู่ตามค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafiği çıkış aktarıcısından önce bir giriş aktarıcısından geçirir. Gecikme (~30-50 ms) ve bant genişliği ek yükü ekler. Varsayılan olarak KAPALI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрямовує трафік через вхідний ретранслятор перед вихідним. Додає затримку (~30-50 мс) і навантаження на канал. За замовчуванням вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在出口中继之前通过入口中继路由流量。会增加延迟（约 30-50 毫秒）和带宽开销。默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在出口中繼之前透過入口中繼路由流量。會增加延遲（約 30-50 毫秒）和頻寬開銷。預設關閉。"
          }
        }
      }
    },
