{
  "sourceLanguage": "en",
  "strings": {
    "Connect to the VPN to request a port.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بشبكة VPN لطلب منفذ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til VPN for at anmode om en port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich mit dem VPN, um einen Port anzufordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the VPN to request a port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctese a la VPN para solicitar un puerto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای درخواست پورت به VPN متصل شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä VPN:ään pyytääksesi porttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au VPN pour demander un port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti alla VPN per richiedere una porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートをリクエストするには、VPNに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 요청하려면 VPN에 연결하세요."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Port တစ်ခုတောင်းဆိုရန် VPN သို့ ချိတ်ဆက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til VPN for å be om en port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met de VPN om een poort aan te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z VPN, aby poprosić o port."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se à VPN para pedir uma porta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la VPN pentru a solicita un port."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к VPN, чтобы запросить порт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till VPN för att begära en port."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ VPN เพื่อขอพอร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı noktası istemek için VPN'e bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до VPN, щоб запитати порт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 VPN 以请求端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線 VPN 以要求連接埠。"
          }
        }
      }
    },
