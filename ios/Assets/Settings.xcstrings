          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitgangsrelais bepaalt je schijnbare locatie voor websites."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaźnik wyjściowy określa Twoją pozorną lokalizację widzianą przez witryny."
          }
        },
        "pt": {
          "stringUnit": {
