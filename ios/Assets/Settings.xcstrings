    "These are not the final service conditions: the full-speed network is a separate, paid product.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ليست شروط الخدمة النهائية: الشبكة كاملة السرعة منتج منفصل مدفوع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke de endelige servicevilkår: netværket med fuld hastighed er et separat, betalt produkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind nicht die endgültigen Bedingungen: das Netz mit voller Geschwindigkeit ist ein separates, kostenpflichtiges Produkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are not the final service conditions: the full-speed network is a separate, paid product."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas no son las condiciones definitivas del servicio: la red a plena velocidad es un producto aparte, de pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شرایط نهایی سرویس نیست: شبکه با سرعت کامل محصولی جداگانه و پولی است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä eivät ole lopulliset palveluehdot: täysinopeuksinen verkko on erillinen, maksullinen tuote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ne sont pas les conditions finales du service : le réseau à pleine vitesse est un produit distinct et payant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste non sono le condizioni finali del servizio: la rete a piena velocità è un prodotto separato, a pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは最終的なサービス条件ではありません。フルスピードの回線は別の有料製品です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 최종 서비스 조건이 아닙니다. 전속도 네트워크는 별도의 유료 제품입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤသည်မှာ နောက်ဆုံး ဝန်ဆောင်မှု အခြေအနေများ မဟုတ်ပါ။ အမြန်နှုန်းပြည့် ကွန်ရက်သည် သီးခြား အခကြေးငွေ ထုတ်ကုန်ဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke de endelige tjenestevilkårene: nettverket med full hastighet er et separat, betalt produkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn niet de definitieve voorwaarden: het netwerk op volle snelheid is een apart, betaald product."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie są docelowe warunki usługi: sieć o pełnej prędkości to osobny, płatny produkt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas não são as condições finais do serviço: a rede à velocidade máxima é um produto separado e pago."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea nu sunt condițiile finale ale serviciului: rețeaua la viteză completă este un produs separat, cu plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не окончательные условия обслуживания: сеть на полной скорости, это отдельный платный продукт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är inte de slutliga villkoren: nätverket med full hastighet är en separat, betald produkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่เงื่อนไขบริการขั้นสุดท้าย เครือข่ายความเร็วเต็มเป็นผลิตภัณฑ์แยกต่างหากที่ต้องเสียเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar hizmetin nihai koşulları değildir: tam hızlı ağ ayrı ve ücretli bir üründür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не остаточні умови обслуговування: мережа на повній швидкості, це окремий платний продукт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是最终的服务条件：全速网络是一项单独的付费产品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是最終的服務條件：全速網路是一項單獨的付費產品。"
          }
        }
      }
    },
