    "HTTP/3 mimicry is active. Traffic is indistinguishable from regular HTTPS.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-mimik er aktiv. Trafik er umulig at skelne fra almindelig HTTPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-Nachahmung ist aktiv. Der Traffic ist von normalem HTTPS ununterscheidbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3 mimicry is active. Traffic is indistinguishable from regular HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imitación de HTTP/3 está activa. El tráfico es indistinguible del HTTPS normal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-jäljittely on käytössä. Liikenne on erottamatonta tavallisesta HTTPS:stä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mimétisme HTTP/3 est actif. Le trafic est indissociable d'un HTTPS normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mimica HTTP/3 è attiva. Il traffico è indistinguibile dal normale HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3擬態が有効です。トラフィックは通常のHTTPSと見分けがつきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3 모방이 활성화되어 있습니다. 트래픽을 일반 HTTPS와 구별할 수 없습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3 အတုယူခြင်း ဖွင့်ထားသည်။ ထရက်ဖစ်ကို ပုံမှန် HTTPS နှင့် ခွဲခြားမရပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-etterligning er aktiv. Trafikk er umulig å skille fra vanlig HTTPS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-nabootsing is actief. Het verkeer is niet te onderscheiden van gewoon HTTPS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naśladowanie HTTP/3 jest aktywne. Ruch jest nieodróżnialny od zwykłego HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A imitação de HTTP/3 está ativa. O tráfego é indistinguível do HTTPS normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитация HTTP/3 активна. Трафик неотличим от обычного HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3-imitation är aktiv. Trafiken är omöjlig att skilja från vanlig HTTPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลียนแบบ HTTP/3 ทำงานอยู่ ทราฟฟิกแยกไม่ออกจาก HTTPS ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3 taklidi etkin. Trafik normal HTTPS'den ayırt edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імітація HTTP/3 активна. Трафік невідрізнюваний від звичайного HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/3 模拟已激活。流量与普通 HTTPS 无法区分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
