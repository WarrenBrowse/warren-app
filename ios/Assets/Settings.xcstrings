        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей застосунок використовує безкоштовну бету Warren, яка допомагає нам перевірити Warren у реальних умовах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用使用免费的 Warren Beta，用于在真实环境中验证 Warren。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用使用免費的 Warren Beta，用於在真實環境中驗證 Warren。"
          }
        }
      }
    },
    "It runs on a separate network with limited bandwidth.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وهي تعمل على شبكة منفصلة ذات نطاق محدود."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kører på et separat netværk med begrænset båndbredde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft auf einem separaten Netz mit begrenzter Bandbreite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs on a separate network with limited bandwidth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en una red aparte con ancho de banda limitado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی شبکه‌ای جدا با پهنای باند محدود اجرا می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se toimii erillisessä verkossa, jonka kaistanleveys on rajattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle tourne sur un réseau distinct à bande passante limitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona su una rete separata con banda limitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のネットワークで動作し、帯域には制限があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도의 네트워크에서 동작하며 대역폭이 제한됩니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "၎င်းသည် လိုင်းအကျယ် ကန့်သတ်ထားသော သီးခြားကွန်ရက်တွင် လည်ပတ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kjører på et separat nettverk med begrenset båndbredde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij draait op een apart netwerk met beperkte bandbreedte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa w osobnej sieci o ograniczonym paśmie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona numa rede separada com largura de banda limitada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează pe o rețea separată, cu lățime de bandă limitată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она работает в отдельной сети с ограниченной полосой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den körs på ett separat nätverk med begränsad bandbredd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานบนเครือข่ายแยกต่างหากที่มีแบนด์วิดท์จำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı bant genişliğine sahip ayrı bir ağda çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вона працює в окремій мережі з обмеженою смугою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
