    "Reconnected through %@. Your traffic stayed protected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة الاتصال عبر %@. بقيت حركة بياناتك محمية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoprettet forbindelse via %@. Din trafik forblev beskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut verbunden über %@. Ihr Traffic blieb geschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnected through %@. Your traffic stayed protected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectado a través de %@. Su tráfico permaneció protegido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال دوباره از طریق %@ برقرار شد. ترافیک شما همچنان محافظت‌شده ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetty uudelleen kohteen %@ kautta. Liikenteesi pysyi suojattuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecté via %@. Votre trafic est resté protégé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnesso tramite %@. Il tuo traffico è rimasto protetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 経由で再接続しました。トラフィックは保護されたままでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 통해 다시 연결되었습니다. 트래픽은 계속 보호되었습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ မှတစ်ဆင့် ပြန်လည်ချိတ်ဆက်ပြီးပါပြီ။ သင့်ထရက်ဖစ်ကို ဆက်လက်ကာကွယ်ထားသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblet til igjen via %@. Trafikken din forble beskyttet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw verbonden via %@. Je verkeer bleef beschermd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono ponownie przez %@. Twój ruch pozostał chroniony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Religado através de %@. O seu tráfego permaneceu protegido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectat prin %@. Traficul tău a rămas protejat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторное подключение через %@. Ваш трафик остался защищенным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återansluten via %@. Din trafik förblev skyddad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อใหม่ผ่าน %@ แล้ว ทราฟฟิกของคุณยังคงได้รับการปกป้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinden yeniden bağlanıldı. Trafiğiniz korunmaya devam etti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно підключено через %@. Ваш трафік залишився захищеним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 %@ 重新连接。您的流量始终受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已透過 %@ 重新連線。您的流量始終受到保護。"
          }
        }
      }
    },
