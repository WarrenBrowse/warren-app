    },
    "Requests an external port from the Warren exit relay via NAT-PMP so peer-to-peer apps (BitTorrent, video calls, self-hosted services) can receive incoming connections.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests an external port from the Warren exit relay via NAT-PMP so peer-to-peer apps (BitTorrent, video calls, self-hosted services) can receive incoming connections."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au relais de sortie Warren un port externe via NAT-PMP, pour que les applications pair-à-pair (BitTorrent, appels vidéo, services auto-hébergés) puissent recevoir des connexions entrantes."
          }
        }
      }
    },
    "Route traffic through an entry relay before the exit relay. Adds latency (~30-50 ms) and bandwidth overhead. OFF by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route traffic through an entry relay before the exit relay. Adds latency (~30-50 ms) and bandwidth overhead. OFF by default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achemine le trafic via un relais d'entrée avant le relais de sortie. Ajoute de la latence (~30-50 ms) et de la surcharge de bande passante. Désactivé par défaut."
          }
        }
      }
    },
    "Switched exit relay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switched exit relay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de relais de sortie"
          }
        }
      }
    },
    "The exit relay determines your apparent location to websites.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit relay determines your apparent location to websites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais de sortie détermine votre emplacement apparent vis-à-vis des sites web."
          }
        }
      }
    },
