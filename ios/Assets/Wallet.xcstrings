{
  "sourceLanguage": "en",
  "strings": {
    "Anyone with access to these words can recover your Warren wallet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with access to these words can recover your Warren wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne ayant accès à ces mots peut récupérer votre portefeuille Warren."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Cannot reveal phrase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reveal phrase"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'afficher la phrase"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        }
      }
    },
    "Enter your 12 recovery words": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your 12 recovery words"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vos 12 mots de récupération"
          }
        }
      }
    },
    "Failed to generate a new recovery phrase. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to generate a new recovery phrase. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de générer une nouvelle phrase de récupération. Veuillez réessayer."
          }
        }
      }
    },
    "Failed to read the wallet from secure storage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to read the wallet from secure storage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le portefeuille depuis le stockage sécurisé."
          }
        }
      }
    },
    "Failed to securely store the wallet. Make sure your device is unlocked and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to securely store the wallet. Make sure your device is unlocked and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de stocker le portefeuille en sécurité. Vérifiez que votre appareil est déverrouillé et réessayez."
          }
        }
      }
    },
    "I have written them down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have written them down"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je les ai notés"
          }
        }
      }
    },
    "No wallet is currently provisioned on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wallet is currently provisioned on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun portefeuille n'est actuellement présent sur cet appareil."
