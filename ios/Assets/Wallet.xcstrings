  "strings" : {
    "An unexpected error occurred while restoring your wallet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ غير متوقع أثناء استعادة محفظتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod en uventet fejl under gendannelsen af din wallet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen Ihrer Wallet ist ein unerwarteter Fehler aufgetreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unexpected error occurred while restoring your wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error inesperado al restaurar su monedero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام بازیابی کیف پول شما خطای غیرمنتظره‌ای رخ داد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lompakkosi palauttamisen aikana tapahtui odottamaton virhe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur inattendue est survenue lors de la restauration de votre portefeuille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore imprevisto durante il ripristino del tuo wallet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットの復元中に予期しないエラーが発生しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑을 복원하는 중에 예기치 않은 오류가 발생했습니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့် wallet ပြန်လည်ရယူနေစဉ် မမျှော်လင့်သော အမှားတစ်ခု ဖြစ်ပွားခဲ့သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det oppstod en uventet feil under gjenoppretting av lommeboken din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een onverwachte fout opgetreden tijdens het herstellen van je wallet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przywracania portfela wystąpił nieoczekiwany błąd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro inesperado ao restaurar a sua carteira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A apărut o eroare neașteptată la restaurarea portofelului tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении кошелька произошла непредвиденная ошибка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett oväntat fel uppstod när din plånbok skulle återställas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกิดข้อผิดพลาดที่ไม่คาดคิดขณะกู้คืนกระเป๋าเงินของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cüzdanınız geri yüklenirken beklenmeyen bir hata oluştu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час відновлення гаманця сталася неочікувана помилка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复您的钱包时发生了意外错误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復原您的錢包時發生未預期的錯誤。"
          }
        }
      }
    },
