        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kelimelere erişimi olan herkes Warren cüzdanınızı kurtarabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто, хто має доступ до цих слів, може відновити ваш гаманець Warren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何能接触到这些单词的人都可以恢复您的 Warren 钱包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
