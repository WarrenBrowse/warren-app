    "Adds an entry relay before your exit. Extra latency for harder traffic correlation.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer et indgangsrelæ før dit udgangsrelæ. Ekstra forsinkelse for at gøre trafikkorrelation sværere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt vor Ihrem Ausgang ein Eingangsrelais hinzu. Zusätzliche Latenz für schwerere Traffic-Korrelation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an entry relay before your exit. Extra latency for harder traffic correlation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un relé de entrada antes de su salida. Latencia adicional para dificultar la correlación de tráfico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää sisääntulorelen ennen ulostuloasi. Lisäviivettä vaikeuttamaan liikenteen korrelointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un relais d'entrée avant la sortie. Latence supplémentaire pour rendre la corrélation de trafic plus difficile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un relè di ingresso prima della tua uscita. Latenza extra per rendere più difficile la correlazione del traffico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口の前に入口リレーを追加します。トラフィックの相関分析を困難にするため遅延が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구 앞에 입구 릴레이를 추가합니다. 트래픽 상관 분석을 더 어렵게 만드는 대신 지연이 늘어납니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်ထွက်ပေါက်မတိုင်မီ ဝင်ပေါက်ရီလေးတစ်ခု ထည့်ပေးသည်။ ထရက်ဖစ်ဆက်စပ်မှုကို ပိုခက်ခဲစေရန် နှောင့်နှေးချိန် ပိုများသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til et inngangsrelé før utgangen din. Ekstra forsinkelse for vanskeligere trafikk-korrelasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een ingangsrelais toe vóór je uitgang. Extra latentie voor moeilijkere verkeerscorrelatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przekaźnik wejściowy przed punktem wyjściowym. Dodatkowe opóźnienie utrudniające korelację ruchu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um relé de entrada antes da sua saída. Latência adicional para dificultar a correlação de tráfego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет входной ретранслятор перед выходным. Дополнительная задержка ради усложнения корреляции трафика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till ett ingångsrelä före din utgång. Extra fördröjning för svårare trafikkorrelation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรีเลย์ทางเข้าก่อนทางออกของคุณ มีความหน่วงเพิ่มขึ้นเพื่อให้การเชื่อมโยงทราฟฟิกทำได้ยากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkışınızdan önce bir giriş aktarıcısı ekler. Trafik ilişkilendirmesini zorlaştırmak için ekstra gecikme oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає вхідний ретранслятор перед вашим виходом. Додаткова затримка ускладнює кореляцію трафіку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的出口前增加一个入口中继。会增加延迟，以提高流量关联分析的难度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的出口前增加一個入口中繼。會增加延遲，以提高流量關聯分析的難度。"
          }
        }
      }
    },
    "Always on. Makes VPN traffic indistinguishable from regular HTTPS.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Altid aktiv. Gør VPN-trafik umulig at skelne fra almindelig HTTPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer aktiv. Macht VPN-Traffic von normalem HTTPS ununterscheidbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on. Makes VPN traffic indistinguishable from regular HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre activo. Hace que el tráfico VPN sea indistinguible del HTTPS normal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina päällä. Tekee VPN-liikenteestä erottamattoman tavallisesta HTTPS:stä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours actif. Rend le trafic VPN indissociable d'un HTTPS classique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre attivo. Rende il traffico VPN indistinguibile dal normale HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常時オン。VPNトラフィックを通常のHTTPSと見分けがつかなくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 켜져 있습니다. VPN 트래픽을 일반 HTTPS와 구별할 수 없게 만듭니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အမြဲဖွင့်ထားသည်။ VPN ထရက်ဖစ်ကို ပုံမှန် HTTPS နှင့် ခွဲခြားမရစေပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid aktiv. Gjør VPN-trafikk umulig å skille fra vanlig HTTPS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd actief. Maakt VPN-verkeer niet te onderscheiden van gewoon HTTPS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze aktywne. Sprawia, że ruch VPN jest nieodróżnialny od zwykłego HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre ativo. Torna o tráfego VPN indistinguível do HTTPS normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда включено. Делает VPN-трафик неотличимым от обычного HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid aktiv. Gör VPN-trafik omöjlig att skilja från vanlig HTTPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานตลอดเวลา ทำให้ทราฟฟิก VPN แยกไม่ออกจาก HTTPS ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman açık. VPN trafiğini normal HTTPS'den ayırt edilemez hale getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди увімкнено. Робить VPN-трафік невідрізнюваним від звичайного HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终开启。让 VPN 流量与普通 HTTPS 无法区分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "始終開啟。讓 VPN 流量與普通 HTTPS 無法區分。"
          }
        }
      }
    },
