    },
    "Defense against AI-guided traffic analysis. ~10% bandwidth overhead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defense against AI-guided traffic analysis. ~10% bandwidth overhead."
