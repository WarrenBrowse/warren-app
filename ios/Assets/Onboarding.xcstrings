            "value": "Scegli le tue impostazioni predefinite. Puoi modificarle in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定値を選択してください。設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값을 선택하세요. 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်မူရင်းတန်ဖိုးများကို ရွေးချယ်ပါ။ ၎င်းတို့ကို ဆက်တင်များတွင် အချိန်မရွေး ပြောင်းလဲနိုင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg standardinnstillingene dine. Du kan endre dem når som helst under Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je standaardinstellingen. Je kunt deze op elk moment wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ustawienia domyślne. Możesz je zmienić w dowolnym momencie w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as suas predefinições. Pode alterá-las a qualquer momento nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите параметры по умолчанию. Их можно изменить в любой момент в Настройках."
          }
        },
        "sv": {
