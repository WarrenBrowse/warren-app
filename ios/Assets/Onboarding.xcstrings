{
  "sourceLanguage": "en",
  "strings": {
    "A decentralized VPN with non-custodial wallet authentication, always-on HTTP/3 mimicry, and optional multi-hop routing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En decentraliseret VPN med non-custodial wallet-godkendelse, altid aktiv HTTP/3-mimik og valgfri multihop-routing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dezentrales VPN mit non-custodial Wallet-Authentifizierung, stets aktiver HTTP/3-Nachahmung und optionalem Multihop-Routing."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decentralized VPN with non-custodial wallet authentication, always-on HTTP/3 mimicry, and optional multi-hop routing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una VPN descentralizada con autenticación mediante monedero no custodial, imitación de HTTP/3 siempre activa y enrutamiento multisalto opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hajautettu VPN, jossa on non-custodial-lompakkotodennus, aina päällä oleva HTTP/3-jäljittely ja valinnainen multihop-reititys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VPN décentralisé avec authentification par portefeuille non-custodial, mimétisme HTTP/3 toujours actif et routage multi-hop optionnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una VPN decentralizzata con autenticazione tramite wallet non custodial, mimica HTTP/3 sempre attiva e instradamento multi-hop opzionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非カストディアルなウォレット認証、常時オンのHTTP/3擬態、オプションのマルチホップルーティングを備えた分散型VPN。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비수탁형 지갑 인증, 상시 작동하는 HTTP/3 모방, 선택적 멀티홉 라우팅을 갖춘 분산형 VPN입니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-custodial wallet အတည်ပြုခြင်း၊ အမြဲဖွင့်ထားသော HTTP/3 အတုယူခြင်းနှင့် ရွေးချယ်နိုင်သော multihop လမ်းကြောင်းသတ်မှတ်ခြင်းပါဝင်သည့် ဗဟိုချုပ်ကိုင်မှုကင်းသော VPN တစ်ခု။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En desentralisert VPN med non-custodial lommebok-autentisering, alltid aktiv HTTP/3-etterligning og valgfri multihopp-ruting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gedecentraliseerde VPN met non-custodial wallet-authenticatie, altijd actieve HTTP/3-nabootsing en optionele multihop-routering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdecentralizowana sieć VPN z uwierzytelnianiem portfela non-custodial, stale aktywnym naśladowaniem HTTP/3 i opcjonalnym routingiem wieloprzeskokowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma VPN descentralizada com autenticação por carteira não custodial, imitação de HTTP/3 sempre ativa e encaminhamento multihop opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Децентрализованный VPN с аутентификацией через некастодиальный кошелек, постоянной имитацией HTTP/3 и опциональной многократной маршрутизацией."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En decentraliserad VPN med non-custodial plånboksautentisering, alltid aktiv HTTP/3-imitation och valfri multihopp-routing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN แบบกระจายศูนย์ที่มีการยืนยันตัวตนด้วยกระเป๋าเงินแบบ non-custodial การเลียนแบบ HTTP/3 ที่เปิดใช้งานตลอดเวลา และการกำหนดเส้นทางแบบมัลติฮอปที่เลือกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-custodial cüzdan kimlik doğrulaması, her zaman açık HTTP/3 taklidi ve isteğe bağlı çoklu geçiş yönlendirmesi sunan merkeziyetsiz bir VPN."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Децентралізований VPN з автентифікацією через некастодіальний гаманець, постійною імітацією HTTP/3 та додатковою багатоперехідною маршрутизацією."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款去中心化 VPN，采用非托管钱包身份验证、始终开启的 HTTP/3 模拟以及可选的多跳路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一款去中心化 VPN，採用非託管錢包身分驗證、始終開啟的 HTTP/3 模擬以及可選的多點跳躍路由。"
          }
        }
      }
    },
    "Activate your subscription": {
