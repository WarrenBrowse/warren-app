{
  "sourceLanguage": "en",
  "strings": {
    "A decentralized VPN with non-custodial wallet authentication, always-on HTTP/3 mimicry, and optional multi-hop routing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decentralized VPN with non-custodial wallet authentication, always-on HTTP/3 mimicry, and optional multi-hop routing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VPN décentralisé avec authentification par portefeuille non-custodial, mimétisme HTTP/3 toujours actif et routage multi-hop optionnel."
          }
        }
      }
    },
    "Activate your subscription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate your subscription"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer votre abonnement"
          }
        }
      }
    },
    "Adds an entry relay before your exit. Extra latency for harder traffic correlation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an entry relay before your exit. Extra latency for harder traffic correlation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un relais d'entrée avant la sortie. Latence supplémentaire pour rendre la corrélation de trafic plus difficile."
          }
        }
      }
    },
    "Always on. Makes VPN traffic indistinguishable from regular HTTPS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on. Makes VPN traffic indistinguishable from regular HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours actif. Rend le trafic VPN indissociable d'un HTTPS classique."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "fr": {
