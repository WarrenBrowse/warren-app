{
  "sourceLanguage" : "en",
  "strings" : {
    "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجربة VPN دون أي تنازل عن الخصوصية. بلا سجلّات. بلا حسابات. بلا تتبّع. مجرد عرض نطاق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En VPN-oplevelse uden kompromiser på privatliv. Ingen logfiler. Ingen konti. Ingen sporing. Bare båndbredde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine VPN-Erfahrung ohne Kompromisse beim Datenschutz. Keine Protokolle. Keine Konten. Kein Tracking. Nur Bandbreite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una experiencia VPN sin concesiones en privacidad. Sin registros. Sin cuentas. Sin rastreo. Solo ancho de banda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجربه‌ای از VPN بدون هیچ سازشی بر سر حریم خصوصی. بدون ثبت فعالیت. بدون حساب کاربری. بدون ردیابی. فقط پهنای باند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-kokemus ilman tinkimistä yksityisyydestä. Ei lokeja. Ei tilejä. Ei seurantaa. Vain kaistanleveyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expérience VPN sans compromis sur la vie privée. Aucune trace. Aucun compte. Aucun suivi. Juste de la bande passante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'esperienza VPN senza compromessi sulla privacy. Nessun log. Nessun account. Nessun tracciamento. Solo banda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーに一切妥協しないVPN体験。ログなし。アカウントなし。追跡なし。あるのは帯域だけ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호를 타협하지 않는 VPN 경험. 로그 없음. 계정 없음. 추적 없음. 오직 대역폭만."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ်ရေးကိုယ်တာကို အလျှော့မပေးသော VPN အတွေ့အကြုံ။ မှတ်တမ်းမရှိ။ အကောင့်မရှိ။ ခြေရာခံမှု မရှိ။ bandwidth သက်သက်သာ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En VPN-opplevelse uten kompromisser på personvern. Ingen logger. Ingen kontoer. Ingen sporing. Bare båndbredde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een VPN-ervaring zonder compromissen op privacy. Geen logs. Geen accounts. Geen tracking. Alleen bandbreedte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doświadczenie VPN bez kompromisów wobec prywatności. Bez logów. Bez kont. Bez śledzenia. Tylko przepustowość."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma experiência VPN sem compromissos quanto à privacidade. Sem registos. Sem contas. Sem rastreio. Apenas largura de banda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O experiență VPN fără compromisuri în ceea ce privește confidențialitatea. Fără loguri. Fără conturi. Fără urmărire. Doar lățime de bandă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN без компромиссов в области конфиденциальности. Никаких логов. Никаких аккаунтов. Никакого отслеживания. Только пропускная способность."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En VPN-upplevelse utan kompromisser kring integritet. Inga loggar. Inga konton. Ingen spårning. Bara bandbredd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประสบการณ์ VPN ที่ไม่ประนีประนอมเรื่องความเป็นส่วนตัว ไม่มีการเก็บประวัติ ไม่ต้องมีบัญชี ไม่มีการติดตาม มีแค่แบนด์วิดท์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilikten ödün vermeyen bir VPN deneyimi. Günlük yok. Hesap yok. Takip yok. Sadece bant genişliği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN без компромісів щодо приватності. Без логів. Без облікових записів. Без відстеження. Лише пропускна здатність."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在隐私上绝不妥协的 VPN 体验。无日志。无账户。无追踪。只有带宽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毫不妥協於隱私的 VPN 體驗。無紀錄。無帳號。無追蹤。只有純粹的頻寬。"
          }
        }
      }
    },
    "Adds an entry relay before your exit. Extra latency for harder traffic correlation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف مرحِّل دخول قبل خادم الخروج. زمن استجابة إضافي مقابل صعوبة أكبر في ربط حركة البيانات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer et indgangsrelæ før dit udgangsrelæ. Ekstra forsinkelse for at gøre trafikkorrelation sværere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt vor Ihrem Ausgang ein Eingangsrelais hinzu. Zusätzliche Latenz für schwerere Traffic-Korrelation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds an entry relay before your exit. Extra latency for harder traffic correlation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un relé de entrada antes de su salida. Latencia adicional para dificultar la correlación de tráfico."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک رلهٔ ورودی پیش از خروجی شما اضافه می‌کند. تأخیر بیشتر در ازای همبسته‌سازی دشوارتر ترافیک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää sisääntulorelen ennen ulostuloasi. Lisäviivettä vaikeuttamaan liikenteen korrelointia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un relais d'entrée avant la sortie. Latence supplémentaire pour rendre la corrélation de trafic plus difficile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un relè di ingresso prima della tua uscita. Latenza extra per rendere più difficile la correlazione del traffico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口の前に入口リレーを追加します。トラフィックの相関分析を困難にするため遅延が増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출구 앞에 입구 릴레이를 추가합니다. 트래픽 상관 분석을 더 어렵게 만드는 대신 지연이 늘어납니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်ထွက်ပေါက်မတိုင်မီ ဝင်ပေါက်ရီလေးတစ်ခု ထည့်ပေးသည်။ ထရက်ဖစ်ဆက်စပ်မှုကို ပိုခက်ခဲစေရန် နှောင့်နှေးချိန် ပိုများသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til et inngangsrelé før utgangen din. Ekstra forsinkelse for vanskeligere trafikk-korrelasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een ingangsrelais toe vóór je uitgang. Extra latentie voor moeilijkere verkeerscorrelatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje przekaźnik wejściowy przed punktem wyjściowym. Dodatkowe opóźnienie utrudniające korelację ruchu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um relé de entrada antes da sua saída. Latência adicional para dificultar a correlação de tráfego."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un releu de intrare înainte de ieșirea ta. Latență suplimentară pentru o corelare mai dificilă a traficului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет входной ретранслятор перед выходным. Дополнительная задержка ради усложнения корреляции трафика."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till ett ingångsrelä före din utgång. Extra fördröjning för svårare trafikkorrelation."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มรีเลย์ทางเข้าก่อนทางออกของคุณ มีความหน่วงเพิ่มขึ้นเพื่อให้การเชื่อมโยงทราฟฟิกทำได้ยากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkışınızdan önce bir giriş aktarıcısı ekler. Trafik ilişkilendirmesini zorlaştırmak için ekstra gecikme oluşur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає вхідний ретранслятор перед вашим виходом. Додаткова затримка ускладнює кореляцію трафіку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的出口前增加一个入口中继。会增加延迟，以提高流量关联分析的难度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的出口前增加一個入口中繼。會增加延遲，以提高流量關聯分析的難度。"
