    "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Warren محفظة غير وصائية: حسابك هو عبارة استرداد مكوّنة من 12 كلمة تملكها أنت وحدك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warren bruger en non-custodial wallet: din konto er en gendannelsessætning på 12 ord, som kun du har."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warren verwendet ein nicht-verwahrtes Wallet: Ihr Konto ist eine 12-Wörter-Wiederherstellungsphrase, die nur Sie besitzen."
          }
        },
        "en" : {
          "stringUnit" : {
