    "Pick your defaults. You can change these anytime in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dine standardindstillinger. Du kan ændre dem når som helst under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ihre Standardeinstellungen. Sie können diese jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your defaults. You can change these anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija sus valores predeterminados. Puede cambiarlos en cualquier momento en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse oletusasetuksesi. Voit muuttaa niitä milloin tahansa Asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
