      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld of %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %1$lld sur %2$lld"
          }
        }
      }
    },
    "Subscriptions are paid in privacy-preserving currencies on warrenbrowse.com. Your wallet pubkey is the only identifier the Warren network sees; no email or account number required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions are paid in privacy-preserving currencies on warrenbrowse.com. Your wallet pubkey is the only identifier the Warren network sees; no email or account number required."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements sont payés en monnaies respectueuses de la vie privée sur warrenbrowse.com. Votre clé publique de portefeuille est le seul identifiant que voit le réseau Warren ; aucun e-mail ni numéro de compte requis."
          }
        }
      }
    },
    "Tap Launch Warren to connect to the network. Your wallet stays in your secure enclave; no Warren server ever sees your private key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Launch Warren to connect to the network. Your wallet stays in your secure enclave; no Warren server ever sees your private key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Lancer Warren pour vous connecter au réseau. Votre portefeuille reste dans votre Secure Enclave ; aucun serveur Warren ne voit votre clé privée."
          }
        }
      }
    },
    "Wallet ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet ready"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille prêt"
          }
        }
      }
    },
    "Warren uses a non-custodial Ed25519 wallet derived from a 12-word recovery phrase. You alone hold the keys, and you can restore your subscription on any device using the same phrase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warren uses a non-custodial Ed25519 wallet derived from a 12-word recovery phrase. You alone hold the keys, and you can restore your subscription on any device using the same phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warren utilise un portefeuille Ed25519 non-custodial dérivé d'une phrase de récupération de 12 mots. Vous seul détenez les clés et pouvez restaurer votre abonnement sur n'importe quel appareil avec la même phrase."
          }
        }
      }
    },
    "Welcome to Warren VPN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Warren VPN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Warren VPN"
          }
        }
      }
    },
