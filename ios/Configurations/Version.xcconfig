// Versioning system
VERSIONING_SYSTEM = apple-generic

// Marketing version, calendar-based (YYYY.N). Independent of the desktop 1.x
// tag: the signed update-metadata pipeline requires this calendar form.
MARKETING_VERSION = 2026.3

// Build number
// Normally we reset the build number to 1 after bumping MARKETING_VERSION.
// Otherwise increment it for each subsequent TestFlight submission.
CURRENT_PROJECT_VERSION = 1
