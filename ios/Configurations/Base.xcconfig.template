#include "Version.xcconfig"
#include "ProductEnv.xcconfig"
#include "Api.xcconfig"

// Development team
// Replace with the Warren Apple Developer Team ID (10-char alphanumeric)
// when Warren account is provisioned. Placeholder until then.
DEVELOPMENT_TEAM = XXXXXXXXXX

// Product display name, per product environment (ProductEnv.xcconfig)
DISPLAY_NAME = $(WARREN_DISPLAY_NAME)

// Bundle ID, per product environment (ProductEnv.xcconfig). The suffix is what
// makes a non-prod build a separate install with a Keychain of its own.
APPLICATION_IDENTIFIER = com.warrenbrowse.vpn.ios$(WARREN_APP_ID_SUFFIX)

// Shared container security group ID, per product environment
SECURITY_GROUP_IDENTIFIER = group.com.warrenbrowse.vpn$(WARREN_APP_ID_SUFFIX)

// Code signing style
// Possible values: Manual or Automatic
CODE_SIGN_STYLE = Automatic

// Code signing identity
CODE_SIGN_IDENTITY[config=Debug] = Apple Development
CODE_SIGN_IDENTITY[config=Staging] = Apple Development
CODE_SIGN_IDENTITY[config=MockRelease] = Apple Development
CODE_SIGN_IDENTITY[config=Release] = Apple Distribution

// Flag used to conditionally show features that are in development
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG NEVER_IN_PRODUCTION
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Staging] = DEBUG NEVER_IN_PRODUCTION
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=MockRelease] =
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release] =
