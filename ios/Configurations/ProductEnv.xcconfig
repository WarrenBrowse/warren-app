// The Warren product environment of this build, and the per-environment
// anchors Xcode needs before any Rust runs.
//
// WARREN_PRODUCT_ENV is the single selector: prod | staging | beta. It reaches
// the Rust staticlib through build-rust-library.sh (the warren-product-env
// crate compiles the same environment in), the Info.plist (the URL scheme the
// OS registers, the display name) and the API host below. Override it from the
// command line for a one-off build of another environment:
//
//     xcodebuild ... WARREN_PRODUCT_ENV=beta
//
// The tables are copies of the rows of warren-product-env/src/lib.rs, spelled
// here because xcconfig cannot read a Rust crate; warren-product-env's
// tests/platform_lockstep.rs reads this file and fails on drift, the same way
// it holds the desktop and Android tables.
WARREN_PRODUCT_ENV = prod
WARREN_PRODUCT_ENV[config=Staging] = staging

WARREN_DEEP_LINK_SCHEME_prod = warren
WARREN_DEEP_LINK_SCHEME_staging = warren-staging
WARREN_DEEP_LINK_SCHEME_beta = warren-beta
WARREN_DEEP_LINK_SCHEME = $(WARREN_DEEP_LINK_SCHEME_$(WARREN_PRODUCT_ENV))

WARREN_API_HOST_prod = api.warrenbrowse.com
WARREN_API_HOST_staging = api.staging.warrenbrowse.com
WARREN_API_HOST_beta = api.beta.warrenbrowse.com
WARREN_API_HOST = $(WARREN_API_HOST_$(WARREN_PRODUCT_ENV))

WARREN_DISPLAY_NAME_prod = Warren VPN
WARREN_DISPLAY_NAME_staging = Warren VPN Staging
WARREN_DISPLAY_NAME_beta = Warren VPN Beta
WARREN_DISPLAY_NAME = $(WARREN_DISPLAY_NAME_$(WARREN_PRODUCT_ENV))

// The bundle id and the app group carry the same suffix, so a non-prod build
// is a separate product: it installs BESIDE the prod app instead of replacing
// it, and gets its own Keychain (the default access group is
// teamID.bundleID), so a beta binary cannot read the prod wallet mnemonic or
// the prod forum identity and sign beta-API requests with them. Prod keeps the
// shipped identity, so its suffix is empty. A non-prod build needs its own
// provisioning profiles: add the suffixed ids to ExportOptions.plist and to
// App.xcconfig / PacketTunnel.xcconfig before signing one for distribution.
WARREN_APP_ID_SUFFIX_prod =
WARREN_APP_ID_SUFFIX_staging = .staging
WARREN_APP_ID_SUFFIX_beta = .beta
WARREN_APP_ID_SUFFIX = $(WARREN_APP_ID_SUFFIX_$(WARREN_PRODUCT_ENV))

// The app-icon set in Assets.xcassets. The bundle id lets a beta install sit
// beside a prod one; the icon is what tells them apart on the home screen and
// in the App Switcher, the only place iOS shows the app before it is opened.
// Staging shares the beta artwork, as it does on the desktop: what matters is
// being distinguishable from prod, and there is no third palette. Regenerate
// the badged set with ios/scripts/generate-beta-app-icon.sh.
WARREN_APPICON_NAME_prod = AppIcon
WARREN_APPICON_NAME_staging = AppIconBeta
WARREN_APPICON_NAME_beta = AppIconBeta
WARREN_APPICON_NAME = $(WARREN_APPICON_NAME_$(WARREN_PRODUCT_ENV))

// The bootstrap seed the iOS address cache dials before it self-populates. Its
// resolver has no system-DNS fallback, so this must be a LIVE IP of the API
// host of the same row, never desktop's 0.0.0.0 no-pin sentinel. Keyed on the
// environment rather than on the build configuration: `Api.xcconfig` used to
// key it on Debug / Release / MockRelease, so a beta build resolved
// api.beta.warrenbrowse.com and then seeded itself with the production box.
WARREN_API_ENDPOINT_prod = 204.168.244.76:443
WARREN_API_ENDPOINT_staging = 37.27.198.240:443
WARREN_API_ENDPOINT_beta = 185.146.232.126:443
WARREN_API_ENDPOINT = $(WARREN_API_ENDPOINT_$(WARREN_PRODUCT_ENV))
