    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض عبارة الاسترداد لمحفظة Warren الخاصة بك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis gendannelsessætningen for din Warren-wallet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsphrase Ihrer Warren-Wallet anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reveal the recovery phrase for your Warren wallet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la frase de recuperación de su monedero Warren"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش عبارت بازیابی کیف پول Warren شما"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä Warren-lompakkosi palautuslause"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la phrase de récupération de votre portefeuille Warren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la frase di recupero del tuo wallet Warren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのWarrenウォレットのリカバリーフレーズを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 Warren 지갑의 복구 문구 표시"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့် Warren wallet အတွက် ပြန်လည်ရယူရေးစကားစုကို ပြသရန်"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis gjenopprettingsfrasen for Warren-lommeboken din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelzin van je Warren-wallet weergeven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetl frazę odzyskiwania portfela Warren"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a frase de recuperação da sua carteira Warren"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezvăluie fraza de recuperare pentru portofelul tău Warren"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать фразу восстановления кошелька Warren"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa återställningsfrasen för din Warren-plånbok"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงวลีกู้คืนสำหรับกระเป๋าเงิน Warren ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warren cüzdanınızın kurtarma ifadesini göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати фразу відновлення вашого гаманця Warren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示您的 Warren 钱包恢复短语"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示您的 Warren 錢包復原片語"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج التطبيق إلى هذا للاتصال واختبار طريقة جديدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen skal bruge dette til at oprette forbindelse og teste en ny metode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt dies, um eine Verbindung herzustellen und eine neue Funktion zu testen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The app needs this to connect and test a new method."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación lo necesita para conectarse y probar un método nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه برای اتصال و آزمایش یک روش جدید به این نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus tarvitsee tätä yhteyden muodostamiseen ja uuden tavan testaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de ceci pour se connecter et tester une nouvelle méthode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne ha bisogno per connettersi e testare un nuovo metodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでは新しい方法の接続とテストのためにこれが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 새로운 방식으로 연결하고 테스트하는 데 필요합니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အက်ပ်သည် ချိတ်ဆက်ရန်နှင့် နည်းလမ်းအသစ်ကို စမ်းသပ်ရန်အတွက် ဤအရာကို လိုအပ်ပါသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen trenger dette for å koble til og teste en ny metode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app heeft dit nodig om verbinding te maken en een nieuwe methode te testen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja potrzebuje tego, aby połączyć się i przetestować nową metodę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita desta opção para ligar e testar um novo método."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația are nevoie de aceasta pentru a se conecta și a testa o metodă nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению это необходимо для подключения и тестирования нового метода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen behöver det här för att ansluta och testa en ny metod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปต้องการสิ่งนี้เพื่อเชื่อมต่อและทดสอบวิธีการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın buna bağlanması ve yeni bir yöntemi test etmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунку потрібно це, щоб підключитись і перевірити новий метод."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要此项来连接并测试新方法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式需要此項目來連線並測試新方式。"
          }
        }
      }
    }
  },
  "version": "1.0"
}