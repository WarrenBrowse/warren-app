    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض عبارة الاسترداد لمحفظة Warren الخاصة بك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis gendannelsessætningen for din Warren-wallet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsphrase Ihrer Warren-Wallet anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reveal the recovery phrase for your Warren wallet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la frase de recuperación de su monedero Warren"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش عبارت بازیابی کیف پول Warren شما"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä Warren-lompakkosi palautuslause"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la phrase de récupération de votre portefeuille Warren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la frase di recupero del tuo wallet Warren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのWarrenウォレットのリカバリーフレーズを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 Warren 지갑의 복구 문구 표시"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့် Warren wallet အတွက် ပြန်လည်ရယူရေးစကားစုကို ပြသရန်"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis gjenopprettingsfrasen for Warren-lommeboken din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelzin van je Warren-wallet weergeven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetl frazę odzyskiwania portfela Warren"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a frase de recuperação da sua carteira Warren"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezvăluie fraza de recuperare pentru portofelul tău Warren"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать фразу восстановления кошелька Warren"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa återställningsfrasen för din Warren-plånbok"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงวลีกู้คืนสำหรับกระเป๋าเงิน Warren ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warren cüzdanınızın kurtarma ifadesini göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати фразу відновлення вашого гаманця Warren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示您的 Warren 钱包恢复短语"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示您的 Warren 錢包復原片語"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للتطبيق اختبار واستخدام وكيل تضيفه في الوصول إلى واجهة API عندما يكون هذا الوكيل على شبكتك المحلية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giver appen mulighed for at teste og bruge en proxy, du tilføjer under API-adgang, når proxyen er på dit lokale netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht der App, einen Proxy zu testen und zu nutzen, den Sie unter API-Zugriff hinzufügen, wenn sich dieser Proxy in Ihrem lokalen Netzwerk befindet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lets the app test and use a proxy you add under API access when that proxy is on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la aplicación pruebe y use un proxy que añada en Acceso a API cuando ese proxy está en su red local."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به برنامه اجازه می‌دهد پراکسی‌ای را که در دسترسی به API اضافه می‌کنید، وقتی در شبکهٔ محلی شما است، آزمایش و استفاده کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallii sovelluksen testata ja käyttää välityspalvelinta, jonka lisäät kohdassa Ohjelmointirajapinnan käyttö, kun välityspalvelin on paikallisessa verkossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l'application de tester et d'utiliser un proxy que vous ajoutez dans Accès à l'API lorsque ce proxy se trouve sur votre réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente all'app di testare e usare un proxy che aggiungi in Accesso API quando il proxy si trova sulla tua rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIアクセスで追加したプロキシがローカルネットワーク上にある場合に、アプリがそのプロキシをテストして使用するために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 액세스에서 추가한 프록시가 로컬 네트워크에 있을 때 앱이 해당 프록시를 테스트하고 사용할 수 있게 합니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "API ရယူသုံးစွဲခွင့် တွင် သင်ထည့်သည့် proxy သည် သင်၏ လိုကယ် ကွန်ရက်ပေါ်တွင် ရှိသည့်အခါ အက်ပ်က ၎င်းကို စမ်းသပ်ပြီး အသုံးပြုနိုင်စေရန် ဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar appen teste og bruke en proxy du legger til under API-tilgang, når proxyen er på det lokale nettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kan de app een proxy testen en gebruiken die je toevoegt onder API-toegang, als die proxy op je lokale netwerk staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala aplikacji przetestować i używać serwera proxy dodanego w sekcji Dostęp do API, gdy ten serwer proxy znajduje się w Twojej sieci lokalnej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que a aplicação teste e utilize um proxy que adicione em Acesso à API quando esse proxy está na sua rede local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației să testeze și să folosească un proxy pe care îl adaugi în Acces la API, atunci când acel proxy se află în rețeaua ta locală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет приложению проверять и использовать прокси, который вы добавили в разделе «Доступ к API», если этот прокси находится в вашей локальной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter appen testa och använda en proxy som du lägger till under API-åtkomst när proxyn finns på ditt lokala nätverk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้แอปทดสอบและใช้พร็อกซีที่คุณเพิ่มไว้ในการเข้าถึง API เมื่อพร็อกซีนั้นอยู่ในเครือข่ายท้องถิ่นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın, API erişimi bölümünde eklediğiniz proxy yerel ağınızdaysa onu test etmesini ve kullanmasını sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє застосунку перевіряти й використовувати проксі, який ви додали в розділі «Доступ до API», якщо цей проксі розташований у вашій локальній мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您在“API 访问”中添加的代理位于本地网络时，应用需要此权限来测试并使用该代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您在「API 存取」中新增的代理伺服器位於本機網路時，應用程式需要此權限來測試並使用該代理伺服器。"
          }
        }
      }
    }
  },
  "version": "1.0"
}