# some docs
/docs/sign*

# Auto-generated by the `mullvad-release` tool in the working dir
# (Config::load_or_create writes a default `base_urls = []` if missing).
# Per-environment, not canonical source.
/mullvad-release.toml

# Python bytecode cache from ci/ scripts.
__pycache__/

# Windows local-dev artefacts (scripts/dev/windows/*). The daemon dev-service
# logs to dev-logs/ (SYSTEM-owned), the Electron dev launcher logs to dev-gui.log,
# and build-daemon.sh stages generated relay resources into dist-assets/. All
# per-machine, regenerated, never canonical source.
/dev-logs/
/dev-gui.log
/dist-assets/relays.json
/dist-assets/warren-relays.json

# Raw master art for the connect-screen scenery (processed into assets/images/scenery/*.webp)
new-da/
windows/.warren-product-env
