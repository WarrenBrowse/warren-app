#!/usr/bin/env bash

set -eux

INSTALL_DIR=$2

# Workaround for issue in electron-builder where the pkg-scripts are run twice, once with the
# correct install dir and once with an incorrect one. This guard prevents running the script when
# called the second time.
#
# TODO: This can be reverted when the following issue has been fixed:
# https://github.com/electron-userland/electron-builder/issues/8166
if [[ $INSTALL_DIR == *"Warren VPN.app" ]]; then
    exit 0
fi

# Same override the daemon honours (mullvad-paths::get_log_dir), so the test
# harness can exercise this script without root and without writing to the
# log directory of the install that is actually on the machine.
LOG_DIR=${WARREN_LOG_DIR:-/var/log/warren-vpn}

mkdir -p "$LOG_DIR"
chmod 755 "$LOG_DIR"
exec > "$LOG_DIR/preinstall.log" 2>&1

echo "Running preinstall at $(date)"

SETUP="$INSTALL_DIR/Warren VPN.app/Contents/Resources/warren-setup"

# The whole seal below belongs to an UPGRADE: it protects the host while the
# old bundle is deleted and its daemon killed. A first install has neither, so
# there is nothing to seal and $SETUP does not even exist, which the fatal
# prepare-restart then read as "could not protect the host" and aborted every
# fresh install. Linux guards the same block on the daemon being present
# (dist-assets/linux/before-install.sh) and Windows runs it only on the upgrade
# path (dist-assets/windows/installer.nsh).
if [[ -x "$SETUP" ]]; then
    # Arm the detached update guard BEFORE anything is armed or removed. It stages
    # its own copy of warren-setup outside this bundle and registers an OS timer, so
    # a machine whose daemon never comes back resets its own firewall instead of
    # waiting for a human with a terminal. Runs as root: it writes a LaunchDaemon.
    # Not fatal: a machine that cannot schedule the guard is still better served by
    # an update that proceeds with the in-daemon dead-man than by no update at all.
    "$SETUP" arm-deadman || echo "Failed to arm the detached update guard"

    # Stop the existing daemon. INSTALL_DIR is writeable by admins, so we drop privileges before executing warren-setup.
    #
    # FATAL since 2026-08-08, matching Windows: this is what seals the host for the
    # swap, and an installer that could not arm the protection must not go on to
    # delete the app and kill the daemon. Proceeding is how a user ends up with no
    # internet, no daemon and no app to click.
    PREPARE_RESTART_STATUS=0
    sudo -u nobody "$SETUP" prepare-restart &>/dev/null || PREPARE_RESTART_STATUS=$?

    # 3 is warren-setup's DaemonNotRunning (mullvad-setup/src/main.rs): no daemon
    # is left holding the host, which is the state the seal was reaching for, not
    # a failure. Windows tolerates the same status (MVSETUP_DAEMON_NOT_RUNNING).
    if [[ $PREPARE_RESTART_STATUS -ne 0 && $PREPARE_RESTART_STATUS -ne 3 ]]; then
        echo "Failed to send 'prepare-restart' command to old warren-daemon; aborting the install"
        "$SETUP" disarm-deadman || true
        exit 1
    fi
fi

# NOTE: This path must be kept in sync with the path defined
# in warren-daemon/src/macos_launch_daemon.rs and postinstall
DAEMON_PLIST_PATH="/Library/LaunchDaemons/com.warrenbrowse.vpn.daemon.plist"
launchctl unload -w $DAEMON_PLIST_PATH || echo "Failed to unload old warren-daemon"

# For good measure, delete old application directories that may prevent install/upgrade.
# Make sure this happens after the daemon is unloaded, or it will trip the daemon's uninstall
# detection.
rm -rf "$INSTALL_DIR/Warren VPN.app"
rm -rf "$INSTALL_DIR/Warren VPN.localized"

# Migrate cache files from <=2020.8-beta2 paths
OLD_CACHE_DIR="/var/root/Library/Caches/warren-vpn"
NEW_CACHE_DIR="/Library/Caches/warren-vpn"

if [ -d "$OLD_CACHE_DIR" ]; then
    echo "Found old cache dir at $OLD_CACHE_DIR, moving to $NEW_CACHE_DIR"
    mkdir -p "$NEW_CACHE_DIR"
    mv "$OLD_CACHE_DIR"/* "$NEW_CACHE_DIR/" || echo "Unable to migrate cache. No cache files?"
    rm -rf "$OLD_CACHE_DIR"
fi

# Remove the existing relay and API address cache lists.
# There is a risk that they're incompatible with the format this version wants
rm "$NEW_CACHE_DIR/relays.json" || true
rm "$NEW_CACHE_DIR/api-ip-address.txt" || true

# Record whether the GUI is running so postinstall can relaunch it. /var/run is
# root-only writable, so an unprivileged user can't plant the marker.
GUI_RUNNING_MARKER="/var/run/warren-gui-was-running"
if pgrep -x "Warren VPN" >/dev/null 2>&1; then
    : > "$GUI_RUNNING_MARKER"
else
    rm -f "$GUI_RUNNING_MARKER"
fi

# Kill the GUI before proceeding with the upgrade.
pkill -x "Warren VPN" && sleep 1 || echo "Unable to kill GUI, not running?"
