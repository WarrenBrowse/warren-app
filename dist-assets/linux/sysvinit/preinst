#!/bin/sh
# sysvinit counterpart of dist-assets/linux/before-install.sh. Keep the two in
# step: the systemd flavour drives systemctl, this one drives the init script.
set -eu

NAME=warren-daemon@WARREN_SUFFIX@
LOG_DIR=/var/log/warren-vpn@WARREN_SUFFIX@
CACHE_DIR=/var/cache/warren-vpn@WARREN_SUFFIX@
SETUP="@WARREN_PRODUCT_DIR@/resources/warren-setup"

if [ -x "/etc/init.d/$NAME" ]; then
    # prepare-restart pins the target state to Secured, so the window between
    # the old daemon exiting and the new one starting cannot leak.
    if [ -x "$SETUP" ]; then
        "$SETUP" prepare-restart || true
    fi
    if command -v invoke-rc.d > /dev/null 2>&1; then
        invoke-rc.d "$NAME" stop || true
    else
        "/etc/init.d/$NAME" stop || true
    fi
    # The daemon rotates its log with a single level of history, so a reinstall
    # would destroy the incident window a bug report needs.
    cp "$LOG_DIR/daemon.log" "$LOG_DIR/old-install-daemon.log" \
        || echo "Failed to copy old daemon log"
fi

rm -f "$CACHE_DIR/relays.json"
rm -f "$CACHE_DIR/api-ip-address.txt"
