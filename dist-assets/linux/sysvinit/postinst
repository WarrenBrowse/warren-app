#!/bin/sh
# sysvinit counterpart of dist-assets/linux/after-install.sh. Keep the two in
# step: the systemd flavour drives systemctl, this one drives update-rc.d.
set -eu

NAME=warren-daemon@WARREN_SUFFIX@
EARLY_BOOT=warren-early-boot-blocking@WARREN_SUFFIX@
PRODUCT_DIR="@WARREN_PRODUCT_DIR@"

case "${1:-configure}" in
    configure) ;;
    abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
esac

chmod u+s "/usr/bin/warren-exclude@WARREN_SUFFIX@"

# No management-socket group is provisioned: the daemon exposes the socket to
# local users and gates wallet/secret RPCs per-uid (matching upstream Mullvad's
# threat model). Group membership only applies at the next login, so a
# group-based install would leave the GUI unable to reach the daemon until the
# user logs out and back in. Operators wanting kernel-enforced restriction can
# create a group and set WARREN_MANAGEMENT_SOCKET_GROUP in the supervisor.

# `defaults` takes the runlevels from each script's LSB header, so the daemon
# lands in the multi-user runlevels and the blocker in rcS.
update-rc.d "$NAME" defaults > /dev/null
update-rc.d "$EARLY_BOOT" defaults > /dev/null

# The blocker is enabled, never started here: running it now would block the
# traffic of the machine doing the install.
if command -v invoke-rc.d > /dev/null 2>&1; then
    invoke-rc.d "$NAME" start || echo "Failed to start $NAME"
else
    "/etc/init.d/$NAME" start || echo "Failed to start $NAME"
fi

# The system bus reads its policy directory once and denies ownership of any
# name it has no policy for, so it has to re-read before the NetworkManager VPN
# plugin can own the name NetworkManager calls it on. Without systemd the
# supported signal is SIGHUP to the daemon itself.
if [ -s /run/dbus/pid ]; then
    kill -HUP "$(cat /run/dbus/pid)" 2> /dev/null \
        || echo "Failed to reload dbus; the VPN indicator starts working after a reboot"
elif command -v invoke-rc.d > /dev/null 2>&1; then
    invoke-rc.d dbus force-reload > /dev/null 2>&1 \
        || echo "Failed to reload dbus; the VPN indicator starts working after a reboot"
fi

# Check if the system supports a new-enough AppArmor version.
supported_apparmor() {
    [ -e /etc/apparmor.d/abi/4.0 ]
}

if supported_apparmor; then
    # The AppArmor profile lets the Electron sandbox work by lifting the user
    # namespace restrictions.
    echo "Creating apparmor profile"
    cp "$PRODUCT_DIR/resources/apparmor_warren" /etc/apparmor.d/warren@WARREN_SUFFIX@
    apparmor_parser -r /etc/apparmor.d/warren@WARREN_SUFFIX@ \
        || echo "Failed to reload apparmor profile"
fi
