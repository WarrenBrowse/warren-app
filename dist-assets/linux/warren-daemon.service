# Systemd service unit file for the Warren VPN daemon (fork de Mullvad).

[Unit]
Description=Warren VPN daemon
Before=network-online.target
After=warren-early-boot-blocking.service NetworkManager.service systemd-resolved.service

StartLimitBurst=5
StartLimitIntervalSec=20
RequiresMountsFor=/opt/Warren\x20VPN/resources/

[Service]
Restart=always
RestartSec=1
ExecStart=/usr/bin/warren-daemon -vv --disable-stdout-timestamps
Environment="MULLVAD_RESOURCE_DIR=/opt/Warren VPN/resources/"

[Install]
WantedBy=multi-user.target
