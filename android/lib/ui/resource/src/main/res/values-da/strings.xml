    <string name="tunnel_exit_key_pinning_section">Fastgørelse af exit-nøgle</string>
    <string name="tunnel_exit_key_pinning_desc">Warren fastgør hver exits nøgle ved første brug og nægter at oprette forbindelse, hvis den ændres. Nulstil kun fastgørelserne, hvis du forventer en legitim nøglerotation; næste tilslutning fastgør igen.</string>
    <string name="tunnel_reset_pinned_keys">Nulstil fastgjorte exit-nøgler</string>
    <string name="tunnel_exit_relay">Exit-relæ…</string>
    <string name="tunnel_multihop_title">Multi-hop er endnu ikke tilgængelig på Android.</string>
    <string name="tunnel_multihop_desc">Multi-hop dirigerer trafik gennem et separat indgangsrelæ, så exit aldrig ser din IP. Det er tilgængeligt i Warren-skrivebordsappen. Android-tunnelen opretter i øjeblikket forbindelse med single-hop, så der vises ingen multi-hop-indikator, mens der er forbindelse.</string>
    <string name="tunnel_obfuscation_title">HTTP/3-efterligningssløring er altid slået til for Warren-tunneler.</string>
    <string name="tunnel_obfuscation_desc">Warren-tunneler udgiver sig for at være almindelig HTTP/3-browsertrafik: ALPN h3, SNI warrenbrowse.com, Initial-pakkeopdeling, UDP/443. Dette kan ikke slås fra, fordi en deaktivering ville gøre Warren-klienter umiddelbart genkendelige på netværket.</string>
    <string name="tunnel_obfuscation_legacy">Ældre sløringsmetoder (Shadowsocks, UDP-over-TCP, QUIC, LWO) gælder ikke for Warren-tunneler.</string>
    <string name="tunnel_mtu_range">%1$d-%2$d</string>
