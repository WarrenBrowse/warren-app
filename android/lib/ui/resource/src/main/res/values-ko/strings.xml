    <string name="tunnel_natpmp_status_requesting">상태: 포트 요청 중…</string>
    <string name="tunnel_natpmp_status_rate_limited">상태: 속도 제한됨</string>
    <string name="tunnel_natpmp_status_rate_limited_retry">" - %1$s초 후 재시도"</string>
