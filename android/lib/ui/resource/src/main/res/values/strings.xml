    <string name="device_name_info_first_paragraph">This is the name assigned to the device. Each device logged in on a Warren account gets a unique name that helps you identify it when you manage your devices in the app or on the website.</string>
    <string name="device_name_info_second_paragraph">You can have up to 5 devices logged in on one Warren account.</string>
