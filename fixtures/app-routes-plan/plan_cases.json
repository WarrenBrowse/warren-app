      "entry_country": null,
      "main_exit": 1,
      "exits": [
        { "app": "bank", "country": "se", "city": null },
        { "app": "browser", "country": "de", "city": "berlin" },
        { "app": "chat", "country": "fi", "city": null },
        { "app": "editor", "country": "de", "city": "berlin" },
        { "app": "game", "country": "jp", "city": null },
        { "app": "mail", "country": "se", "city": "stockholm" }
      ],
      "connected": true,
      "reports": [
        { "exit": 2, "state": "connected" },
        { "exit": 4, "state": "waiting" }
      ],
      "expect": {
        "routes": [
          { "entry": 2, "exit": 2, "apps": ["browser", "editor"] },
          { "entry": 4, "exit": 4, "apps": ["chat"] }
        ],
        "main": [{ "exit": 1, "apps": ["bank", "mail"] }],
        "blocked": ["game"],
        "resolutions": [
          { "country": "de", "city": "berlin", "kind": "route", "exit": 2, "public_ip": "198.51.100.2" },
          { "country": "fi", "city": null, "kind": "route", "exit": 4, "public_ip": "198.51.100.4" },
          { "country": "jp", "city": null, "kind": "unavailable", "reason": "no_relay" },
          { "country": "se", "city": null, "kind": "main", "public_ip": "198.51.100.1" },
          { "country": "se", "city": "stockholm", "kind": "main", "public_ip": "198.51.100.1" }
