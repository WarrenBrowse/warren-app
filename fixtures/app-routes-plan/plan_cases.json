        "statuses": [
          { "country": "de", "city": "berlin", "state": "connected", "reason": null, "public_ip": "198.51.100.2", "apps": ["browser", "editor"] },
          { "country": "fi", "city": null, "state": "unavailable", "reason": "waiting_for_route", "public_ip": null, "apps": ["chat"] },
          { "country": "jp", "city": null, "state": "unavailable", "reason": "no_relay", "public_ip": null, "apps": ["game"] },
          { "country": "se", "city": null, "state": "connected", "reason": null, "public_ip": "198.51.100.1", "apps": ["bank"] },
          { "country": "se", "city": "stockholm", "state": "connected", "reason": null, "public_ip": "198.51.100.1", "apps": ["mail"] }
