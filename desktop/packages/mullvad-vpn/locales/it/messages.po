msgstr "Verifica non riuscita. Riprova o segnala il problema sul forum della community."

msgctxt "auth-failure"
msgid "Blocking internet: account is out of time"
msgstr "Blocco di Internet: l'account è scaduto"

msgctxt "auth-failure"
msgid "Too many simultaneous connections on this account. Disconnect another device or try connecting again shortly."
msgstr "Troppe connessioni simultanee per questo account. Disconnetti l'altro dispositivo o prova a riconnetterti a breve."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please send a problem report."
msgstr "Impossibile autenticare l'account. Invia una segnalazione del problema."

msgctxt "auth-failure"
msgid "You are logged in with an invalid account number. Please log out and try another one."
msgstr "Hai effettuato l'accesso con un numero di account non valido. Esci e provane un altro."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended for a usage policy violation. Contact support if you believe this is a mistake."
msgstr "Blocco di Internet: il tuo accesso è stato sospeso per una violazione delle condizioni d'uso. Contatta l'assistenza se ritieni che si tratti di un errore."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended for abuse on a forwarded port. Contact support if you believe this is a mistake."
msgstr "Blocco di Internet: il tuo accesso è stato sospeso per abuso di una porta inoltrata. Contatta l'assistenza se ritieni che si tratti di un errore."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please report the problem on our community forum."
msgstr "Impossibile autenticare l'account. Segnala il problema sul forum della community."

#. Accessibility label of the beta badge button.
msgctxt "beta-badge"
msgid "About the Warren beta"
msgstr "Informazioni sulla beta di Warren"

#. Label of the beta badge shown in beta builds.
msgctxt "beta-badge"
msgid "BETA"
msgstr "BETA"

msgctxt "beta-badge"
msgid "Free beta network, limited bandwidth"
msgstr "Rete beta gratuita, banda limitata"

#. Short beta banner line. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "Free beta network, speed capped at %(mbps)d Mbps"
msgstr "Rete beta gratuita, velocità limitata a %(mbps)d Mbps"

#. Beta info dialog sentence. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "It runs on a separate network with bandwidth capped at %(mbps)d Mbps."
msgstr "Funziona su una rete separata con la banda limitata a %(mbps)d Mbps."

msgctxt "beta-badge"
msgid "It runs on a separate network with limited bandwidth."
msgstr "Funziona su una rete separata con banda limitata."

#. Link to the community forum in the beta info dialog.
