msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or send a problem report."
msgstr "Impossibile comunicare con il driver del kernel Warren. Prova a riconnetterti o invia una segnalazione del problema."

msgctxt "notifications"
msgid "Unable to resolve host of custom tunnel. Try changing your settings."
msgstr "Impossibile risolvere l'host del tunnel personalizzato. Prova a modificare le impostazioni."

msgctxt "notifications"
msgid "Unable to set system DNS server. Please send a problem report."
msgstr "Impossibile impostare il server DNS di sistema. Invia una segnalazione del problema."

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please send a problem report."
msgstr "Impossibile avviare la connessione tunnel. Invia una segnalazione del problema."

msgctxt "notifications"
msgid "Unable to start tunnel connection. This could be because of conflicts with VMware, please troubleshoot."
msgstr "Impossibile avviare la connessione al tunnel. Ciò potrebbe essere dovuto a conflitti con VMware, risolvere il problema."

msgctxt "notifications"
msgid "Update available. Install the latest app version to stay up to date"
msgstr "Aggiornamento disponibile. Installa l'ultima versione dell'app per restare aggiornato"

msgctxt "notifications"
msgid "Upgrade"
msgstr "Aggiorna"

msgctxt "notifications"
msgid "Your device is offline. The tunnel will automatically connect once your device is back online."
msgstr "Il tuo dispositivo è offline. Il tunnel si connetterà automaticamente una volta che il tuo dispositivo sarà di nuovo online."

#. The in-app banner which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version."
msgstr "La tua privacy potrebbe essere a rischio con questa versione dell'app non supportata."

#. The system notification which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version. Please update now."
msgstr "La tua privacy potrebbe essere a rischio con questa versione dell'app non supportata. Aggiornala subito."

msgctxt "notifications"
msgid "Automatic renewal charged: 1 month will be added to your Warren time. You can turn auto-renewal off anytime in Account settings."
msgstr "Rinnovo automatico addebitato: 1 mese verrà aggiunto al tuo tempo Warren. Puoi disattivare il rinnovo automatico quando vuoi nelle impostazioni dell'account."

msgctxt "notifications"
msgid "Automatic renewal failed. Update your payment method or buy credit manually."
msgstr "Rinnovo automatico non riuscito. Aggiorna il metodo di pagamento o acquista credito manualmente."

msgctxt "notifications"
msgid "Automatic renewal has been turned off for this account."
msgstr "Il rinnovo automatico è stato disattivato per questo account."

msgctxt "notifications"
msgid "Unable to block all network traffic. Please troubleshoot or report the problem on our community forum."
msgstr "Impossibile bloccare tutto il traffico di rete. Consulta la risoluzione dei problemi o segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try temporarily disabling any third-party antivirus or security software, or report the problem on our community forum."
msgstr "Impossibile bloccare tutto il traffico di rete. Prova a disabilitare temporaneamente qualsiasi antivirus o software di sicurezza di terze parti oppure segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try updating your kernel or report the problem on our community forum."
msgstr "Impossibile bloccare tutto il traffico di rete. Prova ad aggiornare il kernel o segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or report the problem on our community forum."
msgstr "Impossibile comunicare con il driver del kernel Warren. Prova a riconnetterti o segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Unable to set system DNS server. Please report the problem on our community forum."
msgstr "Impossibile impostare il server DNS di sistema. Segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please report the problem on our community forum."
msgstr "Impossibile avviare la connessione tunnel. Segnala il problema sul forum della community."

msgctxt "notifications"
msgid "Your bank asks for a confirmation to renew. Open Warren and buy credit to confirm."
msgstr "La tua banca richiede una conferma per il rinnovo. Apri Warren e acquista credito per confermare."

msgctxt "notifications"
msgid "Your network looks unstable: the tunnel reconnected too many times in a row. Reconnect once your connection has settled."
msgstr "La tua rete sembra instabile: il tunnel si è riconnesso troppe volte di seguito. Riconnettiti quando la connessione si sarà stabilizzata."

#. The 30-day advance notice before an automatic renewal charge.
#. Available placeholder:
#. %(date)s - the renewal date
msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at the monthly rate. You can turn auto-renewal off anytime in Account settings."
msgstr "Il tuo tempo Warren si rinnova automaticamente intorno al %(date)s, alla tariffa mensile. Puoi disattivare il rinnovo automatico quando vuoi nelle impostazioni dell'account."

msgctxt "notifications"
msgid "Your Warren time renews in the next days. You can turn auto-renewal off anytime in Account settings."
msgstr "Il tuo tempo Warren si rinnoverà nei prossimi giorni. Puoi disattivare il rinnovo automatico quando vuoi nelle impostazioni dell'account."

msgctxt "port-forwarding-view"
msgid "Assign a free port"
msgstr "Assegna una porta libera"

msgctxt "port-forwarding-view"
msgid "Choose another exit"
msgstr "Scegli un altro server di uscita"

msgctxt "port-forwarding-view"
msgid "disabled"
msgstr "disattivato"

msgctxt "port-forwarding-view"
msgid "This public port is already in use on this exit. Keep your port by switching exit, let the exit assign a free public port, or type another port above."
msgstr "Questa porta pubblica è già in uso su questo server di uscita. Mantieni la tua porta cambiando server di uscita, lascia che il server assegni una porta pubblica libera oppure digita un'altra porta qui sopra."

#. Cancel button label for voucher redemption.
msgctxt "redeem-voucher-alert"
msgid "Cancel"
msgstr "Annulla"

#. Input field label for voucher code.
msgctxt "redeem-voucher-alert"
msgid "Enter voucher code"
msgstr "Inserisci codice voucher"

