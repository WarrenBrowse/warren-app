msgstr "Apri il modulo di aiuto"

msgctxt "report-problem"
msgid "Open the topic"
msgstr "Apri l'argomento"

msgctxt "report-problem"
msgid "Posted as %(handle)s."
msgstr "Pubblicato come %(handle)s."

msgctxt "report-problem"
