msgctxt "split-tunneling-view"
msgid "No session token left"
msgstr "Token di sessione esauriti"

msgctxt "split-tunneling-view"
msgid "Off, uses the main connection"
msgstr "Disattivato, connessione principale"

msgctxt "split-tunneling-view"
msgid "Open System Settings"
msgstr "Apri le impostazioni di sistema"

msgctxt "split-tunneling-view"
msgid "Opens through a script: pick its program with Find another app"
msgstr "Si apre tramite uno script: scegli il suo programma con \"Trova un'altra app\""

#. This error message is shown if the user tries to launch a Linux desktop
#. entry file that doesn't contain the required 'Exec' value.
msgctxt "split-tunneling-view"
msgid "Please send a problem report."
msgstr "Invia una segnalazione del problema."

#. This error message is shown if the user tries to launch an app that
#. doesn't exist.
#. This error message is shown if an application fails during startup.
msgctxt "split-tunneling-view"
msgid "Please try again or send a problem report."
msgstr "Riprova o invia una segnalazione del problema."

msgctxt "split-tunneling-view"
msgid "Restart Warren Service"
msgstr "Riavvia il servizio Warren"

msgctxt "split-tunneling-view"
msgid "Snap apps cannot use a country yet"
msgstr "Le app Snap non possono ancora usare un Paese"

#. Information about split tunneling being unavailable due to
#. missing support in the user's operating system.
#. Available placeholders:
#. %(splitTunneling)s - will be replaced with Split tunneling
msgctxt "split-tunneling-view"
msgid "To use %(splitTunneling)s, please update to a Linux kernel version that supports cgroup v2."
msgstr "Per utilizzare %(splitTunneling)s, aggiorna il kernel Linux a una versione che supporti cgroup v2."

msgctxt "split-tunneling-view"
msgid "To use this, enable “Full disk access” for “Warren VPN” in the macOS system settings."
msgstr "Per usare questa funzione, abilita \"Accesso completo al disco\" per \"Warren VPN\" nelle impostazioni del sistema macOS."

#. Error message showed in a dialog when an application fails to launch.
msgctxt "split-tunneling-view"
msgid "Unable to launch selection. %(detailedErrorMessage)s"
msgstr "Impossibile avviare la selezione. %(detailedErrorMessage)s"

msgctxt "split-tunneling-view"
msgid "Unavailable"
msgstr "Non disponibile"

msgctxt "split-tunneling-view"
msgid "Waiting for the VPN"
msgstr "In attesa della VPN"

msgctxt "split-tunneling-view"
msgid "%(application)s, %(route)s"
msgstr "%(application)s, %(route)s"

msgctxt "split-tunneling-view"
msgid "Add an app"
msgstr "Aggiungi un'app"

msgctxt "split-tunneling-view"
msgid "All apps are protected by the VPN, except for the rules below."
msgstr "Tutte le app sono protette dalla VPN, salvo le regole qui sotto."

msgctxt "split-tunneling-view"
msgid "App"
msgstr "App"

msgctxt "split-tunneling-view"
msgid "Choose an exit country"
msgstr "Scegli un Paese di uscita"

msgctxt "split-tunneling-view"
msgid "Choose where each app goes."
msgstr "Scegli da dove passa ogni app."

msgctxt "split-tunneling-view"
msgid "Country of your main connection"
msgstr "Paese della tua connessione principale"

msgctxt "split-tunneling-view"
msgid "Default"
msgstr "Predefinito"

msgctxt "split-tunneling-view"
msgid "Direct connection by default. Only the apps below use the VPN."
msgstr "Connessione diretta per impostazione predefinita. Solo le app qui sotto usano la VPN."

msgctxt "split-tunneling-view"
msgid "Direct connection, your real IP is visible"
msgstr "Connessione diretta, il tuo IP reale è visibile"

msgctxt "split-tunneling-view"
msgid "Done"
msgstr "Fatto"

msgctxt "split-tunneling-view"
msgid "It uses this country when you open it with “Open through the VPN”."
msgstr "Usa questo Paese quando la apri con «Apri tramite la VPN»."

msgctxt "split-tunneling-view"
msgid "Needs Full Disk Access"
msgstr "Richiede l'accesso completo al disco"

msgctxt "split-tunneling-view"
msgid "Needs a signed build of Warren VPN"
msgstr "Richiede una versione firmata di Warren VPN"

msgctxt "split-tunneling-view"
msgid "Needs macOS 13 or newer"
msgstr "Richiede macOS 13 o successivo"

msgctxt "split-tunneling-view"
msgid "No app uses the VPN. Add one, or send the other apps through the VPN again."
msgstr "Nessuna app usa la VPN. Aggiungine una, oppure fai di nuovo passare le altre app dalla VPN."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to open it through the VPN: it uses the VPN until you close it."
msgstr "Nessuna regola. Aggiungi un'app per aprirla tramite la VPN: la usa finché non la chiudi."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to send it through another country or outside the VPN."
msgstr "Nessuna regola. Aggiungi un'app per farla passare da un altro Paese o fuori dalla VPN."

msgctxt "split-tunneling-view"
msgid "Not available on this system"
msgstr "Non disponibile su questo sistema"

msgctxt "split-tunneling-view"
msgid "Open outside the VPN"
msgstr "Apri fuori dalla VPN"

msgctxt "split-tunneling-view"
msgid "Open through the VPN"
msgstr "Apri tramite la VPN"

msgctxt "split-tunneling-view"
msgid "Other apps go"
msgstr "Le altre app passano"

msgctxt "split-tunneling-view"
msgid "Outside the VPN"
msgstr "Fuori dalla VPN"

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs a signed build of Warren VPN."
msgstr "La modalità «Fuori dalla VPN» richiede una versione firmata di Warren VPN."

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs macOS 13 or newer."
msgstr "La modalità «Fuori dalla VPN» richiede macOS 13 o successivo."

msgctxt "split-tunneling-view"
msgid "Remove %(application)s from the list"
msgstr "Rimuovi %(application)s dall'elenco"

msgctxt "split-tunneling-view"
msgid "Remove the rule"
msgstr "Rimuovi la regola"

msgctxt "split-tunneling-view"
msgid "Route for %(application)s"
msgstr "Percorso di %(application)s"

msgctxt "split-tunneling-view"
msgid "Rules per app"
msgstr "Regole per app"

msgctxt "split-tunneling-view"
msgid "Through the VPN"
msgstr "Tramite la VPN"

msgctxt "split-tunneling-view"
msgid "Through the VPN, another country"
msgstr "Tramite la VPN, altro Paese"

msgctxt "split-tunneling-view"
msgid "Through the VPN, from this country"
msgstr "Tramite la VPN, da questo Paese"

msgctxt "split-tunneling-view"
msgid "Until you close it. Close it first if it is already open."
msgstr "Finché non la chiudi. Chiudila prima se è già aperta."

msgctxt "split-tunneling-view"
msgid "VPN"
msgstr "VPN"

msgctxt "split-tunneling-view"
msgid "Your system cannot send apps outside the VPN."
msgstr "Il tuo sistema non consente di far passare le app fuori dalla VPN."

msgctxt "split-tunneling-view"
msgid "Only the apps you choose will use the VPN. The rest of this device will not be protected."
msgstr "Solo le app che scegli useranno la VPN. Il resto di questo dispositivo non sarà protetto."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be excluded from the VPN tunnel."
msgstr "Già in esecuzione. Chiudi %(applicationName)s prima di avviare da qui. In caso contrario, l'applicazione potrebbe non essere esclusa dal tunnel VPN."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not use the VPN."
msgstr "Se è già in esecuzione, chiudi %(applicationName)s prima di avviarla da qui. Altrimenti potrebbe non usare la VPN."

#. Link to the webpage
msgctxt "support-view"
msgid "FAQs & Guides"
msgstr "FAQ e guide"

#. Title label in navigation bar
msgctxt "support-view"
msgid "Support"
msgstr "Supporto"

#. Link to the refund policy webpage
msgctxt "support-view"
msgid "Refund policy"
msgstr "Politica di rimborso"

msgctxt "tray-icon-context-menu"
msgid "Disconnected from system service"
msgstr "Disconnesso dai servizi di sistema"

msgctxt "tray-icon-context-menu"
msgid "Open %(appName)s"
msgstr "Apri %(appName)s"

msgctxt "tray-icon-tooltip"
msgid "%(city)s, %(country)s"
msgstr "%(city)s, %(country)s"

msgctxt "tray-icon-tooltip"
msgid "Connected. %(location)s"
msgstr "Connesso. %(location)s"

msgctxt "tray-icon-tooltip"
msgid "Connecting. %(location)s"
msgstr "Connessione. %(location)s"

msgctxt "troubleshoot"
msgid "Disable split tunneling"
msgstr "Disabilita split tunneling"

msgctxt "troubleshoot"
msgid "Enable “Full Disk Access” for “Warren VPN” in the macOS system settings."
msgstr "Abilita \"Accesso completo al disco\" per \"Warren VPN\" nelle impostazioni di sistema macOS."

msgctxt "troubleshoot"
msgid "Failed to enable split tunneling. This is because the app is missing system permissions. What you can do:"
msgstr "Impossibile abilitare lo split tunneling: all'app mancano le autorizzazioni di sistema. Cosa puoi fare:"

msgctxt "troubleshoot"
msgid "If you have installed another VPN then try to uninstall that."
msgstr "Se hai installato un'altra VPN, prova a disinstallarla."

msgctxt "troubleshoot"
msgid "Make sure you have NF tables support."
msgstr "Assicurati di avere compatibilità per le tabelle NF."

msgctxt "troubleshoot"
msgid "Open system settings"
msgstr "Apri le impostazioni di sistema"

msgctxt "troubleshoot"
msgid "This error can happen when something other than Warren is actively updating the DNS."
msgstr "Questo errore può verificarsi quando qualcosa di diverso da Warren sta aggiornando attivamente il DNS."

msgctxt "troubleshoot"
msgid "This might be caused by an outdated kernel."
msgstr "Potrebbe essere causato da un kernel obsoleto."

msgctxt "troubleshoot"
msgid "Try restarting your device."
msgstr "Prova a riavviare il dispositivo."

msgctxt "troubleshoot"
msgid "Try to reinstall VMware."
msgstr "Prova a reinstallare VMware."

msgctxt "troubleshoot"
msgid "Try to turn Wi-Fi Calling off in the FaceTime app settings and restart the Mac."
msgstr "Prova a disattivare le chiamate Wi-Fi nelle impostazioni dell'app FaceTime e riavvia il Mac."

msgctxt "troubleshoot"
msgid "Try to uninstall VMware."
msgstr "Prova a disinstallare VMware."

msgctxt "troubleshoot"
msgid "Unable to communicate with the split tunnel driver."
msgstr "Impossibile comunicare con il driver di split tunneling."

msgctxt "troubleshoot"
msgid "Unable to start tunnel connection because of a failure when creating the tunnel device. This is often caused by conflicts with the VMware Bridge Protocol."
msgstr "Impossibile avviare la connessione tunnel a causa di un errore durante la creazione del dispositivo tunnel. Ciò è spesso causato da conflitti con il protocollo VMware Bridge."

msgctxt "troubleshoot"
msgid "Uninstall or disable other DNS, networking and ads/website blocking apps."
msgstr "Disinstalla o disabilita altre app di blocco DNS, di rete e di pubblicità/sito web."

msgctxt "troubleshoot"
msgid "Update your kernel."
msgstr "Aggiorna il tuo kernel."

msgctxt "troubleshoot"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Se questi passaggi non funzionano, segnala il problema sul forum della community."

msgctxt "tunnel-control"
msgid "Connect"
msgstr "Connetti"

msgctxt "tunnel-control"
msgid "Only selected apps are protected"
msgstr "Solo le app scelte sono protette"

#. Bold status title shown when the tunnel is up but the
#. device has no internet connection.
msgctxt "tunnel-control"
msgid "Connection interrupted"
msgstr "Connessione interrotta"

msgctxt "user-interface-settings-view"
msgid "Enable or disable system notifications. The critical notifications will always be displayed."
msgstr "Abilita o disabilita le notifiche di sistema. Le notifiche critiche saranno sempre visualizzate."

msgctxt "user-interface-settings-view"
msgid "Enable to move the app around as a free-standing window."
msgstr "Abilita per spostare l'app come una finestra indipendente."

#. Navigation button to the 'Language' settings view
msgctxt "user-interface-settings-view"
msgid "Language"
msgstr "Lingua"

msgctxt "user-interface-settings-view"
msgid "Monochromatic tray icon"
msgstr "Icona nell'area di notifica monocromatica"

msgctxt "user-interface-settings-view"
msgid "Notifications"
msgstr "Notifiche"

msgctxt "user-interface-settings-view"
msgid "Show only the tray icon when the app starts."
msgstr "Mostra solo l'icona nell'area di notifica all'avvio dell'app."

msgctxt "user-interface-settings-view"
msgid "Start minimized"
msgstr "Avvia ridotta a icona"

msgctxt "user-interface-settings-view"
msgid "Unpin app from taskbar"
msgstr "Sblocca l'app dalla barra delle applicazioni"

msgctxt "user-interface-settings-view"
msgid "Use a monochromatic tray icon instead of a colored one."
msgstr "Usa un'icona nell'area di notifica monocromatica e non colorata."

#. Title label in navigation bar
msgctxt "user-interface-settings-view"
msgid "User interface settings"
msgstr "Impostazioni dell'interfaccia utente"

msgctxt "vpn-settings-view"
msgid "Add a server"
msgstr "Aggiungi un server"

#. Button label to add a private IP DNS server despite warning.
msgctxt "vpn-settings-view"
msgid "Add anyway"
msgstr "Aggiungi comunque"

#. Label for settings that enables ad blocking.
msgctxt "vpn-settings-view"
msgid "Ads"
msgstr "Annunci"

#. Label for settings that enables block of adult content.
msgctxt "vpn-settings-view"
msgid "Adult content"
msgstr "Contenuti per adulti"

#. Label for list item that navigates to anti-censorship
#. settings view.
msgctxt "vpn-settings-view"
msgid "Anti-censorship"
msgstr "Anticensura"

msgctxt "vpn-settings-view"
msgid "Attention: enabling this will always require a Warren VPN connection in order to reach the internet."
msgstr "Attenzione: abilitando questa opzione, si richiederà sempre una connessione Warren VPN per navigare in Internet."

msgctxt "vpn-settings-view"
msgid "Attention: this setting cannot be used in combination with <b>%(customDnsFeatureName)s</b>"
msgstr "Attenzione: questa impostazione non può essere utilizzata in combinazione con <b>%(customDnsFeatureName)s</b>"

msgctxt "vpn-settings-view"
msgid "Auto-connect"
msgstr "Connessione automatica"

msgctxt "vpn-settings-view"
msgid "Automatically connect to a server when the app launches."
msgstr "Connettiti automaticamente al server all'avvio dell'app."

#. This is displayed when the custom DNS setting is turned on which makes the block
#. ads/trackers settings disabled. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(customDnsFeatureName)s - The name displayed next to the custom DNS toggle.
msgctxt "vpn-settings-view"
msgid "Disable \"%(customDnsFeatureName)s\" below to activate these settings."
msgstr "Disabilita \"%(customDnsFeatureName)s\" di seguito per attivare queste impostazioni."

#. This is displayed when either or both of the block ads/trackers settings are
#. turned on which makes the custom DNS setting disabled.
#. Available placeholders:
#. %(preferencesPageName)s - The page title showed on top in the preferences page.
msgctxt "vpn-settings-view"
msgid "Disable all <b>DNS content blockers</b> above to activate this setting."
msgstr "Disabilita tutti i <b>blocchi dei contenuti DNS</b> per attivare questa impostazione."

msgctxt "vpn-settings-view"
msgid "DNS content blockers"
msgstr "Blocchi dei contenuti DNS"

msgctxt "vpn-settings-view"
msgid "Enable to add at least one DNS server."
msgstr "Abilita per aggiungere almeno un server DNS."

#. Description of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "Enable to allow IPv6 traffic through the tunnel."
msgstr "Abilita per consentire il traffico IPv6 attraverso il tunnel."

msgctxt "vpn-settings-view"
msgid "Enter IP"
msgstr "Inserisci IP"

#. Label for settings that enables block of gamling related websites.
msgctxt "vpn-settings-view"
msgid "Gambling"
msgstr "Gioco d'azzardo"

#. Title of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "In-tunnel IPv6"
msgstr "In-tunnel IPv6"

msgctxt "vpn-settings-view"
msgid "IPv4 is always enabled and the majority of websites and applications use this protocol. We do not recommend enabling IPv6 unless you know you need it."
msgstr "IPv4 è sempre abilitato e la maggior parte dei siti web e delle applicazioni utilizza questo protocollo. Non consigliamo di abilitare IPv6 a meno che tu non sappia di averne bisogno."

#. A complimentary description for the setting Device IP version,
#. explaining why the user might want to configure the setting.
msgctxt "vpn-settings-view"
msgid "It can be useful when you are aware of problems caused by a certain IP version."
msgstr "Può essere utile quando si è a conoscenza di problemi causati da una determinata versione IP."

msgctxt "vpn-settings-view"
msgid "It does this by allowing network communication outside the tunnel to local multicast and broadcast ranges as well as to and from these private IP ranges:"
msgstr "Lo fa consentendo la comunicazione di rete al di fuori del tunnel verso intervalli multicast e broadcast locali, nonché da e verso questi intervalli IP privati:"

msgctxt "vpn-settings-view"
msgid "Kill switch"
msgstr "Kill switch"

msgctxt "vpn-settings-view"
msgid "Launch app on start-up"
msgstr "Lancia app all'avvio"

msgctxt "vpn-settings-view"
msgid "Local network sharing"
msgstr "Condivisione rete locale"

msgctxt "vpn-settings-view"
msgid "Lockdown mode"
msgstr "Modalità Blocco"

#. Label for settings that enables malware blocking.
msgctxt "vpn-settings-view"
msgid "Malware"
msgstr "Malware"

msgctxt "vpn-settings-view"
msgid "Server IP override"
msgstr "Sovrascritture IP server"

#. Label for settings that enables block of social media.
msgctxt "vpn-settings-view"
msgid "Social media"
msgstr "Social media"

msgctxt "vpn-settings-view"
msgid "The app’s built-in kill switch is always on. This setting will additionally block the internet if clicking Disconnect or Quit."
msgstr "Il kill switch integrato dell'app è sempre attivo. Questa impostazione serve inoltre a bloccare Internet quando si clicca su Disconnetti o Esci."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents."
msgstr "La differenza tra il Kill Switch e la Modalità Blocco è che il Kill Switch eviterà che si verifichino perdite durante le riconnessioni automatiche del tunnel, arresti anomali del software e incidenti simili."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents. With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "La differenza tra il Kill Switch e la Modalità Blocco è che il Kill Switch eviterà che si verifichino perdite durante le riconnessioni automatiche del tunnel, arresti anomali del software e incidenti simili. Con la Modalità Blocco abilitata, devi essere connesso a un server Warren VPN per poter raggiungere Internet. La disconnessione o la chiusura manuale dell'app bloccherà la connessione."

msgctxt "vpn-settings-view"
msgid "The DNS server you want to add is a private IP. You must ensure that your network interfaces are configured to use it."
msgstr "Il server DNS che vuoi aggiungere è un IP privato. È necessario assicurarsi che le interfacce di rete siano configurate per utilizzarlo."

msgctxt "vpn-settings-view"
msgid "This built-in feature prevents your traffic from leaking outside of the VPN tunnel if your network suddenly stops working or if the tunnel fails, it does this by blocking your traffic until your connection is reestablished."
msgstr "Questa funzione integrata impedisce al tuo traffico di fuoriuscire dal tunnel VPN qualora la tua rete smettesse improvvisamente di funzionare o qualora il tunnel si guastasse: lo fa bloccando il tuo traffico fino a quando la tua connessione non viene ristabilita."

msgctxt "vpn-settings-view"
msgid "This feature allows access to other devices on the local network, such as for sharing, printing, streaming, etc."
msgstr "Questa funzione consente l'accesso ad altri dispositivi sulla rete locale, ad esempio per la condivisione, la stampa, lo streaming, ecc."

#. A description for the setting Device IP version,
#. explaining how the user can configure the setting.
msgctxt "vpn-settings-view"
msgid "This feature allows you to choose whether to use only IPv4, only IPv6, or allow the app to automatically decide the best option when connecting to a server."
msgstr "Questa funzionalità consente di scegliere se utilizzare solo IPv4, solo IPv6 oppure consentire all'app di decidere automaticamente l'opzione migliore quando ci si connette a un server."

msgctxt "vpn-settings-view"
msgid "This might cause issues on certain websites, services, and apps."
msgstr "Ciò potrebbe causare problemi su determinati siti web, servizi e app."

msgctxt "vpn-settings-view"
msgid "This network cannot be shared."
msgstr "Questa rete non può essere condivisa."

msgctxt "vpn-settings-view"
msgid "This network is too broad to be shared outside the tunnel."
msgstr "Questa rete è troppo ampia per essere condivisa al di fuori del tunnel."

#. Label for settings that enables tracker blocking.
msgctxt "vpn-settings-view"
msgid "Trackers"
msgstr "Tracker"

msgctxt "vpn-settings-view"
msgid "Traffic to these networks goes outside the VPN tunnel."
msgstr "Il traffico verso queste reti passa al di fuori del tunnel VPN."

msgctxt "vpn-settings-view"
msgid "Use custom DNS server"
msgstr "Usa un server DNS personalizzato"

#. Title label in navigation bar
msgctxt "vpn-settings-view"
msgid "VPN settings"
msgstr "Impostazioni VPN"

msgctxt "vpn-settings-view"
msgid "Warning: The malware blocker is not an anti-virus and should not be treated as such, this is just an extra layer of protection."
msgstr "Avvertenza: questa protezione dai malware non è un antivirus e non deve essere trattata come tale, è solo un ulteriore livello di protezione."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled it stops the device from contacting certain domains or websites known for distributing ads, malware, trackers and more."
msgstr "Quando è abilitata, questa funzionalità impedisce al dispositivo di contattare determinati domini o siti Web noti per la distribuzione di annunci, malware, tracker e altro."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled, IPv6 can be used alongside IPv4 in the VPN tunnel to communicate with internet services."
msgstr "Quando questa funzione è abilitata, IPv6 può essere utilizzato insieme a IPv4 nel tunnel VPN per comunicare con i servizi Internet."

msgctxt "vpn-settings-view"
msgid "With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Con la Modalità Blocco abilitata, devi essere connesso a un server Warren VPN per poter raggiungere Internet. La disconnessione o la chiusura manuale dell'app bloccherà la connessione."

#. Value shown for the bandwidth limit in beta builds.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "vpn-settings-view"
msgid "%(mbps)d Mbps"
msgstr "%(mbps)d Mbps"

msgctxt "vpn-settings-view"
msgid "Add a network"
msgstr "Aggiungi una rete"

#. Feature indicator shown when the advanced "Allow external DNS resolvers"
#. setting is on, i.e. DNS leak protection is relaxed.
msgctxt "vpn-settings-view"
msgid "Allow external DNS"
msgstr "Consenti DNS esterni"

#. Label for the advanced setting that allows DNS queries to resolvers
#. other than the configured one.
msgctxt "vpn-settings-view"
msgid "Allow external DNS resolvers"
msgstr "Consenti resolver DNS esterni"

#. Hint below the bandwidth limit row in beta builds.
msgctxt "vpn-settings-view"
msgid "Bandwidth is limited by the free beta network and enforced by the servers. This setting is unavailable during the beta."
msgstr "La banda è limitata dalla rete beta gratuita e viene applicata dai server. Questa impostazione non è disponibile durante la beta."

msgctxt "vpn-settings-view"
msgid "Connect to a single self-hosted exit you enter manually, bypassing the verified server list. Only use an exit you operate or fully trust: it sees your unencrypted traffic."
msgstr "Connettiti a un singolo server di uscita self-hosted che inserisci manualmente, ignorando l'elenco dei server verificati. Usa solo un server di uscita che gestisci tu o di cui ti fidi completamente: vede il tuo traffico non crittografato."

msgctxt "vpn-settings-view"
msgid "Cover domain (optional)"
msgstr "Dominio di copertura (facoltativo)"

msgctxt "vpn-settings-view"
msgid "Custom exit (advanced)"
msgstr "Server di uscita personalizzato (avanzato)"

msgctxt "vpn-settings-view"
msgid "Endpoint"
msgstr "Endpoint"

msgctxt "vpn-settings-view"
msgid "Enter a network in CIDR notation, such as 192.168.1.0/24 or fd00::/8."
msgstr "Inserisci una rete in notazione CIDR, ad esempio 192.168.1.0/24 o fd00::/8."

#. Placeholder of the field where the user types a network to share
#. outside the tunnel, in CIDR notation.
msgctxt "vpn-settings-view"
msgid "Enter a network, e.g. 192.168.1.0/24"
msgstr "Inserisci una rete, ad es. 192.168.1.0/24"

msgctxt "vpn-settings-view"
msgid "Exit address as host:port. Bracket IPv6, for example [2001:db8::1]:443."
msgstr "Indirizzo del server di uscita in formato host:porta. Metti l'IPv6 tra parentesi quadre, ad esempio [2001:db8::1]:443."

msgctxt "vpn-settings-view"
msgid "For advanced users. When enabled, the firewall stops blocking DNS queries to resolvers other than the configured one, so tools like \"dig @1.1.1.1\" work while connected."
msgstr "Per utenti esperti. Se abilitata, il firewall smette di bloccare le query DNS verso resolver diversi da quello configurato, così strumenti come \"dig @1.1.1.1\" funzionano mentre sei connesso."

#. The hint displayed below the bandwidth limit input field.
#. Available placeholders:
#. %(max)d - the maximum accepted value in Mbps
#. %(min)d - the minimum accepted value in Mbps
msgctxt "vpn-settings-view"
msgid "Limit the VPN bandwidth in Mbps, applied to upload and download separately. Valid range: %(min)d - %(max)d. Leave empty for no limit. Applies immediately."
msgstr "Limita la banda della VPN in Mbps, applicata separatamente a caricamento e download. Intervallo valido: %(min)d - %(max)d. Lascia vuoto per nessun limite. Si applica immediatamente."

msgctxt "vpn-settings-view"
msgid "Managed"
msgstr "Gestito"

#. The title for the bandwidth limit setting.
msgctxt "vpn-settings-view"
msgid "Max bandwidth"
msgstr "Banda massima"

msgctxt "vpn-settings-view"
msgid "Set only when the exit runs a public TLS certificate (X.509 mode). Leave empty for the default raw-key mode."
msgstr "Da impostare solo se il server di uscita utilizza un certificato TLS pubblico (modalità X.509). Lascia vuoto per la modalità predefinita a chiave grezza."

msgctxt "vpn-settings-view"
msgid "The exit’s Ed25519 public key, 64 hexadecimal characters."
msgstr "La chiave pubblica Ed25519 del server di uscita, 64 caratteri esadecimali."

msgctxt "vpn-settings-view"
msgid "The exit’s routing id, 32 hexadecimal characters."
msgstr "L'ID di instradamento del server di uscita, 32 caratteri esadecimali."

msgctxt "vpn-settings-view"
msgid "The exit’s X25519 multi-hop key, 64 hexadecimal characters."
msgstr "La chiave multihop X25519 del server di uscita, 64 caratteri esadecimali."

msgctxt "vpn-settings-view"
msgid "The queries still travel through the VPN tunnel, but the resolver you choose will see them. Leave this off unless you are testing remote DNS resolution."
msgstr "Le query viaggiano comunque nel tunnel VPN, ma il resolver che scegli le vedrà. Lascia disattivata questa opzione a meno che tu non stia testando la risoluzione DNS remota."

#. Placeholder shown when no bandwidth limit is set.
msgctxt "vpn-settings-view"
msgid "Unlimited"
msgstr "Illimitata"

msgctxt "vpn-settings-view"
msgid "X25519 multi-hop key"
msgstr "Chiave multihop X25519"

msgctxt "vpn-settings-view"
msgid "Exit ID"
msgstr "ID di uscita"

msgctxt "vpn-settings-view"
msgid "Public key"
msgstr "Chiave pubblica"

#. Description of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "A prepaid beta access voucher is linked to your account automatically. No payment, nothing to do."
msgstr "Un voucher di accesso beta prepagato viene collegato automaticamente al tuo account. Nessun pagamento, niente da fare."

#. Confirmation that the beta access is active.
#. Available placeholders:
#. %(date)s - the expiry date of the granted access
msgctxt "warren-onboarding"
msgid "Beta access active until %(date)s."
msgstr "Accesso beta attivo fino al %(date)s."

#. Error shown when the beta access could not be activated yet.
msgctxt "warren-onboarding"
msgid "Could not activate the beta access yet (are you online?). Retrying automatically, and again at next launch. You can continue anyway."
msgstr "Non è ancora stato possibile attivare l'accesso beta (sei online?). Il tentativo verrà ripetuto automaticamente, e di nuovo al prossimo avvio. Puoi comunque continuare."

#. Link shown under onboarding errors pointing to the public help page.
msgctxt "warren-onboarding"
msgid "Having trouble? Visit our help page"
msgstr "Problemi? Visita la nostra pagina di aiuto"

msgctxt "warren-onboarding"
msgid "Retry now"
msgstr "Riprova ora"

#. Beta onboarding line describing the degraded service.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with bandwidth capped at %(mbps)d Mbps. These are not the final service conditions."
msgstr "La beta funziona su una rete separata e gratuita, con banda limitata a %(mbps)d Mbps. Queste non sono le condizioni definitive del servizio."

msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with limited bandwidth. These are not the final service conditions."
msgstr "La beta funziona su una rete separata e gratuita, con banda limitata. Queste non sono le condizioni definitive del servizio."

#. Title of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "Your beta access"
msgstr "Il tuo accesso beta"

msgctxt "warren-pubkey-warning"
msgid "Could not find that exit server anymore. Try reconnecting."
msgstr "Non è più possibile trovare quel server di uscita. Prova a riconnetterti."

msgctxt "warren-pubkey-warning"
msgid "Could not save the new key. Please try again."
msgstr "Impossibile salvare la nuova chiave. Riprova."

msgctxt "warren-pubkey-warning"
msgid "Could not trust the new key."
msgstr "Impossibile affidarsi alla nuova chiave."

msgctxt "warren-pubkey-warning"
msgid "The key changed again before it could be trusted. Review the new key and try again."
msgstr "La chiave è cambiata di nuovo prima che fosse possibile affidarsi a essa. Controlla la nuova chiave e riprova."

msgctxt "wireguard-settings-view"
msgid "%(daita)s (%(daitaFull)s) hides patterns in your encrypted VPN traffic."
msgstr "%(daita)s (%(daitaFull)s) nasconde i percorsi in un traffico VPN crittografato."

msgctxt "wireguard-settings-view"
msgid "By enabling “%(directOnly)s” you will have to manually select a server that is %(daita)s-enabled. This can cause you to end up in a blocked state until you have selected a compatible server in the “Select location” view."
msgstr "Abilitando “%(directOnly)s” dovrai selezionare manualmente un server abilitato per %(daita)s. Questo può comportare uno stato di blocco finché non selezioni un server compatibile nella vista “Seleziona posizione”."

msgctxt "wireguard-settings-view"
msgid "Cancel"
msgstr "Annulla"

#. Title for device IP version setting.
msgctxt "wireguard-settings-view"
msgid "Device IP version"
msgstr "Versione IP dispositivo"

msgctxt "wireguard-settings-view"
msgid "It combines a quantum-safe key exchange with the classical one. When it is on, the app only connects through servers that offer it. When it is off, it is still used wherever a server offers it."
msgstr "Combina uno scambio di chiavi resistente ai computer quantistici con quello classico. Quando è attiva, l'app si connette solo tramite server che lo offrono. Quando è disattivata, viene comunque usato ovunque un server lo offra."

#. The title for the QUIC MTU setting. MTU stands for Maximum
#. Transmission Unit and controls the maximum size of packets sent over
#. the VPN tunnel.
msgctxt "wireguard-settings-view"
msgid "MTU"
msgstr "MTU"

msgctxt "wireguard-settings-view"
msgid "Multihop is being used to enable DAITA for your selected location"
msgstr "Il multihop viene utilizzato per abilitare DAITA per la posizione selezionata"

#. Warning text in a dialog that is displayed after a setting is toggled.
msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. In order to use the internet, you might have to select a new location after enabling."
msgstr "Non tutti i nostri server sono abilitati per %(daita)s. Per usare Internet, potresti dover selezionare una nuova posizione dopo l'abilitazione."

#. The title for the QUIC quantum resistance selector. This setting
#. makes the cryptography resistant to the future abilities of quantum
#. computers.
msgctxt "wireguard-settings-view"
msgid "Quantum-resistant tunnel"
msgstr "Tunnel resistente agli attacchi quantistici"

#. The hint displayed below the QUIC MTU input field.
#. Available placeholders:
#. %(wireguard)s - Will be replaced with the string "QUIC"
#. %(max)d - the maximum possible wireguard mtu value
#. %(min)d - the minimum possible wireguard mtu value
msgctxt "wireguard-settings-view"
msgid "Set %(wireguard)s MTU value. Valid range: %(min)d - %(max)d."
msgstr "Imposta il valore MTU di %(wireguard)s. Intervallo valido: %(min)d - %(max)d."

msgctxt "wireguard-settings-view"
msgid "Shadowsocks"
msgstr "Shadowsocks"

msgctxt "wireguard-settings-view"
msgid "This feature protects your traffic to the exit server against potential attacks from quantum computers."
msgstr "Questa funzione protegge il tuo traffico verso il server di uscita da potenziali attacchi dei computer quantistici."

msgctxt "wireguard-settings-view"
msgid "UDP-over-TCP"
msgstr "UDP-over-TCP"

msgid "Continue"
msgstr "Continua"


msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "Paese di entrata"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "Paese di uscita"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "Aspettatevi circa la metà della larghezza di banda single-hop in cambio della non collegabilità tra l'IP utente e l'IP di destinazione. Disattivato di default; opt-in per la privacy."

msgctxt "warren-multi-hop-view"
msgid "Restart the Warren daemon after changing this setting."
msgstr "Riavvia il daemon Warren dopo aver modificato questa impostazione."

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "Instrada il tuo traffico attraverso due relay Warren con cifratura end-to-end HPKE. Il relay di entrata vede solo testo cifrato; quello di uscita vede solo il payload decifrato, mai il tuo IP. Schema ispirato ad Apple Private Relay."

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "Compromesso: circa la metà della larghezza di banda single-hop. Disattivato di default; opt-in per la privacy. Richiede il riavvio del daemon dopo la modifica."

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "Warren multi-hop"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "Quando attivato, il traffico viene instradato attraverso due relay Warren (entrata e poi uscita) con cifratura end-to-end HPKE tra il client e l'uscita. Il relay di entrata vede solo testo cifrato; quello di uscita vede solo il payload decifrato, mai l'IP utente."

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "Copiato negli appunti"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "Copia negli appunti"

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "Un'esperienza VPN senza compromessi sulla privacy. Nessun log. Nessun account. Nessun tracciamento. Solo banda."

msgctxt "warren-onboarding"
msgid "All set"
msgstr "Tutto pronto"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "Controlla di nuovo"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "Verifica in corso... (clicca per aggiornare ora)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "Configurazione completata. Scegli un paese e connettiti a Warren."

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "Continua"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "Impossibile verificare lo stato dell'abbonamento. Riprova."

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "Il daemon non ha ancora una frase mnemonica: accedi o riavvia l'app."

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Impossibile recuperare la frase mnemonica dal daemon."

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "Inizia"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "Ho già un abbonamento"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "L'ho annotata in un luogo sicuro."

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "Nessun abbonamento attivo trovato. Acquistane prima uno."

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "Scegli un paese e connetti"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "Scegli le difese che vuoi fin dal primo giorno. Puoi modificarle tutte in seguito da Impostazioni."

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "Preferenze sulla privacy"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "Salta procedura guidata (avanzato)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "Visualizza piani (si apre nel browser)"

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "Benvenuto in Warren VPN"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "Annota queste 12 parole in ordine e conservale in un luogo sicuro. Sono l'unico modo per ripristinare il tuo abbonamento se perdi l'accesso a questo dispositivo."

msgctxt "warren-onboarding"
msgid "You don’t have an active subscription yet. You buy VPN time in advance, with no account to create. If you choose automatic monthly renewal, you can turn it off at any time, at no cost."
msgstr "Non hai ancora un abbonamento attivo. Acquisti tempo VPN in anticipo, senza creare un account. Se scegli il rinnovo mensile automatico, puoi disattivarlo in qualsiasi momento, senza costi."

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "Il tuo portafoglio Warren"

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "Il tuo abbonamento"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• Offuscamento sempre attivo (ATTIVO di default): mimetismo HTTP/3 affinché il traffico si confonda nella massa."

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (DISATTIVATO di default): inietta padding per neutralizzare l'analisi del traffico via ML. ~5-15 % di banda."

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-hop (DISATTIVATO di default): instrada attraverso due relay per la non collegabilità tra entrata e uscita."

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "Dettagli della discrepanza crittografica"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "ID di uscita"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "Posizione"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "Nuova chiave osservata"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "Chiave precedentemente bloccata"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "Elaborazione della tua scelta in corso, attendere."

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "Rifiuta (disconnetti)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "Rifiuta e rimani disconnesso"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "Segnala a Warren"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "L'identità del server è cambiata"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "Il server di uscita Warren a cui ti affidavi presenta ora un'identità crittografica diversa."

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "Di solito significa che l'operatore ha ruotato la chiave, ma può anche indicare che il server è stato sostituito o compromesso. Rifiuta se non ti aspettavi una modifica."

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "Affidati alla nuova chiave"


msgctxt "warren-status-view"
msgid "Last"
msgstr "Ultima"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "Offuscamento"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "Riconnessioni"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "inattivo"

msgctxt "warren-status-view"
msgid "never"
msgstr "mai"

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "Apre una porta pubblica sul server di uscita connesso e la inoltra al tuo dispositivo. Utile per applicazioni peer-to-peer, condivisione di file o servizi self-hosted."

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "Inoltro delle porte"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "Protocollo"

msgctxt "keys-view"
msgid "Backup keys"
msgstr "Backup delle chiavi"

msgctxt "keys-view"
msgid "Done"
msgstr "Fatto"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "Inserisci la tua frase di recupero BIP39 da 12 parole (o 24 parole), separate da spazi."

msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Impossibile recuperare la frase di recupero dal daemon."

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "L'ho annotata in un luogo sicuro."

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "Capisco che questa operazione sostituirà definitivamente la mia identità attuale."

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "Identità ripristinata. Il tuo nuovo portafoglio Warren è ora attivo."

msgctxt "keys-view"
msgid "Keys"
msgstr "Chiavi"

msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "Nessuna frase di recupero disponibile. Accedi o ripristina prima un'identità."

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "Ripristina da frase di recupero"

msgctxt "keys-view"
msgid "Restore identity"
msgstr "Ripristina identità"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "Ripristino in corso…"

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "Mostra frase di recupero"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "ATTENZIONE: Questa operazione SOSTITUIRÀ la tua identità attuale. Qualsiasi abbonamento collegato all'identità attuale sarà irrecuperabile."

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "Annotala su carta. Non conservarla mai nel cloud, in uno screenshot o in un'email."

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "La tua frase di recupero da 12 parole è l'UNICO modo per ripristinare la tua identità Warren su un altro dispositivo. Se la perdi, il tuo abbonamento è irrecuperabile."

msgctxt "keys-view"
msgid "words"
msgstr "parole"

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "Esegui il backup della frase"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "Ho eseguito il backup della mia frase di recupero e comprendo che questo account verrà rimosso da questo dispositivo."

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "Se non hai eseguito il backup della tua frase di recupero, il tuo abbonamento andrà perso definitivamente."

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "Disconnettersi da questo account?"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "La disconnessione elimina questo account da questo dispositivo. Non esiste alcun indirizzo email o password per accedere di nuovo: la tua frase di recupero è l'UNICO modo per ripristinarlo."

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "Esegui il backup della tua frase di recupero"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "Impossibile leggere la nuova frase di recupero. Riprova."

msgctxt "login-view"
msgid "Discard"
msgstr "Scarta"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "Scartare questo nuovo account?"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "Inserisci la tua frase di recupero di 12 parole, separate da spazi, per ripristinare il tuo account su questo dispositivo."

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "Torna indietro solo se volevi ripristinare un account che hai già."

msgctxt "login-view"
msgid "I already have an account"
msgstr "Ho già un account"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "Ho annotato la mia frase di recupero in un luogo sicuro."

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "Frase di recupero non valida. Controlla le parole e il loro ordine, quindi riprova."

msgctxt "login-view"
msgid "Keep it"
msgstr "Mantienilo"

msgctxt "login-view"
msgid "Restore account"
msgstr "Ripristina account"

msgctxt "login-view"
msgid "Restore your account"
msgstr "Ripristina il tuo account"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "L'account appena creato verrà abbandonato e la sua frase di recupero non sarà mostrata di nuovo."

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren utilizza un wallet non custodial: il tuo account è una frase di recupero di 12 parole che solo tu possiedi."

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "Ti diamo il benvenuto in Warren"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "Annota queste 12 parole e conservale in un luogo sicuro. Sono l'unico modo per ripristinare il tuo account se perdi questo dispositivo."

msgctxt "connect-view"
msgid "I’ve completed payment"
msgstr "Ho completato il pagamento"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "Sessione inattiva"

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node’s public key has changed."
msgstr "Rilevata discrepanza nell'identità del server. La chiave pubblica del nodo di uscita è cambiata."

msgctxt "vpn-settings-view"
msgid "URL of the warren-api server. Format http(s)://host:port. Empty = unset (fallback to the default backend). Restart the daemon for the change to take effect."
msgstr "URL del server warren-api. Formato http(s)://host:porta. Vuoto = non impostato (ripiego sul backend predefinito). Riavvia il servizio affinché la modifica abbia effetto."

msgid "OK"
msgstr "OK"

msgctxt "accessibility"
msgid "Copy public key"
msgstr "Copia chiave pubblica"

#. Accessibility label of the control that copies
#. the voucher code to the clipboard.
msgctxt "accessibility"
msgid "Copy the voucher code"
msgstr "Copia il codice voucher"

msgctxt "account-view"
msgid "Backup keys"
msgstr "Backup delle chiavi"

msgctxt "account-view"
msgid "Could not log out: the VPN did not disconnect in time. You are still logged in."
msgstr "Impossibile uscire dall'account: la VPN non si è disconnessa in tempo. Sei ancora connesso all'account."

msgctxt "account-view"
msgid "Something went wrong while logging out."
msgstr "Si è verificato un problema durante l'uscita dall'account."

#. Button that runs a logout again after it failed.
msgctxt "account-view"
msgid "Try again"
msgstr "Riprova"

msgctxt "auth-failure"
msgid "Blocking internet: this device has been revoked. Log in again to connect, or disconnect to unblock the internet."
msgstr "Blocco di Internet: questo dispositivo è stato revocato. Accedi di nuovo per connetterti, oppure disconnettiti per sbloccare Internet."

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "Verifica in corso... (clicca per aggiornare ora)"

msgctxt "connect-view"
msgid "Here’s your public key. Save it!"
msgstr "Ecco la tua chiave pubblica. Conservala!"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "Inoltro porte: %(ports)s"

msgctxt "connection-info"
