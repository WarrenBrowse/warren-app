msgid "Current device"
msgstr "Dispositivo corrente"

msgctxt "device-management"
msgid "Device is inactive"
msgstr "Il dispositivo è inattivo"

msgctxt "device-management"
msgid "Device name"
msgstr "Nome dispositivo"

