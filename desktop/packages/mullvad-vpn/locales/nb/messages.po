msgctxt "licenses-view"
msgid "It is based on the Mullvad VPN app, copyright Mullvad VPN AB, released under the same license."
msgstr "Den bygger på Mullvad VPN-appen, copyright Mullvad VPN AB, utgitt under samme lisens."

msgctxt "licenses-view"
msgid "The tunnel engine, warrenguard, is released under the GNU Affero General Public License, version 3."
msgstr "Tunnelmotoren, warrenguard, er utgitt under GNU Affero General Public License, versjon 3."

