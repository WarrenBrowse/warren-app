msgid "Add method"
msgstr "Legg til metode"

msgctxt "api-access-methods-view"
msgid "Adding a new API access method also tests it."
msgstr "Når du legger til en ny API-tilgangsmetode, vil den også bli testet."

msgctxt "api-access-methods-view"
msgid "API reachable"
msgstr "API tilgjengelig"

msgctxt "api-access-methods-view"
