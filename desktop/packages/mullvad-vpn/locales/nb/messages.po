msgctxt "split-tunneling-view"
msgid "Never without the VPN"
msgstr "Aldri uten VPN"

msgctxt "split-tunneling-view"
msgid "When the VPN is off, %(application)s has no Internet, even with Warren VPN closed."
msgstr "Når VPN er av, har %(application)s ikke internett, selv når Warren VPN er lukket."

msgctxt "split-tunneling-view"
msgid "Lockdown mode already blocks every app while the VPN is off."
msgstr "Låsemodus blokkerer allerede alle apper mens VPN er av."

msgctxt "split-tunneling-view"
msgid "Choose a route through the VPN to turn this on"
msgstr "Velg en rute gjennom VPN for å slå dette på"

msgctxt "split-tunneling-view"
msgid "%(route)s, never without the VPN"
msgstr "%(route)s, aldri uten VPN"

msgctxt "split-tunneling-view"
msgid "Blocked until the VPN connects"
msgstr "Blokkert til VPN kobler til"

msgctxt "connect-view"
msgid "%(count)d app blocked until the VPN connects"
msgid_plural "%(count)d apps blocked until the VPN connects"
msgstr[0] "%(count)d app blokkert til VPN kobler til"
msgstr[1] "%(count)d apper blokkert til VPN kobler til"

msgctxt "split-tunneling-view"
msgid "Open never without the VPN"
msgstr "Åpne aldri uten VPN"

msgctxt "split-tunneling-view"
msgid "Until you close it, it has no Internet while the VPN is off. Close it first if it is already open."
msgstr "Til du lukker den, har den ikke internett mens VPN er av. Lukk den først hvis den allerede er åpen."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be locked to the VPN."
msgstr "Hvis %(applicationName)s allerede kjører, må du avslutte den før du starter den herfra. Hvis ikke, er den kanskje ikke låst til VPN."

msgctxt "split-tunneling-view"
msgid "%(applicationName)s is problematic and can’t be opened locked to the VPN."
msgstr "%(applicationName)s skaper problemer og kan ikke åpnes låst til VPN."

msgctxt "split-tunneling-view"
msgid "Flatpak and Snap apps cannot be opened locked to the VPN"
msgstr "Flatpak- og Snap-apper kan ikke åpnes låst til VPN"

msgctxt "account-view"
msgid "Notice of %(date)s"
msgstr "Varsel av %(date)s"

msgctxt "account-view"
msgid "Renewal notices"
msgstr "Fornyelsesvarsler"

msgctxt "notifications"
msgid "Amount charged: %(price)s, VAT included."
msgstr "Belastet beløp: %(price)s inkl. mva."

msgctxt "notifications"
msgid "Automatic renewal notice"
msgstr "Varsel om automatisk fornyelse"

msgctxt "notifications"
msgid "Best monthly rate Warren offers today: %(price)s."
msgstr "Beste månedspris Warren tilbyr i dag: %(price)s."

msgctxt "notifications"
msgid "Issued on %(date)s"
msgstr "Utstedt %(date)s"

msgctxt "notifications"
msgid "The monthly price changed after your renewal notice, so this renewal was not charged. Your Warren time ends around %(date)s unless you buy more."
msgstr "Månedsprisen endret seg etter fornyelsesvarselet ditt, så denne fornyelsen ble ikke belastet. Warren-tiden din utløper rundt %(date)s med mindre du kjøper mer."

msgctxt "notifications"
msgid "The monthly price changes from %(previous)s to %(price)s, VAT included, from this renewal."
msgstr "Månedsprisen endres fra %(previous)s til %(price)s inkl. mva. fra og med denne fornyelsen."

msgctxt "notifications"
msgid "The monthly price of your automatic renewal changes from %(previous)s to %(price)s from around %(date)s. You can turn auto-renewal off anytime in Account settings, at no cost."
msgstr "Månedsprisen for den automatiske fornyelsen din endres fra %(previous)s til %(price)s fra rundt %(date)s. Du kan når som helst slå av automatisk fornyelse i kontoinnstillingene, uten kostnad."

msgctxt "notifications"
msgid "You can turn automatic renewal off at any time, at no cost, in Account settings of the Warren app or at %(url)s. Turning it off takes effect immediately."
msgstr "Du kan når som helst og uten kostnad slå av automatisk fornyelse i kontoinnstillingene i Warren-appen eller på %(url)s. Det trer i kraft umiddelbart."

msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at %(price)s per month. You can turn auto-renewal off anytime in Account settings, at no cost."
msgstr "Warren-tiden din fornyes automatisk rundt %(date)s til %(price)s per måned. Du kan når som helst slå av automatisk fornyelse i kontoinnstillingene, uten kostnad."

msgctxt "notifications"
msgid "Your Warren time renews automatically on or around %(date)s, for one month."
msgstr "Warren-tiden din fornyes automatisk med én måned på eller rundt %(date)s."

msgctxt "account-view"
msgid "Withdrawal (14 days)"
msgstr "Angrerett (14 dager)"

msgctxt "account-view"
msgid "Purchase of %(date)s, withdrawal possible until %(deadline)s"
msgstr "Kjøp fra %(date)s, angring mulig til %(deadline)s"

msgctxt "account-view"
msgid "Withdraw"
msgstr "Angre kjøpet"

msgctxt "account-view"
msgid "Refund address (crypto payment only)"
msgstr "Refusjonsadresse (kun ved kryptobetaling)"

msgctxt "account-view"
msgid "Confirm the withdrawal"
msgstr "Bekreft angringen"

msgctxt "account-view"
msgid "Withdrawal recorded on %(date)s, reference %(reference)s"
msgstr "Angring registrert %(date)s, referanse %(reference)s"

msgctxt "account-view"
msgid "Withdrawal recorded, reference %(reference)s"
msgstr "Angring registrert, referanse %(reference)s"

msgctxt "account-view"
msgid "Refund owed: %(amount)s"
msgstr "Beløp til refusjon: %(amount)s"

msgctxt "account-view"
msgid "This purchase was not credited to this account."
msgstr "Dette kjøpet ble ikke kreditert denne kontoen."

msgctxt "account-view"
msgid "The refund address is not valid."
msgstr "Refusjonsadressen er ikke gyldig."

msgctxt "account-view"
msgid "No account is logged in."
msgstr "Ingen konto er logget inn."

msgctxt "account-view"
msgid "The withdrawal could not be recorded. Try again later."
msgstr "Angringen kunne ikke registreres. Prøv igjen senere."

msgctxt "in-app-notifications"
msgid "DEVICE CLOCK IS OFF"
msgstr "ENHETENS KLOKKE GÅR FEIL"

msgctxt "in-app-notifications"
msgid "This device’s clock is off by %(minutes)d min: set it right to connect."
msgstr "Klokken på denne enheten går %(minutes)d min feil: still den riktig for å koble til."

msgctxt "in-app-notifications"
msgid "This device’s clock is off: set it right to connect."
msgstr "Klokken på denne enheten går feil: still den riktig for å koble til."

msgctxt "auth-failure"
msgid "This device has no session credentials right now. Another device of your account may be holding them."
msgstr "Denne enheten har ingen øktlegitimasjon akkurat nå. En annen enhet på kontoen din kan ha dem."

msgctxt "device-management"
msgid "A device of this account runs a version of Warren older than 1.1.36. It no longer blocks your other devices. Update or uninstall it."
msgstr "En enhet på denne kontoen kjører en versjon av Warren som er eldre enn 1.1.36. Den blokkerer ikke lenger de andre enhetene dine. Oppdater eller avinstaller den."

msgctxt "device-management"
msgid "Active today"
msgstr "Aktiv i dag"

msgctxt "device-management"
msgid "An older version of Warren"
msgstr "En eldre versjon av Warren"

msgctxt "device-management"
msgid "Browser extension"
msgstr "Nettleserutvidelse"

msgctxt "device-management"
msgid "Command line"
msgstr "Kommandolinje"

msgctxt "device-management"
msgid "Could not disconnect the device. Try again."
msgstr "Kunne ikke koble fra enheten. Prøv igjen."

msgctxt "device-management"
msgid "Could not load your devices. Try again."
msgstr "Kunne ikke laste inn enhetene dine. Prøv igjen."

msgctxt "device-management"
msgid "Could not rename the device. Try again."
msgstr "Kunne ikke gi enheten nytt navn. Prøv igjen."

msgctxt "device-management"
msgid "Devices"
msgstr "Enheter"

msgctxt "device-management"
msgid "Devices signed in to this account. Disconnecting one signs it out: it needs the recovery phrase to sign in again."
msgstr "Enheter som er logget på denne kontoen. Når du kobler fra en enhet, logges den ut: den trenger gjenopprettingsfrasen for å logge på igjen."

msgctxt "device-management"
msgid "Disconnect"
msgstr "Koble fra"

msgctxt "device-management"
msgid "Disconnect %(name)s?"
msgstr "Koble fra %(name)s?"

msgctxt "device-management"
msgid "It will be signed out within 10 minutes and will need the recovery phrase to sign in again. For a lost or stolen device, move to a new account instead: a device that keeps the recovery phrase can sign in again."
msgstr "Den logges ut innen 10 minutter og trenger gjenopprettingsfrasen for å logge på igjen. For en mistet eller stjålet enhet bør du heller bytte til en ny konto: en enhet som har gjenopprettingsfrasen, kan logge på igjen."

msgctxt "device-management"
msgid "Last active %(date)s"
msgstr "Sist aktiv %(date)s"

msgctxt "device-management"
msgid "Last seen %(date)s"
msgstr "Sist sett %(date)s"

msgctxt "device-management"
msgid "Other platform"
msgstr "Annen plattform"

msgctxt "device-management"
msgid "Rename device"
msgstr "Gi enheten nytt navn"

msgctxt "device-management"
msgid "This device"
msgstr "Denne enheten"

msgctxt "device-management"
msgid "This device was disconnected from another device of your account. Sign in with your recovery phrase to use it again."
msgstr "Denne enheten ble koblet fra av en annen enhet på kontoen din. Logg på med gjenopprettingsfrasen din for å bruke den igjen."

#. Short state badge on the home screen while the traffic
#. leaves the device unencrypted.
msgctxt "tunnel-control"
msgid "Unprotected"
msgstr "Ubeskyttet"

#. Short state badge on the home screen once the tunnel is up.
msgctxt "tunnel-control"
msgid "Protected"
msgstr "Beskyttet"

#. Short state badge on the home screen while the tunnel is
#. up but the device has no internet connection.
msgctxt "tunnel-control"
msgid "Interrupted"
msgstr "Avbrutt"

#. Short state badge on the home screen while the kill switch
#. holds all traffic.
msgctxt "tunnel-control"
msgid "Blocked"
msgstr "Blokkert"

msgctxt "tunnel-control"
msgid "Connection blocked"
msgstr "Tilkoblingen er blokkert"

