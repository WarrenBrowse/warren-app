msgid "Click here to update"
msgstr "Klikk her for å oppdatere"

#. Label of the voucher code an announcement granted to this account.
msgctxt "in-app-notifications"
msgid "Your code"
msgstr "Din kode"

#. Confirmation shown once the voucher code is on the clipboard.
msgctxt "in-app-notifications"
msgid "Copied"
msgstr "Kopiert"

#. Notification subtitle when the installer download failed.
msgctxt "in-app-notifications"
msgid "Could not download installer."
msgstr "Kunne ikke laste ned installasjonsprogrammet."

#. Generic notification subtitle when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "Could not upgrade the app."
msgstr "Kunne ikke oppgradere appen."

#. Notification title when app upgrade is verifying the installer.
