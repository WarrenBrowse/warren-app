msgctxt "split-tunneling-view"
msgid "All apps are protected by the VPN, except for the rules below."
msgstr "Alle apper er beskyttet av VPN, unntatt reglene nedenfor."

msgctxt "split-tunneling-view"
msgid "App"
msgstr "App"

msgctxt "split-tunneling-view"
msgid "Choose an exit country"
msgstr "Velg et utgangsland"

msgctxt "split-tunneling-view"
msgid "Choose where each app goes."
msgstr "Velg hvilken vei hver app går."

msgctxt "split-tunneling-view"
msgid "Country of your main connection"
msgstr "Landet til hovedtilkoblingen din"

msgctxt "split-tunneling-view"
msgid "Default"
msgstr "Standard"

msgctxt "split-tunneling-view"
msgid "Direct connection by default. Only the apps below use the VPN."
msgstr "Direkte tilkobling som standard. Bare appene nedenfor bruker VPN."

msgctxt "split-tunneling-view"
msgid "Direct connection, your real IP is visible"
msgstr "Direkte tilkobling, den ekte IP-en din er synlig"

msgctxt "split-tunneling-view"
msgid "Done"
msgstr "Ferdig"

msgctxt "split-tunneling-view"
msgid "It uses this country when you open it with “Open through the VPN”."
msgstr "Den bruker dette landet når du åpner den med «Åpne gjennom VPN»."

msgctxt "split-tunneling-view"
msgid "Needs Full Disk Access"
msgstr "Krever full disktilgang"

msgctxt "split-tunneling-view"
msgid "Needs a signed build of Warren VPN"
msgstr "Krever en signert versjon av Warren VPN"

msgctxt "split-tunneling-view"
msgid "Needs macOS 13 or newer"
msgstr "Krever macOS 13 eller nyere"

msgctxt "split-tunneling-view"
msgid "No app uses the VPN. Add one, or send the other apps through the VPN again."
msgstr "Ingen apper bruker VPN. Legg til en, eller send de andre appene gjennom VPN igjen."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to open it through the VPN: it uses the VPN until you close it."
msgstr "Ingen regler. Legg til en app for å åpne den gjennom VPN: den bruker VPN til du lukker den."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to send it through another country or outside the VPN."
msgstr "Ingen regler. Legg til en app for å sende den gjennom et annet land eller utenom VPN."

msgctxt "split-tunneling-view"
msgid "Not available on this system"
msgstr "Ikke tilgjengelig på dette systemet"

msgctxt "split-tunneling-view"
msgid "Open outside the VPN"
msgstr "Åpne utenom VPN"

msgctxt "split-tunneling-view"
msgid "Open through the VPN"
msgstr "Åpne gjennom VPN"

msgctxt "split-tunneling-view"
msgid "Other apps go"
msgstr "Andre apper går"

msgctxt "split-tunneling-view"
msgid "Outside the VPN"
msgstr "Utenom VPN"

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs a signed build of Warren VPN."
msgstr "«Utenom VPN» krever en signert versjon av Warren VPN."

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs macOS 13 or newer."
msgstr "«Utenom VPN» krever macOS 13 eller nyere."

msgctxt "split-tunneling-view"
msgid "Remove %(application)s from the list"
msgstr "Fjern %(application)s fra listen"

msgctxt "split-tunneling-view"
msgid "Remove the rule"
msgstr "Fjern regelen"

msgctxt "split-tunneling-view"
msgid "Route for %(application)s"
msgstr "Rute for %(application)s"

msgctxt "split-tunneling-view"
msgid "Rules per app"
msgstr "Regler per app"

msgctxt "split-tunneling-view"
msgid "Through the VPN"
msgstr "Gjennom VPN"

msgctxt "split-tunneling-view"
msgid "Through the VPN, another country"
msgstr "Gjennom VPN, annet land"

msgctxt "split-tunneling-view"
msgid "Through the VPN, from this country"
msgstr "Gjennom VPN, fra dette landet"

msgctxt "split-tunneling-view"
msgid "Until you close it. Close it first if it is already open."
msgstr "Til du lukker den. Lukk den først hvis den allerede er åpen."

msgctxt "split-tunneling-view"
msgid "VPN"
msgstr "VPN"

msgctxt "split-tunneling-view"
msgid "Your system cannot send apps outside the VPN."
msgstr "Systemet ditt kan ikke sende apper utenom VPN."

msgctxt "split-tunneling-view"
msgid "Only the apps you choose will use the VPN. The rest of this device will not be protected."
msgstr "Bare appene du velger, vil bruke VPN. Resten av denne enheten blir ikke beskyttet."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be excluded from the VPN tunnel."
msgstr "Hvis den allerede kjører, må du avslutte %(applicationName)s før du starter den herfra. Hvis ikke, kan den kanskje ikke utelates fra VPN-tunnelen."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not use the VPN."
msgstr "Hvis %(applicationName)s allerede kjører, må du avslutte den før du starter den herfra. Hvis ikke, bruker den kanskje ikke VPN."

#. Link to the webpage
msgctxt "support-view"
msgid "FAQs & Guides"
msgstr "Ofte stilte spørsmål og veiledninger"

#. Title label in navigation bar
msgctxt "support-view"
msgid "Support"
msgstr "Kundestøtte"

#. Link to the refund policy webpage
msgctxt "support-view"
msgid "Refund policy"
msgstr "Retningslinjer for refusjon"

msgctxt "tray-icon-context-menu"
msgid "Disconnected from system service"
msgstr "Koblet fra systemservice"

msgctxt "tray-icon-context-menu"
msgid "Open %(appName)s"
msgstr "Åpne %(appName)s"

msgctxt "tray-icon-tooltip"
msgid "%(city)s, %(country)s"
msgstr "%(city)s, %(country)s"

msgctxt "tray-icon-tooltip"
msgid "Connected. %(location)s"
msgstr "Tilkoblet. %(location)s"

msgctxt "tray-icon-tooltip"
msgid "Connecting. %(location)s"
msgstr "Kobler til. %(location)s"

msgctxt "troubleshoot"
msgid "Disable split tunneling"
msgstr "Deaktiver Split Tunneling"

msgctxt "troubleshoot"
msgid "Enable “Full Disk Access” for “Warren VPN” in the macOS system settings."
msgstr "Aktiver «Full disktilgang» for «Warren VPN» i systeminnstillingene for macOS."

msgctxt "troubleshoot"
msgid "Failed to enable split tunneling. This is because the app is missing system permissions. What you can do:"
msgstr "Kunne ikke aktivere delt tunnelering. Dette skyldes at appen mangler systemtillatelser. Dette kan du gjøre:"

msgctxt "troubleshoot"
msgid "If you have installed another VPN then try to uninstall that."
msgstr "Hvis du har installert et annet VPN-program, kan du prøve å avinstallere det."

msgctxt "troubleshoot"
msgid "Make sure you have NF tables support."
msgstr "Sørg for at NF-tabeller støttes."

msgctxt "troubleshoot"
msgid "Open system settings"
msgstr "Åpne systeminnstillinger"

msgctxt "troubleshoot"
msgid "This error can happen when something other than Warren is actively updating the DNS."
msgstr "Feilen kan skje når noe annet enn Warren holder på med oppdatering av DNS."

msgctxt "troubleshoot"
msgid "This might be caused by an outdated kernel."
msgstr "Dette kan være et resultat av en utdatert kjerne."

msgctxt "troubleshoot"
msgid "Try restarting your device."
msgstr "Prøv å starte enheten på nytt."

msgctxt "troubleshoot"
msgid "Try to reinstall VMware."
msgstr "Prøv å installere VMware på nytt."

msgctxt "troubleshoot"
msgid "Try to turn Wi-Fi Calling off in the FaceTime app settings and restart the Mac."
msgstr "Prøv å slå av Wi-Fi-oppringing i innstillingene til FaceTime-appen og start Mac-enheten på nytt."

msgctxt "troubleshoot"
msgid "Try to uninstall VMware."
msgstr "Prøv å avinstallere VMware."

msgctxt "troubleshoot"
msgid "Unable to communicate with the split tunnel driver."
msgstr "Kan ikke kommunisere med split tunnel-driveren."

msgctxt "troubleshoot"
msgid "Unable to start tunnel connection because of a failure when creating the tunnel device. This is often caused by conflicts with the VMware Bridge Protocol."
msgstr "Kunne ikke opprette tunneltilkobling på grunn av en feil under opprettingen av tunnelenheten. Dette oppstår ofte ved konflikter med VMware sin broprotokoll."

msgctxt "troubleshoot"
msgid "Uninstall or disable other DNS, networking and ads/website blocking apps."
msgstr "Avinstaller eller deaktiver andre apper som blokkerer DNS, nettverk og annonser/nettsider."

msgctxt "troubleshoot"
msgid "Update your kernel."
msgstr "Oppdater kjernen."

msgctxt "troubleshoot"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Hvis disse trinnene ikke løser noe, kan du rapportere problemet på forumet vårt."

msgctxt "tunnel-control"
msgid "Connect"
msgstr "Koble til"

msgctxt "tunnel-control"
msgid "Only selected apps are protected"
msgstr "Bare valgte apper er beskyttet"

#. Bold status title shown when the tunnel is up but the
#. device has no internet connection.
msgctxt "tunnel-control"
msgid "Connection interrupted"
msgstr "Tilkoblingen ble avbrutt"

msgctxt "user-interface-settings-view"
msgid "Enable or disable system notifications. The critical notifications will always be displayed."
msgstr "Aktiver eller deaktiver systemmeldinger. Kritiske meldinger vil alltid vises."

msgctxt "user-interface-settings-view"
msgid "Enable to move the app around as a free-standing window."
msgstr "Aktiver for å flytte appen rundt som et frittstående vindu."

#. Navigation button to the 'Language' settings view
msgctxt "user-interface-settings-view"
msgid "Language"
msgstr "Språk"

msgctxt "user-interface-settings-view"
msgid "Monochromatic tray icon"
msgstr "Ensfarget skuffeikon"

msgctxt "user-interface-settings-view"
msgid "Notifications"
msgstr "Meldinger"

msgctxt "user-interface-settings-view"
msgid "Show only the tray icon when the app starts."
msgstr "Vis bare skuffeikonet når appen starter."

msgctxt "user-interface-settings-view"
msgid "Start minimized"
msgstr "Start i minimert tilstand"

msgctxt "user-interface-settings-view"
msgid "Unpin app from taskbar"
msgstr "Fjern appen fra menylinjen"

msgctxt "user-interface-settings-view"
msgid "Use a monochromatic tray icon instead of a colored one."
msgstr "Bruk ensfarget skuffeikon i stedet for flerfarget."

#. Title label in navigation bar
msgctxt "user-interface-settings-view"
msgid "User interface settings"
msgstr "Innstillinger for brukergrensesnitt"

msgctxt "vpn-settings-view"
msgid "Add a server"
msgstr "Legg til en server"

#. Button label to add a private IP DNS server despite warning.
msgctxt "vpn-settings-view"
msgid "Add anyway"
msgstr "Legg til likevel"

#. Label for settings that enables ad blocking.
msgctxt "vpn-settings-view"
msgid "Ads"
msgstr "Annonser"

#. Label for settings that enables block of adult content.
msgctxt "vpn-settings-view"
msgid "Adult content"
msgstr "Vokseninnhold"

#. Label for list item that navigates to anti-censorship
#. settings view.
msgctxt "vpn-settings-view"
msgid "Anti-censorship"
msgstr "Antisensur"

msgctxt "vpn-settings-view"
msgid "Attention: enabling this will always require a Warren VPN connection in order to reach the internet."
msgstr "Advarsel: Hvis du aktiverer dette, må du alltid ha en Warren VPN-tilkobling for å være tilkoblet internett."

msgctxt "vpn-settings-view"
msgid "Attention: this setting cannot be used in combination with <b>%(customDnsFeatureName)s</b>"
msgstr "OBS: Denne innstillingen kan ikke brukes sammen med <b>%(customDnsFeatureName)s</b>"

msgctxt "vpn-settings-view"
msgid "Auto-connect"
msgstr "Automatisk tilkobling"

msgctxt "vpn-settings-view"
msgid "Automatically connect to a server when the app launches."
msgstr "Kobler automatisk til en server når appen starter."

#. This is displayed when the custom DNS setting is turned on which makes the block
#. ads/trackers settings disabled. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(customDnsFeatureName)s - The name displayed next to the custom DNS toggle.
msgctxt "vpn-settings-view"
msgid "Disable \"%(customDnsFeatureName)s\" below to activate these settings."
msgstr "Deaktiver «%(customDnsFeatureName)s» nedenfor for å aktivere innstillingene."

#. This is displayed when either or both of the block ads/trackers settings are
#. turned on which makes the custom DNS setting disabled.
#. Available placeholders:
#. %(preferencesPageName)s - The page title showed on top in the preferences page.
msgctxt "vpn-settings-view"
msgid "Disable all <b>DNS content blockers</b> above to activate this setting."
msgstr "Deaktiver all <b>DNS-innholdsblokkering</b> over for å aktivere innstillingen."

msgctxt "vpn-settings-view"
msgid "DNS content blockers"
msgstr "DNS-innholdsblokkering"

msgctxt "vpn-settings-view"
msgid "Enable to add at least one DNS server."
msgstr "Aktiver for å legge til minst én DNS-server."

#. Description of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "Enable to allow IPv6 traffic through the tunnel."
msgstr "Aktiver for å slippe IPv6-trafikk gjennom tunnelen."

msgctxt "vpn-settings-view"
msgid "Enter IP"
msgstr "Angi IP"

#. Label for settings that enables block of gamling related websites.
msgctxt "vpn-settings-view"
msgid "Gambling"
msgstr "Pengespill"

#. Title of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "In-tunnel IPv6"
msgstr "IPv6 i tunnel"

msgctxt "vpn-settings-view"
msgid "IPv4 is always enabled and the majority of websites and applications use this protocol. We do not recommend enabling IPv6 unless you know you need it."
msgstr "IPv4 er alltid aktivert, og de aller fleste nettsteder og applikasjoner benytter denne protokollen. Vi anbefaler å ikke aktivere IPv6 hvis du ikke vet at du trenger det."

#. A complimentary description for the setting Device IP version,
#. explaining why the user might want to configure the setting.
msgctxt "vpn-settings-view"
msgid "It can be useful when you are aware of problems caused by a certain IP version."
msgstr "Det kan være nyttig når du er klar over problemer som skyldes en bestemt IP-versjon."

msgctxt "vpn-settings-view"
msgid "It does this by allowing network communication outside the tunnel to local multicast and broadcast ranges as well as to and from these private IP ranges:"
msgstr "Den gjør det ved å tillate nettverkkommunikasjon utenfor tunnelen til lokale multicast- og sendingsintervall, samt mellom følgende privat IP-intervall:"

msgctxt "vpn-settings-view"
msgid "Kill switch"
msgstr "Avbruddsbryter"

msgctxt "vpn-settings-view"
msgid "Launch app on start-up"
msgstr "Kjør app ved oppstart"

msgctxt "vpn-settings-view"
msgid "Local network sharing"
msgstr "Deling over lokalt nettverk"

msgctxt "vpn-settings-view"
msgid "Lockdown mode"
msgstr "Låsemodus"

#. Label for settings that enables malware blocking.
msgctxt "vpn-settings-view"
msgid "Malware"
msgstr "Skadelig programvare"

#. Label for settings that enables block of social media.
msgctxt "vpn-settings-view"
msgid "Social media"
msgstr "Sosiale medier"

msgctxt "vpn-settings-view"
msgid "The app’s built-in kill switch is always on. This setting will additionally block the internet if clicking Disconnect or Quit."
msgstr "Appens innebygde avbruddsbryter er alltid på. Innstillingen vil også blokkere tilgangen til internettet hvis du trykker på Koble fra eller Lukk."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents."
msgstr "Forskjellen mellom avbruddsbryter og låsemodus er at avbruddsbryteren forhindrer lekkasjer under automatiske tilkoblinger til tunnel, programvarekrasj og lignende hendelser."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents. With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Forskjellen mellom avbruddsbryter og låsemodus er at avbruddsbryteren forhindrer lekkasjer under automatiske tilkoblinger til tunnel, programvarekrasj og lignende hendelser. Med aktivert låsemodus må du være tilkoblet en Warren VPN-server for å kunne koble til internettet. Manuell frakobling eller å avslutte appen vil blokkere tilkoblingen."

msgctxt "vpn-settings-view"
msgid "The DNS server you want to add is a private IP. You must ensure that your network interfaces are configured to use it."
msgstr "DNS-serveren som du vil legge til, er en privat IP. Du må forsikre deg om at nettverksgrensesnittene er konfigurert til å kunne bruke den."

msgctxt "vpn-settings-view"
msgid "This built-in feature prevents your traffic from leaking outside of the VPN tunnel if your network suddenly stops working or if the tunnel fails, it does this by blocking your traffic until your connection is reestablished."
msgstr "Denne innebygde funksjonen forhindrer lekkasje av trafikk utenfor VPN-tunnelen hvis nettverket plutslig slutter å fungere eller tunnelen feiler. Den blokkerer trafikken til tilkoblingen er gjenopprettet."

msgctxt "vpn-settings-view"
msgid "This feature allows access to other devices on the local network, such as for sharing, printing, streaming, etc."
msgstr "Funksjonen gir tilgang til andre enheter på det lokale nettverket for ting som deling, utskrift, strømming osv."

#. A description for the setting Device IP version,
#. explaining how the user can configure the setting.
msgctxt "vpn-settings-view"
msgid "This feature allows you to choose whether to use only IPv4, only IPv6, or allow the app to automatically decide the best option when connecting to a server."
msgstr "Med denne funksjonen kan du velge om du vil bruke bare IPv4, bare IPv6 eller la appen automatisk velge det beste alternativet når du kobler deg til en server."

msgctxt "vpn-settings-view"
msgid "This might cause issues on certain websites, services, and apps."
msgstr "Dette kan føre til problemer på enkelte nettsteder, tjenester og apper."

msgctxt "vpn-settings-view"
msgid "This network cannot be shared."
msgstr "Dette nettverket kan ikke deles."

msgctxt "vpn-settings-view"
msgid "This network is too broad to be shared outside the tunnel."
msgstr "Dette nettverket er for stort til å deles utenfor tunnelen."

#. Label for settings that enables tracker blocking.
msgctxt "vpn-settings-view"
msgid "Trackers"
msgstr "Sporing"

msgctxt "vpn-settings-view"
msgid "Traffic to these networks goes outside the VPN tunnel."
msgstr "Trafikk til disse nettverkene går utenfor VPN-tunnelen."

msgctxt "vpn-settings-view"
msgid "Use custom DNS server"
msgstr "Bruk egendefinert DNS-server"

#. Title label in navigation bar
msgctxt "vpn-settings-view"
msgid "VPN settings"
msgstr "VPN-innstillinger"

msgctxt "vpn-settings-view"
msgid "Warning: The malware blocker is not an anti-virus and should not be treated as such, this is just an extra layer of protection."
msgstr "Advarsel: Blokkeringen av skadelig programvare er ikke et antivirusprogram og skal ikke brukes som dette. Det er bare et ekstra lag med beskyttelse."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled it stops the device from contacting certain domains or websites known for distributing ads, malware, trackers and more."
msgstr "Når denne funksjonen er aktivert, forhindrer den enheten fra å kontakte bestemte domener og nettsteder som er kjent for å spre annonser, skadelig programvare, sporingsenheter og mer."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled, IPv6 can be used alongside IPv4 in the VPN tunnel to communicate with internet services."
msgstr "Når denne funksjonen er aktivert, kan IPv6 brukes sammen med IPv4 i VPN-tunnelen til å kommunisere med internettjenester."

msgctxt "vpn-settings-view"
msgid "With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Med Låsemodus aktivert må du være tilkoblet en Warren VPN-server for å kunne koble deg til internettet. Manuell frakobling eller avslutning av appen vil blokkere tilkoblingen din."

#. Value shown for the bandwidth limit in beta builds.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "vpn-settings-view"
msgid "%(mbps)d Mbps"
msgstr "%(mbps)d Mbps"

msgctxt "vpn-settings-view"
msgid "Add a network"
msgstr "Legg til et nettverk"

#. Feature indicator shown when the advanced "Allow external DNS resolvers"
#. setting is on, i.e. DNS leak protection is relaxed.
msgctxt "vpn-settings-view"
msgid "Allow external DNS"
msgstr "Tillat ekstern DNS"

#. Label for the advanced setting that allows DNS queries to resolvers
#. other than the configured one.
msgctxt "vpn-settings-view"
msgid "Allow external DNS resolvers"
msgstr "Tillat eksterne DNS-resolvere"

#. Hint below the bandwidth limit row in beta builds.
msgctxt "vpn-settings-view"
msgid "Bandwidth is limited by the free beta network and enforced by the servers. This setting is unavailable during the beta."
msgstr "Båndbredden begrenses av det gratis betanettverket og håndheves av serverne. Denne innstillingen er ikke tilgjengelig under betaen."

msgctxt "vpn-settings-view"
msgid "Connect to a single self-hosted exit you enter manually, bypassing the verified server list. Only use an exit you operate or fully trust: it sees your unencrypted traffic."
msgstr "Koble til én enkelt selvdrevet utgangsserver som du oppgir manuelt, utenom den verifiserte serverlisten. Bruk bare en utgangsserver du selv drifter eller stoler fullt ut på: den ser den ukrypterte trafikken din."

msgctxt "vpn-settings-view"
msgid "Cover domain (optional)"
msgstr "Dekkdomene (valgfritt)"

msgctxt "vpn-settings-view"
msgid "Custom exit (advanced)"
msgstr "Tilpasset utgangsserver (avansert)"

msgctxt "vpn-settings-view"
msgid "Endpoint"
msgstr "Endepunkt"

msgctxt "vpn-settings-view"
msgid "Enter a network in CIDR notation, such as 192.168.1.0/24 or fd00::/8."
msgstr "Angi et nettverk i CIDR-notasjon, for eksempel 192.168.1.0/24 eller fd00::/8."

#. Placeholder of the field where the user types a network to share
#. outside the tunnel, in CIDR notation.
msgctxt "vpn-settings-view"
msgid "Enter a network, e.g. 192.168.1.0/24"
msgstr "Angi et nettverk, f.eks. 192.168.1.0/24"

msgctxt "vpn-settings-view"
msgid "Exit address as host:port. Bracket IPv6, for example [2001:db8::1]:443."
msgstr "Utgangsserverens adresse som vert:port. Sett IPv6 i hakeparenteser, for eksempel [2001:db8::1]:443."

msgctxt "vpn-settings-view"
msgid "For advanced users. When enabled, the firewall stops blocking DNS queries to resolvers other than the configured one, so tools like \"dig @1.1.1.1\" work while connected."
msgstr "For avanserte brukere. Når dette er aktivert, slutter brannmuren å blokkere DNS-forespørsler til andre resolvere enn den konfigurerte, slik at verktøy som «dig @1.1.1.1» fungerer mens du er tilkoblet."

#. The hint displayed below the bandwidth limit input field.
#. Available placeholders:
#. %(max)d - the maximum accepted value in Mbps
#. %(min)d - the minimum accepted value in Mbps
msgctxt "vpn-settings-view"
msgid "Limit the VPN bandwidth in Mbps, applied to upload and download separately. Valid range: %(min)d - %(max)d. Leave empty for no limit. Applies immediately."
msgstr "Begrens VPN-båndbredden i Mbps, brukes separat på opplasting og nedlasting. Gyldig område: %(min)d - %(max)d. La feltet stå tomt for ingen grense. Trer i kraft umiddelbart."

msgctxt "vpn-settings-view"
msgid "Managed"
msgstr "Administrert"

#. The title for the bandwidth limit setting.
msgctxt "vpn-settings-view"
msgid "Max bandwidth"
msgstr "Maks båndbredde"

msgctxt "vpn-settings-view"
msgid "Set only when the exit runs a public TLS certificate (X.509 mode). Leave empty for the default raw-key mode."
msgstr "Angi dette bare når utgangsserveren bruker et offentlig TLS-sertifikat (X.509-modus). La feltet stå tomt for standardmodusen med rå nøkler."

msgctxt "vpn-settings-view"
msgid "The exit’s Ed25519 public key, 64 hexadecimal characters."
msgstr "Utgangsserverens offentlige Ed25519-nøkkel, 64 heksadesimale tegn."

msgctxt "vpn-settings-view"
msgid "The exit’s routing id, 32 hexadecimal characters."
msgstr "Utgangsserverens rutings-ID, 32 heksadesimale tegn."

msgctxt "vpn-settings-view"
msgid "The exit’s X25519 multi-hop key, 64 hexadecimal characters."
msgstr "Utgangsserverens X25519-multihoppnøkkel, 64 heksadesimale tegn."

msgctxt "vpn-settings-view"
msgid "The queries still travel through the VPN tunnel, but the resolver you choose will see them. Leave this off unless you are testing remote DNS resolution."
msgstr "Forespørslene går fortsatt gjennom VPN-tunnelen, men resolveren du velger, ser dem. La dette være av med mindre du tester DNS-oppslag mot en ekstern resolver."

#. Placeholder shown when no bandwidth limit is set.
msgctxt "vpn-settings-view"
msgid "Unlimited"
msgstr "Ubegrenset"

msgctxt "vpn-settings-view"
msgid "X25519 multi-hop key"
msgstr "X25519-multihoppnøkkel"

msgctxt "vpn-settings-view"
msgid "Exit ID"
msgstr "Utgangs-ID"

msgctxt "vpn-settings-view"
msgid "Public key"
msgstr "Offentlig nøkkel"

#. Description of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "A prepaid beta access voucher is linked to your account automatically. No payment, nothing to do."
msgstr "En forhåndsbetalt kupong for betatilgang knyttes automatisk til kontoen din. Ingen betaling, ingenting å gjøre."

#. Confirmation that the beta access is active.
#. Available placeholders:
#. %(date)s - the expiry date of the granted access
msgctxt "warren-onboarding"
msgid "Beta access active until %(date)s."
msgstr "Betatilgangen er aktiv til %(date)s."

#. Error shown when the beta access could not be activated yet.
msgctxt "warren-onboarding"
msgid "Could not activate the beta access yet (are you online?). Retrying automatically, and again at next launch. You can continue anyway."
msgstr "Betatilgangen kunne ikke aktiveres ennå (er du tilkoblet?). Vi prøver automatisk igjen, og på nytt ved neste oppstart. Du kan fortsette likevel."

#. Link shown under onboarding errors pointing to the public help page.
msgctxt "warren-onboarding"
msgid "Having trouble? Visit our help page"
msgstr "Problemer? Besøk hjelpesiden vår"

msgctxt "warren-onboarding"
msgid "Retry now"
msgstr "Prøv på nytt nå"

#. Beta onboarding line describing the degraded service.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with bandwidth capped at %(mbps)d Mbps. These are not the final service conditions."
msgstr "Betaen kjører på et gratis, separat nettverk med båndbredden begrenset til %(mbps)d Mbps. Dette er ikke tjenestens endelige vilkår."

msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with limited bandwidth. These are not the final service conditions."
msgstr "Betaen kjører på et gratis, separat nettverk med begrenset båndbredde. Dette er ikke tjenestens endelige vilkår."

#. Title of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "Your beta access"
msgstr "Betatilgangen din"

msgctxt "warren-pubkey-warning"
msgid "Could not find that exit server anymore. Try reconnecting."
msgstr "Finner ikke den utgangsserveren lenger. Prøv å koble til på nytt."

msgctxt "warren-pubkey-warning"
msgid "Could not save the new key. Please try again."
msgstr "Kunne ikke lagre den nye nøkkelen. Prøv på nytt."

msgctxt "warren-pubkey-warning"
msgid "Could not trust the new key."
msgstr "Kunne ikke stole på den nye nøkkelen."

msgctxt "warren-pubkey-warning"
msgid "The key changed again before it could be trusted. Review the new key and try again."
msgstr "Nøkkelen ble endret igjen før den kunne godkjennes. Se gjennom den nye nøkkelen og prøv på nytt."

msgctxt "wireguard-settings-view"
msgid "%(daita)s (%(daitaFull)s) hides patterns in your encrypted VPN traffic."
msgstr "%(daita)s (%(daitaFull)s) skjuler mønstre i din krypterte VPN-trafikk."

msgctxt "wireguard-settings-view"
msgid "By enabling “%(directOnly)s” you will have to manually select a server that is %(daita)s-enabled. This can cause you to end up in a blocked state until you have selected a compatible server in the “Select location” view."
msgstr "Hvis du aktiverer «%(directOnly)s», må du manuelt velge en server som har aktivert %(daita)s. Dette kan føre til at du havner i en blokkert tilstand inntil du har valgt en kompatibel server under «Velg plassering»."

msgctxt "wireguard-settings-view"
msgid "Cancel"
msgstr "Avbryt"

#. Title for device IP version setting.
msgctxt "wireguard-settings-view"
msgid "Device IP version"
msgstr "Enhets-IP-versjon"

msgctxt "wireguard-settings-view"
msgid "It combines a quantum-safe key exchange with the classical one. When it is on, the app only connects through servers that offer it. When it is off, it is still used wherever a server offers it."
msgstr "Den kombinerer en kvantesikker nøkkelutveksling med den klassiske. Når den er på, kobler appen seg bare til via servere som tilbyr den. Når den er av, brukes den likevel der en server tilbyr den."

msgctxt "wireguard-settings-view"
msgid "Multihop is being used to enable DAITA for your selected location"
msgstr "Multihop brukes til å aktivere DAITA for den valgte plasseringen"

#. Warning text in a dialog that is displayed after a setting is toggled.
msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. In order to use the internet, you might have to select a new location after enabling."
msgstr "Ikke alle serverne våre er %(daita)s-aktiverte. For å kunne bruke internettet må du kanskje velge en ny plassering etter aktivering."

#. The title for the QUIC quantum resistance selector. This setting
#. makes the cryptography resistant to the future abilities of quantum
#. computers.
msgctxt "wireguard-settings-view"
msgid "Quantum-resistant tunnel"
msgstr "Kvantebestandig tunnel"

msgctxt "wireguard-settings-view"
msgid "This feature protects your traffic to the exit server against potential attacks from quantum computers."
msgstr "Denne funksjonen beskytter trafikken din til utgangsserveren mot mulige angrep fra kvantedatamaskiner."

msgid "Continue"
msgstr "Fortsett"

msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "Inngangsland"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "Utgangsland"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "Forvent omtrent halvparten av single-hop-båndbredden i bytte mot at bruker-IP og destinasjons-IP ikke kan kobles sammen. Av som standard; opt-in for personvern."

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "Ruter trafikken din gjennom to Warren-reléer med HPKE ende-til-ende-kryptering. Inngangsreléet ser kun chiffertekst; utgangsreléet ser kun den dekrypterte nyttelasten, aldri IP-en din. Mønster inspirert av Apple Private Relay."

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "Avveining: omtrent halvparten av single-hop-båndbredden. Av som standard; opt-in for personvern. Daemon-omstart kreves etter endring av denne innstillingen."

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "Warren multi-hop"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "Når aktivert rutes trafikken gjennom to Warren-reléer (inngang og deretter utgang) med HPKE ende-til-ende-kryptering mellom klienten og utgangen. Inngangsreléet ser kun chiffertekst; utgangsreléet ser kun den dekrypterte nyttelasten, aldri bruker-IP-en."

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "Kopiert til utklippstavlen"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "Kopiér til utklippstavlen"

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "En VPN-opplevelse uten kompromisser på personvern. Ingen logger. Ingen kontoer. Ingen sporing. Bare båndbredde."

msgctxt "warren-onboarding"
msgid "All set"
msgstr "Alt klart"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "Sjekk på nytt"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "Sjekker... (klikk for å oppdatere nå)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "Konfigurasjon fullført. Velg et land og koble til Warren."

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "Fortsett"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "Kunne ikke sjekke abonnementsstatus. Prøv igjen."

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "Daemonen har ennå ingen mnemonic, logg inn eller start appen på nytt."

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Kunne ikke hente mnemonic fra daemonen."

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "Kom i gang"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "Jeg har allerede et abonnement"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "Jeg har skrevet den ned på et trygt sted."

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "Fant ingen aktivt abonnement. Kjøp et først."

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "Velg et land og koble til"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "Velg forsvarene du vil ha fra første dag. Du kan endre alle disse senere fra Innstillinger."

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "Personverninnstillinger"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "Hopp over veiviser (avansert)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "Se planer (åpnes i nettleseren)"

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "Velkommen til Warren VPN"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "Skriv ned disse 12 ordene i rekkefølge, og oppbevar dem på et trygt sted. De er den eneste måten å gjenopprette abonnementet ditt på hvis du mister tilgangen til denne enheten."

msgctxt "warren-onboarding"
msgid "You don’t have an active subscription yet. You buy VPN time in advance, with no account to create. If you choose automatic monthly renewal, you can turn it off at any time, at no cost."
msgstr "Du har ikke et aktivt abonnement ennå. Du kjøper VPN-tid på forhånd, uten å opprette en konto. Hvis du velger automatisk månedlig fornyelse, kan du slå den av når som helst, uten kostnad."

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "Din Warren-lommebok"

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "Ditt abonnement"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• Alltid-på-obfuskering (PÅ som standard): HTTP/3-mimikk slik at trafikken blender inn."

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (AV som standard): injiserer utfylling for å motvirke ML-trafikkanalyse. ~5-15 % båndbredde."

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-hop (AV som standard): rute gjennom to reléer for at inngang og utgang ikke skal kunne kobles sammen."

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "Detaljer om kryptografisk avvik"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "Utgangs-ID"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "Plassering"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "Nylig observert nøkkel"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "Tidligere festet nøkkel"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "Behandler valget ditt, vennligst vent."

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "Avvis (koble fra)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "Avvis og forbli frakoblet"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "Rapporter til Warren"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "Serverens identitet er endret"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "Warren-utgangsserveren du tidligere stolte på presenterer nå en annen kryptografisk identitet."

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "Det betyr vanligvis at operatøren har rotert nøkkelen, men det kan også tyde på at serveren er erstattet eller kompromittert. Avvis hvis du ikke forventet en endring."

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "Stol på den nye nøkkelen"

msgctxt "warren-status-view"
msgid "Last"
msgstr "Sist"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "Obfuskering"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "Tilkoblinger på nytt"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "inaktiv"

msgctxt "warren-status-view"
msgid "never"
msgstr "aldri"

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "Åpner en offentlig port på den tilkoblede utgangsserveren og videresender den til enheten din. Nyttig for node-til-node-applikasjoner, fildeling eller selvhostede tjenester."

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "Portvideresending"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "Protokoll"

msgctxt "keys-view"
msgid "Backup keys"
msgstr "Sikkerhetskopier nøkler"

msgctxt "keys-view"
msgid "Done"
msgstr "Ferdig"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "Skriv inn BIP39-gjenopprettingsfrasen din på 12 (eller 24) ord, atskilt med mellomrom."

msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Kunne ikke hente gjenopprettingsfrasen fra tjenesten."

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "Jeg har skrevet den ned på et trygt sted."

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "Jeg forstår at dette permanent erstatter min nåværende identitet."

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "Identiteten er gjenopprettet. Den nye Warren-lommeboken din er nå aktiv."

msgctxt "keys-view"
msgid "Keys"
msgstr "Nøkler"

msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "Ingen gjenopprettingsfrase tilgjengelig, logg inn eller gjenopprett en identitet først."

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "Gjenopprett fra gjenopprettingsfrase"

msgctxt "keys-view"
msgid "Restore identity"
msgstr "Gjenopprett identitet"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "Gjenoppretter …"

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "Vis gjenopprettingsfrase"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "ADVARSEL: Dette vil ERSTATTE din nåværende identitet. Ethvert abonnement knyttet til den nåværende identiteten kan ikke gjenopprettes."

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "Skriv den ned på papir. Lagre den aldri i en sky, et skjermbilde eller en e-post."

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "Gjenopprettingsfrasen din på 12 ord er den ENESTE måten å gjenopprette Warren-identiteten din på en annen enhet. Mister du den, kan abonnementet ditt ikke gjenopprettes."

msgctxt "keys-view"
msgid "words"
msgstr "ord"

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "Sikkerhetskopier frasen min"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "Jeg har sikkerhetskopiert gjenopprettingsfrasen min og forstår at denne kontoen fjernes fra denne enheten."

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "Hvis du ikke har sikkerhetskopiert gjenopprettingsfrasen din, går abonnementet ditt tapt permanent."

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "Logge ut av denne kontoen?"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "Når du logger ut, slettes denne kontoen fra denne enheten. Det finnes ingen e-post eller passord for å logge inn igjen, gjenopprettingsfrasen din er den ENESTE måten å gjenopprette den på."

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "Sikkerhetskopier gjenopprettingsfrasen din"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "Kunne ikke lese den nye gjenopprettingsfrasen. Prøv igjen."

msgctxt "login-view"
msgid "Discard"
msgstr "Forkast"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "Vil du forkaste denne nye kontoen?"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "Skriv inn gjenopprettingsfrasen din på 12 ord, atskilt med mellomrom, for å gjenopprette kontoen din på denne enheten."

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "Gå bare tilbake hvis du mente å gjenopprette en konto du allerede har."

msgctxt "login-view"
msgid "I already have an account"
msgstr "Jeg har allerede en konto"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "Jeg har skrevet ned gjenopprettingsfrasen min på et trygt sted."

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "Ugyldig gjenopprettingsfrase. Kontroller ordene og rekkefølgen deres, og prøv igjen."

msgctxt "login-view"
msgid "Keep it"
msgstr "Behold den"

msgctxt "login-view"
msgid "Restore account"
msgstr "Gjenopprett konto"

msgctxt "login-view"
msgid "Restore your account"
msgstr "Gjenopprett kontoen din"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "Kontoen som nettopp ble opprettet, blir forlatt, og gjenopprettingsfrasen vises ikke igjen."

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren bruker en ikke-forvaltet lommebok: kontoen din er en gjenopprettingsfrase på 12 ord som bare du har."

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "Velkommen til Warren"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "Skriv ned disse 12 ordene og oppbevar dem trygt. De er den eneste måten å gjenopprette kontoen din på hvis du mister denne enheten."

msgctxt "connect-view"
msgid "I’ve completed payment"
msgstr "Jeg har fullført betalingen"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "Økten er inaktiv"

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node’s public key has changed."
msgstr "Avvik i serveridentitet oppdaget. Den offentlige nøkkelen til utgangsnoden er endret."

msgid "OK"
msgstr "OK"

msgctxt "accessibility"
msgid "Copy public key"
msgstr "Kopier offentlig nøkkel"

#. Accessibility label of the control that copies
#. the voucher code to the clipboard.
msgctxt "accessibility"
msgid "Copy the voucher code"
msgstr "Kopier kupongkoden"

msgctxt "account-view"
msgid "Backup keys"
msgstr "Sikkerhetskopier nøkler"

msgctxt "account-view"
msgid "Could not log out: the VPN did not disconnect in time. You are still logged in."
msgstr "Kunne ikke logge ut: VPN-tilkoblingen ble ikke koblet fra i tide. Du er fortsatt logget på."

msgctxt "account-view"
msgid "Something went wrong while logging out."
msgstr "Noe gikk galt under utloggingen."

#. Button that runs a logout again after it failed.
msgctxt "account-view"
msgid "Try again"
msgstr "Prøv igjen"

msgctxt "auth-failure"
msgid "Blocking internet: this device has been revoked. Log in again to connect, or disconnect to unblock the internet."
msgstr "Blokkerer internett: denne enheten er tilbakekalt. Logg på igjen for å koble til, eller koble fra for å oppheve blokkeringen av internett."

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "Sjekker … (klikk for å oppdatere nå)"

msgctxt "connect-view"
msgid "Here’s your public key. Save it!"
msgstr "Her er din offentlige nøkkel. Ta vare på den!"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "Portvideresending: %(ports)s"

msgctxt "connection-info"
msgid "Multihop (2 hops)"
msgstr "Multihop (2 hopp)"

msgctxt "in-app-notifications"
msgid "EXIT SWITCHED"
msgstr "UTGANG BYTTET"

msgctxt "in-app-notifications"
msgid "Your previous exit became unreachable. Warren routed you through an alternative server automatically."
msgstr "Din forrige utgang ble utilgjengelig. Warren rutet deg automatisk gjennom en alternativ server."

msgctxt "in-app-notifications"
msgid "Your server is being updated. Warren moved you to another server automatically, no action needed."
msgstr "Serveren din oppdateres. Warren flyttet deg automatisk til en annen server, ingen handling kreves."

msgctxt "port-forwarding-view"
msgid "+ Add a port"
msgstr "+ Legg til en port"

msgctxt "port-forwarding-view"
msgid "Each port you add is opened on the exit and forwarded to the same port on your device. Changes apply immediately, no reconnection needed."
msgstr "Hver port du legger til, åpnes på utgangsserveren og videresendes til samme port på enheten din. Endringer trer i kraft umiddelbart, uten gjentilkobling."

msgctxt "port-forwarding-view"
msgid "Last port change before a temporary block. Wait a moment before changing it again."
msgstr "Siste portendring før en midlertidig sperre. Vent et øyeblikk før du endrer den igjen."

msgctxt "port-forwarding-view"
msgid "Maximum of %(max)d ports reached"
msgstr "Maksimalt antall på %(max)d porter nådd"

msgctxt "port-forwarding-view"
msgid "No port yet. Add one to open it on the exit."
msgstr "Ingen port ennå. Legg til en for å åpne den på utgangsserveren."

msgctxt "port-forwarding-view"
msgid "Port"
msgstr "Port"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535."
msgstr "Porten må være mellom 49152 og 65535."

msgctxt "port-forwarding-view"
msgid "Remove port"
msgstr "Fjern port"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mappings."
msgstr "Status: venter på en aktiv tunneltilkobling for å sette opp portvideresendingene."

msgctxt "port-forwarding-view"
msgid "This port is already in your list."
msgstr "Denne porten er allerede i listen din."

msgctxt "port-forwarding-view"
msgid "Too many port changes. You can change ports again in %(countdown)s."
msgstr "For mange portendringer. Du kan endre porter igjen om %(countdown)s."

msgctxt "port-forwarding-view"
msgid "applying…"
msgstr "bruker …"

msgctxt "port-forwarding-view"
msgid "failed"
msgstr "mislyktes"

msgctxt "port-forwarding-view"
msgid "no port available"
msgstr "ingen port tilgjengelig"

msgctxt "port-forwarding-view"
msgid "open: %(port)d"
msgstr "åpen: %(port)d"

