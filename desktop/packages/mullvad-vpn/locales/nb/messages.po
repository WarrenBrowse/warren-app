msgstr "Fjern %(location)s fra %(listName)s"

msgctxt "account-view"
msgid "Paused while access is revoked: nothing is charged."
msgstr "Satt på pause mens tilgangen er tilbakekalt: ingenting belastes."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been revoked until %(date)s after repeated abuse reports about a forwarded port. You can contest this at %(url)s"
msgstr "Blokkerer internett: tilgangen din er tilbakekalt frem til %(date)s etter gjentatte misbruksrapporter om en videresendt port. Du kan bestride dette på %(url)s"

msgctxt "connect-view"
msgid "Degraded bond"
msgstr "Svekket bonding"

msgctxt "connect-view"
msgid "Degraded bond (%(stalled)s of %(bonded)s)"
msgstr "Svekket bonding (%(stalled)s av %(bonded)s)"

msgctxt "in-app-notifications"
msgid "%(product)s has taken priority on this device, so this build disconnected and turned its kill switch off."
msgstr "%(product)s har fått prioritet på denne enheten, så denne versjonen koblet fra og slo av avbruddsbryteren sin."

msgctxt "in-app-notifications"
msgid "%(product)s holds the tunnel on this device. It stands down on its own as soon as you connect here."
msgstr "%(product)s bruker tunnelen på denne enheten. Den gir fra seg tunnelen automatisk så snart du kobler til her."

msgctxt "in-app-notifications"
msgid "ANOTHER BUILD IS CONNECTED"
msgstr "EN ANNEN VERSJON ER TILKOBLET"

msgctxt "in-app-notifications"
msgid "Bring this build back"
msgstr "Aktiver denne versjonen igjen"

msgctxt "in-app-notifications"
msgid "Bring this build back."
msgstr "Aktiver denne versjonen igjen."

msgctxt "in-app-notifications"
msgid "PORT FORWARDING WARNING"
msgstr "ADVARSEL OM PORTVIDERESENDING"

msgctxt "in-app-notifications"
msgid "RECONNECTED AFTER A CRASH"
msgstr "KOBLET TIL IGJEN ETTER ET KRASJ"

msgctxt "in-app-notifications"
msgid "STANDING BY"
msgstr "I VENTEMODUS"

msgctxt "in-app-notifications"
msgid "You can bring it back once %(product)s is disconnected."
msgstr "Du kan aktivere den igjen når %(product)s er koblet fra."

msgctxt "in-app-notifications"
msgid "Your device did not shut down cleanly, so Warren restored your previous connection. Neither auto-connect nor launch on start-up is on. Disconnect if you did not want this."
msgstr "Enheten din ble ikke slått av på riktig måte, så Warren gjenopprettet den forrige tilkoblingen din. Verken «Automatisk tilkobling» eller «Kjør app ved oppstart» er slått på. Koble fra hvis du ikke ønsket dette."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse until %(date)s."
msgstr "Tilgang tilbakekalt for misbruk av portvideresending frem til %(date)s."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse."
msgstr "Tilgang tilbakekalt for misbruk av portvideresending."

msgctxt "port-forwarding-view"
msgid "Access revoked until %(date)s."
msgstr "Tilgang tilbakekalt frem til %(date)s."

