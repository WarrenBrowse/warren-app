msgctxt "login-view"
msgid "Check your recovery phrase"
msgstr "Kontroller gjenopprettingsfrasen din"

msgctxt "login-view"
msgid "To make sure you saved it, type these words from your recovery phrase."
msgstr "Skriv inn disse ordene fra gjenopprettingsfrasen for å bekrefte at du har tatt vare på den."

msgctxt "login-view"
msgid "Word %(position)d"
msgstr "Ord %(position)d"

msgctxt "login-view"
msgid "These words do not match your recovery phrase. Check what you wrote down."
msgstr "Disse ordene stemmer ikke med gjenopprettingsfrasen din. Sjekk det du skrev ned."

msgctxt "in-app-notifications"
msgid "DISCONNECTION NOT CONFIRMED"
msgstr "FRAKOBLING IKKE BEKREFTET"

msgctxt "in-app-notifications"
msgid "The server says this device was disconnected from your account, but your account did not confirm it. Nothing was erased from this device."
msgstr "Serveren sier at denne enheten ble koblet fra kontoen din, men kontoen din har ikke bekreftet det. Ingenting ble slettet fra denne enheten."

msgctxt "support-view"
msgid "Privacy policy"
msgstr "Retningslinjer for personvern"

msgctxt "auth-failure"
msgid "Blocking internet: your access has been revoked for a usage policy violation. If you believe this is a mistake, write to us from the help page at %(url)s"
msgstr "Blokkerer internett: tilgangen din er tilbakekalt på grunn av brudd på bruksvilkårene. Hvis du mener dette er en feil, skriv til oss fra hjelpesiden på %(url)s"

msgctxt "auth-failure"
msgid "Blocking internet: your access has been revoked until %(date)s for a usage policy violation. If you believe this is a mistake, write to us from the help page at %(url)s"
msgstr "Blokkerer internett: tilgangen din er tilbakekalt frem til %(date)s på grunn av brudd på bruksvilkårene. Hvis du mener dette er en feil, skriv til oss fra hjelpesiden på %(url)s"

msgctxt "account-view"
msgid "A withdrawal with another refund address is already recorded: write to us from the help page at %(url)s"
msgstr "En angring med en annen refusjonsadresse er allerede registrert: skriv til oss fra hjelpesiden på %(url)s"

msgctxt "forum-login"
msgid "Forum access requires a Warren subscription. This wallet has never subscribed: use the help form on the website instead."
msgstr "Tilgang til forumet krever et Warren-abonnement. Denne lommeboken har aldri hatt et: bruk hjelpeskjemaet på nettstedet i stedet."
