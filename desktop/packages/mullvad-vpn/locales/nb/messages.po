#. Page title for anti censorship settings view
msgctxt "anti-censorship-view"
msgid "Anti-censorship"
msgstr "Antisensur"

msgctxt "api-access-methods-view"
msgid "Add method"
msgstr "Legg til metode"

msgctxt "api-access-methods-view"
msgid "Adding a new API access method also tests it."
msgstr "Når du legger til en ny API-tilgangsmetode, vil den også bli testet."

msgctxt "api-access-methods-view"
msgid "API reachable"
msgstr "API tilgjengelig"

msgctxt "api-access-methods-view"
msgid "API reachable, adding method…"
msgstr "API tilgjengelig, legger til metode …"

msgctxt "api-access-methods-view"
msgid "API reachable, saving method…"
msgstr "API tilgjengelig, lagrer metode …"

msgctxt "api-access-methods-view"
msgid "API unreachable"
msgstr "API ikke tilgjengelig"

msgctxt "api-access-methods-view"
msgid "API unreachable, add anyway?"
msgstr "API ikke tilgjengelig, legge til uansett?"

msgctxt "api-access-methods-view"
msgid "API unreachable, save anyway?"
msgstr "API ikke tilgjengelig, lagre uansett?"

msgctxt "api-access-methods-view"
msgid "Authentication"
msgstr "Autentisering"

#. %(save)s - Will be replaced with the translation for the word "Save".
msgctxt "api-access-methods-view"
msgid "Clicking “%(save)s” changes the in use method."
msgstr "Når du trykker på «%(save)s», vil det endre hvilken metode som brukes."

msgctxt "api-access-methods-view"
msgid "Delete %(name)s?"
msgstr "Slette %(name)s?"

msgctxt "api-access-methods-view"
msgid "Edit method"
msgstr "Endre metode"

msgctxt "api-access-methods-view"
msgid "Editing an API access method also tests it."
msgstr "Når du endrer en API-tilgangsmetode, vil den også bli testet."

msgctxt "api-access-methods-view"
msgid "Enter IP"
msgstr "Skriv inn IP"

msgctxt "api-access-methods-view"
msgid "Enter name"
msgstr "Skriv inn navn"

msgctxt "api-access-methods-view"
msgid "Enter port"
msgstr "Skriv inn port"

msgctxt "api-access-methods-view"
msgid "In use"
msgstr "Er i bruk"

msgctxt "api-access-methods-view"
msgid "Local SOCKS5 server"
msgstr "Lokal SOCKS5-server"

msgctxt "api-access-methods-view"
msgid "Manage and add custom methods to access the Warren API."
msgstr "Administrer og legg til tilpassede metoder for tilgang til Warren API."

msgctxt "api-access-methods-view"
msgid "On some networks, where various types of censorship are being used, the API servers might not be directly reachable."
msgstr "På enkelte nettverk der det brukes ulike typer sensur, kan det hende API-servere ikke er direkte tilgjengelig."

msgctxt "api-access-methods-view"
msgid "Please enter a valid IPv4 or IPv6 address."
msgstr "Skriv inn en gyldig IPv4- eller IPv6-adresse."

msgctxt "api-access-methods-view"
msgid "Please enter a valid localhost port."
msgstr "Skriv inn en gyldig localhost-port."

msgctxt "api-access-methods-view"
msgid "Please enter a valid remote server port."
msgstr "Skriv inn en gyldig ekstern server-port."

msgctxt "api-access-methods-view"
msgid "Please select a name for the access method not already in use."
msgstr "Velg et navn for tilgangsmetoden som ikke allerede er i bruk."

msgctxt "api-access-methods-view"
msgid "Remote Server"
msgstr "Ekstern server"

msgctxt "api-access-methods-view"
msgid "Server"
msgstr "Server"

msgctxt "api-access-methods-view"
msgid "Server details"
msgstr "Serverinformasjon"

msgctxt "api-access-methods-view"
msgid "SOCKS5 local"
msgstr "SOCKS5 lokal"

msgctxt "api-access-methods-view"
msgid "SOCKS5 remote"
msgstr "SOCKS5 ekstern"

msgctxt "api-access-methods-view"
msgid "Testing method..."
msgstr "Tester metode ..."

msgctxt "api-access-methods-view"
msgid "Testing..."
msgstr "Tester ..."

msgctxt "api-access-methods-view"
msgid "The API could not be reached using the %(name)s method."
msgstr "API var ikke tilgjengelig ved bruk av metoden %(name)s."

msgctxt "api-access-methods-view"
msgid "The app needs the remote server details, where your local SOCKS5 server will forward your traffic."
msgstr "Appen trenger informasjonen til den eksterne serveren, der den lokale SOCKS5-serveren videresender trafikken din."

msgctxt "api-access-methods-view"
msgid "The app needs to communicate with a Warren API server to log you in, fetch server lists, and other critical operations."
msgstr "Appen må kunne kommunisere med en Warren API-server for å logge deg inn, hente serverlister og utføre andre kritiske operasjoner."

msgctxt "api-access-methods-view"
msgid "The in use API access method will change."
msgstr "API-tilgangsmetoden vil bli endret."

msgctxt "api-access-methods-view"
msgid "The TCP port where your local SOCKS5 server is listening."
msgstr "TCP-porten der din lokale SOCKS5-server lytter."

msgctxt "api-access-methods-view"
msgid "This can be useful when you are not affected by censorship."
msgstr "Dette kan være nyttig når du ikke er berørt av sensur."

msgctxt "api-access-methods-view"
msgid "This feature allows you to circumvent that censorship by adding custom ways to access the API via proxies and similar methods."
msgstr "Denne funksjonen lar deg omgå sensuren ved å legge til tilpassede måter å få tilgang til API på via proxyer og lignende metoder."

msgctxt "api-access-methods-view"
msgid "This is needed so our app can allow that traffic in the firewall."
msgstr "Dette er nødvendig for at appen kan tillate trafikken i brannmuren."

msgctxt "api-access-methods-view"
msgid "Transport protocol"
msgstr "Transportprotokoll"

msgctxt "api-access-methods-view"
msgid "With the “Direct” method, the app communicates with a Warren API server directly without any intermediate proxies."
msgstr "Med «Direkte»-metoden kan appen kommunisere direkte med en Warren API-server uten proxyer mellom."

#. Title of the app info view.
msgctxt "app-info-view"
msgid "App info"
msgstr "Appinfo"

#. Description for version list item when app is out of sync.
msgctxt "app-info-view"
msgid "App is out of sync. Please quit and restart."
msgstr "Appen er ikke synkronisert. Avslutt og start på nytt."

#. Label for switch to toggle beta program.
msgctxt "app-info-view"
msgid "Beta program"
msgstr "Betaprogram"

msgctxt "app-info-view"
msgid "Enable to get notified when new beta versions of the app are released."
msgstr "Aktiver for å bli varslet når betaversjoner av appen lanseres."

msgctxt "app-info-view"
msgid "This option is unavailable while using a beta version."
msgstr "Dette alternativet er utilgjengelig i betaversjonen."

#. Label for update available list item.
msgctxt "app-info-view"
msgid "Update available"
msgstr "Oppdatering er tilgjengelig"

#. Label for version list item.
msgctxt "app-info-view"
msgid "Version"
msgstr "Versjon"

#. Label for changelog list item.
msgctxt "app-info-view"
msgid "What’s new"
msgstr "Dette er nytt"

#. Status text displayed below a progress bar when the update is being downloaded
#. with the estimated time of completion is within a few seconds.
msgctxt "app-upgrade-view"
msgid "A few seconds remaining..."
msgstr "Det gjenstår noen sekunder …"

#. Status text displayed below a progress bar when the update is being downloaded
#. with the estimated time of completion represented in minutes.
#. Available placeholders:
#. %(minutes)s - Will be replaced with remaining minutes until download is complete
msgctxt "app-upgrade-view"
msgid "About %(minutes)s minutes remaining..."
msgstr "Omtrent %(minutes)s minutter gjenstår …"

#. Status text displayed below a progress bar when the update is being downloaded
#. with the estimated time of completion represented in seconds.
#. Available placeholders:
#. %(second)s - Will be replaced with remaining seconds until download is complete
msgctxt "app-upgrade-view"
msgid "About %(seconds)s seconds remaining..."
msgstr "Omtrent %(seconds)s sekunder gjenstår …"

#. Label displayed when an error occurred due to the connection being blocked
msgctxt "app-upgrade-view"
msgid "Connection blocked. Try changing server or other settings."
msgstr "Tilkoblingen er blokkert. Prøv å endre serveren eller andre innstillinger."

#. Button text to download and install an update
msgctxt "app-upgrade-view"
msgid "Download & install"
msgstr "Last ned og installer"

#. Status text displayed below a progress bar when the download of an update is complete
msgctxt "app-upgrade-view"
msgid "Download complete!"
msgstr "Nedlastingen er fullført!"

#. Status text displayed below a progress bar when the download of an update fails
msgctxt "app-upgrade-view"
msgid "Download failed"
msgstr "Nedlastingen mislyktes"

#. Status text displayed below a progress bar when the download of an update has been paused
#. Label displayed above a progress bar when the update is verified successfully
msgctxt "app-upgrade-view"
msgid "Download paused"
msgstr "Nedlastingen er satt på pause"

#. Label displayed above a progress bar informing the user which server
#. the update is downloading from
msgctxt "app-upgrade-view"
msgid "Downloading from: %(server)s"
msgstr "Laster ned fra: %(server)s"

#. Label displayed above a progress bar when a download is in progress
msgctxt "app-upgrade-view"
msgid "Downloading..."
msgstr "Laster ned …"

#. Link shown to optionally manually download the update
#. due to repeated errors in the upgrade process.
msgctxt "app-upgrade-view"
msgid "Having problems? Try downloading the app from our website"
msgstr "Har du problemer? Prøv å laste ned appen fra nettstedet vårt"

#. Button text to install an update
msgctxt "app-upgrade-view"
msgid "Install update"
msgstr "Installer oppdatering"

#. Info about which directory the app update will be downloaded to
msgctxt "app-upgrade-view"
msgid "Installer will be downloaded to <b>%(cacheDir)s</b>."
msgstr "Installasjonsrogrammet lastes ned til <b>%(cacheDir)s</b>."

msgctxt "app-upgrade-view"
msgid "Latest version: %(version)s"
msgstr "Nyeste versjon: %(version)s"

#. Text displayed when there are no updates for this platform in the next app version
msgctxt "app-upgrade-view"
msgid "No updates or changes were made in this release for this platform."
msgstr "Ingen oppdateringer eller endringer er gjort i denne versjonen for plattformen."

#. Button text to pause the download of an update
msgctxt "app-upgrade-view"
msgid "Pause"
msgstr "Pause"

#. Button text to resume updating
msgctxt "app-upgrade-view"
msgid "Resume"
msgstr "Fortsett"

#. Button text to try again
msgctxt "app-upgrade-view"
msgid "Retry"
msgstr "Prøv på nytt"

#. Button text to try download again
msgctxt "app-upgrade-view"
msgid "Retry download"
msgstr "Prøv å laste ned på nytt"

#. Status text displayed below a progress bar when the download of an update is starting
msgctxt "app-upgrade-view"
msgid "Starting download..."
msgstr "Starter nedlasting …"

#. Button text to when starting the installer for an update
msgctxt "app-upgrade-view"
msgid "Starting installer..."
msgstr "Starter installasjonsprogrammet …"

#. Title in navigation bar
#. Main title for the update available view
msgctxt "app-upgrade-view"
msgid "Update available"
msgstr "En oppdatering er tilgjengelig"

#. Label displayed above a progress bar when the update is verified successfully
msgctxt "app-upgrade-view"
msgid "Verification successful!"
msgstr "Bekreftelse lyktes!"

#. Label displayed above a progress bar when the update is being verified
msgctxt "app-upgrade-view"
msgid "Verifying installer..."
msgstr "Bekrefter installasjonsprogram …"

#. Heading which shows the version of the app which can be upgraded to.
#. Available placeholders:
#. %(version)s - The new version of the app.
msgctxt "app-upgrade-view"
msgid "Version %(version)s"
msgstr "Versjon %(version)s"

#. The user has the latest version of the app and does not need to be update
msgctxt "app-upgrade-view"
msgid "You are using the latest version"
msgstr "Du bruker den nyeste versjonen"

#. Label displayed when an error occurred due to the installer failing to start
#. and the suggested resolution is to download the update again.
msgctxt "app-upgrade-view"
msgid "Could not open installer, please try again or report the problem on our community forum."
msgstr "Kunne ikke åpne installasjonsprogrammet. Prøv igjen eller rapporter problemet på forumet vårt."

#. Label displayed when an error occurred due to the download failing
msgctxt "app-upgrade-view"
msgid "Download failed, please check your connection/firewall and try again, or report the problem on our community forum."
msgstr "Nedlastingen mislyktes. Sjekk forbindelsen/brannmuren og prøv igjen, eller rapporter problemet på forumet vårt."

#. Label displayed when an error occurred within the installer
msgctxt "app-upgrade-view"
msgid "Installer quit unexpectedly, please try again or report the problem on our community forum."
msgstr "Installasjonsprogrammet avsluttet uventet. Prøv på nytt eller rapporter problemet på forumet vårt."

#. Button text to report a problem on the community forum
msgctxt "app-upgrade-view"
msgid "Report a problem on the forum"
msgstr "Rapporter et problem på forumet"

msgctxt "app-upgrade-view"
msgid "This version of Warren is no longer supported. To keep your connection protected, you must update the app to keep using it."
msgstr "Denne versjonen av Warren støttes ikke lenger. For at tilkoblingen din fortsatt skal være beskyttet, må du oppdatere appen for å kunne bruke den."

#. Label displayed when an unknown error occurred
msgctxt "app-upgrade-view"
msgid "Unknown error occurred. Please try again or report the problem on our community forum."
msgstr "Det oppstod en ukjent feil. Prøv på nytt eller rapporter problemet på forumet vårt."

#. Title of the screen that forces the user to update.
msgctxt "app-upgrade-view"
msgid "Update required"
msgstr "Oppdatering kreves"

#. Label displayed when an error occurred due to the installer failed verification
msgctxt "app-upgrade-view"
msgid "Verification failed, please try again or report the problem on our community forum."
msgstr "Bekreftelse mislyktes. Prøv på nytt eller rapporter problemet på forumet vårt."

msgctxt "auth-failure"
msgid "Blocking internet: account is out of time"
msgstr "Blokkerer internett: tidsavbrudd for konto"

msgctxt "auth-failure"
msgid "Too many simultaneous connections on this account. Disconnect another device or try connecting again shortly."
msgstr "For mange simultantilkoblinger på denne kontoen. Koble fra en annen enhet eller prøv å koble til igjen snart."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please report the problem on our community forum."
msgstr "Kunne ikke autentisere konto. Rapporter problemet på forumet vårt."

#. Accessibility label of the beta badge button.
msgctxt "beta-badge"
msgid "About the Warren beta"
msgstr "Om Warren-betaen"

#. Label of the beta badge shown in beta builds.
msgctxt "beta-badge"
msgid "BETA"
msgstr "BETA"

msgctxt "beta-badge"
msgid "Free beta network, limited bandwidth"
msgstr "Gratis betanettverk, begrenset båndbredde"

#. Short beta banner line. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "Free beta network, speed capped at %(mbps)d Mbps"
msgstr "Gratis betanettverk, hastigheten begrenset til %(mbps)d Mbit/s"

#. Beta info dialog sentence. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "It runs on a separate network with bandwidth capped at %(mbps)d Mbps."
msgstr "Den kjører på et separat nettverk med båndbredden begrenset til %(mbps)d Mbit/s."

msgctxt "beta-badge"
msgid "It runs on a separate network with limited bandwidth."
msgstr "Den kjører på et separat nettverk med begrenset båndbredde."

#. Link to the community forum in the beta info dialog.
msgctxt "beta-badge"
msgid "Share your feedback on the forum"
msgstr "Del tilbakemeldingen din på forumet"

#. Paragraph of the beta info dialog clarifying that the beta terms are temporary.
msgctxt "beta-badge"
msgid "These are not the final service conditions: the full-speed network is a separate, paid product."
msgstr "Dette er ikke de endelige vilkårene: nettverket med full hastighet er et separat, betalt produkt."

#. First paragraph of the beta info dialog.
msgctxt "beta-badge"
msgid "This app uses the free Warren beta, here to help us validate Warren in real conditions."
msgstr "Denne appen bruker Warrens gratis beta, som hjelper oss å teste Warren under virkelige forhold."

#. Title of the beta info dialog.
msgctxt "beta-badge"
msgid "Warren beta"
msgstr "Warren-beta"

#. Text displayed when there are no updates for this platform in the app version
msgctxt "changelog-view"
msgid "No updates or changes were made in this release for this platform."
msgstr "Ingen oppdateringer eller endringer er gjort i denne versjonen for denne plattformen."

#. Heading for the view of the changes and updates in the
#. current version compared to the old version.
msgctxt "changelog-view"
msgid "What’s new"
msgstr "Nytt"

#. The selected location label displayed on the main view, when a user selected a specific host to connect to.
#. Example: Malmö (se-mma-001)
#. Available placeholders:
#. %(city)s - a city name
#. %(hostname)s - a hostname
msgctxt "connect-container"
msgid "%(city)s (%(hostname)s)"
msgstr "%(city)s (%(hostname)s)"

#. This is used as a feature indicator to show that DAITA is enabled through
#. multihop.
#. Available placeholders:
#. %(DAITA)s - Is a non-translatable feature "DAITA"
msgctxt "connect-view"
msgid "%(DAITA)s: Multihop"
msgstr "%(DAITA)s: Multihopp"

msgctxt "connect-view"
msgid "%(count)d app in another country"
msgid_plural "%(count)d apps in other countries"
msgstr[0] "%(count)d app i et annet land"
msgstr[1] "%(count)d apper i andre land"

msgctxt "connect-view"
msgid "Congrats!"
msgstr "Gratulerer!"

msgctxt "connect-view"
msgid "Connection details"
msgstr "Tilkoblingsdetaljer"

#. Button label for disconnecting from the VPN.
msgctxt "connect-view"
msgid "Disconnect"
msgstr "Koble fra"

msgctxt "connect-view"
msgid "Either buy credit on our website or redeem a voucher."
msgstr "Du kan enten kjøpe kreditt på nettsiden vår eller løse inn en kupong."

msgctxt "connect-view"
msgid "Enter voucher code"
msgstr "Skriv inn kupongkode"

msgctxt "connect-view"
msgid "Go ahead and start using the app to begin reclaiming your online privacy."
msgstr "Fortsett og bruk appen for å begynne gjenvinningen av personvernet ditt på nett."

#. Button label for opening privacy information link.
msgctxt "connect-view"
msgid "Learn about privacy"
msgstr "Lær om personvern"

msgctxt "connect-view"
msgid "Out of time"
msgstr "Tiden har utløpt"

#. Button label for navigating to the voucher redemption view.
msgctxt "connect-view"
msgid "Redeem voucher"
msgstr "Løs inn kupong"

msgctxt "connect-view"
msgid "Remember, turning it off will allow network traffic while the VPN is disconnected until you turn it back on under Advanced settings."
msgstr "Husk at å slå den av vil tillate trafikk over nettverket mens VPN er frakoblet helt til du slår den på igjen under Avanserte innstillinger."

#. Button label for starting the app.
msgctxt "connect-view"
msgid "Start using the app"
msgstr "Begynn å buke appen"

msgctxt "connect-view"
msgid "Time was successfully added"
msgstr "Tid ble lagt til"

msgctxt "connect-view"
msgid "To add more, you will need to disconnect and access the Internet with an unsecure connection."
msgstr "For å legge til mer, må du koble fra og koble til internettet med en usikker tilkobling."

msgctxt "connect-view"
msgid "To continue your journey as a privacy ninja, visit our website to pick up other privacy-friendly habits and tools."
msgstr "For å fortsette reisen som en personvernninja, besøk nettstedet vårt og plukk opp andre personvernvennlige vaner og verktøy."

msgctxt "connect-view"
msgid "To start using the app, you first need to add time to your account."
msgstr "For å starte bruken av appen, må du først legge til tid til kontoen."

msgctxt "connect-view"
msgid "VPN only for %(count)d app"
msgid_plural "VPN only for %(count)d apps"
msgstr[0] "VPN bare for %(count)d app"
msgstr[1] "VPN bare for %(count)d apper"

msgctxt "connect-view"
msgid "VPN only for chosen apps"
msgstr "VPN bare for valgte apper"

msgctxt "connect-view"
msgid "Voucher was successfully redeemed"
msgstr "Kupongkoden er løst inn"

msgctxt "connect-view"
msgid "You have no more VPN time left on this account."
msgstr "Du har ikke mer VPN-tid igjen på kontoen."

msgctxt "connect-view"
msgid "You need to disable \"Lockdown mode\" in order to access the Internet to add time."
msgstr "Du må deaktivere «Låsemodus» for å få tilgang til internettet og legge til mer tid."

msgctxt "connect-view"
msgid "You’re all set!"
msgstr "Du er klar!"

#. This is used as a feature indicator (warning) shown when the user enabled
#. DAITA but the current server did not grant the defense, so it is NOT
#. protecting this connection.
#. Available placeholders:
#. %(DAITA)s - Is a non-translatable feature "DAITA"
msgctxt "connect-view"
msgid "%(DAITA)s: not active on this server"
msgstr "%(DAITA)s: ikke aktiv på denne serveren"

msgctxt "connect-view"
msgid "Could not refresh the beta access. Check your connection and try again."
msgstr "Kunne ikke oppdatere betatilgangen. Sjekk tilkoblingen din og prøv igjen."

#. could not be established.
msgctxt "connect-view"
msgid "Port forwarding: blocked"
msgstr "Portvideresending: blokkert"

msgctxt "connect-view"
msgid "Port forwarding: clock of this device is off"
msgstr "Portvideresending: klokken på denne enheten går feil"

#. public port is already taken on the connected exit.
msgctxt "connect-view"
msgid "Port forwarding: port in use"
msgstr "Portvideresending: porten er opptatt"

#. Feature indicator (warning) shown when the network path cannot carry
#. full-size packets; the tunnel adapts automatically.
msgctxt "connect-view"
msgid "Reduced MTU"
msgstr "Redusert MTU"

#. Feature indicator (warning) shown when the network path cannot carry
#. full-size packets; the tunnel adapts automatically.
#. Available placeholders:
#. %(mtu)s - the measured usable packet size in bytes
msgctxt "connect-view"
msgid "Reduced MTU (%(mtu)s)"
msgstr "Redusert MTU (%(mtu)s)"

#. Button label that re-activates the free beta access.
msgctxt "connect-view"
msgid "Refresh beta access"
msgstr "Oppdater betatilgang"

msgctxt "connect-view"
msgid "This app uses the free Warren beta: no payment needed. Refresh your beta access to continue."
msgstr "Denne appen bruker den gratis Warren-betaen: ingen betaling er nødvendig. Oppdater betatilgangen din for å fortsette."

#. The hostname line displayed below the country on the main screen
#. Available placeholders:
#. %(relay)s - the relay hostname
#. %(entry)s - the entry relay hostname
msgctxt "connection-info"
msgid "%(relay)s via %(entry)s"
msgstr "%(relay)s via %(entry)s"

msgctxt "connection-info"
msgid "In"
msgstr "Inngående"

msgctxt "connection-info"
msgid "Out"
msgstr "Utgående"

#. This is a label shown above a list of options.
#. Available placeholder:
#. %(locationName)s - The name of the location being added to the list.
msgctxt "custom-list-feature"
msgid "Add %(locationName)s to list"
msgstr "Legg %(locationName)s til i listen"

#. Label for button to create a new custom list with a specific location.
#. Available placeholder:
#. %(locationName)s - The name of the location being added to the list.
msgctxt "custom-list-feature"
msgid "Add %(locationName)s to new list"
msgstr "Legg til %(locationName)s i ny liste"

#. This is a label shown above a list of options.
#. Available placeholder:
#. %(locationType) - Could be either "Country", "City" and "Relay"
msgctxt "custom-list-feature"
msgid "Add %(locationType)s to list"
msgstr "Legg %(locationType)s til i listen"

msgctxt "custom-list-feature"
msgid "City"
msgstr "By"

msgctxt "custom-list-feature"
msgid "Country"
msgstr "Land"

#. Label for the input where the user can enter the name of a new custom list.
msgctxt "custom-list-feature"
msgid "Create list"
msgstr "Opprett liste"

#. Label for the option to delete a custom list in a menu.
msgctxt "custom-list-feature"
msgid "Delete"
msgstr "Slett"

#. Confirmation message shown when the user tries to delete a custom list.
#. Asks the user if they are sure they want to delete the list.
#. Available placeholder:
#. %(list)s - The name of the custom list that is about to be deleted.
msgctxt "custom-list-feature"
msgid "Do you want to delete the list %(list)s?"
msgstr "Vil du slette listen %(list)s?"

msgctxt "custom-list-feature"
msgid "Edit list name"
msgstr "Endre listenavn"

#. Label for the option to edit a custom list in a menu.
msgctxt "custom-list-feature"
msgid "Edit name"
msgstr "Endre navn"

msgctxt "custom-list-feature"
msgid "Enter a name for the list"
msgstr "Skriv inn et navn på listen"

msgctxt "custom-list-feature"
msgid "Enter a new name for the list"
msgstr "Skriv inn et nytt navn på listen"

msgctxt "custom-list-feature"
msgid "List names must be unique"
msgstr "Listenavnene må være unike"

msgctxt "custom-list-feature"
msgid "Relay"
msgstr "Relé"

#. Button label for navigating to login.
msgctxt "device-management"
msgid "Go to login"
msgstr "Gå til pålogging"

msgctxt "device-management"
msgid "Going to login will unblock the Internet on this device."
msgstr "Å gå til pålogging vil oppheve blokkeringen av internett på denne enheten."

#. Title label in navigation bar for the manage devices view.
#. Title text in the manage devices view
msgctxt "device-management"
msgid "Manage devices"
msgstr "Behandle enheter"

msgctxt "device-management"
msgid "Time left: %(timeLeft)s"
msgstr "Tid igjen: %(timeLeft)s"

#. Button text to retry fetching devices.
msgctxt "device-management"
msgid "Try again"
msgstr "Prøv igjen"

#. The message displayed to the user in case of critical error in the GUI
#. Available placeholders:
#. %(email)s - support email
msgctxt "error-boundary-view"
msgid "Something went wrong. Please contact us at %(email)s"
msgstr "Det oppstod en feil. Kontakt oss på %(email)s"

#. Button label on the fatal-error view that reloads the app
#. interface, as an alternative to force-quitting the app.
msgctxt "error-boundary-view"
msgid "Reload the app"
msgstr "Last inn appen på nytt"

msgctxt "filter-view"
msgid "Owned"
msgstr "Eid"

msgctxt "filter-view"
msgid "Rented"
msgstr "Leid"

msgctxt "in-app-notifications"
msgid "%(duration)s. Buy more credit."
msgstr "%(duration)s. Kjøp mer kreditt."

#. Notification subtitle when the app upgrade is ready to install.
#. Available placeholders:
#. - %(suggestedUpgradeVersion)s: Upgrade version to be installed.
msgctxt "in-app-notifications"
msgid "%(suggestedUpgradeVersion)s is ready to be installed."
msgstr "%(suggestedUpgradeVersion)s er klar for installasjon."

msgctxt "in-app-notifications"
msgid "<a>%(lockdownModeSettingName)s</a> is enabled. Please click “Connect“ or disable “%(lockdownModeSettingName)s“ to unblock internet."
msgstr "<a>%(lockdownModeSettingName)s</a> er aktivert. Klikk på «Koble til» eller deaktiver «%(lockdownModeSettingName)s» for å oppheve blokkeringen av internett."

msgctxt "in-app-notifications"
msgid "ACCESS REVOKED"
msgstr "TILGANG TILBAKEKALT"

msgctxt "in-app-notifications"
msgid "ACCOUNT CREDIT EXPIRES SOON"
msgstr "KREDITTEN PÅ KONTOEN UTLØPER SNART"

msgctxt "in-app-notifications"
msgid "APP IS OUT OF SYNC"
msgstr "APPEN ER IKKE SYNKRONISERT"

msgctxt "in-app-notifications"
msgid "BLOCKING INTERNET"
msgstr "INTERNETT ER BLOKKERT"

#. Notification subtitle when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "Click here to install update."
msgstr "Klikk her for å installere oppdateringen."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "Click here to retry"
msgstr "Klikk her for å prøve på nytt"

#. Notification subtitle when the download of the installer failed
#. and the user can try downloading again.
msgctxt "in-app-notifications"
msgid "Click here to retry download"
msgstr "Klikk her for å prøve å laste ned på nytt"

msgctxt "in-app-notifications"
msgid "Click here to see what’s new."
msgstr "Klikk her for å se hva som er nytt."

msgctxt "in-app-notifications"
msgid "Connecting is not possible while access is revoked."
msgstr "Det er ikke mulig å koble til så lenge tilgangen er tilbakekalt."

#. Label of the voucher code an announcement granted to this account.
msgctxt "in-app-notifications"
msgid "Your code"
msgstr "Din kode"

#. Confirmation shown once the voucher code is on the clipboard.
msgctxt "in-app-notifications"
msgid "Copied"
msgstr "Kopiert"

#. Notification subtitle when the installer download failed.
msgctxt "in-app-notifications"
msgid "Could not download installer."
msgstr "Kunne ikke laste ned installasjonsprogrammet."

#. Generic notification subtitle when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "Could not upgrade the app."
msgstr "Kunne ikke oppgradere appen."

#. Notification title when app upgrade is verifying the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOAD COMPLETE! VERIFYING..."
msgstr "NEDLASTINGEN ER FULLFØRT! BEKREFTER …"

#. Notification title when the installer download failed.
msgctxt "in-app-notifications"
msgid "DOWNLOAD FAILED"
msgstr "NEDLASTINGEN MISLYKTES"

#. Generic notification title when app upgrade is downloading the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE..."
msgstr "LASTER NED OPPDATERINGEN …"

#. Notification title when the app upgrade is in progress.
#. Available placeholders:
#. - %(appUpgradeDownloadProgressValue)s: The download progress value.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE... %(appUpgradeDownloadProgressValue)s%%"
msgstr "LASTER NED OPPDATERINGEN … %(appUpgradeDownloadProgressValue)s%%"

#. The in-app banner displayed to the user when the app update is available.
msgctxt "in-app-notifications"
msgid "IMPORTANT"
msgstr "VIKTIG"

#. Notification title when the installer failed.
msgctxt "in-app-notifications"
msgid "INSTALLER FAILED"
msgstr "INSTALLASJONSPROGRAMMET MISLYKTES"

msgctxt "in-app-notifications"
msgid "NETWORK TRAFFIC MIGHT BE LEAKING"
msgstr "NETTVERKSTRAFIKKEN KAN LEKKE"

msgctxt "in-app-notifications"
msgid "NEW VERSION INSTALLED"
msgstr "NY VERSJON INSTALLERT"

msgctxt "in-app-notifications"
msgid "NOTICE"
msgstr "MELDING"

msgctxt "in-app-notifications"
msgid "Please quit and restart the app."
msgstr "Avslutt og start appen på nytt."

#. Notification title when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "READY TO INSTALL UPDATE"
msgstr "KLAR TIL Å INSTALLERE OPPDATERINGEN"

#. Accessibility label for the button to retry download of the installer.
msgctxt "in-app-notifications"
msgid "Read the full message"
msgstr "Les hele meldingen"

msgctxt "in-app-notifications"
msgid "Retry download of the installer"
msgstr "Prøv å laste ned installasjonsprogrammet på nytt"

#. Accessibility label for the button to retry the installation.
msgctxt "in-app-notifications"
msgid "Retry installation"
msgstr "Prøv å installere på nytt"

msgctxt "in-app-notifications"
msgid "SERVER MAINTENANCE"
msgstr "SERVERVEDLIKEHOLD"

#. Notification subtitle when the installer verification failed.
msgctxt "in-app-notifications"
msgid "The installer could not be verified."
msgstr "Installasjonsprogrammet kunne ikke bekreftes."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not complete successfully."
msgstr "Installasjonsprogrammet ble ikke fullført."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not start successfully."
msgstr "Installasjonsprogrammet startet ikke."

msgctxt "in-app-notifications"
msgid "UNSUPPORTED VERSION"
msgstr "VERSJON UTEN STØTTE"

#. Generic notification title when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "UPDATE FAILED"
msgstr "OPPDATERINGEN MISLYKTES"

#. Notification title when app upgrade is ready for the user to launch the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! INSTALLER READY!"
msgstr "BEKREFTELSEN ER FULLFØRT! INSTALLASJONSPROGRAMMET ER KLART!"

#. Notification title when app upgrade is launching the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! LAUNCHING INSTALLER..."
msgstr "BEKREFTELSEN ER FULLFØRT! STARTER INSTALLASJONSPROGRAMMET …"

#. Notification title when the installer verification failed.
msgctxt "in-app-notifications"
msgid "VERIFICATION FAILED"
msgstr "BEKREFTELSEN MISLYKTES"

msgctxt "in-app-notifications"
msgid "AUTO-RENEWAL SOON"
msgstr "AUTOMATISK FORNYELSE SNART"

msgctxt "in-app-notifications"
msgid "MIGRATION POSTPONED, PORT KEPT"
msgstr "MIGRERING UTSATT, PORTEN BEHOLDES"

msgctxt "in-app-notifications"
msgid "NO INTERNET CONNECTION"
msgstr "INGEN INTERNETTILKOBLING"

#. Button label opening the community forum to report a problem.
msgctxt "in-app-notifications"
msgid "Report on the forum"
msgstr "Rapporter på forumet"

msgctxt "in-app-notifications"
msgid "SERVER NOT FORWARDING TRAFFIC"
msgstr "SERVEREN VIDERESENDER IKKE TRAFIKK"

msgctxt "in-app-notifications"
msgid "The server stopped forwarding your traffic. Warren will switch or reconnect automatically."
msgstr "Serveren sluttet å videresende trafikken din. Warren bytter server eller kobler til på nytt automatisk."

msgctxt "in-app-notifications"
msgid "This is taking longer than usual. Warren keeps retrying; if it does not connect, report the problem on our community forum."
msgstr "Dette tar lengre tid enn vanlig. Warren fortsetter å prøve. Rapporter problemet på forumet vårt hvis tilkoblingen ikke opprettes."

msgctxt "in-app-notifications"
msgid "TROUBLE CONNECTING?"
msgstr "PROBLEMER MED Å KOBLE TIL?"

msgctxt "in-app-notifications"
msgid "Your device is offline. Warren will reconnect automatically as soon as the network is back."
msgstr "Enheten din er frakoblet. Warren kobler til automatisk igjen så snart nettverket er tilbake."

msgctxt "in-app-notifications"
msgid "Your forwarded port is busy on every alternative server, so Warren kept you on the current one. Expect a brief interruption while it updates."
msgstr "Den videresendte porten din er opptatt på alle alternative servere, så Warren beholdt deg på den nåværende. Forvent et kort avbrudd mens den oppdateres."

msgctxt "in-app-notifications"
msgid "Your Warren time renews in the next days. You can turn it off anytime in Account settings."
msgstr "Warren-tiden din fornyes i løpet av de nærmeste dagene. Du kan slå det av når som helst i Kontoinnstillinger."

#. Status text app is trying to connect to the system service.
msgctxt "launch-view"
msgid "Connecting to Warren system service..."
msgstr "Kobler til Warrens systemtjeneste ..."

#. Button label for opening dialog with troubleshooting details.
msgctxt "launch-view"
msgid "Details"
msgstr "Detaljer"

#. List item in troubleshooting modal advising user disable third party antivirus.
msgctxt "launch-view"
msgid "Disabling third party antivirus software"
msgstr "Deaktiverer antivirusprogramvare fra tredjepart"

#. Status text shown when app fails to start.
msgctxt "launch-view"
msgid "Failed to start the app, please try again or click “Details” for more info"
msgstr "Kunne ikke starte appen. Prøv igjen eller klikk på «Detaljer» for mer informasjon"

#. Message in launch view when another account on this computer set up Warren, so the daemon refuses this one.
msgctxt "launch-view"
msgid "Only the account that set Warren up, or an administrator, can use it here."
msgstr "Bare kontoen som satte opp Warren, eller en administrator, kan bruke det her."

#. Message in launch view when Warren was set up on this computer before it recorded an owner, and this account is not the one at the computer's own screen.
msgctxt "launch-view"
msgid "Open Warren from the account signed in at this computer’s own screen to become its owner, or ask an administrator."
msgstr "Åpne Warren fra kontoen som er logget på datamaskinens egen skjerm for å bli eieren, eller spør en administrator."

#. Status text when Warren was set up on this computer before it recorded an owner, and this account may not take it over.
msgctxt "launch-view"
msgid "Warren on this computer has no owner yet"
msgstr "Warren på denne datamaskinen har ingen eier ennå"

#. Status text when another account on this computer set up Warren, so the daemon refuses this one.
msgctxt "launch-view"
msgid "Warren is set up by another account on this computer"
msgstr "Warren er satt opp av en annen konto på denne datamaskinen"

#. Message in launch view when the background process permissions have been revoked.
msgctxt "launch-view"
msgid "Permission for the Warren VPN service has been revoked. Please go to System Settings and allow Warren VPN under the “Allow in the Background” setting."
msgstr "Tillatelsen til Warren VPN-tjenesten er trukket tilbake. Gå til Systeminnstillinger og gi tillatelse til Warren VPN under innstillingen «Tillat i bakgrunnen»."

#. List item in troubleshooting modal advising user to reinstall the app.
msgctxt "launch-view"
msgid "Reinstalling the app"
msgstr "Installere appen på nytt"

#. List item in troubleshooting modal advising user to restart background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process"
msgstr "Starte Warren-bakgrunnsprosessen på nytt"

#. List item in troubleshooting modal instructing user how to restart the background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process by clicking \"Back\", then \"Try again\""
msgstr "Starte Warren-bakgrunnsprosessen på nytt ved å klikke på «Tilbake» og deretter «Prøv igjen»"

#. List item in troubleshooting modal advising user to restart their computer.
msgctxt "launch-view"
msgid "Restarting your computer"
msgstr "Starte datamaskinen på nytt"

#. Status text shown when app is starting.
msgctxt "launch-view"
msgid "Starting up...."
msgstr "Starter …"

#. Message in troubleshooting modal when the background process failed to start.
msgctxt "launch-view"
msgid "The Warren background process failed to start. The background process is responsible for the security, kill switch, and the VPN tunnel. Please try:"
msgstr "Warren-bakgrunnsprosessen kunne ikke starte. Bakgrunnsprosessen er ansvarlig for sikkerheten, avbruddsbryteren og VPN-tunnelen. Prøv:"

#. Button label for trying to restart the daemon again.
msgctxt "launch-view"
msgid "Try again"
msgstr "Prøv igjen"

#. Message in troubleshooting modal pointing the user to the community forum if the steps do not work.
msgctxt "launch-view"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Hvis disse trinnene ikke løser noe, kan du rapportere problemet på forumet vårt."

#. Button label on the launch view that lifts the failsafe
#. firewall block when the system service cannot be reached,
#. restoring internet access without VPN protection.
msgctxt "launch-view"
msgid "Restore internet without VPN"
msgstr "Gjenopprett internett uten VPN"

#. Message in launch view when the mullvad service cannot be contacted.
msgctxt "launch-view"
msgid "Unable to contact the Warren system service, your connection might be unsecure. Please troubleshoot by clicking the \"Learn more\" button, or report the problem on our community forum."
msgstr "Kunne ikke kontakte Warren-systemtjenesten. Tilkoblingen din kan være usikker. Feilsøk ved å trykke på «Finn ut mer», eller rapporter problemet på forumet vårt."

msgctxt "launch-view"
msgid "Warren VPN will restore internet access without VPN protection."
msgstr "Warren VPN gjenoppretter internettilgangen uten VPN-beskyttelse."

#. Button label opening the community forum to report a problem.
msgctxt "launch-view"
msgid "Report on the forum"
msgstr "Rapporter på forumet"

#. This is used for appending information about a location.
#. E.g. "Gothenburg (Entry)" if Gothenburg has been selected as the entrypoint.
#. Available placeholders:
#. %(location)s - Translated location name
#. %(info)s - Information about the location
msgctxt "locations-feature"
msgid "%(location)s (%(info)s)"
msgstr "%(location)s (%(info)s)"

msgctxt "locations-feature"
msgid "Disabling recents will also clear history."
msgstr "Historikken slettes også hvis du deaktiverer nylige."

msgctxt "locations-feature"
msgid "Entry"
msgstr "Inngang"

msgctxt "locations-feature"
msgid "Exit"
msgstr "Utgang"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
#. Available placeholder:
#. %(lockdownModeSettingName)s - The translation of "Lockdown mode"
msgctxt "login-view"
msgid "<b>%(lockdownModeSettingName)s</b> is enabled. Disable it to unblock your connection."
msgstr "<b>%(lockdownModeSettingName)s</b> er aktivert. Deaktiver den for å fjerne blokkeringen av tilkoblingen."

#. Text in button that allows user to create a new account.
msgctxt "login-view"
msgid "Create a new account"
msgstr "Opprett en ny konto"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
msgctxt "login-view"
msgid "Our kill switch is currently blocking your connection."
msgstr "Vår avbruddsbryter blokkerer tilkoblingen din for øyeblikket."

msgctxt "login-view"
msgid "Upgrading..."
msgstr "Oppgraderer …"

#. Error when a recovery phrase could not be restored for a reason that has nothing to do with its words, such as no connection to Warren.
msgctxt "login-view"
msgid "Warren could not restore your account right now. Check your internet connection and try again."
msgstr "Warren kunne ikke gjenopprette kontoen din akkurat nå. Sjekk internettilkoblingen og prøv igjen."

#. Title label in navigation bar
msgctxt "navigation-bar"
msgid "API access"
msgstr "API-tilgang"

msgctxt "network-stats"
msgid "High load"
msgstr "Høy belastning"

msgctxt "network-stats"
msgid "Live figures appear once %(threshold)d people share an exit, so no one’s traffic can be singled out."
msgstr "Sanntidstall vises så snart %(threshold)d personer deler en utgangsserver, slik at ingens trafikk kan pekes ut."

msgctxt "network-stats"
msgid "Load %(load)s, %(people)s people"
msgstr "Belastning %(load)s, %(people)s personer"

msgctxt "network-stats"
msgid "Load unknown"
msgstr "Ukjent belastning"

msgctxt "network-stats"
msgid "Low load"
msgstr "Lav belastning"

msgctxt "network-stats"
msgid "Moderate load"
msgstr "Moderat belastning"

msgctxt "network-stats"
msgid "Offline"
msgstr "Frakoblet"

msgctxt "network-stats"
msgid "Saturated"
msgstr "Mettet"

msgctxt "network-stats"
msgid "%(band)s, %(people)s people"
msgstr "%(band)s, %(people)s personer"

#. The system notification displayed to the user when the account credit is close to expiry.
#. Available placeholder:
#. %(duration)s - remaining time, e.g. "2 days"
msgctxt "notifications"
msgid "Account credit expires in %(duration)s. Buy more credit."
msgstr "Kontokreditten utløper om %(duration)s. Kjøp mer kreditt."

msgctxt "notifications"
msgid "Account is out of time"
msgstr "Kontoen har ikke mer tid"

msgctxt "notifications"
msgid "App is out of sync. Please quit and restart."
msgstr "Appen er ikke synkronisert. Avslutt og start på nytt."

#. The system notification that notifies the user when a beta update is
#. available.
#. Available placeholders:
#. %(version)s - The version number of the new beta version.
msgctxt "notifications"
msgid "Beta update available. Try out the newest beta version (%(version)s)."
msgstr "Betaoppdatering tilgjengelig. Prøv vår nyeste betaversjon (%(version)s)."

msgctxt "notifications"
msgid "Buy more"
msgstr "Kjøp mer"

msgctxt "notifications"
msgid "Connected"
msgstr "Tilkoblet"

#. The message showed when a server has been connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connected to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connected to %(location)s"
msgstr "Koblet til %(location)s"

msgctxt "notifications"
msgid "Connecting"
msgstr "Kobler til"

#. The message showed when a server is being connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connecting to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connecting to %(location)s"
msgstr "Kobler til %(location)s"

msgctxt "notifications"
msgid "Connection might be unsecured. App lost contact with system service, please troubleshoot."
msgstr "Tilkoblingen kan være usikker. Appen mistet kontakt med systemtjenesten. Prøv feilsøking."

msgctxt "notifications"
msgid "Could not configure IPv6. Disable it in the app or enable it on your device."
msgstr "Kunne ikke konfigurere IPv6. Deaktiver den i appen eller aktiver den på enheten din."

msgctxt "notifications"
msgid "Disconnected and unsecure"
msgstr "Frakoblet og usikret"

msgctxt "notifications"
msgid "Failed to enable split tunneling."
msgstr "Kunne ikke aktivere delt tunnelering."

msgctxt "notifications"
msgid "Failed to enable split tunneling. Please try reconnecting or disable split tunneling."
msgstr "Kunne ikke aktivere delt tunnelering. Prøv å koble til på nytt eller deaktivere delt tunnelering."

#. Label for the system notification when the app encountered an error
#. and will block network traffic until the error is resolved.
#. Label for the in-app banner when the app encountered an error
msgctxt "notifications"
msgid "Failed to start %(splitTunneling)s. To unblock network traffic, disable split tunneling."
msgstr "Kunne ikke starte %(splitTunneling)s. For å blokkere nettverkstrafikk må du deaktivere split tunneling."

#. Label for notification when IPv4 is not available.
msgctxt "notifications"
msgid "IPv4 is not available, please try changing Device IP version setting."
msgstr "IPv4 er ikke tilgjengelig. Prøv å endre innstillingen Enhetens IP-versjon."

#. Label for notification when IPv6 is not available.
msgctxt "notifications"
msgid "IPv6 is not available, please try changing Device IP version setting."
msgstr "IPv6 er ikke tilgjengelig. Prøv å endre innstillingen Enhetens IP-versjon."

msgctxt "notifications"
msgid "Lockdown mode active, connection blocked"
msgstr "Låsemodus aktivert, tilkobling blokkert"

msgctxt "notifications"
msgid "No servers match your settings, try changing server or other settings."
msgstr "Ingen servere passer til innstillingene dine. Prøv å endre server eller andre innstillinger."

msgctxt "notifications"
msgid "Open port forwarding"
msgstr "Åpne portvideresending"

#. A link in the in-app banner to encourage the user to update the app.
#. The in-app banner is is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Please click here to update now"
msgstr "Klikk her for å oppdatere nå"

msgctxt "notifications"
msgid "Port forwarding: public port %(port)d is no longer open"
msgstr "Portvideresending: Den offentlige porten %(port)d er ikke lenger åpen"

msgctxt "notifications"
msgid "Port forwarding: public port %(port)d is open"
msgstr "Portvideresending: Den offentlige porten %(port)d er åpen"

msgctxt "notifications"
msgid "Reconnecting"
msgstr "Kobler til på nytt"

msgctxt "notifications"
msgid "The apps excluded with %(splitTunneling)s might not work properly right now."
msgstr "Appene som er ekskludert med %(splitTunneling)s fungerer kanskje ikke på riktig måte akkurat nå."

msgctxt "notifications"
msgid "Unable to apply firewall rules."
msgstr "Kunne ikke bruke brannmurregler."

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try temporarily disabling any third-party antivirus or security software."
msgstr "Kunne ikke bruke brannmurregler. Forsøk midlertidig deaktivering av eventuelle tredjeparts antivirus eller sikkerhetsprogramvarer."

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try updating your kernel."
msgstr "Kunne ikke bruke brannmurregler. Forsøk å oppdatere operativsystemet ditt."

msgctxt "notifications"
msgid "Unable to resolve host of custom tunnel. Try changing your settings."
msgstr "Kunne ikke løse vert for egendefinert tunnel. Forsøk å endre innstillingene dine."

msgctxt "notifications"
msgid "Unable to start tunnel connection. This could be because of conflicts with VMware, please troubleshoot."
msgstr "Kunne ikke opprette tunneltilkobling. Årsaken kan være konflikter med VMware. Prøv feilsøking."

msgctxt "notifications"
msgid "Update available. Install the latest app version to stay up to date"
msgstr "Oppdatering tilgjengelig. Installer den siste appversjonen for å holde deg oppdatert"

msgctxt "notifications"
msgid "Upgrade"
msgstr "Oppgrader"

msgctxt "notifications"
msgid "Your device is offline. The tunnel will automatically connect once your device is back online."
msgstr "Enheten er frakoblet. Tunnelen vil koble til automatisk når enheten er tilkoblet internett igjen."

#. The in-app banner which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version."
msgstr "Personvernet ditt kan være i fare med denne ustøttede appversjonen."

#. The system notification which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version. Please update now."
msgstr "Personvernet ditt kan være i fare med denne appversjonen som ikke støttes. Oppdater nå."

msgctxt "notifications"
msgid "Automatic renewal charged: 1 month will be added to your Warren time. You can turn auto-renewal off anytime in Account settings."
msgstr "Automatisk fornyelse er belastet: 1 måned legges til Warren-tiden din. Du kan slå av automatisk fornyelse når som helst i Kontoinnstillinger."

msgctxt "notifications"
msgid "Automatic renewal failed. Update your payment method or buy credit manually."
msgstr "Den automatiske fornyelsen mislyktes. Oppdater betalingsmåten din eller kjøp kreditt manuelt."

msgctxt "notifications"
msgid "Automatic renewal has been turned off for this account."
msgstr "Automatisk fornyelse er slått av for denne kontoen."

msgctxt "notifications"
msgid "Unable to block all network traffic. Please troubleshoot or report the problem on our community forum."
msgstr "Kunne ikke blokkere all nettverkstrafikk. Feilsøk eller rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try temporarily disabling any third-party antivirus or security software, or report the problem on our community forum."
msgstr "Kunne ikke blokkere all nettverkstrafikk. Prøv å deaktivere antivirus- eller sikkerhetsprogrammer fra tredjeparter midlertidig, eller rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try updating your kernel or report the problem on our community forum."
msgstr "Kunne ikke blokkere all nettverkstrafikk. Prøv å oppdatere kjernen din eller rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or report the problem on our community forum."
msgstr "Kunne ikke kommunisere med Warren-kjernedriveren. Prøv å koble til på nytt eller rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Unable to set system DNS server. Please report the problem on our community forum."
msgstr "Kunne ikke angi DNS-server for systemet. Rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please report the problem on our community forum."
msgstr "Kunne ikke starte tunneltilkobling. Rapporter problemet på forumet vårt."

msgctxt "notifications"
msgid "Your bank asks for a confirmation to renew. Open Warren and buy credit to confirm."
msgstr "Banken din ber om en bekreftelse av fornyelsen. Åpne Warren og kjøp kreditt for å bekrefte."

msgctxt "notifications"
msgid "Your network looks unstable: the tunnel reconnected too many times in a row. Reconnect once your connection has settled."
msgstr "Nettverket ditt virker ustabilt: tunnelen har koblet til på nytt for mange ganger på rad. Koble til igjen når tilkoblingen har stabilisert seg."

#. The 30-day advance notice before an automatic renewal charge.
#. Available placeholder:
#. %(date)s - the renewal date
msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at the monthly rate. You can turn auto-renewal off anytime in Account settings."
msgstr "Warren-tiden din fornyes automatisk rundt %(date)s til månedsprisen. Du kan slå av automatisk fornyelse når som helst i Kontoinnstillinger."

msgctxt "notifications"
msgid "Your Warren time renews in the next days. You can turn auto-renewal off anytime in Account settings."
msgstr "Warren-tiden din fornyes i løpet av de nærmeste dagene. Du kan slå av automatisk fornyelse når som helst i Kontoinnstillinger."

