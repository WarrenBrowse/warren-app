msgstr "klokken på denne enheten går feil, slå på automatisk tid"

msgctxt "port-forwarding-view"
msgid "the clock of this device is %(seconds)d s ahead, turn on automatic time"
msgstr "klokken på denne enheten går %(seconds)d s for fort, slå på automatisk tid"

