msgid "the clock of this device is %(seconds)d s behind, turn on automatic time"
msgstr "klokken på denne enheten går %(seconds)d s for sakte, slå på automatisk tid"

msgctxt "port-forwarding-view"
msgid "other"
msgstr "annet"

msgctxt "port-forwarding-view"
msgid "phishing"
msgstr "phishing"

msgctxt "port-forwarding-view"
msgid "Port %(port)d was closed after an abuse report. %(client)s keeps its port until you apply one."
msgstr "Port %(port)d ble stengt etter en misbruksrapport. %(client)s beholder porten sin til du tar i bruk en ny."

msgctxt "port-forwarding-view"
msgid "refused, retrying"
msgstr "avvist, prøver på nytt"

msgctxt "port-forwarding-view"
msgid "scanning or intrusion"
msgstr "skanning eller inntrenging"

msgctxt "port-forwarding-view"
msgid "spam"
msgstr "spam"

msgctxt "port-forwarding-view"
msgid "To contest a warning, write to %(email)s quoting its case reference."
msgstr "For å bestride en advarsel, skriv til %(email)s og oppgi saksreferansen."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d of %(threshold)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Advarsel %(ordinal)d av %(threshold)d: port %(port)d ble stengt %(day)s etter en misbruksrapport (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Advarsel %(ordinal)d: port %(port)d ble stengt %(day)s etter en misbruksrapport (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warnings"
msgstr "Advarsler"

msgctxt "port-forwarding-view"
msgid "Warnings and how to contest them"
msgstr "Advarsler og hvordan du bestrider dem"

msgctxt "redeem-voucher-view"
msgid "The voucher was not used: keep it and redeem it once the revocation ends."
msgstr "Kupongen ble ikke brukt: ta vare på den og løs den inn når tilbakekallingen er over."

