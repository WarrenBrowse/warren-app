msgstr "tämän laitteen kello on väärässä, ota automaattinen aika käyttöön"

msgctxt "port-forwarding-view"
msgid "the clock of this device is %(seconds)d s ahead, turn on automatic time"
msgstr "tämän laitteen kello on %(seconds)d s edellä, ota automaattinen aika käyttöön"

msgctxt "port-forwarding-view"
msgid "the clock of this device is %(seconds)d s behind, turn on automatic time"
msgstr "tämän laitteen kello on %(seconds)d s jäljessä, ota automaattinen aika käyttöön"

msgctxt "port-forwarding-view"
msgid "other"
msgstr "muu"

msgctxt "port-forwarding-view"
msgid "phishing"
msgstr "phishing"

msgctxt "port-forwarding-view"
msgid "Port %(port)d was closed after an abuse report. %(client)s keeps its port until you apply one."
msgstr "Portti %(port)d suljettiin väärinkäyttöilmoituksen jälkeen. %(client)s säilyttää porttinsa, kunnes otat uuden käyttöön."

msgctxt "port-forwarding-view"
msgid "refused, retrying"
msgstr "hylätty, yritetään uudelleen"

msgctxt "port-forwarding-view"
msgid "scanning or intrusion"
msgstr "skannaus tai tunkeutuminen"

msgctxt "port-forwarding-view"
msgid "spam"
msgstr "spam"

msgctxt "port-forwarding-view"
msgid "To contest a warning, write to %(email)s quoting its case reference."
msgstr "Voit riitauttaa varoituksen kirjoittamalla osoitteeseen %(email)s ja mainitsemalla tapauksen viitteen."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d of %(threshold)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Varoitus %(ordinal)d/%(threshold)d: portti %(port)d suljettiin %(day)s väärinkäyttöilmoituksen jälkeen (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Varoitus %(ordinal)d: portti %(port)d suljettiin %(day)s väärinkäyttöilmoituksen jälkeen (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warnings"
msgstr "Varoitukset"

msgctxt "port-forwarding-view"
msgid "Warnings and how to contest them"
msgstr "Varoitukset ja niiden riitauttaminen"

msgctxt "redeem-voucher-view"
msgid "The voucher was not used: keep it and redeem it once the revocation ends."
msgstr "Kuponkia ei käytetty: säilytä se ja lunasta se, kun käyttöoikeuden peruutus päättyy."

msgctxt "list-format"
msgid ", "
msgstr ", "

msgctxt "connect-view"
msgid "%(country)s, %(city)s"
msgstr "%(country)s, %(city)s"

msgctxt "vpn-settings-view"
msgid "Shared networks"
msgstr "Jaetut verkot"

msgctxt "vpn-settings-view"
msgid "%(count)d network"
msgid_plural "%(count)d networks"
msgstr[0] "%(count)d verkko"
msgstr[1] "%(count)d verkkoa"

