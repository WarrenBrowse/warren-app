msgid "%(suggestedUpgradeVersion)s is ready to be installed."
msgstr "%(suggestedUpgradeVersion)s on valmis asennettavaksi."

msgctxt "in-app-notifications"
msgid "<a>%(lockdownModeSettingName)s</a> is enabled. Please click “Connect“ or disable “%(lockdownModeSettingName)s“ to unblock internet."
msgstr "<a>%(lockdownModeSettingName)s</a> on käytössä. Poista internetin esto napsauttamalla Yhdistä tai poistamalla %(lockdownModeSettingName)s käytöstä."

msgctxt "in-app-notifications"
msgid "ACCESS REVOKED"
msgstr "KÄYTTÖOIKEUS PERUTTU"

msgctxt "in-app-notifications"
msgid "ACCOUNT CREDIT EXPIRES SOON"
msgstr "TILIN KÄYTTÖAIKA PÄÄTTYY PIAN"

