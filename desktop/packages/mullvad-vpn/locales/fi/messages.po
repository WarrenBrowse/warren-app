msgstr "Heikentynyt niputus (%(stalled)s/%(bonded)s)"

msgctxt "in-app-notifications"
msgid "%(product)s has taken priority on this device, so this build disconnected and turned its kill switch off."
msgstr "%(product)s on saanut etusijan tässä laitteessa, joten tämä versio katkaisi yhteyden ja poisti tappokytkimensä käytöstä."

msgctxt "in-app-notifications"
msgid "%(product)s holds the tunnel on this device. It stands down on its own as soon as you connect here."
msgstr "%(product)s käyttää tunnelia tässä laitteessa. Se väistyy automaattisesti heti, kun yhdistät tästä versiosta."

msgctxt "in-app-notifications"
msgid "ANOTHER BUILD IS CONNECTED"
msgstr "TOINEN VERSIO ON YHDISTETTY"

msgctxt "in-app-notifications"
msgid "Bring this build back"
msgstr "Ota tämä versio takaisin käyttöön"

msgctxt "in-app-notifications"
msgid "Bring this build back."
msgstr "Ota tämä versio takaisin käyttöön."

msgctxt "in-app-notifications"
msgid "PORT FORWARDING WARNING"
msgstr "PORTTIOHJAUKSEN VAROITUS"

msgctxt "in-app-notifications"
msgid "RECONNECTED AFTER A CRASH"
msgstr "YHDISTETTY UUDELLEEN KAATUMISEN JÄLKEEN"

msgctxt "in-app-notifications"
msgid "STANDING BY"
msgstr "ODOTUSTILASSA"

msgctxt "in-app-notifications"
msgid "You can bring it back once %(product)s is disconnected."
msgstr "Voit ottaa sen takaisin käyttöön, kun %(product)s on katkaissut yhteytensä."

msgctxt "in-app-notifications"
msgid "Your device did not shut down cleanly, so Warren restored your previous connection. Neither auto-connect nor launch on start-up is on. Disconnect if you did not want this."
msgstr "Laitteesi ei sammunut asianmukaisesti, joten Warren palautti edellisen yhteytesi. Automaattinen yhteys ja sovelluksen käynnistys järjestelmän käynnistyessä ovat kumpikin pois käytöstä. Katkaise yhteys, jos et halunnut tätä."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse until %(date)s."
msgstr "Käyttöoikeus peruttu porttiohjauksen väärinkäytön vuoksi %(date)s asti."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse."
msgstr "Käyttöoikeus peruttu porttiohjauksen väärinkäytön vuoksi."

msgctxt "port-forwarding-view"
msgid "Access revoked until %(date)s."
msgstr "Käyttöoikeus peruttu %(date)s asti."

