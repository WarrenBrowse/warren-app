msgstr "Odotetaan vapaata reittiä"

msgctxt "split-tunneling-view"
msgid "This network reaches no entry server"
msgstr "Tämä verkko ei tavoita yhtään sisääntulopalvelinta"

msgctxt "split-tunneling-view"
msgid "Enabled \"Full disk access\" and still having issues?"
msgstr "Oletko sallinut koko levyn käytön, mutta kohtaat edelleen ongelmia?"

#. Button label for browsing applications with split tunneling.
msgctxt "split-tunneling-view"
msgid "Find another app"
msgstr "Etsi jokin muu sovellus"

msgctxt "split-tunneling-view"
msgid "Flatpak apps cannot use a country yet"
msgstr "Flatpak-sovellukset eivät vielä voi käyttää omaa maata"

msgctxt "split-tunneling-view"
msgid "In use"
msgstr "Käytössä"

msgctxt "split-tunneling-view"
msgid "No server there"
msgstr "Sijainnissa ei palvelimia"

msgctxt "split-tunneling-view"
msgid "No session token left"
msgstr "Ei istuntotunnuksia jäljellä"

msgctxt "split-tunneling-view"
msgid "Off, uses the main connection"
msgstr "Pois päältä, käyttää pääyhteyttä"

msgctxt "split-tunneling-view"
msgid "Open System Settings"
msgstr "Avaa järjestelmäasetukset"

msgctxt "split-tunneling-view"
msgid "Opens through a script: pick its program with Find another app"
msgstr "Avautuu skriptin kautta: valitse sen ohjelma painikkeella \"Etsi jokin muu sovellus\""

#. This error message is shown if the user tries to launch a Linux desktop
#. entry file that doesn't contain the required 'Exec' value.
msgctxt "split-tunneling-view"
msgid "Please send a problem report."
msgstr "Lähetä ongelmaraportti."

#. This error message is shown if the user tries to launch an app that
#. doesn't exist.
#. This error message is shown if an application fails during startup.
msgctxt "split-tunneling-view"
msgid "Please try again or send a problem report."
msgstr "Yritä uudelleen tai lähetä ongelmaraportti."

msgctxt "split-tunneling-view"
msgid "Restart Warren Service"
msgstr "Käynnistä Warren Service uudelleen"

msgctxt "split-tunneling-view"
msgid "Snap apps cannot use a country yet"
msgstr "Snap-sovellukset eivät vielä voi käyttää omaa maata"

#. Information about split tunneling being unavailable due to
#. missing support in the user's operating system.
#. Available placeholders:
#. %(splitTunneling)s - will be replaced with Split tunneling
msgctxt "split-tunneling-view"
msgid "To use %(splitTunneling)s, please update to a Linux kernel version that supports cgroup v2."
msgstr "%(splitTunneling)s on käytettävissä, kun päivität cgroup v2:ta tukevaan Linuxin ydinversioon."

msgctxt "split-tunneling-view"
msgid "To use this, enable “Full disk access” for “Warren VPN” in the macOS system settings."
msgstr "Jos haluat käyttää tätä, salli koko levyn käyttö \"Warren VPN\" -kohdassa macOS-järjestelmäasetuksissa."

#. Error message showed in a dialog when an application fails to launch.
msgctxt "split-tunneling-view"
msgid "Unable to launch selection. %(detailedErrorMessage)s"
msgstr "Valinnan käynnistäminen ei onnistu. %(detailedErrorMessage)s"

msgctxt "split-tunneling-view"
msgid "Unavailable"
msgstr "Ei saatavilla"

msgctxt "split-tunneling-view"
msgid "Waiting for the VPN"
msgstr "Odotetaan VPN:ää"

msgctxt "split-tunneling-view"
msgid "%(application)s, %(route)s"
msgstr "%(application)s, %(route)s"

msgctxt "split-tunneling-view"
msgid "Add an app"
msgstr "Lisää sovellus"

msgctxt "split-tunneling-view"
msgid "All apps are protected by the VPN, except for the rules below."
msgstr "Kaikki sovellukset ovat VPN:n suojaamia, paitsi alla olevat säännöt."

msgctxt "split-tunneling-view"
msgid "App"
msgstr "Sovellus"

msgctxt "split-tunneling-view"
msgid "Choose an exit country"
msgstr "Valitse lähtömaa"

msgctxt "split-tunneling-view"
msgid "Choose where each app goes."
msgstr "Valitse, mitä kautta kukin sovellus kulkee."

msgctxt "split-tunneling-view"
msgid "Country of your main connection"
msgstr "Pääyhteytesi maa"

msgctxt "split-tunneling-view"
msgid "Default"
msgstr "Oletus"

msgctxt "split-tunneling-view"
msgid "Direct connection by default. Only the apps below use the VPN."
msgstr "Oletuksena suora yhteys. Vain alla olevat sovellukset käyttävät VPN:ää."

msgctxt "split-tunneling-view"
msgid "Direct connection, your real IP is visible"
msgstr "Suora yhteys, todellinen IP-osoitteesi näkyy"

msgctxt "split-tunneling-view"
msgid "Done"
msgstr "Valmis"

msgctxt "split-tunneling-view"
msgid "It uses this country when you open it with “Open through the VPN”."
msgstr "Se käyttää tätä maata, kun avaat sen toiminnolla ”Avaa VPN:n kautta”."

msgctxt "split-tunneling-view"
msgid "Needs Full Disk Access"
msgstr "Vaatii täyden levyn käyttöoikeuden"

msgctxt "split-tunneling-view"
msgid "Needs a signed build of Warren VPN"
msgstr "Vaatii Warren VPN:n allekirjoitetun version"

msgctxt "split-tunneling-view"
msgid "Needs macOS 13 or newer"
msgstr "Vaatii macOS 13:n tai uudemman"

msgctxt "split-tunneling-view"
msgid "No app uses the VPN. Add one, or send the other apps through the VPN again."
msgstr "Mikään sovellus ei käytä VPN:ää. Lisää sovellus tai ohjaa muut sovellukset taas VPN:n kautta."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to open it through the VPN: it uses the VPN until you close it."
msgstr "Ei sääntöjä. Lisää sovellus avataksesi sen VPN:n kautta: se käyttää VPN:ää, kunnes suljet sen."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to send it through another country or outside the VPN."
msgstr "Ei sääntöjä. Lisää sovellus ohjataksesi sen toisen maan kautta tai VPN:n ohi."

msgctxt "split-tunneling-view"
msgid "Not available on this system"
msgstr "Ei käytettävissä tässä järjestelmässä"

msgctxt "split-tunneling-view"
msgid "Open outside the VPN"
msgstr "Avaa ilman VPN:ää"

msgctxt "split-tunneling-view"
msgid "Open through the VPN"
msgstr "Avaa VPN:n kautta"

msgctxt "split-tunneling-view"
msgid "Other apps go"
msgstr "Muut sovellukset kulkevat"

msgctxt "split-tunneling-view"
msgid "Outside the VPN"
msgstr "Ilman VPN:ää"

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs a signed build of Warren VPN."
msgstr "”Ilman VPN:ää” vaatii Warren VPN:n allekirjoitetun version."

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs macOS 13 or newer."
msgstr "”Ilman VPN:ää” vaatii macOS 13:n tai uudemman."

msgctxt "split-tunneling-view"
msgid "Remove %(application)s from the list"
msgstr "Poista %(application)s luettelosta"

msgctxt "split-tunneling-view"
msgid "Remove the rule"
msgstr "Poista sääntö"

msgctxt "split-tunneling-view"
msgid "Route for %(application)s"
msgstr "Sovelluksen %(application)s reitti"

msgctxt "split-tunneling-view"
msgid "Rules per app"
msgstr "Sovelluskohtaiset säännöt"

msgctxt "split-tunneling-view"
msgid "Through the VPN"
msgstr "VPN:n kautta"

msgctxt "split-tunneling-view"
msgid "Through the VPN, another country"
msgstr "VPN:n kautta, toinen maa"

msgctxt "split-tunneling-view"
msgid "Through the VPN, from this country"
msgstr "VPN:n kautta, tästä maasta"

msgctxt "split-tunneling-view"
msgid "Until you close it. Close it first if it is already open."
msgstr "Kunnes suljet sen. Sulje se ensin, jos se on jo auki."

msgctxt "split-tunneling-view"
msgid "VPN"
msgstr "VPN"

msgctxt "split-tunneling-view"
msgid "Your system cannot send apps outside the VPN."
msgstr "Järjestelmäsi ei voi ohjata sovelluksia VPN:n ohi."

msgctxt "split-tunneling-view"
msgid "Only the apps you choose will use the VPN. The rest of this device will not be protected."
msgstr "Vain valitsemasi sovellukset käyttävät VPN:ää. Muuta tämän laitteen liikennettä ei suojata."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be excluded from the VPN tunnel."
msgstr "Jos sovellus on jo käynnissä, sulje %(applicationName)s ennen sen käynnistämistä täältä. Muuten sitä ei välttämättä suljeta ulos VPN-tunnelista."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not use the VPN."
msgstr "Jos sovellus on jo käynnissä, sulje %(applicationName)s ennen sen käynnistämistä täältä. Muuten se ei välttämättä käytä VPN:ää."

#. Link to the webpage
msgctxt "support-view"
msgid "FAQs & Guides"
msgstr "Usein kysytyt kysymykset ja oppaat"

#. Title label in navigation bar
msgctxt "support-view"
msgid "Support"
msgstr "Tuki"

#. Link to the refund policy webpage
msgctxt "support-view"
msgid "Refund policy"
msgstr "Palautuskäytäntö"

msgctxt "tray-icon-context-menu"
msgid "Disconnected from system service"
msgstr "Yhteys järjestelmäpalveluun katkaistu"

msgctxt "tray-icon-context-menu"
msgid "Open %(appName)s"
msgstr "Avaa %(appName)s"

msgctxt "tray-icon-tooltip"
msgid "%(city)s, %(country)s"
msgstr "%(city)s, %(country)s"

msgctxt "tray-icon-tooltip"
msgid "Connected. %(location)s"
msgstr "Yhdistetty. %(location)s"

msgctxt "tray-icon-tooltip"
msgid "Connecting. %(location)s"
msgstr "Yhdistetään. %(location)s"

msgctxt "troubleshoot"
msgid "Disable split tunneling"
msgstr "Poista split tunneling käytöstä"

msgctxt "troubleshoot"
msgid "Enable “Full Disk Access” for “Warren VPN” in the macOS system settings."
msgstr "Ota käyttöön \"Täysi levyn käyttöoikeus\" Warren VPN:lle macOS:n järjestelmäasetuksista."

msgctxt "troubleshoot"
msgid "Failed to enable split tunneling. This is because the app is missing system permissions. What you can do:"
msgstr "Sovelluskohtaisen yhdistämisen käyttöönotto epäonnistui. Tämä johtuu siitä, että sovellukselta puuttuvat järjestelmän käyttöoikeudet. Mitä voit tehdä:"

msgctxt "troubleshoot"
msgid "If you have installed another VPN then try to uninstall that."
msgstr "Jos olet asentanut toisen VPN:n, kokeile poistaa se."

msgctxt "troubleshoot"
msgid "Make sure you have NF tables support."
msgstr "Varmista, että käytössäsi on Nftables-tuki."

msgctxt "troubleshoot"
msgid "Open system settings"
msgstr "Avaa järjestelmäasetukset"

msgctxt "troubleshoot"
msgid "This error can happen when something other than Warren is actively updating the DNS."
msgstr "Tämä virhe voi tapahtua, kun DNS:ää päivittää aktiivisesti jokin muu instanssi kuin Warren."

msgctxt "troubleshoot"
msgid "This might be caused by an outdated kernel."
msgstr "Ongelma saattaa johtua vanhentuneesta ytimestä."

msgctxt "troubleshoot"
msgid "Try restarting your device."
msgstr "Kokeile käynnistää laitteesi uudelleen."

msgctxt "troubleshoot"
msgid "Try to reinstall VMware."
msgstr "Yritä asentaa VMware uudelleen."

msgctxt "troubleshoot"
msgid "Try to turn Wi-Fi Calling off in the FaceTime app settings and restart the Mac."
msgstr "Yritä poistaa Wi-Fi-puhelut käytöstä FaceTime-sovelluksen asetuksista ja käynnistä Mac uudelleen."

msgctxt "troubleshoot"
msgid "Try to uninstall VMware."
msgstr "Yritä poistaa VMwaren asennus."

msgctxt "troubleshoot"
msgid "Unable to communicate with the split tunnel driver."
msgstr "Viestintä sovelluskohtaisen yhdistämisen ohjaimen kanssa ei onnistu."

msgctxt "troubleshoot"
msgid "Unable to start tunnel connection because of a failure when creating the tunnel device. This is often caused by conflicts with the VMware Bridge Protocol."
msgstr "Tunneliyhteyttä ei voida käynnistää, koska tunnelilaitteen luomisen aikana tapahtui virhe. Tämä johtuu usein ristiriidoista VMwaren siltausprotokollan kanssa."

msgctxt "troubleshoot"
msgid "Uninstall or disable other DNS, networking and ads/website blocking apps."
msgstr "Poista muut DNS:t ja verkot ja mainosten ja verkkosivustojen estosovellukset käytöstä tai poista niiden asennus."

msgctxt "troubleshoot"
msgid "Update your kernel."
msgstr "Päivitä ydin."

msgctxt "troubleshoot"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Jos ongelma ei ratkea näillä ohjeilla, ilmoita siitä foorumillamme."

msgctxt "tunnel-control"
msgid "Connect"
msgstr "Yhdistä"

msgctxt "tunnel-control"
msgid "Only selected apps are protected"
msgstr "Vain valitut sovellukset on suojattu"

#. Bold status title shown when the tunnel is up but the
#. device has no internet connection.
msgctxt "tunnel-control"
msgid "Connection interrupted"
msgstr "Yhteys katkesi"

msgctxt "user-interface-settings-view"
msgid "Enable or disable system notifications. The critical notifications will always be displayed."
msgstr "Salli tai estä järjestelmän ilmoitukset. Tärkeät ilmoitukset näytetään aina."

msgctxt "user-interface-settings-view"
msgid "Enable to move the app around as a free-standing window."
msgstr "Salli sovelluksen siirtäminen itsenäisenä ikkunana."

#. Navigation button to the 'Language' settings view
msgctxt "user-interface-settings-view"
msgid "Language"
msgstr "Kieli"

msgctxt "user-interface-settings-view"
msgid "Monochromatic tray icon"
msgstr "Yksivärinen ilmaisinalueen kuvake"

msgctxt "user-interface-settings-view"
msgid "Notifications"
msgstr "Ilmoitukset"

msgctxt "user-interface-settings-view"
msgid "Show only the tray icon when the app starts."
msgstr "Näytä vain ilmaisinalueen kuvake, kun sovellus käynnistyy."

msgctxt "user-interface-settings-view"
msgid "Start minimized"
msgstr "Käynnistä pienennettynä"

msgctxt "user-interface-settings-view"
msgid "Unpin app from taskbar"
msgstr "Poista sovelluksen kiinnitys tehtäväpalkista"

msgctxt "user-interface-settings-view"
msgid "Use a monochromatic tray icon instead of a colored one."
msgstr "Käytä yksiväristä ilmaisinalueen kuvaketta värillisen asemesta."

#. Title label in navigation bar
msgctxt "user-interface-settings-view"
msgid "User interface settings"
msgstr "Käyttöliittymän asetukset"

msgctxt "vpn-settings-view"
msgid "Add a server"
msgstr "Lisää palvelin"

#. Button label to add a private IP DNS server despite warning.
msgctxt "vpn-settings-view"
msgid "Add anyway"
msgstr "Lisää silti"

#. Label for settings that enables ad blocking.
msgctxt "vpn-settings-view"
msgid "Ads"
msgstr "Mainokset"

#. Label for settings that enables block of adult content.
msgctxt "vpn-settings-view"
msgid "Adult content"
msgstr "Aikuisille suunnattu sisältö"

#. Label for list item that navigates to anti-censorship
#. settings view.
msgctxt "vpn-settings-view"
msgid "Anti-censorship"
msgstr "Sensuurinesto"

msgctxt "vpn-settings-view"
msgid "Attention: enabling this will always require a Warren VPN connection in order to reach the internet."
msgstr "Huomio: jos tämä otetaan käyttöön, verkkoon yhdistäminen vaatii aina Warren VPN -yhteyden."

msgctxt "vpn-settings-view"
msgid "Attention: this setting cannot be used in combination with <b>%(customDnsFeatureName)s</b>"
msgstr "Huomio: <b>%(customDnsFeatureName)s</b> ja tämä asetus eivät voi olla käytössä samanaikaisesti."

msgctxt "vpn-settings-view"
msgid "Auto-connect"
msgstr "Automaattinen yhteys"

msgctxt "vpn-settings-view"
msgid "Automatically connect to a server when the app launches."
msgstr "Muodosta yhteys palvelimeen automaattisesti, kun sovellus avataan."

#. This is displayed when the custom DNS setting is turned on which makes the block
#. ads/trackers settings disabled. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(customDnsFeatureName)s - The name displayed next to the custom DNS toggle.
msgctxt "vpn-settings-view"
msgid "Disable \"%(customDnsFeatureName)s\" below to activate these settings."
msgstr "Poista \"%(customDnsFeatureName)s\" käytöstä alla näiden asetusten aktivoimiseksi."

#. This is displayed when either or both of the block ads/trackers settings are
#. turned on which makes the custom DNS setting disabled.
#. Available placeholders:
#. %(preferencesPageName)s - The page title showed on top in the preferences page.
msgctxt "vpn-settings-view"
msgid "Disable all <b>DNS content blockers</b> above to activate this setting."
msgstr "Voit ottaa asetuksen käyttöön poistamalla ensin kaikki <b>DNS-sisällönestotoiminnot</b> käytöstä yltä."

msgctxt "vpn-settings-view"
msgid "DNS content blockers"
msgstr "DNS-sisällönestotoiminnot"

msgctxt "vpn-settings-view"
msgid "Enable to add at least one DNS server."
msgstr "Ota käyttöön lisätäksesi vähintään yhden DNS-palvelimen."

#. Description of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "Enable to allow IPv6 traffic through the tunnel."
msgstr "Kun tämä on käytössä, IPv6-liikenne sallitaan tunnelin kautta."

msgctxt "vpn-settings-view"
msgid "Enter IP"
msgstr "Anna IP-osoite"

#. Label for settings that enables block of gamling related websites.
msgctxt "vpn-settings-view"
msgid "Gambling"
msgstr "Uhkapelaaminen"

#. Title of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "In-tunnel IPv6"
msgstr "Tunnelin IPv6"

msgctxt "vpn-settings-view"
msgid "IPv4 is always enabled and the majority of websites and applications use this protocol. We do not recommend enabling IPv6 unless you know you need it."
msgstr "IPv4 on aina käytössä, ja suurin osa verkkosivustoista ja sovelluksista käyttää kyseistä protokollaa. Emme suosittele IPv6:n käyttöönottoa, ellet varta vasten tarvitse sitä."

#. A complimentary description for the setting Device IP version,
#. explaining why the user might want to configure the setting.
msgctxt "vpn-settings-view"
msgid "It can be useful when you are aware of problems caused by a certain IP version."
msgstr "Se voi olla hyödyllistä, kun olet tietoinen tietyn IP-version aiheuttamista ongelmista."

msgctxt "vpn-settings-view"
msgid "It does this by allowing network communication outside the tunnel to local multicast and broadcast ranges as well as to and from these private IP ranges:"
msgstr "Ominaisuus siis sallii verkkoviestinnän tunnelin ulkopuolella paikallisille lähetys- ja monilähetysalueille sekä näillä yksityisillä IP-alueilla kumpaankin suuntaan:"

msgctxt "vpn-settings-view"
msgid "Kill switch"
msgstr "Tappokytkin"

msgctxt "vpn-settings-view"
msgid "Launch app on start-up"
msgstr "Käynnistä sovellus, kun järjestelmä käynnistyy"

msgctxt "vpn-settings-view"
msgid "Local network sharing"
msgstr "Paikallisen verkon jakaminen"

msgctxt "vpn-settings-view"
msgid "Lockdown mode"
msgstr "Lukitustila"

#. Label for settings that enables malware blocking.
msgctxt "vpn-settings-view"
msgid "Malware"
msgstr "Haittaohjelmat"

#. Label for settings that enables block of social media.
msgctxt "vpn-settings-view"
msgid "Social media"
msgstr "Sosiaalinen media"

msgctxt "vpn-settings-view"
msgid "The app’s built-in kill switch is always on. This setting will additionally block the internet if clicking Disconnect or Quit."
msgstr "Sovelluksen sisäänrakennettu tappokytkin on aina käytössä. Tämä asetus estää lisäksi verkkoyhteyden, jos katkaiset sovellusyhteyden tai suljet sovelluksen."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents."
msgstr "Tappokytkin eroaa lukitustilasta siten, että se estää vuotoja tapahtumasta automaattisten tunnelin uudelleenyhdistysten, ohjelmistojen kaatumisen ja vastaavien tapahtumien aikana."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents. With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Tappokytkin eroaa lukitustilasta siten, että se estää vuotoja tapahtumasta automaattisten tunnelin uudelleenyhdistysten, ohjelmistojen kaatumisen ja vastaavien tapahtumien aikana. Kun lukitustila puolestaan on käytössä, voit muodostaa yhteyden internetiin ainoastaan Warrenin VPN-palvelimen kautta. Sovelluksen yhteyden manuaalinen katkaiseminen tai sovelluksen sulkeminen estävät verkkoyhteyden muodostamisen."

msgctxt "vpn-settings-view"
msgid "The DNS server you want to add is a private IP. You must ensure that your network interfaces are configured to use it."
msgstr "DNS-palvelin, jonka haluat lisätä, on yksityinen IP-osoite. Varmista, että verkkoliittymäsi määritykset mahdollistavat palvelimen käytön."

msgctxt "vpn-settings-view"
msgid "This built-in feature prevents your traffic from leaking outside of the VPN tunnel if your network suddenly stops working or if the tunnel fails, it does this by blocking your traffic until your connection is reestablished."
msgstr "Tämä sisäänrakennettu ominaisuus estää liikennettäsi vuotamasta VPN-tunnelin ulkopuolelle, jos verkkosi yhtäkkiä lakkaa toimimasta tai jos tunneli epäonnistuu yhteyden muodostamisessa. Se estää liikenteen, kunnes yhteys on muodostettu uudelleen."

msgctxt "vpn-settings-view"
msgid "This feature allows access to other devices on the local network, such as for sharing, printing, streaming, etc."
msgstr "Tämä ominaisuus mahdollistaa pääsyn muihin paikallisverkon laitteisiin esimerkiksi jakamisen, tulostamisen, suoratoiston jne. tarpeisiin."

#. A description for the setting Device IP version,
#. explaining how the user can configure the setting.
msgctxt "vpn-settings-view"
msgid "This feature allows you to choose whether to use only IPv4, only IPv6, or allow the app to automatically decide the best option when connecting to a server."
msgstr "Tämä ominaisuus antaa sinun valita, käytetäänkö vain IPv4:ää, vain IPv6:ta vai annetaanko sovelluksen päättää paras vaihtoehto automaattisesti, kun se muodostaa yhteyttä palvelimeen."

msgctxt "vpn-settings-view"
msgid "This might cause issues on certain websites, services, and apps."
msgstr "Tämä voi aiheuttaa ongelmia tietyillä verkkosivustoilla, palveluissa ja sovelluksissa."

msgctxt "vpn-settings-view"
msgid "This network cannot be shared."
msgstr "Tätä verkkoa ei voi jakaa."

msgctxt "vpn-settings-view"
msgid "This network is too broad to be shared outside the tunnel."
msgstr "Tämä verkko on liian laaja jaettavaksi tunnelin ulkopuolella."

#. Label for settings that enables tracker blocking.
msgctxt "vpn-settings-view"
msgid "Trackers"
msgstr "Seurantapalvelimet"

msgctxt "vpn-settings-view"
msgid "Traffic to these networks goes outside the VPN tunnel."
msgstr "Liikenne näihin verkkoihin kulkee VPN-tunnelin ulkopuolella."

msgctxt "vpn-settings-view"
msgid "Use custom DNS server"
msgstr "Käytä mukautettua DNS-palvelinta"

#. Title label in navigation bar
msgctxt "vpn-settings-view"
msgid "VPN settings"
msgstr "VPN-asetukset"

msgctxt "vpn-settings-view"
msgid "Warning: The malware blocker is not an anti-virus and should not be treated as such, this is just an extra layer of protection."
msgstr "Varoitus: haittaohjelmien estotoiminto ei ole virustorjuntaohjelma, eikä sitä pidä käyttää sellaisena, kyseessä on vain ylimääräinen suojauskerros."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled it stops the device from contacting certain domains or websites known for distributing ads, malware, trackers and more."
msgstr "Kun tämä ominaisuus on käytössä, se estää laitetta ottamasta yhteyttä tiettyihin verkkotunnuksiin tai -sivustoihin, jotka tunnetaan mainosten, haittaohjelmien, seurantaohjelmien tai muiden vastaavien jakelijoina."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled, IPv6 can be used alongside IPv4 in the VPN tunnel to communicate with internet services."
msgstr "Kun tämä ominaisuus on käytössä, IPv6:ta voidaan käyttää IPv4:n rinnalla VPN-tunnelissa yhteydenpidossa internetpalveluiden kanssa."

msgctxt "vpn-settings-view"
msgid "With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Kun lukitustila on käytössä, voit muodostaa yhteyden internetiin ainoastaan Warrenin VPN-palvelimen kautta. Sovelluksen yhteyden manuaalinen katkaiseminen tai sovelluksen sulkeminen estävät verkkoyhteyden muodostamisen."

#. Value shown for the bandwidth limit in beta builds.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "vpn-settings-view"
msgid "%(mbps)d Mbps"
msgstr "%(mbps)d Mbps"

msgctxt "vpn-settings-view"
msgid "Add a network"
msgstr "Lisää verkko"

#. Feature indicator shown when the advanced "Allow external DNS resolvers"
#. setting is on, i.e. DNS leak protection is relaxed.
msgctxt "vpn-settings-view"
msgid "Allow external DNS"
msgstr "Salli ulkoinen DNS"

#. Label for the advanced setting that allows DNS queries to resolvers
#. other than the configured one.
msgctxt "vpn-settings-view"
msgid "Allow external DNS resolvers"
msgstr "Salli ulkoiset DNS-palvelimet"

#. Hint below the bandwidth limit row in beta builds.
msgctxt "vpn-settings-view"
msgid "Bandwidth is limited by the free beta network and enforced by the servers. This setting is unavailable during the beta."
msgstr "Kaistanleveyttä rajoittaa maksuton beetaverkko, ja palvelimet valvovat rajoitusta. Tämä asetus ei ole käytettävissä beetavaiheen aikana."

msgctxt "vpn-settings-view"
msgid "Connect to a single self-hosted exit you enter manually, bypassing the verified server list. Only use an exit you operate or fully trust: it sees your unencrypted traffic."
msgstr "Yhdistä yhteen itse ylläpitämääsi lähtöpalvelimeen, jonka annat manuaalisesti, ohittaen vahvistetun palvelinluettelon. Käytä vain lähtöpalvelinta, jota ylläpidät itse tai johon luotat täysin: se näkee salaamattoman liikenteesi."

msgctxt "vpn-settings-view"
msgid "Cover domain (optional)"
msgstr "Peitedomeeni (valinnainen)"

msgctxt "vpn-settings-view"
msgid "Custom exit (advanced)"
msgstr "Mukautettu lähtöpalvelin (lisäasetus)"

msgctxt "vpn-settings-view"
msgid "Endpoint"
msgstr "Päätepiste"

msgctxt "vpn-settings-view"
msgid "Enter a network in CIDR notation, such as 192.168.1.0/24 or fd00::/8."
msgstr "Anna verkko CIDR-muodossa, esimerkiksi 192.168.1.0/24 tai fd00::/8."

#. Placeholder of the field where the user types a network to share
#. outside the tunnel, in CIDR notation.
msgctxt "vpn-settings-view"
msgid "Enter a network, e.g. 192.168.1.0/24"
msgstr "Anna verkko, esim. 192.168.1.0/24"

msgctxt "vpn-settings-view"
msgid "Exit address as host:port. Bracket IPv6, for example [2001:db8::1]:443."
msgstr "Lähtöpalvelimen osoite muodossa isäntä:portti. Ympäröi IPv6-osoite hakasulkeilla, esimerkiksi [2001:db8::1]:443."

msgctxt "vpn-settings-view"
msgid "For advanced users. When enabled, the firewall stops blocking DNS queries to resolvers other than the configured one, so tools like \"dig @1.1.1.1\" work while connected."
msgstr "Kokeneille käyttäjille. Kun asetus on käytössä, palomuuri ei enää estä DNS-kyselyitä muille kuin määritetylle nimipalvelimelle, joten esimerkiksi \"dig @1.1.1.1\" toimii yhteyden aikana."

#. The hint displayed below the bandwidth limit input field.
#. Available placeholders:
#. %(max)d - the maximum accepted value in Mbps
#. %(min)d - the minimum accepted value in Mbps
msgctxt "vpn-settings-view"
msgid "Limit the VPN bandwidth in Mbps, applied to upload and download separately. Valid range: %(min)d - %(max)d. Leave empty for no limit. Applies immediately."
msgstr "Rajoita VPN:n kaistanleveyttä (Mbps). Rajoitus koskee lähetystä ja latausta erikseen. Sallittu väli: %(min)d - %(max)d. Jätä tyhjäksi, jos et halua rajoitusta. Tulee voimaan heti."

msgctxt "vpn-settings-view"
msgid "Managed"
msgstr "Hallittu"

#. The title for the bandwidth limit setting.
msgctxt "vpn-settings-view"
msgid "Max bandwidth"
msgstr "Enimmäiskaistanleveys"

msgctxt "vpn-settings-view"
msgid "Set only when the exit runs a public TLS certificate (X.509 mode). Leave empty for the default raw-key mode."
msgstr "Aseta tämä vain, jos lähtöpalvelin käyttää julkista TLS-varmennetta (X.509-tila). Jätä tyhjäksi, jos käytössä on oletusarvoinen raaka-avaintila."

msgctxt "vpn-settings-view"
msgid "The exit’s Ed25519 public key, 64 hexadecimal characters."
msgstr "Lähtöpalvelimen julkinen Ed25519-avain, 64 heksadesimaalimerkkiä."

msgctxt "vpn-settings-view"
msgid "The exit’s routing id, 32 hexadecimal characters."
msgstr "Lähtöpalvelimen reititystunnus, 32 heksadesimaalimerkkiä."

msgctxt "vpn-settings-view"
msgid "The exit’s X25519 multi-hop key, 64 hexadecimal characters."
msgstr "Lähtöpalvelimen X25519-multihop-avain, 64 heksadesimaalimerkkiä."

msgctxt "vpn-settings-view"
msgid "The queries still travel through the VPN tunnel, but the resolver you choose will see them. Leave this off unless you are testing remote DNS resolution."
msgstr "Kyselyt kulkevat edelleen VPN-tunnelin kautta, mutta valitsemasi nimipalvelin näkee ne. Pidä tämä pois päältä, ellet testaa ulkoista DNS-selvitystä."

#. Placeholder shown when no bandwidth limit is set.
msgctxt "vpn-settings-view"
msgid "Unlimited"
msgstr "Rajoittamaton"

msgctxt "vpn-settings-view"
msgid "X25519 multi-hop key"
msgstr "X25519-multihop-avain"

msgctxt "vpn-settings-view"
msgid "Exit ID"
msgstr "Lähtötunnus"

msgctxt "vpn-settings-view"
msgid "Public key"
msgstr "Julkinen avain"

#. Description of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "A prepaid beta access voucher is linked to your account automatically. No payment, nothing to do."
msgstr "Tiliisi liitetään automaattisesti ennakkoon maksettu beetakäyttöoikeuden kuponki. Ei maksua, ei mitään tehtävää."

#. Confirmation that the beta access is active.
#. Available placeholders:
#. %(date)s - the expiry date of the granted access
msgctxt "warren-onboarding"
msgid "Beta access active until %(date)s."
msgstr "Beetakäyttöoikeus voimassa %(date)s asti."

#. Error shown when the beta access could not be activated yet.
msgctxt "warren-onboarding"
msgid "Could not activate the beta access yet (are you online?). Retrying automatically, and again at next launch. You can continue anyway."
msgstr "Beetakäyttöoikeutta ei voitu vielä aktivoida (oletko verkossa?). Yritämme automaattisesti uudelleen ja myös seuraavalla käynnistyksellä. Voit silti jatkaa."

#. Link shown under onboarding errors pointing to the public help page.
msgctxt "warren-onboarding"
msgid "Having trouble? Visit our help page"
msgstr "Ongelmia? Käy ohjesivullamme"

msgctxt "warren-onboarding"
msgid "Retry now"
msgstr "Yritä uudelleen nyt"

#. Beta onboarding line describing the degraded service.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with bandwidth capped at %(mbps)d Mbps. These are not the final service conditions."
msgstr "Beeta toimii maksuttomassa, erillisessä verkossa, jonka kaistanleveys on rajattu arvoon %(mbps)d Mbps. Nämä eivät ole palvelun lopulliset ehdot."

msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with limited bandwidth. These are not the final service conditions."
msgstr "Beeta toimii maksuttomassa, erillisessä verkossa, jonka kaistanleveys on rajallinen. Nämä eivät ole palvelun lopulliset ehdot."

#. Title of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "Your beta access"
msgstr "Beetakäyttöoikeutesi"

msgctxt "warren-pubkey-warning"
msgid "Could not find that exit server anymore. Try reconnecting."
msgstr "Kyseistä lähtöpalvelinta ei enää löydy. Kokeile yhdistää uudelleen."

msgctxt "warren-pubkey-warning"
msgid "Could not save the new key. Please try again."
msgstr "Uuden avaimen tallentaminen ei onnistunut. Yritä uudelleen."

msgctxt "warren-pubkey-warning"
msgid "Could not trust the new key."
msgstr "Uuteen avaimeen ei voitu luottaa."

msgctxt "warren-pubkey-warning"
msgid "The key changed again before it could be trusted. Review the new key and try again."
msgstr "Avain vaihtui uudelleen ennen kuin siihen ehdittiin luottaa. Tarkista uusi avain ja yritä uudelleen."

msgctxt "wireguard-settings-view"
msgid "%(daita)s (%(daitaFull)s) hides patterns in your encrypted VPN traffic."
msgstr "%(daita)s (%(daitaFull)s) piilottaa kuviot salatusta VPN-liikenteestäsi."

msgctxt "wireguard-settings-view"
msgid "By enabling “%(directOnly)s” you will have to manually select a server that is %(daita)s-enabled. This can cause you to end up in a blocked state until you have selected a compatible server in the “Select location” view."
msgstr "Kun \"%(directOnly)s\" otetaan käyttöön, sinun on valittava manuaalisesti palvelin, jossa on %(daita)s-tuki. Tämä voi aiheuttaa sen, että päädyt estettyyn tilaan, kunnes olet valinnut yhteensopivan palvelimen \"Valitse sijainti\" -näkymästä."

msgctxt "wireguard-settings-view"
msgid "Cancel"
msgstr "Peruuta"

#. Title for device IP version setting.
msgctxt "wireguard-settings-view"
msgid "Device IP version"
msgstr "Laitteen IP-versio"

msgctxt "wireguard-settings-view"
msgid "It combines a quantum-safe key exchange with the classical one. When it is on, the app only connects through servers that offer it. When it is off, it is still used wherever a server offers it."
msgstr "Se yhdistää kvanttiturvallisen avaintenvaihdon perinteiseen. Kun se on päällä, sovellus muodostaa yhteyden vain sitä tarjoavien palvelimien kautta. Kun se on pois päältä, sitä käytetään silti aina, kun palvelin tarjoaa sitä."

#. The title for the QUIC MTU setting. MTU stands for Maximum
#. Transmission Unit and controls the maximum size of packets sent over
#. the VPN tunnel.
msgctxt "wireguard-settings-view"
msgid "MTU"
msgstr "MTU"

msgctxt "wireguard-settings-view"
msgid "Multihop is being used to enable DAITA for your selected location"
msgstr "Multihopia käytetään, jotta DAITA on käytettävissä valitsemassasi sijainnissa"

#. Warning text in a dialog that is displayed after a setting is toggled.
msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. In order to use the internet, you might have to select a new location after enabling."
msgstr "Kaikissa palvelimissamme ei ole %(daita)s-tukea. Käyttääksesi internetiä sinun on ehkä valittava uusi sijainti käyttöönoton jälkeen."

#. The title for the QUIC quantum resistance selector. This setting
#. makes the cryptography resistant to the future abilities of quantum
#. computers.
msgctxt "wireguard-settings-view"
msgid "Quantum-resistant tunnel"
msgstr "Kvanttihyökkäyksiä kestävä tunneli"

#. The hint displayed below the QUIC MTU input field.
#. Available placeholders:
#. %(wireguard)s - Will be replaced with the string "QUIC"
#. %(max)d - the maximum possible wireguard mtu value
#. %(min)d - the minimum possible wireguard mtu value
msgctxt "wireguard-settings-view"
msgid "Set %(wireguard)s MTU value. Valid range: %(min)d - %(max)d."
msgstr "Aseta %(wireguard)s MTU -arvo välillä %(min)d-%(max)d."

msgctxt "wireguard-settings-view"
msgid "Shadowsocks"
msgstr "Shadowsocks"

msgctxt "wireguard-settings-view"
msgid "This feature protects your traffic to the exit server against potential attacks from quantum computers."
msgstr "Tämä ominaisuus suojaa poistumispalvelimelle kulkevan liikenteesi kvanttitietokoneiden mahdollisilta hyökkäyksiltä."

msgctxt "wireguard-settings-view"
msgid "UDP-over-TCP"
msgstr "UDP TCP:n kautta"

msgid "Continue"
msgstr "Jatka"

msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "Tulomaa"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "Lähtömaa"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "Odota suunnilleen puolet single-hop-kaistanleveydestä vastineeksi siitä, ettei käyttäjän IP:tä ja kohde-IP:tä voida yhdistää. Oletuksena pois päältä; valinnainen yksityisyyden vuoksi."

msgctxt "warren-multi-hop-view"
msgid "Restart the Warren daemon after changing this setting."
msgstr "Käynnistä Warren-demoni uudelleen tämän asetuksen muuttamisen jälkeen."

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "Reitittää liikenteesi kahden Warren-releen kautta käyttäen HPKE-päästä-päähän-salausta. Tulorele näkee vain salatekstin; lähtörele näkee vain salauksen purkukuorman, ei koskaan IP:täsi. Malli innoittanut Apple Private Relay -palvelusta."

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "Kompromissi: noin puolet single-hop-kaistanleveydestä. Oletuksena pois päältä; valinnainen yksityisyyden vuoksi. Demonin uudelleenkäynnistys vaaditaan tämän asetuksen muuttamisen jälkeen."

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "Warren multi-hop"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "Kun käytössä, liikenne reititetään kahden Warren-releen (tulo ja sitten lähtö) kautta käyttäen HPKE-päästä-päähän-salausta asiakkaan ja lähdön välillä. Tulorele näkee vain salatekstin; lähtörele näkee vain salauksen purkukuorman, ei koskaan käyttäjän IP:tä."

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "Kopioitu leikepöydälle"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "Kopioi leikepöydälle"

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "VPN-kokemus ilman tinkimistä yksityisyydestä. Ei lokeja. Ei tilejä. Ei seurantaa. Vain kaistanleveyttä."

msgctxt "warren-onboarding"
msgid "All set"
msgstr "Kaikki valmista"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "Tarkista uudelleen"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "Tarkistetaan... (napsauta päivittääksesi nyt)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "Määritys valmis. Valitse maa ja yhdistä Warreniin."

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "Jatka"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "Tilauksen tilaa ei voitu tarkistaa. Yritä uudelleen."

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "Demonilla ei ole vielä mnemonista, kirjaudu sisään tai käynnistä sovellus uudelleen."

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Mnemonisen hakeminen demonilta epäonnistui."

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "Aloita"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "Minulla on jo tilaus"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "Olen kirjoittanut sen muistiin turvalliseen paikkaan."

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "Aktiivista tilausta ei löytynyt. Osta sellainen ensin."

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "Valitse maa ja yhdistä"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "Valitse haluamasi suojaukset alusta alkaen. Voit muuttaa kaikkia näitä myöhemmin Asetuksista."

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "Yksityisyysasetukset"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "Ohita ohjattu toiminto (lisäasetukset)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "Näytä tilaukset (avautuu selaimessa)"

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "Tervetuloa Warren VPN:ään"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "Kirjoita nämä 12 sanaa muistiin järjestyksessä ja säilytä ne turvallisessa paikassa. Ne ovat ainoa tapa palauttaa tilauksesi, jos menetät pääsyn tähän laitteeseen."

msgctxt "warren-onboarding"
msgid "You don’t have an active subscription yet. You buy VPN time in advance, with no account to create. If you choose automatic monthly renewal, you can turn it off at any time, at no cost."
msgstr "Sinulla ei ole vielä aktiivista tilausta. Ostat VPN-aikaa etukäteen, eikä tiliä tarvitse luoda. Jos valitset automaattisen kuukausittaisen uusimisen, voit poistaa sen käytöstä milloin tahansa maksutta."

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "Warren-lompakkosi"

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "Tilauksesi"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• Aina päällä oleva hämärrys (oletuksena PÄÄLLÄ): HTTP/3-jäljittely, jotta liikenne sulautuu massaan."

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (oletuksena POIS): lisää täytteen estääkseen ML-liikenneanalyysin. ~5-15 % kaistanleveydestä."

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-hop (oletuksena POIS): reititä kahden releen kautta, jotta tulo- ja lähtöä ei voi yhdistää."

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "Kryptografisen ristiriidan tiedot"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "Lähtötunnus"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "Sijainti"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "Vasta havaittu avain"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "Aiemmin kiinnitetty avain"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "Käsitellään valintaasi, odota."

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "Hylkää (katkaise yhteys)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "Hylkää ja pysy yhteydetön"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "Ilmoita Warrenille"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "Palvelimen identiteetti muuttunut"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "Aiemmin luottamasi Warren-lähtöpalvelin esittää nyt eri kryptografisen identiteetin."

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "Tämä tarkoittaa yleensä, että operaattori on vaihtanut avainta, mutta voi myös merkitä, että palvelin on vaihdettu tai vaarantunut. Hylkää, jos et odottanut muutosta."

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "Luota uuteen avaimeen"

msgctxt "warren-status-view"
msgid "Last"
msgstr "Viimeisin"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "Hämärrys"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "Uudelleenyhdistämiset"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "ei aktiivinen"

msgctxt "warren-status-view"
msgid "never"
msgstr "ei koskaan"

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "Avaa julkisen portin yhdistetyssä poistumispalvelimessa ja välittää sen laitteellesi. Hyödyllinen vertaisverkkosovelluksille, tiedostojen jakamiseen tai itse isännöityihin palveluihin."

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "Porttiohjaus"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "Protokolla"

msgctxt "keys-view"
msgid "Backup keys"
msgstr "Varmuuskopioi avaimet"

msgctxt "keys-view"
msgid "Done"
msgstr "Valmis"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "Syötä 12 sanan (tai 24 sanan) BIP39-palautuslauseesi välilyönnein eroteltuna."

msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Palautuslauseen haku taustapalvelusta epäonnistui."

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "Olen kirjoittanut sen muistiin turvalliseen paikkaan."

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "Ymmärrän, että tämä korvaa nykyisen identiteettini pysyvästi."

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "Identiteetti palautettu. Uusi Warren-lompakkosi on nyt käytössä."

msgctxt "keys-view"
msgid "Keys"
msgstr "Avaimet"

msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "Palautuslausetta ei ole saatavilla. Kirjaudu sisään tai palauta ensin identiteetti."

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "Palauta palautuslauseesta"

msgctxt "keys-view"
msgid "Restore identity"
msgstr "Palauta identiteetti"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "Palautetaan…"

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "Näytä palautuslause"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "VAROITUS: Tämä KORVAA nykyisen identiteettisi. Mitään nykyiseen identiteettiin sidottua tilausta ei voi enää palauttaa."

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "Kirjoita se paperille. Älä koskaan tallenna sitä pilveen, kuvakaappaukseen tai sähköpostiin."

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "12 sanan palautuslauseesi on AINOA tapa palauttaa Warren-identiteettisi toiseen laitteeseen. Jos kadotat sen, tilaustasi ei voi enää palauttaa."

msgctxt "keys-view"
msgid "words"
msgstr "sanaa"

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "Varmuuskopioi lauseeni"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "Olen varmuuskopioinut palautuslauseeni ja ymmärrän, että tämä tili poistetaan tältä laitteelta."

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "Jos et ole varmuuskopioinut palautuslausettasi, tilauksesi menetetään pysyvästi."

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "Kirjaudutaanko ulos tästä tilistä?"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "Uloskirjautuminen poistaa tämän tilin tältä laitteelta. Takaisin kirjautumiseen ei ole sähköpostia eikä salasanaa, palautuslauseesi on AINOA tapa palauttaa se."

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "Varmuuskopioi palautuslauseesi"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "Uutta palautuslausetta ei voitu lukea. Yritä uudelleen."

msgctxt "login-view"
msgid "Discard"
msgstr "Hylkää"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "Hylätäänkö tämä uusi tili?"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "Anna 12 sanan palautuslauseesi välilyönnein eroteltuna palauttaaksesi tilisi tälle laitteelle."

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "Palaa takaisin vain, jos tarkoituksesi oli palauttaa tili, joka sinulla jo on."

msgctxt "login-view"
msgid "I already have an account"
msgstr "Minulla on jo tili"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "Olen kirjoittanut palautuslauseeni muistiin turvalliseen paikkaan."

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "Virheellinen palautuslause. Tarkista sanat ja niiden järjestys ja yritä uudelleen."

msgctxt "login-view"
msgid "Keep it"
msgstr "Säilytä se"

msgctxt "login-view"
msgid "Restore account"
msgstr "Palauta tili"

msgctxt "login-view"
msgid "Restore your account"
msgstr "Palauta tilisi"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "Juuri luotu tili hylätään, eikä sen palautuslausetta näytetä uudelleen."

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren käyttää ei-säilytyksellistä lompakkoa: tilisi on 12 sanan palautuslause, joka on vain sinun hallussasi."

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "Tervetuloa Warreniin"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "Kirjoita nämä 12 sanaa muistiin ja säilytä ne turvallisesti. Ne ovat ainoa tapa palauttaa tilisi, jos menetät tämän laitteen."

msgctxt "connect-view"
msgid "I’ve completed payment"
msgstr "Olen suorittanut maksun"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "Istunto ei ole aktiivinen"

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node’s public key has changed."
msgstr "Palvelimen identiteetin epäjohdonmukaisuus havaittu. Poistumissolmun julkinen avain on muuttunut."

msgid "OK"
msgstr "OK"

msgctxt "accessibility"
msgid "Copy public key"
msgstr "Kopioi julkinen avain"

#. Accessibility label of the control that copies
#. the voucher code to the clipboard.
msgctxt "accessibility"
msgid "Copy the voucher code"
msgstr "Kopioi kuponkikoodi"

msgctxt "account-view"
msgid "Backup keys"
msgstr "Varmuuskopioi avaimet"

msgctxt "account-view"
msgid "Could not log out: the VPN did not disconnect in time. You are still logged in."
msgstr "Uloskirjautuminen epäonnistui: VPN-yhteys ei katkennut ajoissa. Olet yhä kirjautuneena sisään."

msgctxt "account-view"
msgid "Something went wrong while logging out."
msgstr "Uloskirjautumisessa tapahtui virhe."

#. Button that runs a logout again after it failed.
msgctxt "account-view"
msgid "Try again"
msgstr "Yritä uudelleen"

msgctxt "auth-failure"
msgid "Blocking internet: this device has been revoked. Log in again to connect, or disconnect to unblock the internet."
msgstr "Verkkoliikenne estetty: tämän laitteen käyttöoikeus on peruttu. Kirjaudu uudelleen sisään yhdistääksesi, tai katkaise yhteys poistaaksesi Internetin käytön eston."

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "Tarkistetaan… (päivitä napsauttamalla)"

msgctxt "connect-view"
msgid "Here’s your public key. Save it!"
msgstr "Tässä on julkinen avaimesi. Tallenna se!"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "Portin edelleenlähetys: %(ports)s"

msgctxt "connection-info"
msgid "Multihop (2 hops)"
msgstr "Multihop (2 hyppyä)"

msgctxt "in-app-notifications"
msgid "EXIT SWITCHED"
msgstr "POISTUMISPALVELIN VAIHDETTU"

msgctxt "in-app-notifications"
msgid "Your previous exit became unreachable. Warren routed you through an alternative server automatically."
msgstr "Edellinen poistumispalvelimesi muuttui tavoittamattomaksi. Warren reititti sinut automaattisesti vaihtoehtoisen palvelimen kautta."

msgctxt "in-app-notifications"
msgid "Your server is being updated. Warren moved you to another server automatically, no action needed."
msgstr "Palvelintasi päivitetään. Warren siirsi sinut automaattisesti toiselle palvelimelle, ei toimenpiteitä."

msgctxt "port-forwarding-view"
msgid "+ Add a port"
msgstr "+ Lisää portti"

msgctxt "port-forwarding-view"
msgid "Each port you add is opened on the exit and forwarded to the same port on your device. Changes apply immediately, no reconnection needed."
msgstr "Jokainen lisäämäsi portti avataan poistumispalvelimella ja edelleenlähetetään samaan porttiin laitteellasi. Muutokset tulevat voimaan heti, uudelleenyhdistystä ei tarvita."

msgctxt "port-forwarding-view"
msgid "Last port change before a temporary block. Wait a moment before changing it again."
msgstr "Viimeinen portin muutos ennen tilapäistä estoa. Odota hetki ennen seuraavaa muutosta."

msgctxt "port-forwarding-view"
msgid "Maximum of %(max)d ports reached"
msgstr "Enimmäismäärä %(max)d porttia saavutettu"

msgctxt "port-forwarding-view"
msgid "No port yet. Add one to open it on the exit."
msgstr "Ei vielä porttia. Lisää portti avataksesi sen poistumispalvelimella."

msgctxt "port-forwarding-view"
msgid "Port"
msgstr "Portti"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535."
msgstr "Portin on oltava välillä 49152-65535."

msgctxt "port-forwarding-view"
msgid "Remove port"
msgstr "Poista portti"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mappings."
msgstr "Tila: odotetaan aktiivista tunneliyhteyttä porttiohjausten määrittämiseksi."

msgctxt "port-forwarding-view"
msgid "This port is already in your list."
msgstr "Tämä portti on jo luettelossasi."

msgctxt "port-forwarding-view"
msgid "Too many port changes. You can change ports again in %(countdown)s."
msgstr "Liian monta portin muutosta. Voit muuttaa portteja uudelleen %(countdown)s kuluttua."

msgctxt "port-forwarding-view"
msgid "applying…"
msgstr "otetaan käyttöön…"

msgctxt "port-forwarding-view"
msgid "failed"
msgstr "epäonnistui"

msgctxt "port-forwarding-view"
msgid "no port available"
msgstr "ei vapaata porttia"

msgctxt "port-forwarding-view"
msgid "open: %(port)d"
msgstr "auki: %(port)d"

msgctxt "port-forwarding-view"
msgid "pending…"
msgstr "odottaa…"

msgctxt "port-forwarding-view"
msgid "port"
msgstr "portti"

msgctxt "port-forwarding-view"
msgid "port in use"
msgstr "portti käytössä"

msgctxt "port-forwarding-view"
msgid "requesting…"
msgstr "pyydetään…"

msgctxt "redeem-voucher-view"
msgid "It looks like you’ve entered a public key instead of a voucher code. If you would like to change the active account, please log out first."
msgstr "Näyttää siltä, että syötit julkisen avaimen lahjakorttikoodin sijaan. Jos haluat vaihtaa aktiivista tiliä, kirjaudu ensin ulos."

msgctxt "settings-view"
msgid "Port forwarding"
msgstr "Portin edelleenlähetys"

msgctxt "settings-view"
msgid "Replay onboarding"
msgstr "Toista käyttöönotto-opastus"

msgctxt "vpn-settings-view"
msgid "Dropped %(count)s pinned exit key entries."
msgstr "Poistettiin %(count)s kiinnitettyä poistumisavainmerkintää."

msgctxt "vpn-settings-view"
msgid "Every Warren exit you previously connected to will be re-pinned on the next connection (Trust On First Use)."
msgstr "Jokainen aiemmin yhdistämäsi Warren-poistumispalvelin kiinnitetään uudelleen seuraavalla yhteydellä (Trust On First Use)."

msgctxt "vpn-settings-view"
msgid "Pin table cleared"
msgstr "Kiinnitystaulu tyhjennetty"

msgctxt "vpn-settings-view"
msgid "Reset"
msgstr "Nollaa"

msgctxt "vpn-settings-view"
msgid "Reset all"
msgstr "Nollaa kaikki"

msgctxt "vpn-settings-view"
msgid "Reset failed"
msgstr "Nollaus epäonnistui"

msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys"
msgstr "Nollaa kiinnitetyt poistumisavaimet"

msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys?"
msgstr "Nollataanko kiinnitetyt poistumisavaimet?"

#. Restores the list of networks shared outside the tunnel
#. to the built-in private IP ranges.
msgctxt "vpn-settings-view"
msgid "Reset to default"
msgstr "Palauta oletusarvo"

msgctxt "vpn-settings-view"
msgid "Until the new pins are established the substitution-detection guard is briefly down: an attacker who replaced an exit between resets would not be flagged on the first reconnect."
msgstr "Kunnes uudet kiinnitykset on muodostettu, korvaamisen havaitsemissuoja on hetkellisesti poissa käytöstä: hyökkääjää, joka korvasi poistumispalvelimen nollausten välillä, ei merkitä ensimmäisellä uudelleenyhdistyksellä."

msgctxt "warren-multi-hop-view"
msgid "Multihop"
msgstr "Multihop"

msgctxt "forum-login"
msgid "Sign-in refused: this computer’s clock is off by more than a minute. Enable automatic date and time, then start again from the browser page."
msgstr "Kirjautuminen hylättiin: tietokoneen kello on yli minuutin väärässä. Ota automaattinen päivämäärä ja aika käyttöön ja aloita alusta selaimen sivulta."

msgctxt "forum-login"
msgid "Approve only if you are looking at that sign-in page right now. If someone sent you this code, they are signing in as you. No email and no password are used."
msgstr "Hyväksy vain, jos katsot kyseistä kirjautumissivua juuri nyt. Jos joku lähetti sinulle tämän koodin, hän kirjautuu sinuna. Sähköpostia tai salasanaa ei käytetä."

msgctxt "forum-login"
msgid "Warren cannot tell which browser is being signed in, or whether it is in front of you right now. Your app will sign a one-time challenge with your wallet key to prove it is you."
msgstr "Warren ei voi tietää, mikä selain kirjautuu sisään tai onko se juuri nyt edessäsi. Sovelluksesi allekirjoittaa kertaluonteisen haasteen lompakkoavaimellasi todistaakseen, että se olet sinä."

msgctxt "forum-login"
msgid "Sign in to the forum on another device?"
msgstr "Kirjaudutaanko foorumille toisella laitteella?"

msgctxt "forum-login"
msgid "A sign-in to the Warren community forum was requested. Your app will sign a one-time challenge with your wallet key to prove it is you."
msgstr "Warrenin yhteisöfoorumille pyydettiin kirjautumista. Sovelluksesi allekirjoittaa kertaluonteisen haasteen lompakkoavaimellasi todistaakseen, että se olet sinä."

msgctxt "forum-login"
msgid "Approve sign-in"
msgstr "Hyväksy kirjautuminen"

msgctxt "forum-login"
msgid "Cancel"
msgstr "Peruuta"

msgctxt "forum-login"
msgid "No email and no password are used. You appear under a random pseudonym, and only the Warren support team can match it to a wallet, for support purposes. Only approve if you started this sign-in."
msgstr "Sähköpostia tai salasanaa ei käytetä. Näyt satunnaisella salanimellä, ja vain Warrenin tukitiimi voi yhdistää sen lompakkoon tukitarkoituksiin. Hyväksy vain, jos aloitit tämän kirjautumisen itse."

msgctxt "forum-login"
msgid "Sign in to the Warren community forum?"
msgstr "Kirjaudutaanko Warrenin yhteisöfoorumille?"

msgctxt "forum-login"
msgid "Sign-in failed. Please try again in a moment."
msgstr "Kirjautuminen epäonnistui. Yritä hetken kuluttua uudelleen."

msgctxt "forum-login"
msgid "Signing, please wait."
msgstr "Allekirjoitetaan, odota hetki."

msgctxt "support-view"
msgid "Community forum"
msgstr "Yhteisöfoorumi"

msgctxt "tunnel-control"
msgid "Random location"
msgstr "Satunnainen sijainti"

msgctxt "tunnel-control"
msgid "You are protected"
msgstr "Olet suojattu"

msgctxt "tunnel-control"
msgid "You are visible"
msgstr "Olet näkyvissä"

msgctxt "tunnel-control"
msgid "Your connection is not encrypted"
msgstr "Yhteyttäsi ei ole salattu"

msgctxt "tunnel-control"
msgid "Disconnecting..."
msgstr "Yhteyttä katkaistaan..."

msgctxt "tunnel-control"
msgid "Connection in progress"
msgstr "Yhteyttä muodostetaan"

msgctxt "forum-attach"
msgid "Attach the logs"
msgstr "Liitä lokit"

msgctxt "forum-attach"
msgid "Attach your logs to the bug report?"
msgstr "Liitetäänkö lokit virheraporttiin?"

msgctxt "forum-attach"
msgid "Attaching the logs failed. Please try again in a moment."
msgstr "Lokien liittäminen epäonnistui. Yritä hetken kuluttua uudelleen."

msgctxt "forum-attach"
msgid "Cancel"
msgstr "Peruuta"

msgctxt "forum-attach"
msgid "Only the author of the bug report can attach logs to it."
msgstr "Vain virheraportin tekijä voi liittää siihen lokeja."

msgctxt "forum-attach"
msgid "Sending, please wait."
msgstr "Lähetetään, odota hetki."

msgctxt "forum-attach"
msgid "The log file is too large to attach."
msgstr "Lokitiedosto on liian suuri liitettäväksi."

msgctxt "forum-attach"
msgid "Your Warren account is not ready yet, so the logs cannot be signed. Finish setting up the app, then attach them from the forum page."
msgstr "Warren-tilisi ei ole vielä valmis, joten lokeja ei voi allekirjoittaa. Viimeistele sovelluksen käyttöönotto ja liitä ne sitten foorumisivulta."

msgctxt "forum-attach"
msgid "The Warren support service could not accept the report. Nothing is wrong on your side. Try again later, and say so on the forum if it keeps failing."
msgstr "Warrenin tukipalvelu ei voinut ottaa raporttia vastaan. Sinun päässäsi ei ole mitään vikaa. Yritä myöhemmin uudelleen ja kerro foorumilla, jos vika jatkuu."

msgctxt "forum-attach"
msgid "Wallet addresses and personal data are redacted from the logs. They go privately to the Warren support staff and never appear publicly on the forum. You can view exactly what will be sent before approving."
msgstr "Lompakko-osoitteet ja henkilötiedot poistetaan lokeista. Ne lähetetään luottamuksellisesti Warrenin tukihenkilöstölle, eivätkä ne koskaan näy julkisesti foorumilla. Näet tarkalleen, mitä lähetetään, ennen kuin hyväksyt."

msgctxt "forum-attach"
msgid "This request has expired. Start again from the forum page."
msgstr "Tämä pyyntö on vanhentunut. Aloita uudelleen foorumisivulta."

msgctxt "forum-attach"
msgid "View the logs"
msgstr "Näytä lokit"

msgctxt "forum-attach"
msgid "Your bug report on the Warren forum (topic %(topicId)d) asks to attach the app technical logs to help diagnose the problem."
msgstr "Warren-foorumilla tekemäsi virheraportti (aihe %(topicId)d) pyytää liittämään sovelluksen tekniset lokit ongelman selvittämiseksi."

msgctxt "forum-attach"
msgid "Your new bug report being composed on the Warren forum asks to attach the app technical logs to help diagnose the problem."
msgstr "Warren-foorumille parhaillaan laatimasi uusi virheraportti pyytää liittämään sovelluksen tekniset lokit ongelman selvittämiseksi."

#. Status line confirming traffic obfuscation is on.
msgctxt "warren-status-view"
msgid "Obfuscation is active."
msgstr "Hämärrys on käytössä."

#. Status line shown if traffic obfuscation is off.
msgctxt "warren-status-view"
msgid "Obfuscation is currently inactive."
msgstr "Hämärrys ei ole tällä hetkellä käytössä."

#. Explains what obfuscation does and why it cannot be turned off.
msgctxt "warren-status-view"
msgid "To evade censorship, Warren disguises the tunnel as ordinary web browsing: on the network it looks like standard browser traffic to a regular website (HTTP/3 on port 443). Obfuscation cannot be turned off, as traffic that stands out is traffic that can be blocked."
msgstr "Sensuurin kiertämiseksi Warren naamioi tunnelin tavalliseksi verkkoselaamiseksi: verkossa se näyttää normaalilta selainliikenteeltä tavalliselle verkkosivustolle (HTTP/3, portti 443). Hämärrystä ei voi kytkeä pois, sillä erottuva liikenne voidaan estää."

msgctxt "wireguard-settings-view"
msgid "%(daita)s adds network noise and makes all packets the same size, so it is much harder to tell which sites you visit or who you communicate with."
msgstr "%(daita)s lisää verkkokohinaa ja tekee kaikista paketeista samankokoisia, joten on paljon vaikeampi päätellä, millä sivustoilla käyt tai kenen kanssa viestit."

msgctxt "wireguard-settings-view"
msgid "%(daita)s is not active on the current server: this connection is not protected by it. Reconnect or select a different location."
msgstr "%(daita)s ei ole käytössä nykyisellä palvelimella: tämä yhteys ei ole sen suojaama. Yhdistä uudelleen tai valitse toinen sijainti."

msgctxt "wireguard-settings-view"
msgid "Even when encrypted, the data packets entering and leaving your device can be analyzed by AI to reveal your activity."
msgstr "Vaikka laitteeseesi saapuvat ja siitä lähtevät datapaketit ovat salattuja, tekoäly voi analysoida ne ja paljastaa toimintasi."

msgctxt "wireguard-settings-view"
msgid "Note: this increases network traffic and can reduce speed, latency, and battery life. Use with caution on limited plans."
msgstr "Huomaa: tämä lisää verkkoliikennettä ja voi heikentää nopeutta, viivettä ja akunkestoa. Käytä harkiten, jos datapakettisi on rajallinen."

msgctxt "accessibility"
msgid "Forum"
msgstr "Foorumi"

msgctxt "accessibility"
msgid "Forum, %(count)s new"
msgstr "Foorumi, %(count)s uutta"

msgctxt "account-view"
msgid "Forum name"
msgstr "Foorumin nimi"

msgctxt "auth-failure"
msgid "Blocking internet: your access has been revoked after repeated abuse reports about a forwarded port. You can contest this at %(url)s"
msgstr "Verkkoyhteys estetään: käyttöoikeutesi on peruttu toistuvien väärinkäyttöilmoitusten vuoksi, jotka koskevat edelleenohjattua porttia. Voit riitauttaa tämän osoitteessa %(url)s"

msgctxt "forum-activity-view"
msgid "%(actor)s liked your post"
msgstr "%(actor)s tykkäsi viestistäsi"

msgctxt "forum-activity-view"
msgid "%(actor)s linked to your post"
msgstr "%(actor)s linkitti viestiisi"

msgctxt "forum-activity-view"
msgid "%(actor)s mentioned you"
msgstr "%(actor)s mainitsi sinut"

msgctxt "forum-activity-view"
msgid "%(actor)s opened a new topic"
msgstr "%(actor)s avasi uuden ketjun"

msgctxt "forum-activity-view"
msgid "%(actor)s quoted you"
msgstr "%(actor)s lainasi sinua"

msgctxt "forum-activity-view"
msgid "%(actor)s replied"
msgstr "%(actor)s vastasi"

msgctxt "forum-activity-view"
msgid "%(actor)s sent you a message"
msgstr "%(actor)s lähetti sinulle viestin"

msgctxt "forum-activity-view"
msgid "Could not reach the forum. Check your connection and try again."
msgstr "Foorumia ei tavoitettu. Tarkista yhteytesi ja yritä uudelleen."

msgctxt "forum-activity-view"
msgid "Forum"
msgstr "Foorumi"

msgctxt "forum-activity-view"
msgid "New forum activity"
msgstr "Uutta toimintaa foorumilla"

msgctxt "forum-activity-view"
msgid "Nothing new on the forum. Come and ask a question, or help someone else out."
msgstr "Ei uutta foorumilla. Tule kysymään tai auta jotakuta toista."

msgctxt "forum-activity-view"
msgid "Open the forum"
msgstr "Avaa foorumi"

msgctxt "forum-activity-view"
msgid "Someone"
msgstr "Joku"

msgctxt "forum-activity-view"
msgid "Try again"
msgstr "Yritä uudelleen"

msgctxt "forum-activity-view"
msgid "You earned a badge"
msgstr "Sait ansiomerkin"

msgctxt "forum-activity-view"
msgid "You post as %(handle)s"
msgstr "Kirjoitat nimellä %(handle)s"

msgctxt "in-app-notifications"
msgid "WARREN"
msgstr "WARREN"

msgctxt "notifications"
msgid "More than %(count)d new notifications on the forum"
msgstr "Yli %(count)d uutta ilmoitusta foorumilla"

msgctxt "notifications"
msgid "New notification on the forum"
msgid_plural "%(count)d new notifications on the forum"
msgstr[0] "Uusi ilmoitus foorumilla"
msgstr[1] "%(count)d uutta ilmoitusta foorumilla"

msgctxt "notifications"
msgid "Open"
msgstr "Avaa"

msgctxt "port-forwarding-view"
msgid "A forwarded port is reachable from the internet. If a third party reports abuse coming from it, we close the port and record a warning on your account; three warnings within 90 days revoke access. Details and how to contest: %(url)s"
msgstr "Edelleenohjattu portti on tavoitettavissa internetistä. Jos kolmas osapuoli ilmoittaa siitä tulevasta väärinkäytöstä, suljemme portin ja kirjaamme tilillesi varoituksen; kolme varoitusta 90 päivän sisällä peruuttaa käyttöoikeuden. Tiedot ja riitauttaminen: %(url)s"

msgctxt "port-forwarding-view"
msgid "%(client)s now listens on port %(port)d"
msgstr "%(client)s kuuntelee nyt porttia %(port)d"

msgctxt "port-forwarding-view"
msgid "%(client)s refused the login"
msgstr "%(client)s hylkäsi kirjautumisen"

msgctxt "port-forwarding-view"
msgid "%(client)s rejected the port: %(detail)s"
msgstr "%(client)s hylkäsi portin: %(detail)s"

msgctxt "port-forwarding-view"
msgid "Apply now"
msgstr "Ota käyttöön nyt"

msgctxt "port-forwarding-view"
msgid "Cannot reach %(client)s at %(url)s"
msgstr "Kohteeseen %(client)s ei saada yhteyttä osoitteessa %(url)s"

msgctxt "port-forwarding-view"
msgid "Client"
msgstr "Asiakasohjelma"

msgctxt "port-forwarding-view"
msgid "Connected to %(client)s"
msgstr "Yhdistetty: %(client)s"

