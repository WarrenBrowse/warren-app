msgctxt "split-tunneling-view"
msgid "Connected"
msgstr "Yhdistetty"

msgctxt "split-tunneling-view"
msgid "Connected, IP %(ip)s"
msgstr "Yhdistetty, IP %(ip)s"

msgctxt "split-tunneling-view"
msgid "Connecting..."
msgstr "Yhdistetään..."

msgctxt "split-tunneling-view"
msgid "Countries"
msgstr "Maat"

msgctxt "split-tunneling-view"
msgid "Country for %(application)s"
msgstr "Sovelluksen %(application)s maa"

msgctxt "split-tunneling-view"
