msgctxt "in-app-notifications"
msgid "Click here to retry"
msgstr "Yritä uudelleen napsauttamalla tätä"

#. Notification subtitle when the download of the installer failed
#. and the user can try downloading again.
msgctxt "in-app-notifications"
msgid "Click here to retry download"
msgstr "Yritä latausta uudelleen napsauttamalla tätä"

msgctxt "in-app-notifications"
msgid "Click here to see what’s new."
msgstr "Katso uudet ominaisuudet napsauttamalla tästä."

msgctxt "in-app-notifications"
msgid "Connecting is not possible while access is revoked."
msgstr "Yhdistäminen ei ole mahdollista, kun käyttöoikeus on peruttu."

#. Label of the voucher code an announcement granted to this account.
msgctxt "in-app-notifications"
msgid "Your code"
msgstr "Koodisi"

#. Confirmation shown once the voucher code is on the clipboard.
msgctxt "in-app-notifications"
msgid "Copied"
msgstr "Kopioitu"

#. Notification subtitle when the installer download failed.
msgctxt "in-app-notifications"
msgid "Could not download installer."
msgstr "Asennusohjelman lataaminen ei onnistunut."

#. Generic notification subtitle when the app upgrade failed.
