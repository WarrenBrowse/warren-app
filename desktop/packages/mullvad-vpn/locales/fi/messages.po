msgid "Theme"
msgstr "Teema"

msgctxt "user-interface-settings-view"
msgid "System"
msgstr "Järjestelmä"

msgctxt "user-interface-settings-view"
msgid "Dark"
msgstr "Tumma"

msgctxt "user-interface-settings-view"
msgid "Light"
msgstr "Vaalea"

msgctxt "split-tunneling-view"
msgid "Never without the VPN"
msgstr "Ei koskaan ilman VPN:ää"

msgctxt "split-tunneling-view"
msgid "When the VPN is off, %(application)s has no Internet, even with Warren VPN closed."
msgstr "Kun VPN on pois päältä, %(application)s ei pääse internetiin, vaikka Warren VPN olisi suljettu."

msgctxt "split-tunneling-view"
msgid "Lockdown mode already blocks every app while the VPN is off."
msgstr "Lukitustila estää jo kaikki sovellukset, kun VPN on pois päältä."

msgctxt "split-tunneling-view"
msgid "Choose a route through the VPN to turn this on"
msgstr "Valitse reitti VPN:n kautta ottaaksesi tämän käyttöön"

msgctxt "split-tunneling-view"
msgid "%(route)s, never without the VPN"
msgstr "%(route)s, ei koskaan ilman VPN:ää"

msgctxt "split-tunneling-view"
msgid "Blocked until the VPN connects"
msgstr "Estetty, kunnes VPN yhdistää"

msgctxt "connect-view"
msgid "%(count)d app blocked until the VPN connects"
msgid_plural "%(count)d apps blocked until the VPN connects"
msgstr[0] "%(count)d sovellus estetty, kunnes VPN yhdistää"
msgstr[1] "%(count)d sovellusta estetty, kunnes VPN yhdistää"

msgctxt "split-tunneling-view"
msgid "Open never without the VPN"
msgstr "Avaa ei koskaan ilman VPN:ää"

msgctxt "split-tunneling-view"
msgid "Until you close it, it has no Internet while the VPN is off. Close it first if it is already open."
msgstr "Kunnes suljet sen, sillä ei ole internetiä, kun VPN on pois päältä. Sulje se ensin, jos se on jo auki."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be locked to the VPN."
msgstr "Jos sovellus on jo käynnissä, sulje %(applicationName)s ennen sen käynnistämistä täältä. Muuten sitä ei ehkä lukita VPN:ään."

msgctxt "split-tunneling-view"
msgid "%(applicationName)s is problematic and can’t be opened locked to the VPN."
msgstr "%(applicationName)s on ongelmallinen, eikä sitä voida avata VPN:ään lukittuna."

msgctxt "split-tunneling-view"
msgid "Flatpak and Snap apps cannot be opened locked to the VPN"
msgstr "Flatpak- ja Snap-sovelluksia ei voi avata VPN:ään lukittuina"

msgctxt "account-view"
msgid "Notice of %(date)s"
msgstr "Ilmoitus %(date)s"

msgctxt "account-view"
msgid "Renewal notices"
msgstr "Uusimisilmoitukset"

msgctxt "notifications"
msgid "Amount charged: %(price)s, VAT included."
msgstr "Veloitettava summa: %(price)s, sis. ALV."

msgctxt "notifications"
msgid "Automatic renewal notice"
msgstr "Ilmoitus automaattisesta uusimisesta"

msgctxt "notifications"
msgid "Best monthly rate Warren offers today: %(price)s."
msgstr "Edullisin Warrenin tänään tarjoama kuukausihinta: %(price)s."

msgctxt "notifications"
msgid "Issued on %(date)s"
msgstr "Annettu %(date)s"

msgctxt "notifications"
msgid "The monthly price changed after your renewal notice, so this renewal was not charged. Your Warren time ends around %(date)s unless you buy more."
msgstr "Kuukausihinta muuttui uusimisilmoituksesi jälkeen, joten tätä uusimista ei veloitettu. Warren-aikasi päättyy noin %(date)s, ellet osta lisää."

msgctxt "notifications"
msgid "The monthly price changes from %(previous)s to %(price)s, VAT included, from this renewal."
msgstr "Kuukausihinta muuttuu tästä uusimisesta alkaen %(previous)s:sta %(price)s:aan, sis. ALV."

msgctxt "notifications"
msgid "The monthly price of your automatic renewal changes from %(previous)s to %(price)s from around %(date)s. You can turn auto-renewal off anytime in Account settings, at no cost."
msgstr "Automaattisen uusimisesi kuukausihinta muuttuu noin %(date)s alkaen %(previous)s:sta %(price)s:aan. Voit poistaa automaattisen uusimisen käytöstä milloin tahansa tiliasetuksista maksutta."

msgctxt "notifications"
msgid "You can turn automatic renewal off at any time, at no cost, in Account settings of the Warren app or at %(url)s. Turning it off takes effect immediately."
msgstr "Voit poistaa automaattisen uusimisen käytöstä milloin tahansa maksutta Warren-sovelluksen tiliasetuksista tai osoitteessa %(url)s. Muutos tulee voimaan heti."

msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at %(price)s per month. You can turn auto-renewal off anytime in Account settings, at no cost."
msgstr "Warren-aikasi uusitaan automaattisesti noin %(date)s hintaan %(price)s kuukaudessa. Voit poistaa automaattisen uusimisen käytöstä milloin tahansa tiliasetuksista maksutta."

msgctxt "notifications"
msgid "Your Warren time renews automatically on or around %(date)s, for one month."
msgstr "Warren-aikasi uusitaan automaattisesti kuukaudeksi %(date)s tai sen tienoilla."

msgctxt "account-view"
msgid "Withdrawal (14 days)"
msgstr "Peruuttaminen (14 päivää)"

msgctxt "account-view"
