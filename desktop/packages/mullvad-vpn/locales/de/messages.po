msgstr "Geräte"

msgctxt "device-management"
msgid "Devices signed in to this account. Disconnecting one signs it out: it needs the recovery phrase to sign in again."
msgstr "Bei diesem Konto angemeldete Geräte. Wenn Sie ein Gerät trennen, wird es abgemeldet: Für eine erneute Anmeldung braucht es die Wiederherstellungsphrase."

msgctxt "device-management"
msgid "Disconnect"
msgstr "Trennen"

msgctxt "device-management"
msgid "Disconnect %(name)s?"
msgstr "%(name)s trennen?"

msgctxt "device-management"
msgid "It will be signed out within 10 minutes and will need the recovery phrase to sign in again. For a lost or stolen device, move to a new account instead: a device that keeps the recovery phrase can sign in again."
msgstr "Es wird innerhalb von 10 Minuten abgemeldet und braucht die Wiederherstellungsphrase, um sich erneut anzumelden. Wechseln Sie bei einem verlorenen oder gestohlenen Gerät stattdessen zu einem neuen Konto: Ein Gerät, das die Wiederherstellungsphrase behält, kann sich erneut anmelden."

msgctxt "device-management"
msgid "Last active %(date)s"
msgstr "Zuletzt aktiv am %(date)s"

msgctxt "device-management"
msgid "Last seen %(date)s"
msgstr "Zuletzt gesehen am %(date)s"

