msgid "Remove %(location)s from %(listName)s"
msgstr "%(location)s aus %(listName)s entfernen"

msgctxt "account-view"
msgid "Paused while access is revoked: nothing is charged."
msgstr "Pausiert, solange der Zugang entzogen ist: Es wird nichts abgebucht."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been revoked until %(date)s after repeated abuse reports about a forwarded port. You can contest this at %(url)s"
msgstr "Internet wird blockiert: Ihr Zugang wurde nach wiederholten Missbrauchsmeldungen zu einem weitergeleiteten Port bis zum %(date)s entzogen. Sie können dagegen Einspruch erheben unter %(url)s"

msgctxt "connect-view"
msgid "Degraded bond"
msgstr "Bündelung beeinträchtigt"

msgctxt "connect-view"
msgid "Degraded bond (%(stalled)s of %(bonded)s)"
msgstr "Bündelung beeinträchtigt (%(stalled)s von %(bonded)s)"

msgctxt "in-app-notifications"
msgid "%(product)s has taken priority on this device, so this build disconnected and turned its kill switch off."
msgstr "%(product)s hat auf diesem Gerät Vorrang erhalten, daher hat diese Version die Verbindung getrennt und ihren Killswitch deaktiviert."

msgctxt "in-app-notifications"
msgid "%(product)s holds the tunnel on this device. It stands down on its own as soon as you connect here."
msgstr "%(product)s belegt auf diesem Gerät den Tunnel und gibt ihn von selbst frei, sobald Sie hier eine Verbindung herstellen."

msgctxt "in-app-notifications"
msgid "ANOTHER BUILD IS CONNECTED"
msgstr "EINE ANDERE VERSION IST VERBUNDEN"

msgctxt "in-app-notifications"
msgid "Bring this build back"
msgstr "Diese Version wieder aktivieren"

msgctxt "in-app-notifications"
msgid "Bring this build back."
msgstr "Diese Version wieder aktivieren."

msgctxt "in-app-notifications"
msgid "PORT FORWARDING WARNING"
msgstr "VERWARNUNG ZUR PORTWEITERLEITUNG"

msgctxt "in-app-notifications"
msgid "RECONNECTED AFTER A CRASH"
msgstr "NACH ABSTURZ WIEDER VERBUNDEN"

msgctxt "in-app-notifications"
msgid "STANDING BY"
msgstr "IN BEREITSCHAFT"

msgctxt "in-app-notifications"
msgid "You can bring it back once %(product)s is disconnected."
msgstr "Sie können diese Version wieder aktivieren, sobald die Verbindung von %(product)s getrennt ist."

msgctxt "in-app-notifications"
msgid "Your device did not shut down cleanly, so Warren restored your previous connection. Neither auto-connect nor launch on start-up is on. Disconnect if you did not want this."
msgstr "Ihr Gerät wurde nicht ordnungsgemäß heruntergefahren, daher hat Warren Ihre vorherige Verbindung wiederhergestellt. Weder „Automatische Verbindung“ noch „App beim Hochfahren starten“ ist aktiviert. Trennen Sie die Verbindung, wenn Sie das nicht wollten."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse until %(date)s."
msgstr "Zugang wegen Missbrauchs der Portweiterleitung bis zum %(date)s entzogen."

msgctxt "port-forwarding-view"
msgid "Access revoked for port-forwarding abuse."
msgstr "Zugang wegen Missbrauchs der Portweiterleitung entzogen."

msgctxt "port-forwarding-view"
