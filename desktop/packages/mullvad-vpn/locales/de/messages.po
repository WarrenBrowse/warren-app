msgctxt "split-tunneling-view"
msgid "Snap apps cannot use a country yet"
msgstr "Snap-Apps können noch kein eigenes Land nutzen"

#. Information about split tunneling being unavailable due to
#. missing support in the user's operating system.
#. Available placeholders:
#. %(splitTunneling)s - will be replaced with Split tunneling
msgctxt "split-tunneling-view"
msgid "To use %(splitTunneling)s, please update to a Linux kernel version that supports cgroup v2."
msgstr "Um %(splitTunneling)s zu verwenden, aktualisieren Sie bitte auf eine Linux-Kernel-Version, die cgroup v2 unterstützt."

msgctxt "split-tunneling-view"
msgid "To use this, enable “Full disk access” for “Warren VPN” in the macOS system settings."
msgstr "Um dies zu nutzen, aktivieren Sie in den macOS-Systemeinstellungen „Voller Festplattenzugriff“ für „Warren VPN“."

#. Error message showed in a dialog when an application fails to launch.
msgctxt "split-tunneling-view"
msgid "Unable to launch selection. %(detailedErrorMessage)s"
msgstr "Auswahl konnte nicht gestartet werden. %(detailedErrorMessage)s"

msgctxt "split-tunneling-view"
msgid "Unavailable"
msgstr "Nicht verfügbar"

msgctxt "split-tunneling-view"
msgid "Waiting for the VPN"
msgstr "Wartet auf das VPN"

msgctxt "split-tunneling-view"
msgid "%(application)s, %(route)s"
msgstr "%(application)s, %(route)s"

msgctxt "split-tunneling-view"
msgid "Add an app"
msgstr "App hinzufügen"

msgctxt "split-tunneling-view"
msgid "All apps are protected by the VPN, except for the rules below."
msgstr "Alle Apps sind durch das VPN geschützt, außer bei den Regeln unten."

msgctxt "split-tunneling-view"
msgid "App"
msgstr "App"

msgctxt "split-tunneling-view"
msgid "Choose an exit country"
msgstr "Ausgangsland wählen"

msgctxt "split-tunneling-view"
msgid "Choose where each app goes."
msgstr "Legen Sie fest, welchen Weg jede App nimmt."

msgctxt "split-tunneling-view"
msgid "Country of your main connection"
msgstr "Land Ihrer Hauptverbindung"

msgctxt "split-tunneling-view"
msgid "Default"
msgstr "Standard"

msgctxt "split-tunneling-view"
msgid "Direct connection by default. Only the apps below use the VPN."
msgstr "Standardmäßig direkte Verbindung. Nur die Apps unten nutzen das VPN."

msgctxt "split-tunneling-view"
msgid "Direct connection, your real IP is visible"
msgstr "Direkte Verbindung, Ihre echte IP ist sichtbar"

msgctxt "split-tunneling-view"
msgid "Done"
msgstr "Fertig"

msgctxt "split-tunneling-view"
msgid "It uses this country when you open it with “Open through the VPN”."
msgstr "Sie nutzt dieses Land, wenn Sie sie mit „Über das VPN öffnen“ starten."

msgctxt "split-tunneling-view"
msgid "Needs Full Disk Access"
msgstr "Benötigt Festplattenvollzugriff"

msgctxt "split-tunneling-view"
msgid "Needs a signed build of Warren VPN"
msgstr "Benötigt eine signierte Version von Warren VPN"

msgctxt "split-tunneling-view"
msgid "Needs macOS 13 or newer"
msgstr "Benötigt macOS 13 oder neuer"

msgctxt "split-tunneling-view"
msgid "No app uses the VPN. Add one, or send the other apps through the VPN again."
msgstr "Keine App nutzt das VPN. Fügen Sie eine hinzu oder leiten Sie die anderen Apps wieder über das VPN."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to open it through the VPN: it uses the VPN until you close it."
msgstr "Keine Regeln. Fügen Sie eine App hinzu, um sie über das VPN zu öffnen: Sie nutzt das VPN, bis Sie sie schließen."

msgctxt "split-tunneling-view"
msgid "No rules. Add an app to send it through another country or outside the VPN."
msgstr "Keine Regeln. Fügen Sie eine App hinzu, um sie über ein anderes Land oder außerhalb des VPN zu leiten."

msgctxt "split-tunneling-view"
msgid "Not available on this system"
msgstr "Auf diesem System nicht verfügbar"

msgctxt "split-tunneling-view"
msgid "Open outside the VPN"
msgstr "Ohne VPN öffnen"

msgctxt "split-tunneling-view"
msgid "Open through the VPN"
msgstr "Über das VPN öffnen"

msgctxt "split-tunneling-view"
msgid "Other apps go"
msgstr "Andere Apps verbinden sich"

msgctxt "split-tunneling-view"
msgid "Outside the VPN"
msgstr "Ohne VPN"

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs a signed build of Warren VPN."
msgstr "„Ohne VPN“ benötigt eine signierte Version von Warren VPN."

msgctxt "split-tunneling-view"
msgid "Outside the VPN needs macOS 13 or newer."
msgstr "„Ohne VPN“ benötigt macOS 13 oder neuer."

msgctxt "split-tunneling-view"
msgid "Remove %(application)s from the list"
msgstr "%(application)s aus der Liste entfernen"

msgctxt "split-tunneling-view"
msgid "Remove the rule"
msgstr "Regel entfernen"

msgctxt "split-tunneling-view"
msgid "Route for %(application)s"
msgstr "Route für %(application)s"

msgctxt "split-tunneling-view"
msgid "Rules per app"
msgstr "Regeln pro App"

msgctxt "split-tunneling-view"
msgid "Through the VPN"
msgstr "Über das VPN"

msgctxt "split-tunneling-view"
msgid "Through the VPN, another country"
msgstr "Über das VPN, anderes Land"

msgctxt "split-tunneling-view"
msgid "Through the VPN, from this country"
msgstr "Über das VPN, aus diesem Land"

msgctxt "split-tunneling-view"
msgid "Until you close it. Close it first if it is already open."
msgstr "Bis Sie sie schließen. Schließen Sie sie vorher, falls sie bereits geöffnet ist."

msgctxt "split-tunneling-view"
msgid "VPN"
msgstr "VPN"

msgctxt "split-tunneling-view"
msgid "Your system cannot send apps outside the VPN."
msgstr "Ihr System kann keine Apps außerhalb des VPN leiten."

msgctxt "split-tunneling-view"
msgid "Only the apps you choose will use the VPN. The rest of this device will not be protected."
msgstr "Nur die ausgewählten Apps werden das VPN nutzen. Der Rest dieses Geräts wird nicht geschützt."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not be excluded from the VPN tunnel."
msgstr "Falls %(applicationName)s bereits läuft, schließen Sie die App, bevor Sie sie hier starten. Andernfalls wird sie möglicherweise nicht vom VPN-Tunnel ausgeschlossen."

msgctxt "split-tunneling-view"
msgid "If it’s already running, close %(applicationName)s before launching it from here. Otherwise it might not use the VPN."
msgstr "Falls %(applicationName)s bereits läuft, schließen Sie die App, bevor Sie sie hier starten. Andernfalls nutzt sie möglicherweise nicht das VPN."

#. Link to the webpage
msgctxt "support-view"
msgid "FAQs & Guides"
msgstr "Häufig gestellte Fragen & Anleitungen"

#. Title label in navigation bar
msgctxt "support-view"
msgid "Support"
msgstr "Support"

#. Link to the refund policy webpage
msgctxt "support-view"
msgid "Refund policy"
msgstr "Rückerstattungsrichtlinie"

msgctxt "tray-icon-context-menu"
msgid "Disconnected from system service"
msgstr "Vom Systemdienst getrennt"

msgctxt "tray-icon-context-menu"
msgid "Open %(appName)s"
msgstr "%(appName)s öffnen"

msgctxt "tray-icon-tooltip"
msgid "%(city)s, %(country)s"
msgstr "%(city)s, %(country)s"

msgctxt "tray-icon-tooltip"
msgid "Connected. %(location)s"
msgstr "Verbunden. %(location)s"

msgctxt "tray-icon-tooltip"
msgid "Connecting. %(location)s"
msgstr "Wird verbunden. %(location)s"

msgctxt "troubleshoot"
msgid "Disable split tunneling"
msgstr "Split Tunneling deaktivieren"

msgctxt "troubleshoot"
msgid "Enable “Full Disk Access” for “Warren VPN” in the macOS system settings."
msgstr "Aktivieren Sie „Voller Festplattenzugriff“ für „Warren VPN“ in den macOS-Systemeinstellungen."

msgctxt "troubleshoot"
msgid "Failed to enable split tunneling. This is because the app is missing system permissions. What you can do:"
msgstr "Split Tunneling konnte nicht aktiviert werden. Das liegt daran, dass der App Systemberechtigungen fehlen. Was Sie tun können:"

msgctxt "troubleshoot"
msgid "If you have installed another VPN then try to uninstall that."
msgstr "Falls Sie ein anderes VPN installiert haben, versuchen Sie, es zu deinstallieren."

msgctxt "troubleshoot"
msgid "Make sure you have NF tables support."
msgstr "Vergewissern Sie sich, dass Sie nftables unterstützen."

msgctxt "troubleshoot"
msgid "Open system settings"
msgstr "Systemeinstellungen öffnen"

msgctxt "troubleshoot"
msgid "This error can happen when something other than Warren is actively updating the DNS."
msgstr "Der Fehler kann auftreten, wenn etwas Anderes als Warren das DNS aktiv aktualisiert."

msgctxt "troubleshoot"
msgid "This might be caused by an outdated kernel."
msgstr "Die Ursache dafür könnte ein veralteter Kernel sein."

msgctxt "troubleshoot"
msgid "Try restarting your device."
msgstr "Versuchen Sie es mit einem Neustart Ihres Geräts."

msgctxt "troubleshoot"
msgid "Try to reinstall VMware."
msgstr "Versuchen Sie, VMware neu zu installieren."

msgctxt "troubleshoot"
msgid "Try to turn Wi-Fi Calling off in the FaceTime app settings and restart the Mac."
msgstr "Versuchen Sie, Anrufe vom iPhone in den Einstellungen der FaceTime-App zu deaktivieren und starten Sie den Mac neu."

msgctxt "troubleshoot"
msgid "Try to uninstall VMware."
msgstr "Versuchen Sie, VMware zu deinstallieren."

msgctxt "troubleshoot"
msgid "Unable to communicate with the split tunnel driver."
msgstr "Die Kommunikation mit dem Split-Tunnel-Treiber ist nicht möglich."

msgctxt "troubleshoot"
msgid "Unable to start tunnel connection because of a failure when creating the tunnel device. This is often caused by conflicts with the VMware Bridge Protocol."
msgstr "Die Tunnelverbindung kann nicht gestartet werden, weil das Erstellen des Tunnelgeräts fehlgeschlagen ist. Dies wird häufig durch Konflikte mit dem VMware-Brückenprotokoll verursacht."

msgctxt "troubleshoot"
msgid "Uninstall or disable other DNS, networking and ads/website blocking apps."
msgstr "Deinstallieren oder deaktivieren Sie andere DNS-, Netzwerk- und Werbe-/Webseiten-Blocker-Apps."

msgctxt "troubleshoot"
msgid "Update your kernel."
msgstr "Aktualisieren Sie Ihren Kernel."

msgctxt "troubleshoot"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Falls diese Schritte nicht helfen, melden Sie das Problem bitte in unserem Community-Forum."

msgctxt "tunnel-control"
msgid "Connect"
msgstr "Verbinden"

msgctxt "tunnel-control"
msgid "Only selected apps are protected"
msgstr "Nur ausgewählte Apps sind geschützt"

#. Bold status title shown when the tunnel is up but the
#. device has no internet connection.
msgctxt "tunnel-control"
msgid "Connection interrupted"
msgstr "Verbindung unterbrochen"

msgctxt "user-interface-settings-view"
msgid "Enable or disable system notifications. The critical notifications will always be displayed."
msgstr "Aktivieren oder deaktivieren Sie Systembenachrichtigungen. Kritische Benachrichtigungen werden immer angezeigt."

msgctxt "user-interface-settings-view"
msgid "Enable to move the app around as a free-standing window."
msgstr "Aktivieren, um die App als freistehendes Fenster zu bewegen."

#. Navigation button to the 'Language' settings view
msgctxt "user-interface-settings-view"
msgid "Language"
msgstr "Sprache"

msgctxt "user-interface-settings-view"
msgid "Monochromatic tray icon"
msgstr "Monochromatisches Leistensymbol"

msgctxt "user-interface-settings-view"
msgid "Notifications"
msgstr "Benachrichtigungen"

msgctxt "user-interface-settings-view"
msgid "Show only the tray icon when the app starts."
msgstr "Beim Start der App nur das Leistensymbol anzeigen."

msgctxt "user-interface-settings-view"
msgid "Start minimized"
msgstr "Minimiert starten"

msgctxt "user-interface-settings-view"
msgid "Unpin app from taskbar"
msgstr "App von der Taskleiste lösen"

msgctxt "user-interface-settings-view"
msgid "Use a monochromatic tray icon instead of a colored one."
msgstr "Monochromatisches Leistensymbol statt Farbsymbol nutzen."

#. Title label in navigation bar
msgctxt "user-interface-settings-view"
msgid "User interface settings"
msgstr "UI-Einstellungen"

msgctxt "vpn-settings-view"
msgid "Add a server"
msgstr "Server hinzufügen"

#. Button label to add a private IP DNS server despite warning.
msgctxt "vpn-settings-view"
msgid "Add anyway"
msgstr "Trotzdem hinzufügen"

#. Label for settings that enables ad blocking.
msgctxt "vpn-settings-view"
msgid "Ads"
msgstr "Werbung"

#. Label for settings that enables block of adult content.
msgctxt "vpn-settings-view"
msgid "Adult content"
msgstr "Inhalte für Erwachsene"

#. Label for list item that navigates to anti-censorship
#. settings view.
msgctxt "vpn-settings-view"
msgid "Anti-censorship"
msgstr "Anti-Zensur"

msgctxt "vpn-settings-view"
msgid "Attention: enabling this will always require a Warren VPN connection in order to reach the internet."
msgstr "Achtung: Wenn Sie diese Einstellung aktivieren, wird immer eine Warren-VPN-Verbindung erfordert, um das Internet zu erreichen."

msgctxt "vpn-settings-view"
msgid "Attention: this setting cannot be used in combination with <b>%(customDnsFeatureName)s</b>"
msgstr "Achtung: Diese Einstellung kann nicht in Kombination mit <b>%(customDnsFeatureName)s</b> verwendet werden"

msgctxt "vpn-settings-view"
msgid "Auto-connect"
msgstr "Automatische Verbindung"

msgctxt "vpn-settings-view"
msgid "Automatically connect to a server when the app launches."
msgstr "Stellt automatisch eine Verbindung zum Server her, wenn die App startet."

#. This is displayed when the custom DNS setting is turned on which makes the block
#. ads/trackers settings disabled. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(customDnsFeatureName)s - The name displayed next to the custom DNS toggle.
msgctxt "vpn-settings-view"
msgid "Disable \"%(customDnsFeatureName)s\" below to activate these settings."
msgstr "Deaktivieren Sie unten „%(customDnsFeatureName)s“, um diese Einstellungen zu aktivieren."

#. This is displayed when either or both of the block ads/trackers settings are
#. turned on which makes the custom DNS setting disabled.
#. Available placeholders:
#. %(preferencesPageName)s - The page title showed on top in the preferences page.
msgctxt "vpn-settings-view"
msgid "Disable all <b>DNS content blockers</b> above to activate this setting."
msgstr "Deaktivieren Sie oben alle <b>DNS-Inhaltssperren</b>, um diese Einstellung zu aktivieren."

msgctxt "vpn-settings-view"
msgid "DNS content blockers"
msgstr "DNS-Inhaltssperren"

msgctxt "vpn-settings-view"
msgid "Enable to add at least one DNS server."
msgstr "Aktivieren, um mindestens einen DNS-Server hinzuzufügen."

#. Description of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "Enable to allow IPv6 traffic through the tunnel."
msgstr "Aktivieren, um IPv6-Traffic durch den Tunnel zuzulassen."

msgctxt "vpn-settings-view"
msgid "Enter IP"
msgstr "IP eingeben"

#. Label for settings that enables block of gamling related websites.
msgctxt "vpn-settings-view"
msgid "Gambling"
msgstr "Glücksspiel"

#. Title of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "In-tunnel IPv6"
msgstr "In-Tunnel-IPv6"

msgctxt "vpn-settings-view"
msgid "IPv4 is always enabled and the majority of websites and applications use this protocol. We do not recommend enabling IPv6 unless you know you need it."
msgstr "IPv4 ist immer aktiviert und die meisten Websites und Anwendungen verwenden dieses Protokoll. Wir empfehlen nicht, IPv6 zu aktivieren, es sei denn, Sie wissen, dass Sie es benötigen."

#. A complimentary description for the setting Device IP version,
#. explaining why the user might want to configure the setting.
msgctxt "vpn-settings-view"
msgid "It can be useful when you are aware of problems caused by a certain IP version."
msgstr "Dies kann nützlich sein, wenn Sie von Problemen wissen, die durch eine bestimmte IP-Version verursacht werden."

msgctxt "vpn-settings-view"
msgid "It does this by allowing network communication outside the tunnel to local multicast and broadcast ranges as well as to and from these private IP ranges:"
msgstr "Das geschieht, indem die Netzwerkkommunikation außerhalb des Tunnels zu lokalen Multicast- und Broadcast-Bereichen sowie zu und von diesen privaten IP-Bereichen zugelassen wird:"

msgctxt "vpn-settings-view"
msgid "Kill switch"
msgstr "Killswitch"

msgctxt "vpn-settings-view"
msgid "Launch app on start-up"
msgstr "App beim Hochfahren starten"

msgctxt "vpn-settings-view"
msgid "Local network sharing"
msgstr "Teilen im lokalen Netzwerk"

msgctxt "vpn-settings-view"
msgid "Lockdown mode"
msgstr "Sperrmodus"

#. Label for settings that enables malware blocking.
msgctxt "vpn-settings-view"
msgid "Malware"
msgstr "Malware"

#. Label for settings that enables block of social media.
msgctxt "vpn-settings-view"
msgid "Social media"
msgstr "Social Media"

msgctxt "vpn-settings-view"
msgid "The app’s built-in kill switch is always on. This setting will additionally block the internet if clicking Disconnect or Quit."
msgstr "Der integrierte Killswitch der App ist immer aktiv. Diese Einstellung wird außerdem das Internet sperren, wenn Sie auf Trennen oder Beenden klicken."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents."
msgstr "Der Unterschied zwischen dem Killswitch und dem Sperrmodus besteht darin, dass der Killswitch verhindert, dass bei automatischen Tunnel-Neuverbindungen, Softwareabstürzen und ähnlichen Unfällen Lecks entstehen."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents. With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Der Unterschied zwischen dem Killswitch und dem Sperrmodus besteht darin, dass der Killswitch verhindert, dass bei automatischen Tunnel-Neuverbindungen, Softwareabstürzen und ähnlichen Unfällen Lecks entstehen. Wenn der Sperrmodus aktiviert ist, müssen Sie mit einem Warren-VPN-Server verbunden sein, um das Internet erreichen zu können. Das manuelle Trennen der Verbindung oder das Beenden der App blockiert Ihre Verbindung."

msgctxt "vpn-settings-view"
msgid "The DNS server you want to add is a private IP. You must ensure that your network interfaces are configured to use it."
msgstr "Der DNS-Server, den Sie hinzufügen möchten, ist eine private IP. Sie müssen sicherstellen, dass Ihre Netzwerkschnittstellen für die Verwendung dieses Servers konfiguriert sind."

msgctxt "vpn-settings-view"
msgid "This built-in feature prevents your traffic from leaking outside of the VPN tunnel if your network suddenly stops working or if the tunnel fails, it does this by blocking your traffic until your connection is reestablished."
msgstr "Diese eingebaute Funktion verhindert, dass Ihr Datenverkehr außerhalb des VPN-Tunnels verloren geht, wenn Ihr Netzwerk plötzlich nicht mehr funktioniert oder der Tunnel ausfällt, indem Ihr Datenverkehr blockiert wird, bis die Verbindung wiederhergestellt ist."

msgctxt "vpn-settings-view"
msgid "This feature allows access to other devices on the local network, such as for sharing, printing, streaming, etc."
msgstr "Diese Funktion ermöglicht den Zugriff auf andere Geräte im lokalen Netzwerk, z. B. zum Teilen, Drucken, Streamen usw."

#. A description for the setting Device IP version,
#. explaining how the user can configure the setting.
msgctxt "vpn-settings-view"
msgid "This feature allows you to choose whether to use only IPv4, only IPv6, or allow the app to automatically decide the best option when connecting to a server."
msgstr "Mit dieser Funktion können Sie auswählen, ob nur IPv4 oder IPv6 genutzt werden soll, oder der App erlauben, beim Verbinden mit einem Server automatisch die beste Option zu suchen."

msgctxt "vpn-settings-view"
msgid "This might cause issues on certain websites, services, and apps."
msgstr "Dies kann bei bestimmten Websites, Diensten und Apps zu Problemen führen."

msgctxt "vpn-settings-view"
msgid "This network cannot be shared."
msgstr "Dieses Netzwerk kann nicht geteilt werden."

msgctxt "vpn-settings-view"
msgid "This network is too broad to be shared outside the tunnel."
msgstr "Dieses Netzwerk ist zu groß, um außerhalb des Tunnels geteilt zu werden."

#. Label for settings that enables tracker blocking.
msgctxt "vpn-settings-view"
msgid "Trackers"
msgstr "Tracker"

msgctxt "vpn-settings-view"
msgid "Traffic to these networks goes outside the VPN tunnel."
msgstr "Datenverkehr zu diesen Netzwerken läuft außerhalb des VPN-Tunnels."

msgctxt "vpn-settings-view"
msgid "Use custom DNS server"
msgstr "Benutzerdefinierten DNS-Server verwenden"

#. Title label in navigation bar
msgctxt "vpn-settings-view"
msgid "VPN settings"
msgstr "VPN-Einstellungen"

msgctxt "vpn-settings-view"
msgid "Warning: The malware blocker is not an anti-virus and should not be treated as such, this is just an extra layer of protection."
msgstr "Der Malware-Blocker ist kein Antivirusprogramm und sollte auch nicht als solches behandelt werden. Es dient lediglich als zusätzliche Schutzschicht."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled it stops the device from contacting certain domains or websites known for distributing ads, malware, trackers and more."
msgstr "Wenn diese Funktion aktiviert ist, wird das Gerät daran gehindert, bestimmte Domains oder Websites zu kontaktieren, die für die Verbreitung von Werbung, Malware, Trackern und mehr bekannt sind."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled, IPv6 can be used alongside IPv4 in the VPN tunnel to communicate with internet services."
msgstr "Wenn diese Funktion aktiviert ist, kann IPv6 neben IPv4 im VPN-Tunnel für die Kommunikation mit Internetdiensten verwendet werden."

msgctxt "vpn-settings-view"
msgid "With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Wenn der Sperrmodus aktiviert ist, müssen Sie mit einem Warren-VPN-Server verbunden sein, um das Internet zu erreichen. Das manuelle Trennen der Verbindung oder das Beenden der App blockiert Ihre Verbindung."

#. Value shown for the bandwidth limit in beta builds.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "vpn-settings-view"
msgid "%(mbps)d Mbps"
msgstr "%(mbps)d Mbit/s"

msgctxt "vpn-settings-view"
msgid "Add a network"
msgstr "Netzwerk hinzufügen"

#. Feature indicator shown when the advanced "Allow external DNS resolvers"
#. setting is on, i.e. DNS leak protection is relaxed.
msgctxt "vpn-settings-view"
msgid "Allow external DNS"
msgstr "Externes DNS zulassen"

#. Label for the advanced setting that allows DNS queries to resolvers
#. other than the configured one.
msgctxt "vpn-settings-view"
msgid "Allow external DNS resolvers"
msgstr "Externe DNS-Resolver zulassen"

#. Hint below the bandwidth limit row in beta builds.
msgctxt "vpn-settings-view"
msgid "Bandwidth is limited by the free beta network and enforced by the servers. This setting is unavailable during the beta."
msgstr "Die Bandbreite ist durch das kostenlose Beta-Netzwerk begrenzt und wird von den Servern durchgesetzt. Diese Einstellung ist während der Beta nicht verfügbar."

msgctxt "vpn-settings-view"
msgid "Connect to a single self-hosted exit you enter manually, bypassing the verified server list. Only use an exit you operate or fully trust: it sees your unencrypted traffic."
msgstr "Verbindet Sie mit einem einzelnen, selbst gehosteten Exit-Server, den Sie manuell eingeben, unter Umgehung der geprüften Serverliste. Verwenden Sie nur einen Exit-Server, den Sie selbst betreiben oder dem Sie voll vertrauen: Er sieht Ihren unverschlüsselten Traffic."

msgctxt "vpn-settings-view"
msgid "Cover domain (optional)"
msgstr "Cover-Domain (optional)"

msgctxt "vpn-settings-view"
msgid "Custom exit (advanced)"
msgstr "Benutzerdefinierter Exit-Server (erweitert)"

msgctxt "vpn-settings-view"
msgid "Endpoint"
msgstr "Endpunkt"

msgctxt "vpn-settings-view"
msgid "Enter a network in CIDR notation, such as 192.168.1.0/24 or fd00::/8."
msgstr "Geben Sie ein Netzwerk in CIDR-Notation ein, z. B. 192.168.1.0/24 oder fd00::/8."

#. Placeholder of the field where the user types a network to share
#. outside the tunnel, in CIDR notation.
msgctxt "vpn-settings-view"
msgid "Enter a network, e.g. 192.168.1.0/24"
msgstr "Netzwerk eingeben, z. B. 192.168.1.0/24"

msgctxt "vpn-settings-view"
msgid "Exit address as host:port. Bracket IPv6, for example [2001:db8::1]:443."
msgstr "Exit-Adresse als host:port. IPv6 in Klammern setzen, zum Beispiel [2001:db8::1]:443."

msgctxt "vpn-settings-view"
msgid "For advanced users. When enabled, the firewall stops blocking DNS queries to resolvers other than the configured one, so tools like \"dig @1.1.1.1\" work while connected."
msgstr "Für fortgeschrittene Benutzer. Wenn aktiviert, blockiert die Firewall keine DNS-Anfragen mehr an andere als den konfigurierten Resolver, sodass Tools wie „dig @1.1.1.1“ bei bestehender Verbindung funktionieren."

#. The hint displayed below the bandwidth limit input field.
#. Available placeholders:
#. %(max)d - the maximum accepted value in Mbps
#. %(min)d - the minimum accepted value in Mbps
msgctxt "vpn-settings-view"
msgid "Limit the VPN bandwidth in Mbps, applied to upload and download separately. Valid range: %(min)d - %(max)d. Leave empty for no limit. Applies immediately."
msgstr "Begrenzt die VPN-Bandbreite in Mbit/s, getrennt für Upload und Download. Gültiger Bereich: %(min)d - %(max)d. Für keine Begrenzung leer lassen. Gilt sofort."

msgctxt "vpn-settings-view"
msgid "Managed"
msgstr "Verwaltet"

#. The title for the bandwidth limit setting.
msgctxt "vpn-settings-view"
msgid "Max bandwidth"
msgstr "Maximale Bandbreite"

msgctxt "vpn-settings-view"
msgid "Set only when the exit runs a public TLS certificate (X.509 mode). Leave empty for the default raw-key mode."
msgstr "Nur festlegen, wenn der Exit-Server ein öffentliches TLS-Zertifikat verwendet (X.509-Modus). Für den standardmäßigen Raw-Key-Modus leer lassen."

msgctxt "vpn-settings-view"
msgid "The exit’s Ed25519 public key, 64 hexadecimal characters."
msgstr "Der öffentliche Ed25519-Schlüssel des Exit-Servers, 64 hexadezimale Zeichen."

msgctxt "vpn-settings-view"
msgid "The exit’s routing id, 32 hexadecimal characters."
msgstr "Die Routing-ID des Exit-Servers, 32 hexadezimale Zeichen."

msgctxt "vpn-settings-view"
msgid "The exit’s X25519 multi-hop key, 64 hexadecimal characters."
msgstr "Der X25519-Multihop-Schlüssel des Exit-Servers, 64 hexadezimale Zeichen."

msgctxt "vpn-settings-view"
msgid "The queries still travel through the VPN tunnel, but the resolver you choose will see them. Leave this off unless you are testing remote DNS resolution."
msgstr "Die Anfragen laufen weiterhin durch den VPN-Tunnel, aber der von Ihnen gewählte Resolver sieht sie. Lassen Sie diese Option deaktiviert, sofern Sie nicht die entfernte DNS-Auflösung testen."

#. Placeholder shown when no bandwidth limit is set.
msgctxt "vpn-settings-view"
msgid "Unlimited"
msgstr "Unbegrenzt"

msgctxt "vpn-settings-view"
msgid "X25519 multi-hop key"
msgstr "X25519-Multihop-Schlüssel"

msgctxt "vpn-settings-view"
msgid "Exit ID"
msgstr "Ausgangs-ID"

msgctxt "vpn-settings-view"
msgid "Public key"
msgstr "Öffentlicher Schlüssel"

#. Description of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "A prepaid beta access voucher is linked to your account automatically. No payment, nothing to do."
msgstr "Ein vorausbezahlter Beta-Zugangsgutschein wird automatisch mit Ihrem Konto verknüpft. Keine Zahlung, nichts zu tun."

#. Confirmation that the beta access is active.
#. Available placeholders:
#. %(date)s - the expiry date of the granted access
msgctxt "warren-onboarding"
msgid "Beta access active until %(date)s."
msgstr "Beta-Zugang aktiv bis %(date)s."

#. Error shown when the beta access could not be activated yet.
msgctxt "warren-onboarding"
msgid "Could not activate the beta access yet (are you online?). Retrying automatically, and again at next launch. You can continue anyway."
msgstr "Der Beta-Zugang konnte noch nicht aktiviert werden (sind Sie online?). Der Versuch wird automatisch wiederholt, auch beim nächsten Start. Sie können trotzdem fortfahren."

#. Link shown under onboarding errors pointing to the public help page.
msgctxt "warren-onboarding"
msgid "Having trouble? Visit our help page"
msgstr "Probleme? Besuchen Sie unsere Hilfeseite"

msgctxt "warren-onboarding"
msgid "Retry now"
msgstr "Jetzt erneut versuchen"

#. Beta onboarding line describing the degraded service.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with bandwidth capped at %(mbps)d Mbps. These are not the final service conditions."
msgstr "Die Beta läuft in einem kostenlosen, separaten Netzwerk mit einer auf %(mbps)d Mbit/s begrenzten Bandbreite. Das sind nicht die endgültigen Servicebedingungen."

msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with limited bandwidth. These are not the final service conditions."
msgstr "Die Beta läuft in einem kostenlosen, separaten Netzwerk mit begrenzter Bandbreite. Das sind nicht die endgültigen Servicebedingungen."

#. Title of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "Your beta access"
msgstr "Ihr Beta-Zugang"

msgctxt "warren-pubkey-warning"
msgid "Could not find that exit server anymore. Try reconnecting."
msgstr "Dieser Exit-Server konnte nicht mehr gefunden werden. Versuchen Sie, sich erneut zu verbinden."

msgctxt "warren-pubkey-warning"
msgid "Could not save the new key. Please try again."
msgstr "Der neue Schlüssel konnte nicht gespeichert werden. Bitte versuchen Sie es erneut."

msgctxt "warren-pubkey-warning"
msgid "Could not trust the new key."
msgstr "Dem neuen Schlüssel konnte nicht vertraut werden."

msgctxt "warren-pubkey-warning"
msgid "The key changed again before it could be trusted. Review the new key and try again."
msgstr "Der Schlüssel hat sich erneut geändert, bevor ihm vertraut werden konnte. Prüfen Sie den neuen Schlüssel und versuchen Sie es erneut."

msgctxt "wireguard-settings-view"
msgid "%(daita)s (%(daitaFull)s) hides patterns in your encrypted VPN traffic."
msgstr "%(daita)s (%(daitaFull)s) verbirgt Muster in Ihrem verschlüsselten VPN-Traffic."

msgctxt "wireguard-settings-view"
msgid "By enabling “%(directOnly)s” you will have to manually select a server that is %(daita)s-enabled. This can cause you to end up in a blocked state until you have selected a compatible server in the “Select location” view."
msgstr "Wenn Sie „%(directOnly)s“ aktivieren, müssen Sie manuell einen Server auswählen, der %(daita)s-fähig ist. Dies kann dazu führen, dass Sie in einem blockierten Zustand landen, bis Sie einen kompatiblen Server in der Ansicht „Standort auswählen“ ausgewählt haben."

msgctxt "wireguard-settings-view"
msgid "Cancel"
msgstr "Abbrechen"

#. Title for device IP version setting.
msgctxt "wireguard-settings-view"
msgid "Device IP version"
msgstr "Geräte-IP-Version"

msgctxt "wireguard-settings-view"
msgid "It combines a quantum-safe key exchange with the classical one. When it is on, the app only connects through servers that offer it. When it is off, it is still used wherever a server offers it."
msgstr "Sie kombiniert einen quantensicheren Schlüsselaustausch mit dem klassischen. Ist sie aktiviert, verbindet sich die App nur über Server, die ihn anbieten. Ist sie deaktiviert, wird er trotzdem genutzt, wo ein Server ihn anbietet."

msgctxt "wireguard-settings-view"
msgid "Multihop is being used to enable DAITA for your selected location"
msgstr "Multihop wird verwendet, um DAITA für den von Ihnen ausgewählten Standort zu aktivieren"

#. Warning text in a dialog that is displayed after a setting is toggled.
msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. In order to use the internet, you might have to select a new location after enabling."
msgstr "Nicht alle unsere Server sind %(daita)s-fähig. Um das Internet nutzen zu können, müssen Sie nach der Aktivierung möglicherweise einen neuen Standort auswählen."

#. The title for the QUIC quantum resistance selector. This setting
#. makes the cryptography resistant to the future abilities of quantum
#. computers.
msgctxt "wireguard-settings-view"
msgid "Quantum-resistant tunnel"
msgstr "Quantenresistenter Tunnel"

msgctxt "wireguard-settings-view"
msgid "This feature protects your traffic to the exit server against potential attacks from quantum computers."
msgstr "Diese Funktion schützt Ihren Datenverkehr zum Exit-Server vor möglichen Angriffen durch Quantencomputer."

msgid "Continue"
msgstr "Fortfahren"

msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "Eingangsland"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "Ausgangsland"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "Erwarten Sie etwa die Hälfte der Single-Hop-Bandbreite im Austausch für die Nicht-Verknüpfbarkeit zwischen der Benutzer-IP und der Ziel-IP. Standardmäßig deaktiviert; Opt-in für Datenschutz."

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "Leitet Ihren Verkehr über zwei Warren-Relays mit HPKE-Ende-zu-Ende-Verschlüsselung. Das Eingangsrelay sieht nur Chiffretext; das Ausgangsrelay sieht nur die entschlüsselte Nutzlast, niemals Ihre IP. Inspiriert von Apple Private Relay."

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "Kompromiss: etwa die Hälfte der Single-Hop-Bandbreite. Standardmäßig deaktiviert; Opt-in für Datenschutz. Nach Änderung dieser Einstellung ist ein Daemon-Neustart erforderlich."

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "Warren Multi-Hop"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "Wenn aktiviert, wird der Verkehr über zwei Warren-Relays (Eingang, dann Ausgang) mit HPKE-Ende-zu-Ende-Verschlüsselung zwischen Client und Ausgang geleitet. Das Eingangsrelay sieht nur Chiffretext; das Ausgangsrelay sieht nur die entschlüsselte Nutzlast, niemals die Benutzer-IP."

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "In Zwischenablage kopiert"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "In Zwischenablage kopieren"

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "Eine VPN-Erfahrung ohne Kompromisse beim Datenschutz. Keine Protokolle. Keine Konten. Kein Tracking. Nur Bandbreite."

msgctxt "warren-onboarding"
msgid "All set"
msgstr "Alles bereit"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "Erneut prüfen"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "Wird geprüft... (zum sofortigen Aktualisieren klicken)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "Konfiguration abgeschlossen. Wählen Sie ein Land aus und verbinden Sie sich mit Warren."

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "Weiter"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "Abonnementstatus konnte nicht überprüft werden. Bitte erneut versuchen."

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "Der Daemon hat noch keine Mnemonik, melden Sie sich an oder starten Sie die App neu."

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Mnemonik konnte nicht vom Daemon abgerufen werden."

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "Loslegen"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "Ich habe bereits ein Abonnement"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "Ich habe sie an einem sicheren Ort notiert."

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "Kein aktives Abonnement gefunden. Bitte zuerst eines erwerben."

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "Land auswählen und verbinden"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "Wählen Sie die Schutzmaßnahmen, die Sie von Anfang an möchten. Alle können später in den Einstellungen geändert werden."

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "Datenschutzeinstellungen"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "Assistenten überspringen (Fortgeschritten)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "Tarife ansehen (öffnet im Browser)"

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "Willkommen bei Warren VPN"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "Notieren Sie diese 12 Wörter in der richtigen Reihenfolge und bewahren Sie sie an einem sicheren Ort auf. Sie sind die einzige Möglichkeit, Ihr Abonnement wiederherzustellen, wenn Sie den Zugriff auf dieses Gerät verlieren."

msgctxt "warren-onboarding"
msgid "You don’t have an active subscription yet. You buy VPN time in advance, with no account to create. If you choose automatic monthly renewal, you can turn it off at any time, at no cost."
msgstr "Sie haben noch kein aktives Abonnement. Sie kaufen VPN-Zeit im Voraus, ohne ein Konto anzulegen. Wenn Sie die automatische monatliche Verlängerung wählen, können Sie sie jederzeit kostenlos abschalten."

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "Ihr Warren-Wallet"

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "Ihr Abonnement"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• Dauerhafte Verschleierung (standardmäßig EIN): HTTP/3-Mimikry, damit der Datenverkehr unauffällig bleibt."

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (standardmäßig AUS): Padding einfügen, um ML-Datenverkehrsanalysen zu vereiteln. ~5-15 % Bandbreite."

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-Hop (standardmäßig AUS): Routing über zwei Relays für Nicht-Verknüpfbarkeit von Ein-/Ausgang."

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "Details zur kryptografischen Diskrepanz"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "Ausgangs-ID"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "Standort"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "Neu beobachteter Schlüssel"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "Zuvor angeheftete Schlüssel"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "Ihre Auswahl wird verarbeitet, bitte warten."

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "Ablehnen (Verbindung trennen)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "Ablehnen und getrennt bleiben"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "An Warren melden"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "Server-Identität geändert"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "Der Warren-Ausgangsserver, dem Sie zuvor vertraut haben, weist jetzt eine andere kryptografische Identität auf."

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "Das bedeutet üblicherweise, dass der Betreiber den Schlüssel rotiert hat, kann aber auch darauf hinweisen, dass der Server ersetzt oder kompromittiert wurde. Lehnen Sie ab, wenn Sie keine Änderung erwartet haben."

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "Neuem Schlüssel vertrauen"

msgctxt "warren-status-view"
msgid "Last"
msgstr "Zuletzt"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "Verschleierung"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "Wiederverbindungen"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "inaktiv"

msgctxt "warren-status-view"
msgid "never"
msgstr "nie"

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "Öffnet einen öffentlichen Port auf dem verbundenen Exit-Server und leitet ihn an Ihr Gerät weiter. Nützlich für Peer-to-Peer-Anwendungen, Dateifreigabe oder selbst gehostete Dienste."

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "Portweiterleitung"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "Protokoll"

msgctxt "keys-view"
msgid "Backup keys"
msgstr "Schlüssel sichern"

msgctxt "keys-view"
msgid "Done"
msgstr "Fertig"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "Geben Sie Ihre BIP39-Wiederherstellungsphrase aus 12 (oder 24) Wörtern ein, durch Leerzeichen getrennt."

msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Die Wiederherstellungsphrase konnte nicht vom Dienst abgerufen werden."

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "Ich habe sie an einem sicheren Ort notiert."

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "Mir ist bewusst, dass dies meine aktuelle Identität dauerhaft ersetzt."

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "Identität wiederhergestellt. Ihr neues Warren-Wallet ist jetzt aktiv."

msgctxt "keys-view"
msgid "Keys"
msgstr "Schlüssel"

msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "Keine Wiederherstellungsphrase verfügbar, melden Sie sich an oder stellen Sie zuerst eine Identität wieder her."

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "Aus Wiederherstellungsphrase wiederherstellen"

msgctxt "keys-view"
msgid "Restore identity"
msgstr "Identität wiederherstellen"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "Wird wiederhergestellt …"

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "Wiederherstellungsphrase anzeigen"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "WARNUNG: Dies ERSETZT Ihre aktuelle Identität. Jedes mit der aktuellen Identität verknüpfte Abonnement wird unwiederbringlich verloren sein."

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "Notieren Sie sie auf Papier. Speichern Sie sie niemals in einer Cloud, als Screenshot oder in einer E-Mail."

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "Ihre Wiederherstellungsphrase aus 12 Wörtern ist die EINZIGE Möglichkeit, Ihre Warren-Identität auf einem anderen Gerät wiederherzustellen. Geht sie verloren, ist Ihr Abonnement unwiederbringlich verloren."

msgctxt "keys-view"
msgid "words"
msgstr "Wörter"

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "Meine Phrase sichern"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "Ich habe meine Wiederherstellungsphrase gesichert und verstehe, dass dieses Konto von diesem Gerät entfernt wird."

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "Wenn Sie Ihre Wiederherstellungsphrase nicht gesichert haben, geht Ihr Abonnement unwiderruflich verloren."

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "Von diesem Konto abmelden?"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "Beim Abmelden wird dieses Konto von diesem Gerät gelöscht. Es gibt keine E-Mail-Adresse und kein Passwort zum erneuten Anmelden, Ihre Wiederherstellungsphrase ist der EINZIGE Weg, es wiederherzustellen."

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "Sichern Sie Ihre Wiederherstellungsphrase"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "Die neue Wiederherstellungsphrase konnte nicht gelesen werden. Versuchen Sie es erneut."

msgctxt "login-view"
msgid "Discard"
msgstr "Verwerfen"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "Dieses neue Konto verwerfen?"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "Geben Sie Ihre 12-Wörter-Wiederherstellungsphrase durch Leerzeichen getrennt ein, um Ihr Konto auf diesem Gerät wiederherzustellen."

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "Gehen Sie nur zurück, wenn Sie ein Konto wiederherstellen wollten, das Sie bereits haben."

msgctxt "login-view"
msgid "I already have an account"
msgstr "Ich habe bereits ein Konto"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "Ich habe meine Wiederherstellungsphrase an einem sicheren Ort notiert."

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "Ungültige Wiederherstellungsphrase. Überprüfen Sie die Wörter und ihre Reihenfolge und versuchen Sie es erneut."

msgctxt "login-view"
msgid "Keep it"
msgstr "Behalten"

msgctxt "login-view"
msgid "Restore account"
msgstr "Konto wiederherstellen"

msgctxt "login-view"
msgid "Restore your account"
msgstr "Stellen Sie Ihr Konto wieder her"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "Das gerade erstellte Konto wird verworfen und seine Wiederherstellungsphrase wird nicht erneut angezeigt."

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren verwendet ein nicht-verwahrtes Wallet: Ihr Konto ist eine 12-Wörter-Wiederherstellungsphrase, die nur Sie besitzen."

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "Willkommen bei Warren"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "Schreiben Sie diese 12 Wörter auf und bewahren Sie sie sicher auf. Sie sind die einzige Möglichkeit, Ihr Konto wiederherzustellen, wenn Sie dieses Gerät verlieren."

msgctxt "connect-view"
msgid "I’ve completed payment"
msgstr "Ich habe die Zahlung abgeschlossen"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "Sitzung inaktiv"

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node’s public key has changed."
msgstr "Nichtübereinstimmung der Serveridentität erkannt. Der öffentliche Schlüssel des Exit-Knotens hat sich geändert."

msgid "OK"
msgstr "OK"

msgctxt "accessibility"
msgid "Copy public key"
msgstr "Öffentlichen Schlüssel kopieren"

#. Accessibility label of the control that copies
#. the voucher code to the clipboard.
msgctxt "accessibility"
msgid "Copy the voucher code"
msgstr "Gutscheincode kopieren"

msgctxt "account-view"
msgid "Backup keys"
msgstr "Schlüssel sichern"

msgctxt "account-view"
msgid "Could not log out: the VPN did not disconnect in time. You are still logged in."
msgstr "Abmelden nicht möglich: Die VPN-Verbindung wurde nicht rechtzeitig getrennt. Sie sind weiterhin angemeldet."

msgctxt "account-view"
msgid "Something went wrong while logging out."
msgstr "Beim Abmelden ist ein Fehler aufgetreten."

#. Button that runs a logout again after it failed.
msgctxt "account-view"
msgid "Try again"
msgstr "Erneut versuchen"

msgctxt "auth-failure"
msgid "Blocking internet: this device has been revoked. Log in again to connect, or disconnect to unblock the internet."
msgstr "Internet wird blockiert: Dieses Gerät wurde widerrufen. Melden Sie sich erneut an, um eine Verbindung herzustellen, oder trennen Sie die Verbindung, um die Internetsperre aufzuheben."

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "Wird geprüft... (zum sofortigen Aktualisieren klicken)"

msgctxt "connect-view"
msgid "Here’s your public key. Save it!"
msgstr "Hier ist Ihr öffentlicher Schlüssel. Speichern Sie ihn!"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "Portweiterleitung: %(ports)s"

msgctxt "connection-info"
msgid "Multihop (2 hops)"
msgstr "Multihop (2 Hops)"

msgctxt "in-app-notifications"
