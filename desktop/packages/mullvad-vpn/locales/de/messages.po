msgid "Edit name"
msgstr "Name bearbeiten"

msgctxt "custom-list-feature"
msgid "Enter a name for the list"
msgstr "Geben Sie einen Namen für die Liste ein"

msgctxt "custom-list-feature"
msgid "Enter a new name for the list"
msgstr "Geben Sie einen neuen Namen für die Liste ein"

msgctxt "custom-list-feature"
msgid "List names must be unique"
msgstr "Die Namen der Listen müssen eindeutig sein"

