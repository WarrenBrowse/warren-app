msgstr "Sonstiges"

msgctxt "port-forwarding-view"
msgid "phishing"
msgstr "Phishing"

msgctxt "port-forwarding-view"
msgid "Port %(port)d was closed after an abuse report. %(client)s keeps its port until you apply one."
msgstr "Port %(port)d wurde nach einer Missbrauchsmeldung geschlossen. %(client)s behält seinen bisherigen Port, bis Sie einen neuen anwenden."

msgctxt "port-forwarding-view"
msgid "refused, retrying"
msgstr "abgelehnt, erneuter Versuch"

msgctxt "port-forwarding-view"
msgid "scanning or intrusion"
msgstr "Scan oder Eindringversuch"

msgctxt "port-forwarding-view"
msgid "spam"
msgstr "Spam"

msgctxt "port-forwarding-view"
msgid "To contest a warning, write to %(email)s quoting its case reference."
msgstr "Um Einspruch gegen eine Verwarnung zu erheben, schreiben Sie an %(email)s und geben Sie das zugehörige Aktenzeichen an."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d of %(threshold)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Verwarnung %(ordinal)d von %(threshold)d: Port %(port)d wurde am %(day)s nach einer Missbrauchsmeldung geschlossen (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warning %(ordinal)d: port %(port)d was closed on %(day)s after an abuse report (%(category)s)."
msgstr "Verwarnung %(ordinal)d: Port %(port)d wurde am %(day)s nach einer Missbrauchsmeldung geschlossen (%(category)s)."

msgctxt "port-forwarding-view"
msgid "Warnings"
msgstr "Verwarnungen"

msgctxt "port-forwarding-view"
msgid "Warnings and how to contest them"
msgstr "Verwarnungen und wie Sie Einspruch erheben"

msgctxt "redeem-voucher-view"
msgid "The voucher was not used: keep it and redeem it once the revocation ends."
msgstr "Der Gutschein wurde nicht verwendet: Bewahren Sie ihn auf und lösen Sie ihn ein, sobald der Zugangsentzug endet."

