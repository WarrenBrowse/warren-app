msgid "applying…"
msgstr "wird angewendet…"

msgctxt "port-forwarding-view"
msgid "failed"
msgstr "fehlgeschlagen"

msgctxt "port-forwarding-view"
msgid "no port available"
msgstr "kein Port verfügbar"

msgctxt "port-forwarding-view"
msgid "open: %(port)d"
msgstr "offen: %(port)d"

msgctxt "port-forwarding-view"
msgid "pending…"
msgstr "ausstehend…"

msgctxt "port-forwarding-view"
msgid "port"
msgstr "Port"

msgctxt "port-forwarding-view"
msgid "port in use"
msgstr "Port belegt"

msgctxt "port-forwarding-view"
msgid "requesting…"
msgstr "wird angefordert…"

msgctxt "redeem-voucher-view"
msgid "It looks like you’ve entered a public key instead of a voucher code. If you would like to change the active account, please log out first."
msgstr "Es sieht so aus, als hätten Sie einen öffentlichen Schlüssel statt eines Gutscheincodes eingegeben. Wenn Sie das aktive Konto wechseln möchten, melden Sie sich bitte zuerst ab."

msgctxt "settings-view"
msgid "Port forwarding"
msgstr "Portweiterleitung"

msgctxt "settings-view"
msgid "Replay onboarding"
msgstr "Einführung erneut abspielen"

msgctxt "vpn-settings-view"
msgid "Dropped %(count)s pinned exit key entries."
msgstr "%(count)s angeheftete Exit-Schlüsseleinträge entfernt."

msgctxt "vpn-settings-view"
msgid "Every Warren exit you previously connected to will be re-pinned on the next connection (Trust On First Use)."
msgstr "Jeder Warren-Exit, mit dem Sie sich zuvor verbunden haben, wird bei der nächsten Verbindung erneut angeheftet (Trust On First Use)."

msgctxt "vpn-settings-view"
msgid "Pin table cleared"
msgstr "Anheftungstabelle geleert"

msgctxt "vpn-settings-view"
msgid "Reset"
msgstr "Zurücksetzen"

