msgid "Add method"
msgstr "添加方法"

msgctxt "api-access-methods-view"
msgid "Adding a new API access method also tests it."
msgstr "添加新的 API 访问方法也会对其进行测试。"

msgctxt "api-access-methods-view"
msgid "API reachable"
msgstr "可通过 API 访问"

msgctxt "api-access-methods-view"
