msgstr "可通过 API 访问，正在保存方法…"

msgctxt "api-access-methods-view"
msgid "API unreachable"
msgstr "无法通过 API 访问"

msgctxt "api-access-methods-view"
msgid "API unreachable, add anyway?"
msgstr "无法通过 API 访问，仍然添加？"

