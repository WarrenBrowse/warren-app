msgstr "Blocarea accesului la internet: contul a expirat"

msgctxt "auth-failure"
msgid "Too many simultaneous connections on this account. Disconnect another device or try connecting again shortly."
msgstr "Există prea multe conexiuni simultane pe acest cont. Deconectați un alt dispozitiv sau încercați să vă reconectați în scurt timp."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please send a problem report."
msgstr "Nu se poate autentifica contul. Vă rugăm să trimiteți un raport de eroare."

msgctxt "auth-failure"
