msgid "Language"
msgstr "Limba"

msgctxt "user-interface-settings-view"
msgid "Monochromatic tray icon"
msgstr "Pictogramă monocromă pentru tavă"

msgctxt "user-interface-settings-view"
msgid "Notifications"
msgstr "Notificări"

msgctxt "user-interface-settings-view"
msgid "Show only the tray icon when the app starts."
msgstr "Afișați doar pictograma din bara de sistem la pornirea aplicației."

msgctxt "user-interface-settings-view"
msgid "Start minimized"
msgstr "Pornește în modul minimizat"

msgctxt "user-interface-settings-view"
msgid "Unpin app from taskbar"
msgstr "Deschide aplicația din bara de activități"

msgctxt "user-interface-settings-view"
msgid "Use a monochromatic tray icon instead of a colored one."
msgstr "Folosiți o pictogramă monocromă pentru bara de activități, în loc de una colorată."

#. Title label in navigation bar
msgctxt "user-interface-settings-view"
msgid "User interface settings"
msgstr "Setări ale interfeței cu utilizatorul"

msgctxt "vpn-settings-view"
msgid "Add a server"
msgstr "Adăugați un server"

#. Button label to add a private IP DNS server despite warning.
msgctxt "vpn-settings-view"
msgid "Add anyway"
msgstr "Adăugați oricum"

#. Label for settings that enables ad blocking.
msgctxt "vpn-settings-view"
msgid "Ads"
msgstr "Reclame"

#. Label for settings that enables block of adult content.
msgctxt "vpn-settings-view"
msgid "Adult content"
msgstr "Conținut pentru adulți"

#. Label for list item that navigates to anti-censorship
#. settings view.
msgctxt "vpn-settings-view"
msgid "Anti-censorship"
msgstr "Împotriva cenzurii"

msgctxt "vpn-settings-view"
msgid "Attention: enabling this will always require a Warren VPN connection in order to reach the internet."
msgstr "Atenție: activarea acestei opțiuni va necesita întotdeauna o conexiune VPN Warren pentru a accesa internetul."

msgctxt "vpn-settings-view"
msgid "Attention: this setting cannot be used in combination with <b>%(customDnsFeatureName)s</b>"
msgstr "Atenție: această setare nu poate fi utilizată împreună cu <b>%(customDnsFeatureName)s</b>"

msgctxt "vpn-settings-view"
msgid "Auto-connect"
msgstr "Conectare automată"

msgctxt "vpn-settings-view"
msgid "Automatically connect to a server when the app launches."
msgstr "Conectați-vă automat la un server la lansarea aplicației."

#. This is displayed when the custom DNS setting is turned on which makes the block
#. ads/trackers settings disabled. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(customDnsFeatureName)s - The name displayed next to the custom DNS toggle.
msgctxt "vpn-settings-view"
msgid "Disable \"%(customDnsFeatureName)s\" below to activate these settings."
msgstr "Dezactivați opțiunea „%(customDnsFeatureName)s” de mai jos pentru a activa aceste setări."

#. This is displayed when either or both of the block ads/trackers settings are
#. turned on which makes the custom DNS setting disabled.
#. Available placeholders:
#. %(preferencesPageName)s - The page title showed on top in the preferences page.
msgctxt "vpn-settings-view"
msgid "Disable all <b>DNS content blockers</b> above to activate this setting."
msgstr "Dezactivați toate <b>blocatoarele de conținut DNS</b> de mai sus pentru a activa această setare."

msgctxt "vpn-settings-view"
msgid "DNS content blockers"
msgstr "Programe de blocare a conținutului DNS"

#. %(count)s = number of pin entries dropped.
msgctxt "vpn-settings-view"
msgid "Dropped %(count)s pinned exit key entries."
msgstr "Au fost eliminate intrările legate de tasta de ieșire fixată d%(count)s."

msgctxt "vpn-settings-view"
msgid "Enable to add at least one DNS server."
msgstr "Permite adăugarea a cel puțin unui server DNS."

#. Description of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "Enable to allow IPv6 traffic through the tunnel."
msgstr "Activați această opțiune pentru a permite traficul IPv6 prin tunel."

msgctxt "vpn-settings-view"
msgid "Enter IP"
msgstr "Introduceți adresa IP"

msgctxt "vpn-settings-view"
msgid "Every Warren exit you previously connected to will be re-pinned on the next connection (Trust On First Use)."
msgstr "Fiecare ieșire Warren la care v-ați conectat anterior va fi reasociată la următoarea conexiune (Trust On First Use)."

#. Label for settings that enables block of gamling related websites.
msgctxt "vpn-settings-view"
msgid "Gambling"
msgstr "Jocurile de noroc"

#. Title of in-tunnel IPv6 setting.
msgctxt "vpn-settings-view"
msgid "In-tunnel IPv6"
msgstr "IPv6 în tunel"

msgctxt "vpn-settings-view"
msgid "IPv4 is always enabled and the majority of websites and applications use this protocol. We do not recommend enabling IPv6 unless you know you need it."
msgstr "IPv4 este întotdeauna activat, iar majoritatea site-urilor web și a aplicațiilor utilizează acest protocol. Nu recomandăm activarea IPv6 decât dacă știți cu siguranță că aveți nevoie de el."

#. A complimentary description for the setting Device IP version,
#. explaining why the user might want to configure the setting.
msgctxt "vpn-settings-view"
msgid "It can be useful when you are aware of problems caused by a certain IP version."
msgstr "Poate fi util să știi care sunt problemele cauzate de o anumită versiune IP."

msgctxt "vpn-settings-view"
msgid "It does this by allowing network communication outside the tunnel to local multicast and broadcast ranges as well as to and from these private IP ranges:"
msgstr "Acest lucru se realizează prin permiterea comunicării în rețea în afara tunelului către intervalele locale de multicast și difuzare, precum și către și dinspre aceste intervale de adrese IP private:"

msgctxt "vpn-settings-view"
msgid "Kill switch"
msgstr "Kill Switch de oprire de urgență"

msgctxt "vpn-settings-view"
msgid "Launch app on start-up"
msgstr "Pornește aplicația la pornirea sistemului"

msgctxt "vpn-settings-view"
msgid "Local network sharing"
msgstr "Partajarea rețelei locale"

msgctxt "vpn-settings-view"
msgid "Lockdown mode"
msgstr "Mod Blocare"

#. Label for settings that enables malware blocking.
msgctxt "vpn-settings-view"
msgid "Malware"
msgstr "Malware"

msgctxt "vpn-settings-view"
msgid "Pin table cleared"
msgstr "Tabelul cu pin-uri a fost șters"

#. CTA opening the confirmation modal that
#. wipes the TOFU pin table.
msgctxt "vpn-settings-view"
msgid "Reset"
msgstr "Resetare"

msgctxt "vpn-settings-view"
msgid "Reset all"
msgstr "Resetați tot"

msgctxt "vpn-settings-view"
msgid "Reset failed"
msgstr "Resetarea a eșuat"

#. Label for the action that clears every entry
#. from the Warren TOFU pubkey pin table.
msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys"
msgstr "Resetare taste de ieșire fixate"

msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys?"
msgstr "Să resetez tastele de ieșire fixate?"

msgctxt "vpn-settings-view"
msgid "Restart the daemon for the change to take effect."
msgstr "Reporniți serviciul pentru ca modificarea să intre în vigoare."

msgctxt "vpn-settings-view"
msgid "Server IP override"
msgstr "Suprascrierea adresei IP a serverului"

#. Label for settings that enables block of social media.
msgctxt "vpn-settings-view"
msgid "Social media"
msgstr "Rețelele sociale"

msgctxt "vpn-settings-view"
msgid "The app’s built-in kill switch is always on. This setting will additionally block the internet if clicking Disconnect or Quit."
msgstr "Funcția de Kill Switch integrată în aplicație este activată permanent. Această setare va bloca, de asemenea, conexiunea la internet dacă dai clic pe „Deconectare” sau „Ieșire”."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents."
msgstr "Diferența dintre funcția „Kill Switch” și Modul Blocare constă în faptul că funcția „Kill Switch” va împiedica orice scurgere de date în timpul reconectărilor automate ale tunelului, al blocărilor software-ului și al altor incidente similare."

msgctxt "vpn-settings-view"
msgid "The difference between the Kill Switch and Lockdown Mode is that the Kill Switch will prevent any leaks from happening during automatic tunnel reconnects, software crashes and similar accidents. With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Diferența dintre funcția Kill Switch și Modul Blocare constă în faptul că funcția Kill Switch va împiedica apariția oricăror scurgeri de date în timpul reconectărilor automate la tunel, a blocărilor software și a altor incidente similare. Când Modul Blocare este activat, trebuie să fiți conectat la un server VPN Warren pentru a putea accesa internetul. Deconectarea manuală sau închiderea aplicației va bloca conexiunea."

msgctxt "vpn-settings-view"
msgid "The DNS server you want to add is a private IP. You must ensure that your network interfaces are configured to use it."
msgstr "Serverul DNS pe care doriți să îl adăugați are o adresă IP privată. Trebuie să vă asigurați că interfețele de rețea sunt configurate să îl utilizeze."

msgctxt "vpn-settings-view"
msgid "This built-in feature prevents your traffic from leaking outside of the VPN tunnel if your network suddenly stops working or if the tunnel fails, it does this by blocking your traffic until your connection is reestablished."
msgstr "Această funcție integrată împiedică scurgerea traficului în afara tunelului VPN în cazul în care rețeaua se întrerupe brusc sau tunelul se defectează; aceasta se realizează prin blocarea traficului până la restabilirea conexiunii."

msgctxt "vpn-settings-view"
msgid "This feature allows access to other devices on the local network, such as for sharing, printing, streaming, etc."
msgstr "Această funcție permite accesul la alte dispozitive din rețeaua locală, de exemplu pentru partajare, imprimare, redare în flux etc."

#. A description for the setting Device IP version,
#. explaining how the user can configure the setting.
msgctxt "vpn-settings-view"
msgid "This feature allows you to choose whether to use only IPv4, only IPv6, or allow the app to automatically decide the best option when connecting to a server."
msgstr "Această funcție vă permite să alegeți dacă doriți să utilizați doar IPv4, doar IPv6 sau să lăsați aplicația să aleagă automat cea mai bună opțiune la conectarea la un server."

msgctxt "vpn-settings-view"
msgid "This might cause issues on certain websites, services, and apps."
msgstr "Acest lucru ar putea cauza probleme pe anumite site-uri web, servicii și aplicații."

#. Label for settings that enables tracker blocking.
msgctxt "vpn-settings-view"
msgid "Trackers"
msgstr "Dispozitive de urmărire"

msgctxt "vpn-settings-view"
msgid "Until the new pins are established the substitution-detection guard is briefly down: an attacker who replaced an exit between resets would not be flagged on the first reconnect."
msgstr "Până la stabilirea noilor pini, mecanismul de detectare a substituirii este temporar dezactivat: un atacator care a înlocuit o ieșire între resetări nu ar fi semnalat la prima reconectare."

msgctxt "vpn-settings-view"
msgid "URL of the warren-api server. Format http(s)://host:port. Empty = unset (fallback to default). Restart the daemon for the change to take effect."
msgstr "Adresa URL a serverului warren-api. Format: http(s)://host:port. Câmp gol = neconfigurat (se utilizează valoarea implicită). Reporniți serviciul pentru ca modificarea să intre în vigoare."

msgctxt "vpn-settings-view"
msgid "Use custom DNS server"
msgstr "Utilizați un server DNS personalizat"

#. Title label in navigation bar
msgctxt "vpn-settings-view"
msgid "VPN settings"
msgstr "Setări VPN"

msgctxt "vpn-settings-view"
msgid "Warning: The malware blocker is not an anti-virus and should not be treated as such, this is just an extra layer of protection."
msgstr "Atenție: Programul de blocare a programelor malware nu este un antivirus și nu trebuie considerat ca atare; acesta reprezintă doar un nivel suplimentar de protecție."

msgctxt "vpn-settings-view"
msgid "Warren api URL"
msgstr "URL-ul API-ului Warren"

msgctxt "vpn-settings-view"
msgid "Warren local account"
msgstr "Contul local Warren"

msgctxt "vpn-settings-view"
msgid "Warren tunnel mode"
msgstr "Modul tunel Warren"

msgctxt "vpn-settings-view"
msgid "When enabled, the daemon uses a self-hosted account derived from the local Warren mnemonic instead of contacting a remote account API."
msgstr "Când această opțiune este activată, daemonul utilizează un cont auto-găzduit, generat pe baza frazei mnemonice Warren locale, în loc să contacteze API-ul unui cont la distanță."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled it stops the device from contacting certain domains or websites known for distributing ads, malware, trackers and more."
msgstr "Când această funcție este activată, ea împiedică dispozitivul să acceseze anumite domenii sau site-uri web cunoscute pentru distribuirea de reclame, programe malware, modulele de urmărire și altele."

msgctxt "vpn-settings-view"
msgid "When this feature is enabled, IPv6 can be used alongside IPv4 in the VPN tunnel to communicate with internet services."
msgstr "Când această funcție este activată, IPv6 poate fi utilizat împreună cu IPv4 în tunelul VPN pentru a comunica cu serviciile de internet."

msgctxt "vpn-settings-view"
msgid "With Lockdown Mode enabled, you must be connected to a Warren VPN server to be able to reach the internet. Manually disconnecting or quitting the app will block your connection."
msgstr "Când Modul Blocare este activat, trebuie să fiți conectat la un server VPN Warren pentru a putea accesa internetul. Dacă vă deconectați manual sau închideți aplicația, conexiunea dvs. va fi blocată."

#. Value shown for the bandwidth limit in beta builds.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "vpn-settings-view"
msgid "%(mbps)d Mbps"
msgstr "%(mbps)d Mbps"

#. Feature indicator shown when the advanced "Allow external DNS resolvers"
#. setting is on, i.e. DNS leak protection is relaxed.
msgctxt "vpn-settings-view"
msgid "Allow external DNS"
msgstr "Permite DNS extern"

#. Label for the advanced setting that allows DNS queries to resolvers
#. other than the configured one.
msgctxt "vpn-settings-view"
msgid "Allow external DNS resolvers"
msgstr "Permite servere DNS externe"

#. Hint below the bandwidth limit row in beta builds.
msgctxt "vpn-settings-view"
msgid "Bandwidth is limited by the free beta network and enforced by the servers. This setting is unavailable during the beta."
msgstr "Lățimea de bandă este limitată de rețeaua beta gratuită și impusă de servere. Această setare nu este disponibilă în perioada beta."

msgctxt "vpn-settings-view"
msgid "Connect to a single self-hosted exit you enter manually, bypassing the verified server list. Only use an exit you operate or fully trust: it sees your unencrypted traffic."
msgstr "Conectare la un singur server de ieșire găzduit de dvs., introdus manual, ocolind lista de servere verificate. Folosiți doar un server pe care îl administrați sau în care aveți încredere deplină: acesta vede traficul dvs. necriptat."

msgctxt "vpn-settings-view"
msgid "Cover domain (optional)"
msgstr "Domeniu de acoperire (opțional)"

msgctxt "vpn-settings-view"
msgid "Custom exit (advanced)"
msgstr "Server de ieșire personalizat (avansat)"

msgctxt "vpn-settings-view"
msgid "Endpoint"
msgstr "Punct final"

msgctxt "vpn-settings-view"
msgid "Exit address as host:port. Bracket IPv6, for example [2001:db8::1]:443."
msgstr "Adresa serverului de ieșire în formatul host:port. Puneți adresele IPv6 între paranteze drepte, de exemplu [2001:db8::1]:443."

msgctxt "vpn-settings-view"
msgid "For advanced users. When enabled, the firewall stops blocking DNS queries to resolvers other than the configured one, so tools like \"dig @1.1.1.1\" work while connected."
msgstr "Pentru utilizatori avansați. Când este activată, firewall-ul nu mai blochează interogările DNS către alte servere decât cel configurat, astfel încât instrumente precum „dig @1.1.1.1” funcționează în timp ce sunteți conectat."

#. The hint displayed below the bandwidth limit input field.
#. Available placeholders:
#. %(max)d - the maximum accepted value in Mbps
#. %(min)d - the minimum accepted value in Mbps
msgctxt "vpn-settings-view"
msgid "Limit the VPN bandwidth in Mbps, applied to upload and download separately. Valid range: %(min)d - %(max)d. Leave empty for no limit. Applies immediately."
msgstr "Limitați lățimea de bandă VPN în Mbps, aplicată separat la încărcare și la descărcare. Interval valid: %(min)d - %(max)d. Lăsați gol pentru a nu aplica nicio limită. Se aplică imediat."

msgctxt "vpn-settings-view"
msgid "Managed"
msgstr "Gestionat"

#. The title for the bandwidth limit setting.
msgctxt "vpn-settings-view"
msgid "Max bandwidth"
msgstr "Lățime de bandă maximă"

msgctxt "vpn-settings-view"
msgid "Set only when the exit runs a public TLS certificate (X.509 mode). Leave empty for the default raw-key mode."
msgstr "Completați doar dacă serverul de ieșire folosește un certificat TLS public (modul X.509). Lăsați gol pentru modul implicit cu cheie brută."

msgctxt "vpn-settings-view"
msgid "The exit's Ed25519 public key, 64 hexadecimal characters."
msgstr "Cheia publică Ed25519 a serverului de ieșire, 64 de caractere hexazecimale."

msgctxt "vpn-settings-view"
msgid "The exit's routing id, 32 hexadecimal characters."
msgstr "Identificatorul de rutare al serverului de ieșire, 32 de caractere hexazecimale."

msgctxt "vpn-settings-view"
msgid "The exit's X25519 multi-hop key, 64 hexadecimal characters."
msgstr "Cheia X25519 multi-hop a serverului de ieșire, 64 de caractere hexazecimale."

msgctxt "vpn-settings-view"
msgid "The queries still travel through the VPN tunnel, but the resolver you choose will see them. Leave this off unless you are testing remote DNS resolution."
msgstr "Interogările trec în continuare prin tunelul VPN, dar serverul DNS ales de dvs. le va vedea. Lăsați această opțiune dezactivată dacă nu testați rezolvarea DNS la distanță."

#. Placeholder shown when no bandwidth limit is set.
msgctxt "vpn-settings-view"
msgid "Unlimited"
msgstr "Nelimitat"

msgctxt "vpn-settings-view"
msgid "X25519 multi-hop key"
msgstr "Cheie X25519 multi-hop"

msgctxt "vpn-settings-view"
msgid "Exit ID"
msgstr "ID ieșire"

msgctxt "vpn-settings-view"
msgid "Public key"
msgstr "Cheie publică"

msgctxt "warren-multi-hop-view"
msgid "auto"
msgstr "auto"

msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "Țara de intrare"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "Țara de ieșire"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "Expectați că lățimea de bandă va fi aproximativ la jumătate, în schimbul imposibilității de a face legătura între adresa IP a utilizatorului și cea a destinației. Opțiunea este dezactivată în mod implicit; activați-o pentru a vă proteja confidențialitatea."

msgctxt "warren-multi-hop-view"
msgid "Optional: pin the entry and exit relay countries (ISO 3166 alpha-2 codes such as fr, de, se). Leave empty for auto-pick."
msgstr "Opțional: introduceți codurile țărilor de intrare și de ieșire (coduri ISO 3166 alfa-2, cum ar fi fr, de, se). Lăsați câmpul gol pentru selectare automată."

msgctxt "warren-multi-hop-view"
msgid "Restart the Warren daemon after changing this setting."
msgstr "Reporniți serviciul Warren după ce modificați această setare."

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "Direcționează traficul prin două relee Warren, utilizând criptarea end-to-end HPKE. Releul de intrare vede doar textul cifrat, iar cel de ieșire vede doar încărcătura utilă decriptată, fără a avea acces la adresa dvs. IP. Model inspirat de Apple Private Relay."

msgctxt "warren-multi-hop-view"
msgid "Single-hop Warren active. Full bandwidth, identical privacy guarantees as the single-hop default mode."
msgstr "Modul activ Warren cu un singur salt. Lățime de bandă completă, garanții de confidențialitate identice cu cele ale modului implicit cu un singur salt."

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "Compromis: aproximativ jumătate din lățimea de bandă single-hop. Opțiune dezactivată implicit; se activează manual pentru a asigura confidențialitatea. Este necesară repornirea serviciului după modificarea acestei setări."

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "Warren multi-hop"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "Când această opțiune este activată, traficul este redirecționat prin două relee Warren (intrare, apoi ieșire), utilizând criptarea end-to-end HPKE între client și punctul de ieșire. Releul de intrare vede doar textul cifrat, iar cel de ieșire vede doar încărcătura utilă decriptată, fără a avea acces la adresa IP a utilizatorului."

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "Copiat în clipboard"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "Copiați în clipboard"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• Ofuscare permanentă (activată implicit): mimetism HTTP/3 pentru ca traficul să se confunde cu cel normal."

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (dezactivat implicit): adaugă padding pentru a contracara analiza traficului bazată pe învățare automată. ~5-15% din lățimea de bandă."

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-hop (dezactivat implicit): rutare prin două relee pentru a asigura imposibilitatea corelării intrării cu ieșirea."

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "O experiență VPN fără compromisuri în ceea ce privește confidențialitatea. Fără loguri. Fără conturi. Fără urmărire. Doar lățime de bandă."

msgctxt "warren-onboarding"
msgid "All set"
msgstr "Totul e gata"

msgctxt "warren-onboarding"
msgid "Create my new wallet (recommended)"
msgstr "Creați-mi un portofel nou (recomandat)"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "Se verifică... (dă clic pentru a reîmprospăta pagina)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "Configurarea s-a finalizat. Alegeți o țară și conectați-vă la Warren."

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "Continuați"

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "Serviciul nu are încă o frază mnemonică, autentificați-vă sau reporniți aplicația."

msgctxt "warren-onboarding"
msgid "Daemon rejected the mnemonic. Check spelling and word count, then try again."
msgstr "Serviciul a respins fraza mnemonică. Verificați ortografia și numărul de cuvinte, apoi încercați din nou."

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Nu s-a putut prelua fraza mnemonică de la demon."

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "Începeți"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "Am deja un abonament"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "Am pus-o la loc sigur."

msgctxt "warren-onboarding"
msgid "Import an existing mnemonic"
msgstr "Importați o frază mnemonică existentă"

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "Nu s-a găsit niciun abonament activ. Vă rugăm să achiziționați unul mai întâi."

msgctxt "warren-onboarding"
msgid "Paste your 12-word BIP39 mnemonic to restore your existing Warren identity."
msgstr "Lipiți frază mnemonică BIP39 formată din 12 cuvinte pentru a vă restabili identitatea Warren existentă."

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "Alegeți o țară și conectați-vă"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "Alegeți opțiunile de securitate dorite încă din prima zi. Le puteți modifica ulterior din secțiunea Setări."

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "Preferințe de confidențialitate"

msgctxt "warren-onboarding"
msgid "Restore wallet"
msgstr "Restaurați portofelul"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "Omiteți asistentul (opțiuni avansate)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "Vizualizați planurile (se deschide în browserul dvs.)"

msgctxt "warren-onboarding"
msgid "Warren uses a non-custodial wallet (Ed25519 + BIP39). You own the keys; we never see them."
msgstr "Warren utilizează un portofel non-custodial (Ed25519 + BIP39). Cheile vă aparțin; noi nu le vedem niciodată."

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "Bine ați venit la Warren VPN"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "Notați aceste 12 cuvinte în ordine și păstrați-le într-un loc sigur. Este singura modalitate de a vă restaura abonamentul dacă pierdeți accesul la acest dispozitiv."

msgctxt "warren-onboarding"
msgid "You don't have an active subscription yet. Plans start at a few euros per month - no recurring billing, no account creation, pay as you go."
msgstr "Încă nu aveți un abonament activ. Tarifele încep de la câțiva euro pe lună, fără facturare recurentă, fără crearea unui cont, plătiți doar ce folosiți."

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "Abonamentul dumneavoastră"

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "Portofelul dvs. Warren"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "Verificați din nou"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "Nu s-a putut verifica starea abonamentului. Vă rugăm să încercați din nou."

#. Description of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "A prepaid beta access voucher is linked to your account automatically. No payment, nothing to do."
msgstr "Un voucher preplătit de acces beta este asociat automat contului dvs. Nicio plată, nimic de făcut."

#. Confirmation that the beta access is active.
#. Available placeholders:
#. %(date)s - the expiry date of the granted access
msgctxt "warren-onboarding"
msgid "Beta access active until %(date)s."
msgstr "Acces beta activ până la %(date)s."

#. Error shown when the beta access could not be activated yet.
msgctxt "warren-onboarding"
msgid "Could not activate the beta access yet (are you online?). Retrying automatically, and again at next launch. You can continue anyway."
msgstr "Accesul beta nu a putut fi activat încă (sunteți online?). Se reîncearcă automat, precum și la următoarea pornire. Puteți continua oricum."

#. Link shown under onboarding errors pointing to the public help page.
msgctxt "warren-onboarding"
msgid "Having trouble? Visit our help page"
msgstr "Aveți probleme? Vizitați pagina noastră de ajutor"

msgctxt "warren-onboarding"
msgid "Retry now"
msgstr "Reîncercați acum"

#. Beta onboarding line describing the degraded service.
#. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with bandwidth capped at %(mbps)d Mbps. These are not the final service conditions."
msgstr "Versiunea beta funcționează pe o rețea separată, gratuită, cu lățimea de bandă limitată la %(mbps)d Mbps. Acestea nu sunt condițiile finale ale serviciului."

msgctxt "warren-onboarding"
msgid "The beta runs on a free, separate network with limited bandwidth. These are not the final service conditions."
msgstr "Versiunea beta funcționează pe o rețea separată, gratuită, cu lățime de bandă limitată. Acestea nu sunt condițiile finale ale serviciului."

#. Title of the beta onboarding access step.
msgctxt "warren-onboarding"
msgid "Your beta access"
msgstr "Accesul dvs. beta"

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "Detalii privind neconcordanțele criptografice"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "ID ieșire"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "Locație"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "Cheie recent observată"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "Cheie marcată anterior"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "Se procesează opțiunea aleasă, vă rugăm să așteptați."

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "Respingeți (deconectați)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "Respingeți și rămâneți deconectat"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "Raport către Warren"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "Identitatea serverului s-a modificat"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "Serverul de ieșire Warren în care ați avut anterior încredere prezintă acum o identitate criptografică diferită."

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "De obicei, acest lucru înseamnă că operatorul a schimbat cheia, dar poate indica și faptul că serverul a fost înlocuit sau compromis. Refuzați dacă nu vă așteptați la o astfel de schimbare."

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "Confirmați noua cheie"

msgctxt "warren-pubkey-warning"
msgid "Could not find that exit server anymore. Try reconnecting."
msgstr "Acest server de ieșire nu mai poate fi găsit. Încercați să vă reconectați."

msgctxt "warren-pubkey-warning"
msgid "Could not save the new key. Please try again."
msgstr "Noua cheie nu a putut fi salvată. Încercați din nou."

msgctxt "warren-pubkey-warning"
msgid "Could not trust the new key."
msgstr "Nu s-a putut acorda încredere noii chei."

msgctxt "warren-pubkey-warning"
msgid "The key changed again before it could be trusted. Review the new key and try again."
msgstr "Cheia s-a schimbat din nou înainte de a i se putea acorda încredere. Verificați noua cheie și încercați din nou."

msgctxt "warren-status-view"
msgid "HTTP/3 mimicry (active)"
msgstr "Mimetismul HTTP/3 (activ)"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "inactiv"

msgctxt "warren-status-view"
msgid "Last"
msgstr "Ultimul"

msgctxt "warren-status-view"
msgid "Legacy obfuscation methods (Shadowsocks, UDP-over-TCP, QUIC, LWO) do not apply when warren_mode is on."
msgstr "Metodele de ofuscare tradiționale (Shadowsocks, UDP-over-TCP, QUIC, LWO) nu se aplică atunci când opțiunea warren_mode este activată."

msgctxt "warren-status-view"
msgid "never"
msgstr "niciodată"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "Ofuscare"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "Se reconectează"

#. Title label in navigation bar
msgctxt "wireguard-settings-nav"
msgid "Shadowsocks"
msgstr "Shadowsocks"

#. Title label in navigation bar
msgctxt "wireguard-settings-nav"
msgid "UDP-over-TCP"
msgstr "UDP peste TCP"

msgctxt "wireguard-settings-view"
msgid "%(daita)s (%(daitaFull)s) hides patterns in your encrypted VPN traffic."
msgstr "%(daita)s (%(daitaFull)s) ascunde tiparele din traficul dvs. VPN criptat."

msgctxt "wireguard-settings-view"
msgid "%(daita)s does this by carefully adding network noise and making all network packets the same size."
msgstr "%(daita)s realizează acest lucru prin adăugarea atentă a zgomotului de rețea și prin uniformizarea dimensiunii tuturor pachetelor de rețea."

msgctxt "wireguard-settings-view"
msgid "%(wireguard)s port"
msgstr "%(wireguard)s port"

#. Page title for QUIC port view
msgctxt "wireguard-settings-view"
msgid "%(wireGuard)s port"
msgstr "%(wireGuard)s port"

msgctxt "wireguard-settings-view"
msgid "Attention: This increases network traffic and will also negatively affect speed, latency, and battery usage. Use with caution on limited plans."
msgstr "Atenție: această funcție crește traficul de rețea și va afecta negativ viteza, latența și consumul bateriei. Se recomandă utilizarea cu precauție în cazul abonamentelor cu date limitate."

msgctxt "wireguard-settings-view"
msgid "By enabling “%(directOnly)s” you will have to manually select a server that is %(daita)s-enabled. This can cause you to end up in a blocked state until you have selected a compatible server in the “Select location” view."
msgstr "Dacă activați opțiunea „%(directOnly)s”, va trebui să selectați manual un server care acceptă funcția „%(daita)s”. Acest lucru poate duce la blocarea aplicației până când selectați un server compatibil în fereastra „Selectați locația”."

msgctxt "wireguard-settings-view"
msgid "By using sophisticated AI it’s possible to analyze the traffic of data packets going in and out of your device (even if the traffic is encrypted)."
msgstr "Prin utilizarea unor tehnologii sofisticate de inteligență artificială, este posibilă analizarea traficului de pachete de date care intră și ies din dispozitivul dumneavoastră (chiar dacă traficul este criptat)."

msgctxt "wireguard-settings-view"
msgid "Cancel"
msgstr "Anulați"

#. Title for device IP version setting.
msgctxt "wireguard-settings-view"
msgid "Device IP version"
msgstr "Versiunea IP a dispozitivului"

msgctxt "wireguard-settings-view"
msgid "If an observer monitors these data packets, %(daita)s makes it significantly harder for them to identify which websites you are visiting or with whom you are communicating."
msgstr "Dacă un observator monitorizează aceste pachete de date, tehnologia „%(daita)s” îi îngreunează considerabil identificarea site-urilor web pe care le vizitați sau a persoanelor cu care comunicați."

msgctxt "wireguard-settings-view"
msgid "It does this by performing an extra key exchange using a quantum safe algorithm and mixing the result into QUIC’s regular encryption."
msgstr "Acest lucru se realizează prin efectuarea unui schimb suplimentar de chei folosind un algoritm rezistent la atacuri cuantice și prin integrarea rezultatului în procesul obișnuit de criptare al QUIC."

#. The title for the QUIC MTU setting. MTU stands for Maximum
#. Transmission Unit and controls the maximum size of packets sent over
#. the VPN tunnel.
msgctxt "wireguard-settings-view"
msgid "MTU"
msgstr "MTU"

msgctxt "wireguard-settings-view"
msgid "Multihop"
msgstr "Multihop"

msgctxt "wireguard-settings-view"
msgid "Multihop is being used to enable DAITA for your selected location"
msgstr "Se utilizează tehnologia Multihop pentru a activa DAITA în locația selectată"

msgctxt "wireguard-settings-view"
msgid "Multihop routes your traffic into one QUIC server and out another, making it harder to trace. This results in increased latency but increases anonymity online."
msgstr "Rutare multihop direcționează traficul către un server QUIC și îl redirecționează către altul, făcându-l mai greu de urmărit. Acest lucru duce la o latență mai mare, dar sporește anonimatul online."

#. Warning text in a dialog that is displayed after a setting is toggled.
msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. In order to use the internet, you might have to select a new location after enabling."
msgstr "Nu toate serverele noastre au funcția „%(daita)s” activată. Pentru a putea utiliza internetul, s-ar putea să fie necesar să selectați o nouă locație după activarea funcției."

msgctxt "wireguard-settings-view"
msgid "Not all our servers are %(daita)s-enabled. Therefore, we use multihop automatically to enable %(daita)s with any server."
msgstr "Nu toate serverele noastre acceptă funcția „%(daita)s”. Prin urmare, folosim automat funcția „multihop” pentru a activa funcția „%(daita)s” cu orice server."

#. The title for the QUIC port selector.
msgctxt "wireguard-settings-view"
msgid "Port"
msgstr "Port"

#. Text showing currently selected port.
#. Available placeholders:
#. %(port)s - Can be either a number between 1 and 65535 or the text "Automatic".
msgctxt "wireguard-settings-view"
msgid "Port: %(port)s"
msgstr "Link: %(port)s"

#. The title for the QUIC quantum resistance selector. This setting
#. makes the cryptography resistant to the future abilities of quantum
#. computers.
msgctxt "wireguard-settings-view"
msgid "Quantum-resistant tunnel"
msgstr "Tunel rezistent la atacuri cuantice"

#. The hint displayed below the QUIC MTU input field.
#. Available placeholders:
#. %(wireguard)s - Will be replaced with the string "QUIC"
#. %(max)d - the maximum possible wireguard mtu value
#. %(min)d - the minimum possible wireguard mtu value
msgctxt "wireguard-settings-view"
msgid "Set %(wireguard)s MTU value. Valid range: %(min)d - %(max)d."
msgstr "Setați o valoare MTU d%(wireguard)s. Interval valid: %(min)d - %(max)d."

msgctxt "wireguard-settings-view"
msgid "Shadowsocks"
msgstr "Shadowsocks"

msgctxt "wireguard-settings-view"
msgid "The automatic setting will randomly choose from the valid port ranges shown below."
msgstr "Setarea automată va alege aleatoriu din intervalele de porturi valide prezentate mai jos."

msgctxt "wireguard-settings-view"
msgid "The custom port can be any value inside the valid ranges: %(portRanges)s."
msgstr "Portul personalizat poate avea orice valoare din intervalele valide: %(portRanges)s."

msgctxt "wireguard-settings-view"
msgid "This feature makes the QUIC tunnel resistant to potential attacks from quantum computers."
msgstr "Această caracteristică face ca tunelul QUIC să fie rezistent la potențialele atacuri din partea computerelor cuantice."

msgctxt "wireguard-settings-view"
msgid "UDP-over-TCP"
msgstr "UDP peste TCP"

#. Text describing the valid port range for a port selector.
msgctxt "wireguard-settings-view"
msgid "Valid range: %(min)s - %(max)s"
msgstr "Interval valid: %(min)s - %(max)s"

#. Text describing the valid port ranges for a port selector.
#. Available placeholders:
#. %(portRanges)s - will be replaced with a comma-separated list of port ranges
msgctxt "wireguard-settings-view"
msgid "Valid ranges: %(portRanges)s"
msgstr "Intervale valide: %(portRanges)s"

msgctxt "wireguard-settings-view"
msgid "Which TCP port the UDP-over-TCP obfuscation protocol should connect to on the VPN server."
msgstr "La ce port TCP trebuie să se conecteze protocolul de ofuscare UDP-over-TCP pe serverul VPN."

msgctxt "port-forwarding-view"
msgid "auto"
msgstr "automat"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535, or empty for auto."
msgstr "Portul trebuie să fie între 49152 și 65535 sau gol pentru automat."

msgctxt "port-forwarding-view"
msgid "Preferred port"
msgstr "Port preferat"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "Protocol"

msgctxt "port-forwarding-view"
msgid "Status: active"
msgstr "Stare: activ"

msgctxt "port-forwarding-view"
msgid "Status: requesting port mapping..."
msgstr "Stare: se solicită maparea portului…"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mapping."
msgstr "Stare: se așteaptă o conexiune de tunel activă pentru a configura maparea portului."

msgctxt "port-forwarding-view"
msgid "The server may assign a different port if the preferred one is already taken. Changes apply immediately, no reconnection needed."
msgstr "Serverul poate atribui un alt port dacă cel preferat este deja ocupat. Modificările se aplică imediat, fără reconectare."

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "Salvează fraza mea"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "Am salvat fraza mea de recuperare și înțeleg că acest cont va fi eliminat de pe acest dispozitiv."

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "Dacă nu ți-ai salvat fraza de recuperare, abonamentul tău va fi pierdut definitiv."

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "Te deconectezi de la acest cont?"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "Deconectarea șterge acest cont de pe acest dispozitiv. Nu există e-mail sau parolă pentru reconectare, fraza ta de recuperare este SINGURUL mod de a-l restaura."

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "Salvează-ți fraza de recuperare"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "Nu s-a putut citi noua frază de recuperare. Încearcă din nou."

msgctxt "login-view"
msgid "Discard"
msgstr "Renunță"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "Renunți la acest cont nou?"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "Introdu fraza de recuperare din 12 cuvinte, separate prin spații, pentru a-ți restaura contul pe acest dispozitiv."

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "Întoarce-te doar dacă voiai să restaurezi un cont pe care îl ai deja."

msgctxt "login-view"
msgid "I already have an account"
msgstr "Am deja un cont"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "Mi-am notat fraza de recuperare într-un loc sigur."

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "Frază de recuperare invalidă. Verifică cuvintele și ordinea lor, apoi încearcă din nou."

msgctxt "login-view"
msgid "Keep it"
msgstr "Păstrează-l"

msgctxt "login-view"
msgid "Restore account"
msgstr "Restaurează contul"

msgctxt "login-view"
msgid "Restore your account"
msgstr "Restaurează-ți contul"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "Contul tocmai creat va fi abandonat, iar fraza sa de recuperare nu va mai fi afișată."

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren folosește un portofel fără custodie: contul tău este o frază de recuperare din 12 cuvinte pe care doar tu o deții."

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "Bun venit la Warren"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "Notează aceste 12 cuvinte și păstrează-le în siguranță. Sunt singurul mod de a-ți restaura contul dacă pierzi acest dispozitiv."

msgctxt "connect-view"
msgid "I've completed payment"
msgstr "Am finalizat plata"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "Sesiune inactivă"

msgctxt "device-management"
msgid "Your session has ended. To connect again, you will need to log back in."
msgstr "Sesiunea ta s-a încheiat. Pentru a te conecta din nou, va trebui să te autentifici iar."

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node's public key has changed."
msgstr "Nepotrivire de identitate a serverului detectată. Cheia publică a nodului de ieșire s-a schimbat."

msgctxt "vpn-settings-view"
msgid "Automatic failover"
msgstr "Comutare automată"

msgctxt "vpn-settings-view"
msgid "Automatically switch to another exit server if the current one becomes unreachable."
msgstr "Comută automat la alt server de ieșire dacă cel curent devine inaccesibil."

msgctxt "vpn-settings-view"
msgid "This setting takes effect immediately without a daemon restart."
msgstr "Această setare intră în vigoare imediat, fără repornirea serviciului."

msgctxt "vpn-settings-view"
msgid "URL of the warren-api server. Format http(s)://host:port. Empty = unset (fallback to the default backend). Restart the daemon for the change to take effect."
msgstr "URL-ul serverului warren-api. Format http(s)://host:port. Gol = nesetat (revine la backendul implicit). Repornește serviciul pentru ca modificarea să intre în vigoare."

msgid "Continue"
msgstr "Continuă"

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "Se verifică... (apasă pentru a reîmprospăta acum)"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "Redirecționare porturi: %(ports)s"

msgctxt "connection-info"
msgid "Multihop (2 hops)"
msgstr "Multihop (2 salturi)"

msgctxt "port-forwarding-view"
msgid "+ Add a port"
msgstr "+ Adaugă un port"

msgctxt "port-forwarding-view"
msgid "Each port you add is opened on the exit and forwarded to the same port on your device. Changes apply immediately, no reconnection needed."
msgstr "Fiecare port pe care îl adaugi este deschis pe serverul de ieșire și redirecționat către același port de pe dispozitivul tău. Modificările se aplică imediat, fără reconectare."

msgctxt "port-forwarding-view"
msgid "Last port change before a temporary block. Wait a moment before changing it again."
msgstr "Ultima modificare de port înainte de o blocare temporară. Așteaptă un moment înainte de a-l schimba din nou."

msgctxt "port-forwarding-view"
msgid "Maximum of %(max)d ports reached"
msgstr "S-a atins maximul de %(max)d porturi"

msgctxt "port-forwarding-view"
msgid "No port yet. Add one to open it on the exit."
msgstr "Niciun port deocamdată. Adaugă unul pentru a-l deschide pe serverul de ieșire."

msgctxt "port-forwarding-view"
msgid "Port"
msgstr "Port"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535."
msgstr "Portul trebuie să fie între 49152 și 65535."

msgctxt "port-forwarding-view"
msgid "Remove port"
msgstr "Elimină portul"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mappings."
msgstr "Stare: se așteaptă o conexiune activă la tunel pentru a configura maparea porturilor."

msgctxt "port-forwarding-view"
msgid "This port is already in your list."
msgstr "Acest port este deja în lista ta."

msgctxt "port-forwarding-view"
msgid "Too many port changes. You can change ports again in %(countdown)s."
msgstr "Prea multe modificări de port. Poți schimba porturile din nou în %(countdown)s."

msgctxt "port-forwarding-view"
msgid "applying…"
msgstr "se aplică…"

msgctxt "port-forwarding-view"
msgid "failed"
msgstr "eșuat"

msgctxt "port-forwarding-view"
msgid "no port available"
msgstr "niciun port disponibil"

msgctxt "port-forwarding-view"
msgid "not allowed"
msgstr "nepermis"

msgctxt "port-forwarding-view"
msgid "open: %(port)d"
msgstr "deschis: %(port)d"

msgctxt "port-forwarding-view"
msgid "pending…"
msgstr "în așteptare…"

msgctxt "port-forwarding-view"
msgid "port"
msgstr "port"

msgctxt "port-forwarding-view"
msgid "port in use"
msgstr "port ocupat"

msgctxt "port-forwarding-view"
msgid "requesting…"
msgstr "se solicită…"

msgctxt "settings-view"
msgid "Port forwarding"
msgstr "Redirecționare porturi"

msgctxt "warren-multi-hop-view"
msgid "Multihop"
msgstr "Multihop"

msgctxt "forum-login"
msgid "A sign-in to the Warren community forum was requested. Your app will sign a one-time challenge with your wallet key to prove it is you."
msgstr "S-a solicitat autentificarea pe forumul comunității Warren. Aplicația va semna o provocare unică cu cheia portofelului tău pentru a dovedi că ești tu."

msgctxt "forum-login"
msgid "Approve sign-in"
msgstr "Aprobă autentificarea"

msgctxt "forum-login"
msgid "Cancel"
msgstr "Anulează"

msgctxt "forum-login"
msgid "Forum access requires a Warren subscription. This wallet has never subscribed."
msgstr "Accesul la forum necesită un abonament Warren. Acest portofel nu a avut niciodată un abonament."

msgctxt "forum-login"
msgid "No email and no password are used. You appear under an anonymous handle that cannot be linked to your Warren account. Only approve if you started this sign-in."
msgstr "Nu se folosesc adrese de e-mail sau parole. Apari sub un pseudonim anonim care nu poate fi asociat cu contul tău Warren. Aprobă doar dacă tu ai inițiat această autentificare."

msgctxt "forum-login"
msgid "Sign in to the Warren community forum?"
msgstr "Te autentifici pe forumul comunității Warren?"

msgctxt "forum-login"
msgid "Sign-in failed. Please try again in a moment."
msgstr "Autentificarea a eșuat. Te rugăm să încerci din nou peste un moment."

msgctxt "forum-login"
msgid "Signing, please wait."
msgstr "Se semnează, te rugăm să aștepți."

msgctxt "support-view"
msgid "Community forum"
msgstr "Forumul comunității"

msgctxt "tunnel-control"
msgid "Connecting..."
msgstr "Se conectează..."

msgctxt "tunnel-control"
msgid "Connection established"
msgstr "Conexiune stabilită"

msgctxt "tunnel-control"
msgid "Encrypting your connection"
msgstr "Se criptează conexiunea"

msgctxt "tunnel-control"
msgid "Random location"
msgstr "Locație aleatorie"

msgctxt "tunnel-control"
msgid "You are protected"
msgstr "Ești protejat"

msgctxt "tunnel-control"
msgid "You are visible"
msgstr "Ești vizibil"

msgctxt "tunnel-control"
msgid "Your connection is not encrypted"
msgstr "Conexiunea ta nu este criptată"

msgctxt "tunnel-control"
msgid "Disconnecting..."
msgstr "Se deconectează..."

msgctxt "tunnel-control"
msgid "Connection in progress"
msgstr "Conectare în curs"

msgctxt "forum-attach"
msgid "Attach the logs"
msgstr "Atașează logurile"

msgctxt "forum-attach"
msgid "Attach your logs to the bug report?"
msgstr "Atașezi logurile la raportul de eroare?"

msgctxt "forum-attach"
msgid "Attaching the logs failed. Please try again in a moment."
msgstr "Atașarea logurilor a eșuat. Te rugăm să încerci din nou peste un moment."

msgctxt "forum-attach"
msgid "Cancel"
msgstr "Anulează"

msgctxt "forum-attach"
msgid "Only the author of the bug report can attach logs to it."
msgstr "Doar autorul raportului de eroare poate atașa loguri la acesta."

msgctxt "forum-attach"
msgid "Sending, please wait."
msgstr "Se trimite, te rugăm să aștepți."

msgctxt "forum-attach"
msgid "The log file is too large to attach."
msgstr "Fișierul log este prea mare pentru a fi atașat."

msgctxt "forum-attach"
msgid "Your Warren account is not ready yet, so the logs cannot be signed. Finish setting up the app, then attach them from the forum page."
msgstr "Contul tău Warren nu este încă pregătit, deci jurnalele nu pot fi semnate. Termină configurarea aplicației, apoi atașează-le din pagina forumului."

msgctxt "forum-attach"
msgid "The Warren support service could not accept the report. Nothing is wrong on your side. Try again later, and say so on the forum if it keeps failing."
msgstr "Serviciul de asistență Warren nu a putut accepta raportul. Nimic nu este în neregulă la tine. Încearcă din nou mai târziu și spune pe forum dacă problema persistă."

msgctxt "forum-attach"
msgid "The logs are anonymized: wallet addresses and personal data are redacted. They go privately to the Warren support staff and never appear publicly on the forum. You can view exactly what will be sent before approving."
msgstr "Logurile sunt anonimizate: adresele portofelului și datele personale sunt ascunse. Sunt trimise în privat echipei de asistență Warren și nu apar niciodată public pe forum. Poți vedea exact ce va fi trimis înainte de a aproba."

msgctxt "forum-attach"
msgid "This request has expired. Start again from the forum page."
msgstr "Această cerere a expirat. Începe din nou de pe pagina forumului."

msgctxt "forum-attach"
msgid "View the logs"
msgstr "Vizualizează logurile"

msgctxt "forum-attach"
msgid "Your bug report on the Warren forum (topic %(topicId)d) asks to attach the app technical logs to help diagnose the problem."
msgstr "Raportul tău de eroare de pe forumul Warren (subiectul %(topicId)d) cere atașarea logurilor tehnice ale aplicației pentru a ajuta la diagnosticarea problemei."

msgctxt "forum-attach"
msgid "Your new bug report being composed on the Warren forum asks to attach the app technical logs to help diagnose the problem."
msgstr "Noul raport de eroare pe care îl compui pe forumul Warren cere atașarea logurilor tehnice ale aplicației pentru a ajuta la diagnosticarea problemei."

#. Status line confirming traffic obfuscation is on.
msgctxt "warren-status-view"
msgid "Obfuscation is active."
msgstr "Ofuscarea este activă."

#. Status line shown if traffic obfuscation is off.
msgctxt "warren-status-view"
msgid "Obfuscation is currently inactive."
msgstr "Ofuscarea este momentan inactivă."

#. Explains what obfuscation does and why it cannot be turned off.
msgctxt "warren-status-view"
msgid "To evade censorship, Warren disguises the tunnel as ordinary web browsing: on the network it looks like standard browser traffic to a regular website (HTTP/3 on port 443). Obfuscation cannot be turned off, as traffic that stands out is traffic that can be blocked."
msgstr "Pentru a ocoli cenzura, Warren deghizează tunelul în navigare web obișnuită: în rețea arată ca traficul normal al unui browser către un site web obișnuit (HTTP/3 pe portul 443). Ofuscarea nu poate fi dezactivată, deoarece traficul care iese în evidență este trafic care poate fi blocat."

msgctxt "wireguard-settings-view"
msgid "%(daita)s adds network noise and makes all packets the same size, so it is much harder to tell which sites you visit or who you communicate with."
msgstr "%(daita)s adaugă zgomot în rețea și face toate pachetele de aceeași dimensiune, astfel încât este mult mai greu de aflat ce site-uri vizitați sau cu cine comunicați."

msgctxt "wireguard-settings-view"
msgid "%(daita)s is not active on the current server: this connection is not protected by it. Reconnect or select a different location."
msgstr "%(daita)s nu este activă pe serverul curent: această conexiune nu este protejată de ea. Reconectați-vă sau alegeți altă locație."

msgctxt "wireguard-settings-view"
msgid "Even when encrypted, the data packets entering and leaving your device can be analyzed by AI to reveal your activity."
msgstr "Chiar și criptate, pachetele de date care intră și ies din dispozitivul dvs. pot fi analizate de inteligența artificială pentru a vă dezvălui activitatea."

msgctxt "wireguard-settings-view"
msgid "Note: this increases network traffic and can reduce speed, latency, and battery life. Use with caution on limited plans."
msgstr "Notă: aceasta crește traficul de rețea și poate afecta viteza, latența și autonomia bateriei. Folosiți cu prudență pe abonamentele cu trafic limitat."

msgctxt "accessibility"
msgid "Forum"
msgstr "Forum"

msgctxt "accessibility"
msgid "Forum, %(count)s new"
msgstr "Forum, %(count)s noi"

msgctxt "account-view"
msgid "Forum name"
msgstr "Nume pe forum"

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended after repeated abuse reports about a forwarded port. You can contest this at %(url)s"
msgstr "Se blochează internetul: accesul tău a fost suspendat după raportări repetate de abuz privind un port redirecționat. Poți contesta la %(url)s"

msgctxt "forum-activity-view"
msgid "%(actor)s liked your post"
msgstr "%(actor)s a apreciat mesajul tău"

msgctxt "forum-activity-view"
msgid "%(actor)s linked to your post"
msgstr "%(actor)s a pus un link către mesajul tău"

msgctxt "forum-activity-view"
msgid "%(actor)s mentioned you"
msgstr "%(actor)s te-a menționat"

msgctxt "forum-activity-view"
msgid "%(actor)s opened a new topic"
msgstr "%(actor)s a deschis un subiect nou"

msgctxt "forum-activity-view"
msgid "%(actor)s quoted you"
msgstr "%(actor)s te-a citat"

msgctxt "forum-activity-view"
msgid "%(actor)s replied"
msgstr "%(actor)s a răspuns"

msgctxt "forum-activity-view"
msgid "%(actor)s sent you a message"
msgstr "%(actor)s ți-a trimis un mesaj"

msgctxt "forum-activity-view"
msgid "Could not reach the forum. Check your connection and try again."
msgstr "Forumul nu a putut fi contactat. Verifică conexiunea și încearcă din nou."

msgctxt "forum-activity-view"
msgid "Forum"
msgstr "Forum"

msgctxt "forum-activity-view"
msgid "New forum activity"
msgstr "Activitate nouă pe forum"

msgctxt "forum-activity-view"
msgid "Nothing new on the forum. Come and ask a question, or help someone else out."
msgstr "Nimic nou pe forum. Vino să pui o întrebare, sau dă o mână de ajutor cuiva."

msgctxt "forum-activity-view"
msgid "Open the forum"
msgstr "Deschide forumul"

msgctxt "forum-activity-view"
msgid "Someone"
msgstr "Cineva"

msgctxt "forum-activity-view"
msgid "Try again"
msgstr "Încearcă din nou"

msgctxt "forum-activity-view"
msgid "You earned a badge"
msgstr "Ai primit o insignă"

msgctxt "forum-activity-view"
msgid "You post as %(handle)s"
msgstr "Publici ca %(handle)s"

msgctxt "in-app-notifications"
msgid "WARREN"
msgstr "WARREN"

msgctxt "notifications"
msgid "More than %(count)d new notifications on the forum"
msgstr "Mai mult de %(count)d notificări noi pe forum"

msgctxt "notifications"
msgid "New notification on the forum"
msgid_plural "%(count)d new notifications on the forum"
msgstr[0] "Notificare nouă pe forum"
msgstr[1] "%(count)d notificări noi pe forum"
msgstr[2] "%(count)d de notificări noi pe forum"

msgctxt "notifications"
msgid "Open"
msgstr "Deschide"

msgctxt "port-forwarding-view"
msgid "A forwarded port is reachable from the internet. If a third party reports abuse coming from it, we close the port and record a strike on your account; three strikes within 90 days revoke access. Details and how to contest: %(url)s"
msgstr "Un port redirecționat este accesibil de pe internet. Dacă un terț raportează un abuz care provine de acolo, închidem portul și înregistrăm un avertisment în contul tău; trei avertismente în 90 de zile revocă accesul. Detalii și cum contești: %(url)s"

msgctxt "support-view"
msgid "Terms of use"
msgstr "Termeni de utilizare"

msgctxt "user-interface-settings-view"
msgid "Forum notifications"
msgstr "Notificări de pe forum"

msgctxt "forum-activity-view"
msgid "The forum was updated"
msgstr "Forumul a fost actualizat"

msgctxt "forum-activity-view"
msgid "Mark all as read"
msgstr "Marchează tot ca citit"

msgctxt "user-interface-settings-view"
msgid "Be told when someone replies to you on the community forum. Turning this off also hides the forum bell."
msgstr "Află când îți răspunde cineva pe forumul comunității. Dezactivarea ascunde și clopoțelul forumului."

msgctxt "forum-login"
msgid "This sign-in request has expired. Start again from the browser page."
msgstr "Această cerere de autentificare a expirat. Reia de la pagina din browser."

msgctxt "forum-sign-in-code"
msgid "Sign in to the forum with a code"
msgstr "Autentifică-te pe forum cu un cod"

msgctxt "forum-sign-in-code"
msgid "When the forum's \"Open the Warren app\" button did nothing"
msgstr "Când butonul \"Deschide aplicația Warren\" de pe forum nu a făcut nimic"

msgctxt "forum-sign-in-code"
msgid "On the forum sign-in page, the session code is shown under the button. Type it here to approve that sign-in from this app. The page keeps waiting while you do."
msgstr "Pe pagina de autentificare a forumului, codul de sesiune este afișat sub buton. Introdu-l aici pentru a aproba acea autentificare din această aplicație. Pagina așteaptă în continuare între timp."

msgctxt "forum-sign-in-code"
msgid "Sign-in code"
msgstr "Cod de autentificare"

msgctxt "forum-sign-in-code"
msgid "A sign-in code is 32 letters and digits, as shown on the forum page."
msgstr "Un cod de autentificare are 32 de litere și cifre, așa cum apare pe pagina forumului."

msgctxt "forum-sign-in-code"
msgid "Continue"
msgstr "Continuă"

msgctxt "report-problem"
msgid "%(count)d characters"
msgstr "%(count)d caractere"

msgctxt "report-problem"
msgid "%(count)d characters (at least %(min)d)"
msgstr "%(count)d caractere (cel puțin %(min)d)"

msgctxt "report-problem"
msgid "Anonymized logs from this app, visible to the support team only."
msgstr "Jurnale anonimizate ale acestei aplicații, vizibile doar echipei de suport."

msgctxt "report-problem"
msgid "Browsing (pages not loading, slow, broken sites)"
msgstr "Navigare (pagini care nu se încarcă, lentoare, site-uri stricate)"

msgctxt "report-problem"
msgid "Connection (cannot connect, drops, no internet)"
msgstr "Conexiune (nu se poate conecta, întreruperi, fără internet)"

msgctxt "report-problem"
msgid "Every time"
msgstr "De fiecare dată"

msgctxt "report-problem"
msgid "Forum access requires a Warren subscription. This wallet has never subscribed: use the help form on the website instead."
msgstr "Accesul la forum necesită un abonament Warren. Acest portofel nu a avut niciodată unul: folosește în schimb formularul de ajutor de pe site."

msgctxt "report-problem"
msgid "How can we make it happen too? (optional)"
msgstr "Cum putem reproduce problema? (opțional)"

msgctxt "report-problem"
msgid "How often does it happen?"
msgstr "Cât de des se întâmplă?"

msgctxt "report-problem"
msgid "Include technical logs"
msgstr "Include jurnalele tehnice"

msgctxt "report-problem"
msgid "Installing or updating Warren"
msgstr "Instalarea sau actualizarea Warren"

msgctxt "report-problem"
msgid "It happened once"
msgstr "S-a întâmplat o dată"

msgctxt "report-problem"
msgid "Open the help form"
msgstr "Deschide formularul de ajutor"

msgctxt "report-problem"
msgid "Open the topic"
msgstr "Deschide subiectul"

msgctxt "report-problem"
msgid "Posted as %(handle)s."
msgstr "Publicat ca %(handle)s."

msgctxt "report-problem"
msgid "Preparing the report, please wait."
msgstr "Se pregătește raportul, te rugăm să aștepți."

msgctxt "report-problem"
msgid "Report a problem"
msgstr "Raportați o problemă"

msgctxt "report-problem"
msgid "Send a description and your logs to the support team"
msgstr "Trimite o descriere și jurnalele tale echipei de suport"

msgctxt "report-problem"
msgid "Send the report"
msgstr "Trimite raportul"

msgctxt "report-problem"
msgid "Send without the logs"
msgstr "Trimite fără jurnale"

msgctxt "report-problem"
msgid "Sending the logs took too long on this connection."
msgstr "Trimiterea jurnalelor a durat prea mult pe această conexiune."

msgctxt "report-problem"
msgid "Sending, please wait."
msgstr "Se trimite, te rugăm să aștepți."

msgctxt "report-problem"
msgid "Some fields could not be accepted. Check the description and try again."
msgstr "Unele câmpuri nu au putut fi acceptate. Verifică descrierea și încearcă din nou."

msgctxt "report-problem"
msgid "Something else"
msgstr "Altceva"

msgctxt "report-problem"
msgid "Sometimes"
msgstr "Uneori"

msgctxt "report-problem"
msgid "The forum could not take the report right now. Please try again later."
msgstr "Forumul nu a putut prelua raportul acum. Încearcă din nou mai târziu."

msgctxt "report-problem"
msgid "The logs are too large to send."
msgstr "Jurnalele sunt prea mari pentru a fi trimise."

msgctxt "report-problem"
msgid "The logs could not be collected. You can still send the description."
msgstr "Jurnalele nu au putut fi colectate. Poți totuși trimite descrierea."

msgctxt "report-problem"
msgid "The report could not be sent. Check the connection and try again."
msgstr "Raportul nu a putut fi trimis. Verifică conexiunea și încearcă din nou."

msgctxt "report-problem"
msgid "This device's clock is off by more than a minute. Enable automatic date and time, then send again."
msgstr "Ceasul acestui dispozitiv este decalat cu mai mult de un minut. Activează data și ora automate, apoi trimite din nou."

msgctxt "report-problem"
msgid "Too many reports from this wallet for now. Please try again later."
msgstr "Prea multe rapoarte de la acest portofel deocamdată. Încearcă din nou mai târziu."

msgctxt "report-problem"
msgid "View the logs"
msgstr "Vizualizează logurile"

msgctxt "report-problem"
msgid "Wallet, payment or subscription"
msgstr "Portofel, plată sau abonament"

msgctxt "report-problem"
msgid "What did you do just before? Step by step if you can."
msgstr "Ce ai făcut chiar înainte? Pas cu pas, dacă poți."

msgctxt "report-problem"
msgid "What did you see, and what did you expect instead? Copy any error message. Never include your wallet address."
msgstr "Ce ai văzut și la ce te așteptai în schimb? Copiază orice mesaj de eroare. Nu include niciodată adresa portofelului tău."

msgctxt "report-problem"
msgid "What happened?"
msgstr "Ce s-a întâmplat?"

msgctxt "report-problem"
msgid "Where does the problem happen?"
msgstr "Unde apare problema?"

msgctxt "report-problem"
msgid "Your description is posted on the community forum under your anonymous forum name. The technical logs, if you include them, go privately to the support team and never appear publicly."
msgstr "Descrierea ta este publicată pe forumul comunității sub numele tău de forum anonim. Jurnalele tehnice, dacă le incluzi, ajung privat la echipa de suport și nu apar niciodată public."

msgctxt "report-problem"
msgid "Your report is on the forum and your logs reached the support team."
msgstr "Raportul tău este pe forum și jurnalele tale au ajuns la echipa de suport."

msgctxt "report-problem"
msgid "Your report is on the forum."
msgstr "Raportul tău este pe forum."

msgctxt "report-problem"
msgid "Your report is on the forum. The logs could only be delivered in part; the support team may ask for them again."
msgstr "Raportul tău este pe forum. Jurnalele au fost livrate doar parțial; echipa de suport ți le poate cere din nou."

msgctxt "report-problem"
msgid "Your Warren account is not ready yet, so the report cannot be signed. Finish setting up the app, then send again."
msgstr "Contul tău Warren nu este încă pregătit, deci raportul nu poate fi semnat. Termină configurarea aplicației, apoi trimite din nou."
