msgstr "Introduceți un nou nume pentru listă"

msgctxt "custom-list-feature"
msgid "List names must be unique"
msgstr "Numele din listă trebuie să fie unice"

msgctxt "custom-list-feature"
msgid "Relay"
msgstr "Releu"

#. Button for continuing login process.
msgctxt "device-management"
msgid "Continue with login"
msgstr "Continuați cu autentificarea"

#. Label informing the user when a device was created.
#. Available placeholders:
#. %(createdDate)s - The creation date of the device.
msgctxt "device-management"
msgid "Created: %(createdDate)s"
msgstr "Creat: %(createdDate)s"

#. Label indicating that this device is the current device.
msgctxt "device-management"
msgid "Current device"
msgstr "Dispozitivul curent"

msgctxt "device-management"
msgid "Device is inactive"
msgstr "Dispozitivul este inactiv"

msgctxt "device-management"
msgid "Device name"
msgstr "Numele dispozitivului"

#. A label that will display the newly created device name to inform the user
#. about it.
#. Available placeholders:
#. %(deviceName)s - The name of the current device
msgctxt "device-management"
msgid "Device name: %(deviceName)s"
msgstr "Numele dispozitivului: %(deviceName)s"

msgctxt "device-management"
msgid "Failed to remove device"
msgstr "Nu s-a putut dezinstala dispozitivul"

#. Button label for navigating to login.
msgctxt "device-management"
msgid "Go to login"
msgstr "Accesați pagina de autentificare"

msgctxt "device-management"
msgid "Going to login will unblock the Internet on this device."
msgstr "Dacă vă autentificați, conexiunea la internet va fi restabilită pe acest dispozitiv."

msgctxt "device-management"
msgid "If you log out, the device and the device name is removed. When you log back in again, the device will get a new name."
msgstr "Dacă vă deconectați, dispozitivul și numele acestuia vor fi șterse. Când vă veți reconecta, dispozitivul va primi un nume nou."

#. Title label in navigation bar for the manage devices view.
#. Title text in the manage devices view
msgctxt "device-management"
msgid "Manage devices"
msgstr "Gestionarea dispozitivelor"

msgctxt "device-management"
msgid "Please log out of at least one by removing it from the list below. You can find the corresponding device name under the device’s Account settings."
msgstr "Vă rugăm să vă deconectați de la cel puțin unul dintre ele, eliminându-l din lista de mai jos. Puteți găsi numele dispozitivului corespunzător în secțiunea Setări cont a dispozitivului respectiv."

#. Button label for confirming removing a device.
msgctxt "device-management"
msgid "Remove"
msgstr "Eliminare"

#. Text displayed above button which logs out another device.
#. The text enclosed in "<b></b>" will appear bold.
#. Available placeholders:
#. %(deviceName)s - The name of the device to log out.
msgctxt "device-management"
msgid "Remove <em>%(deviceName)s?</em>"
msgstr "Eliminare <em>%(deviceName)s?</em>"

#. Page title informing user that enough devices has been removed to continue
#. login process.
msgctxt "device-management"
msgid "Super!"
msgstr "Super!"

msgctxt "device-management"
msgid "The device will be removed from the list and logged out."
msgstr "Dispozitivul va fi eliminat din listă și deconectat."

msgctxt "device-management"
msgid "This is the name assigned to the device. Each device logged in on a Warren account gets a unique name that helps you identify it when you manage your devices in the app or on the website."
msgstr "Acesta este numele atribuit dispozitivului. Fiecare dispozitiv conectat la un cont Warren primește un nume unic care vă ajută să îl identificați atunci când vă gestionați dispozitivele în aplicație sau pe site-ul web."

msgctxt "device-management"
msgid "Time left: %(timeLeft)s"
msgstr "Timp rămas: %(timeLeft)s"

#. Page title informing user that the login failed due to too many registered
#. devices on account.
msgctxt "device-management"
msgid "Too many devices"
msgstr "Prea multe dispozitive"

#. Button text to retry fetching devices.
msgctxt "device-management"
msgid "Try again"
msgstr "Încercați din nou"

#. Subtitle text in the manage devices view, explaining
#. devices and what they can do in the manage devices view.
msgctxt "device-management"
msgid "View and manage all your logged in devices. You can have up to 5 devices on one account at a time. Each device gets a name when logged in to help you tell them apart easily."
msgstr "Vizualizați și gestionați toate dispozitivele conectate. Puteți avea până la 5 dispozitive conectate simultan la un singur cont. Fiecare dispozitiv primește un nume la conectare, pentru a vă ajuta să le deosebiți cu ușurință."

msgctxt "device-management"
msgid "You can have up to 5 devices logged in on one Warren account."
msgstr "Poți avea până la 5 dispozitive conectate la un singur cont Warren."

msgctxt "device-management"
msgid "You can now continue logging in on this device."
msgstr "Acum vă puteți autentifica în continuare pe acest dispozitiv."

msgctxt "device-management"
msgid "You have removed this device. To connect again, you will need to log back in."
msgstr "Ați deconectat acest dispozitiv. Pentru a vă reconecta, va trebui să vă autentificați din nou."

#. The message displayed to the user in case of critical error in the GUI
#. Available placeholders:
#. %(email)s - support email
msgctxt "error-boundary-view"
msgid "Something went wrong. Please contact us at %(email)s"
msgstr "A apărut o eroare. Te rugăm să ne contactezi la adresa %(email)s"

#. Button label on the fatal-error view that reloads the app
#. interface, as an alternative to force-quitting the app.
msgctxt "error-boundary-view"
msgid "Reload the app"
msgstr "Reîncărcați aplicația"

#. Title label in navigation bar
msgctxt "filter-nav"
msgid "Filter"
msgstr "Filtru"

msgctxt "filter-view"
msgid "All providers"
msgstr "Toți furnizorii"

msgctxt "filter-view"
msgid "Warren owned only"
msgstr "Warren deținea doar"

msgctxt "filter-view"
msgid "Owned"
msgstr "Deținut"

msgctxt "filter-view"
msgid "Ownership"
msgstr "Proprietate"

msgctxt "filter-view"
msgid "Providers"
msgstr "Furnizori"

msgctxt "filter-view"
msgid "Rented"
msgstr "Închiriat"

msgctxt "filter-view"
msgid "Rented only"
msgstr "Doar închiriere"

msgctxt "in-app-notifications"
msgid "%(duration)s. Buy more credit."
msgstr "%(duration)s. Cumpărați mai mult credit."

#. Notification subtitle when the app upgrade is ready to install.
#. Available placeholders:
#. - %(suggestedUpgradeVersion)s: Upgrade version to be installed.
msgctxt "in-app-notifications"
msgid "%(suggestedUpgradeVersion)s is ready to be installed."
msgstr "%(suggestedUpgradeVersion)s este gata de instalare."

msgctxt "in-app-notifications"
msgid "<a>%(lockdownModeSettingName)s</a> is enabled. Please click “Connect“ or disable “%(lockdownModeSettingName)s“ to unblock internet."
msgstr "<a>%(lockdownModeSettingName)s</a> este activată. Vă rugăm să faceți clic pe „Conectare“ sau să dezactivați opțiunea „%(lockdownModeSettingName)s“ pentru a debloca accesul la internet."

msgctxt "in-app-notifications"
msgid "ACCOUNT CREDIT EXPIRES SOON"
msgstr "SOLDUL CONTULUI EXPIRĂ ÎN CURÂND"

msgctxt "in-app-notifications"
msgid "APP IS OUT OF SYNC"
msgstr "APLICAȚIA NU ESTE SINCRONIZATĂ"

msgctxt "in-app-notifications"
msgid "BETA UPDATE AVAILABLE"
msgstr "ACTUALIZARE BETA DISPONIBILĂ"

msgctxt "in-app-notifications"
msgid "BLOCKING INTERNET"
msgstr "BLOCAREA INTERNETULUI"

#. Notification subtitle when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "Click here to install update."
msgstr "Faceți clic aici pentru a instala actualizarea."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "Click here to retry"
msgstr "Faceți clic aici pentru a încerca din nou"

#. Notification subtitle when the download of the installer failed
#. and the user can try downloading again.
msgctxt "in-app-notifications"
msgid "Click here to retry download"
msgstr "Faceți clic aici pentru a încerca din nou descărcarea"

msgctxt "in-app-notifications"
msgid "Click here to see what’s new."
msgstr "Faceți clic aici pentru a vedea noutățile."

#. Link text to go to the app upgrade view
msgctxt "in-app-notifications"
msgid "Click here to update"
msgstr "Faceți clic aici pentru a actualiza"

#. Notification subtitle when the installer download failed.
msgctxt "in-app-notifications"
msgid "Could not download installer."
msgstr "Nu s-a putut descărca programul de instalare."

#. Generic notification subtitle when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "Could not upgrade the app."
msgstr "Nu s-a putut actualiza aplicația."

#. Notification title when app upgrade is verifying the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOAD COMPLETE! VERIFYING..."
msgstr "DESCĂRCAREA S-A ÎNCHEIAT! SE VERIFICĂ..."

#. Notification title when the installer download failed.
msgctxt "in-app-notifications"
msgid "DOWNLOAD FAILED"
msgstr "DESCĂRCAREA A EȘUAT"

#. Generic notification title when app upgrade is downloading the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE..."
msgstr "SE DESCARCĂ ACTUALIZAREA..."

#. Notification title when the app upgrade is in progress.
#. Available placeholders:
#. - %(appUpgradeDownloadProgressValue)s: The download progress value.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE... %(appUpgradeDownloadProgressValue)s%%"
msgstr "SE DESCARCĂ ACTUALIZAREA... %(appUpgradeDownloadProgressValue)s %%"

msgctxt "in-app-notifications"
msgid "EXIT SWITCHED"
msgstr "IEȘIRE COMANDATĂ"

#. The in-app banner displayed to the user when the app update is available.
msgctxt "in-app-notifications"
msgid "IMPORTANT"
msgstr "IMPORTANT"

msgctxt "in-app-notifications"
msgid "Install the latest app version to stay up to date."
msgstr "Instalați cea mai recentă versiune a aplicației pentru a fi la curent cu noutățile."

#. Notification title when the installer failed.
msgctxt "in-app-notifications"
msgid "INSTALLER FAILED"
msgstr "INSTALAREA A EȘUAT"

msgctxt "in-app-notifications"
msgid "NETWORK TRAFFIC MIGHT BE LEAKING"
msgstr "E POSIBIL SĂ EXISTE O SCURGERI DE TRAFIC DE REȚEA"

msgctxt "in-app-notifications"
msgid "NEW DEVICE CREATED"
msgstr "S-A CREAT UN NOU DISPOZITIV"

msgctxt "in-app-notifications"
msgid "NEW VERSION INSTALLED"
msgstr "S-A INSTALAT O NOUĂ VERSIUNE"

msgctxt "in-app-notifications"
msgid "NOTICE"
msgstr "ANUNȚ"

msgctxt "in-app-notifications"
msgid "Please quit and restart the app."
msgstr "Vă rugăm să închideți și să redeschideți aplicația."

#. Notification title when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "READY TO INSTALL UPDATE"
msgstr "GATA DE INSTALARE ACTUALIZARE"

#. Accessibility label for the button to retry download of the installer.
msgctxt "in-app-notifications"
msgid "Read the full message"
msgstr "Citește mesajul complet"

msgctxt "in-app-notifications"
msgid "Retry download of the installer"
msgstr "Reîncercați descărcarea programului de instalare"

#. Accessibility label for the button to retry the installation.
msgctxt "in-app-notifications"
msgid "Retry installation"
msgstr "Reîncercați instalarea"

#. Button label to send a problem report.
msgctxt "in-app-notifications"
msgid "Send problem report"
msgstr "Trimiteți un raport de problemă"

msgctxt "in-app-notifications"
msgid "SERVER MAINTENANCE"
msgstr "MENTENANȚĂ SERVER"

#. Notification subtitle when the installer verification failed.
msgctxt "in-app-notifications"
msgid "The installer could not be verified."
msgstr "Nu s-a putut verifica programul de instalare."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not complete successfully."
msgstr "Instalarea nu s-a finalizat cu succes."

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not start successfully."
msgstr "Programul de instalare nu a pornit cu succes."

#. Notification subtitle indicating the user is using an unsupported port for QUIC.
#. Available placeholders:
#. %(wireGuard)s - Will be replaced with QUIC
msgctxt "in-app-notifications"
msgid "The selected %(wireGuard)s port is not supported, please <a>change it under VPN settings.</a>"
msgstr "Portul %(wireGuard)s selectat nu este acceptat; vă rugăm să-l <a>modificați în setările VPN.</a>"

#. Notification text when a new device has been created.
#. Available placeholders:
#. - %(deviceName)s: Name of created device.
msgctxt "in-app-notifications"
msgid "This device is now named <em>%(deviceName)s</em>. See more under <a>Manage devices</a> in Account."
msgstr "Acest dispozitiv se numește acum <em>%(deviceName)s</em>. Vezi mai multe la <a>Gestionare dispozitive</a> din Cont."

#. The in-app banner displayed to the user when the app beta update is
#. available.
#. Available placeholders:
#. %(version)s - The version number of the new beta version.
msgctxt "in-app-notifications"
msgid "Try out the newest beta version (%(version)s)."
msgstr "Încercați cea mai nouă versiune beta (%(version)s)."

msgctxt "in-app-notifications"
msgid "UNSUPPORTED VERSION"
msgstr "VERSIUNE NEASISTATĂ"

msgctxt "in-app-notifications"
msgid "UPDATE AVAILABLE"
msgstr "ACTUALIZARE DISPONIBILĂ"

#. Generic notification title when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "UPDATE FAILED"
msgstr "ACTUALIZAREA A EȘUAT"

#. Notification title when app upgrade is ready for the user to launch the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! INSTALLER READY!"
msgstr "VERIFICARE FINALIZATĂ! PROGRAMUL DE INSTALARE ESTE GATA!"

#. Notification title when app upgrade is launching the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! LAUNCHING INSTALLER..."
msgstr "VERIFICAREA S-A ÎNCHEIAT! SE LANSEAZĂ PROGRAMUL DE INSTALARE..."

#. Notification title when the installer verification failed.
msgctxt "in-app-notifications"
msgid "VERIFICATION FAILED"
msgstr "VERIFICAREA A EȘUAT"

msgctxt "in-app-notifications"
msgid "Your previous exit became unreachable. Warren routed you through an alternative server automatically."
msgstr "Ieșirea pe care ați folosit-o anterior nu mai este accesibilă. Warren v-a redirecționat automat către un server alternativ."

msgctxt "in-app-notifications"
msgid "Your server is being updated. Warren moved you to another server automatically, no action needed."
msgstr "Serverul dvs. este în curs de actualizare. Warren v-a mutat automat pe alt server, nicio acțiune necesară."

msgctxt "in-app-notifications"
msgid "AUTO-RENEWAL SOON"
msgstr "REÎNNOIRE AUTOMATĂ ÎN CURÂND"

msgctxt "in-app-notifications"
msgid "MIGRATION POSTPONED, PORT KEPT"
msgstr "MIGRARE AMÂNATĂ, PORT PĂSTRAT"

msgctxt "in-app-notifications"
msgid "NO INTERNET CONNECTION"
msgstr "FĂRĂ CONEXIUNE LA INTERNET"

#. Button label opening the community forum to report a problem.
msgctxt "in-app-notifications"
msgid "Report on the forum"
msgstr "Raportați pe forum"

msgctxt "in-app-notifications"
msgid "SERVER NOT FORWARDING TRAFFIC"
msgstr "SERVERUL NU TRANSMITE TRAFICUL"

msgctxt "in-app-notifications"
msgid "The server stopped forwarding your traffic. Warren will switch or reconnect automatically."
msgstr "Serverul a încetat să vă mai transmită traficul. Warren va schimba serverul sau se va reconecta automat."

msgctxt "in-app-notifications"
msgid "This is taking longer than usual. Warren keeps retrying; if it does not connect, report the problem on our community forum."
msgstr "Durează mai mult decât de obicei. Warren încearcă în continuare; dacă nu se conectează, raportați problema pe forumul nostru."

msgctxt "in-app-notifications"
msgid "TROUBLE CONNECTING?"
msgstr "PROBLEME LA CONECTARE?"

msgctxt "in-app-notifications"
msgid "Your device is offline. Warren will reconnect automatically as soon as the network is back."
msgstr "Dispozitivul dvs. este offline. Warren se va reconecta automat imediat ce revine rețeaua."

msgctxt "in-app-notifications"
msgid "Your forwarded port is busy on every alternative server, so Warren kept you on the current one. Expect a brief interruption while it updates."
msgstr "Portul dvs. redirecționat este ocupat pe toate serverele alternative, așa că Warren v-a păstrat pe cel curent. Este posibilă o scurtă întrerupere în timpul actualizării."

msgctxt "in-app-notifications"
msgid "Your Warren time renews in the next days. You can turn it off anytime in Account settings."
msgstr "Timpul dvs. Warren se reînnoiește în zilele următoare. Puteți dezactiva oricând această opțiune în setările contului."

msgctxt "keys-view"
msgid "Backup keys"
msgstr "Chei de rezervă"

#. Shown when the daemon rejects the mnemonic
#. (typically: invalid BIP39 word, bad checksum,
#. wrong word count). User must check + retry.
msgctxt "keys-view"
msgid "Daemon rejected the mnemonic. Check spelling, word count, and try again."
msgstr "Serviciul a respins fraza mnemonică. Verificați ortografia și numărul de cuvinte, apoi încercați din nou."

msgctxt "keys-view"
msgid "Done"
msgstr "Gata"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "Introduceți fraza mnemonică BIP39 formată din 12 (sau 24) cuvinte, separate prin spații."

#. Generic error when the daemon RPC fails. Shown
#. only on transient connection issues.
msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "Nu s-a putut prelua fraza mnemonică de la demon."

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "Am pus-o la loc sigur."

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "Înțeleg că acest lucru îmi va înlocui definitiv identitatea actuală."

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "Identitatea a fost restabilită. Noul tău portofel Warren este acum activ."

#. Title label in navigation bar
msgctxt "keys-view"
msgid "Keys"
msgstr "Chei"

#. Shown when the daemon has no Warren BIP39 mnemonic
#. stored (= identity never bootstrapped). User must
#. log in or restore from mnemonic first.
msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "Nu există frază mnemonică disponibilă. Autentificați-vă sau restabiliți mai întâi o identitate."

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "Restaurare din frază mnemonică"

#. Title label in navigation bar
msgctxt "keys-view"
msgid "Restore identity"
msgstr "Restabilirea identității"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "Se reîncarcă..."

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "Afișați fraza mnemonică"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "ATENȚIE: Această acțiune va ÎNLOCUI identitatea dvs. actuală. Orice abonament asociat identității actuale va fi irecuperabil."

msgctxt "keys-view"
msgid "words"
msgstr "cuvinte"

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "Notați-l pe hârtie. Nu-l salvați niciodată în cloud, sub formă de captură de ecran sau într-un e-mail."

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "Fraza mnemonică din cele 12 cuvinte reprezintă SINGURA modalitate de a vă restabili contul Warren pe un alt dispozitiv. În cazul pierderii acestora, abonamentul dvs. nu mai poate fi recuperat."

#. Status text app is trying to connect to the system service.
msgctxt "launch-view"
msgid "Connecting to Warren system service..."
msgstr "Se realizează conexiunea la serviciul sistemului Warren..."

#. Button label for opening dialog with troubleshooting details.
msgctxt "launch-view"
msgid "Details"
msgstr "Detalii"

#. List item in troubleshooting modal advising user disable third party antivirus.
msgctxt "launch-view"
msgid "Disabling third party antivirus software"
msgstr "Dezactivarea programelor antivirus de la terți"

#. Status text shown when app fails to start.
msgctxt "launch-view"
msgid "Failed to start the app, please try again or click “Details” for more info"
msgstr "Nu s-a putut porni aplicația. Vă rugăm să încercați din nou sau să faceți clic pe „Detalii” pentru mai multe informații"

#. Message in troubleshooting modal advising user to send a problem report if the steps do not work.
msgctxt "launch-view"
msgid "If these steps do not work please send a problem report."
msgstr "Dacă acești pași nu dau rezultate, vă rugăm să trimiteți un raport de eroare."

#. Message in launch view when the background process permissions have been revoked.
msgctxt "launch-view"
msgid "Permission for the Warren VPN service has been revoked. Please go to System Settings and allow Warren VPN under the “Allow in the Background” setting."
msgstr "Permisiunea pentru serviciul Warren VPN a fost revocată. Vă rugăm să accesați Setările sistemului și să activați opțiunea Warren VPN în cadrul setării „Permite în fundal”."

#. List item in troubleshooting modal advising user to reinstall the app.
msgctxt "launch-view"
msgid "Reinstalling the app"
msgstr "Reinstalarea aplicației"

#. List item in troubleshooting modal advising user to restart background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process"
msgstr "Repornirea procesului de fundal Warren"

#. List item in troubleshooting modal instructing user how to restart the background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process by clicking \"Back\", then \"Try again\""
msgstr "Repornirea procesului de fundal Warren făcând clic pe „Înapoi”, apoi pe „Încercați din nou”"

#. List item in troubleshooting modal advising user to restart their computer.
msgctxt "launch-view"
msgid "Restarting your computer"
msgstr "Repornirea computerului"

#. Button label for sending a problem report.
msgctxt "launch-view"
msgid "Send problem report"
msgstr "Trimiteți un raport de problemă"

#. Status text shown when app is starting.
msgctxt "launch-view"
msgid "Starting up...."
msgstr "Se pornește..."

#. Message in troubleshooting modal when the background process failed to start.
msgctxt "launch-view"
msgid "The Warren background process failed to start. The background process is responsible for the security, kill switch, and the VPN tunnel. Please try:"
msgstr "Procesul de fundal Warren nu a putut fi pornit. Acest proces de fundal este responsabil pentru securitate, Kill Switch și tunelul VPN. Vă rugăm să încercați:"

#. Button label for trying to restart the daemon again.
msgctxt "launch-view"
msgid "Try again"
msgstr "Încercați din nou"

#. Message in launch view when the mullvad service cannot be contacted.
msgctxt "launch-view"
msgid "Unable to contact the Warren system service, your connection might be unsecure. Please troubleshoot or send a problem report by clicking the \"Learn more\" button."
msgstr "Nu se poate stabili conexiunea cu serviciul sistemului Warren; este posibil ca conexiunea dumneavoastră să nu fie securizată. Vă rugăm să remediați problema sau să trimiteți un raport de eroare făcând clic pe butonul „Aflați mai multe”."

#. Message in troubleshooting modal pointing the user to the community forum if the steps do not work.
msgctxt "launch-view"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "Dacă acești pași nu funcționează, vă rugăm să raportați problema pe forumul nostru."

#. Button label on the launch view that lifts the failsafe
#. firewall block when the system service cannot be reached,
#. restoring internet access without VPN protection.
msgctxt "launch-view"
msgid "Restore internet without VPN"
msgstr "Restabiliți internetul fără VPN"

#. Message in launch view when the mullvad service cannot be contacted.
msgctxt "launch-view"
msgid "Unable to contact the Warren system service, your connection might be unsecure. Please troubleshoot by clicking the \"Learn more\" button, or report the problem on our community forum."
msgstr "Nu se poate stabili conexiunea cu serviciul de sistem Warren; este posibil ca aceasta să nu fie securizată. Vă rugăm să remediați problema făcând clic pe butonul „Aflați mai multe” sau să raportați problema pe forumul nostru."

msgctxt "launch-view"
msgid "Warren VPN will restore internet access without VPN protection."
msgstr "Warren VPN va restabili accesul la internet fără protecție VPN."

#. Button label opening the community forum to report a problem.
msgctxt "launch-view"
msgid "Report on the forum"
msgstr "Raportați pe forum"

#. This is used for appending information about a location.
#. E.g. "Gothenburg (Entry)" if Gothenburg has been selected as the entrypoint.
#. Available placeholders:
#. %(location)s - Translated location name
#. %(info)s - Information about the location
msgctxt "locations-feature"
msgid "%(location)s (%(info)s)"
msgstr "%(location)s (%(info)s)"

msgctxt "locations-feature"
msgid "Disabling recents will also clear history."
msgstr "Dacă dezactivați funcția „Recente”, se va șterge și istoricul."

msgctxt "locations-feature"
msgid "Entry"
msgstr "Intrare"

msgctxt "locations-feature"
msgid "Exit"
msgstr "Ieșire"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
#. Available placeholder:
#. %(lockdownModeSettingName)s - The translation of "Lockdown mode"
msgctxt "login-view"
msgid "<b>%(lockdownModeSettingName)s</b> is enabled. Disable it to unblock your connection."
msgstr "<b>%(lockdownModeSettingName)s</b> este activată. Dezactiveaz-o pentru a debloca conexiunea."

msgctxt "login-view"
msgid "Account created"
msgstr "Cont creat"

msgctxt "login-view"
msgid "Checking public key"
msgstr "Verificarea cheii publice"

#. Text in button that allows user to create a new account.
msgctxt "login-view"
msgid "Create a new account"
msgstr "Creați un cont nou"

#. Button which confirms the action to create a new account.
msgctxt "login-view"
msgid "Create new account"
msgstr "Creați un cont nou"

msgctxt "login-view"
msgid "Creating account..."
msgstr "Se creează contul..."

#. Text that asks the user if they really want to create a new account.
msgctxt "login-view"
msgid "Do you want to create a new account?"
msgstr "Doriți să creați un cont nou?"

#. Text that asks the user if they really want to remove the saved public key.
msgctxt "login-view"
msgid "Do you want to remove the saved public key?"
msgstr "Doriți să ștergeți cheia publică salvată?"

msgctxt "login-view"
msgid "Enter your public key"
msgstr "Introduceți cheia publică"

msgctxt "login-view"
msgid "Error"
msgstr "Eroare"

msgctxt "login-view"
msgid "Failed to create account"
msgstr "Nu s-a putut crea contul"

msgctxt "login-view"
msgid "Finishing upgrade."
msgstr "Finalizarea actualizării."

#. Error message shown above login input when trying to login with a
#. non-existent public key.
msgctxt "login-view"
msgid "Invalid public key"
msgstr "Cheie publică nevalidă"

msgctxt "login-view"
msgid "Logged in"
msgstr "Conectat"

msgctxt "login-view"
msgid "Logging in..."
msgstr "Se efectuează autentificarea..."

#. Label for the login button.
msgctxt "login-view"
msgid "Login"
msgstr "Autentificare"

msgctxt "login-view"
msgid "Login failed"
msgstr "Autentificarea a eșuat"

#. Text shown between two horizontal lines above the "create account" button.
#. In this context it is used to separate the users alternative of logging in
#. or creating a new account, "Login or Create a new account".
msgctxt "login-view"
msgid "Or"
msgstr "Sau"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
msgctxt "login-view"
msgid "Our kill switch is currently blocking your connection."
msgstr "Kill Switch-ul nostru vă blochează în prezent conexiunea."

msgctxt "login-view"
msgid "Please wait"
msgstr "Vă rugăm să așteptați"

#. Text that informs the user about the consequences of clearing the saved
#. public key.
msgctxt "login-view"
msgid "Removing the saved public key from this device cannot be undone."
msgstr "Ștergerea cheii publice salvate de pe acest dispozitiv este ireversibilă."

#. Error message shown above login input when trying to login to an account
#. with too many registered devices.
msgctxt "login-view"
msgid "Too many devices"
msgstr "Prea multe dispozitive"

msgctxt "login-view"
msgid "Unknown error"
msgstr "Eroare necunoscută"

msgctxt "login-view"
msgid "Upgrading..."
msgstr "Se actualizează..."

msgctxt "login-view"
msgid "Valid public key"
msgstr "Cheie publică validă"

#. Text that informs the users about consequences of creating a new account.
msgctxt "login-view"
msgid "You already have a saved public key, by creating a new account the saved public key will be removed from this device. This cannot be undone."
msgstr "Ai deja o cheie publică salvată; prin crearea unui cont nou, cheia publică salvată va fi ștersă de pe acest dispozitiv. Această acțiune nu poate fi anulată."

#. The title for the LWO port selector.
msgctxt "lwo-settings-view"
msgid "Port"
msgstr "Port"

#. Text showing currently selected port.
#. Available placeholders:
#. %(port)s - Can be either a number between 1 and 65535 or the text "Automatic".
msgctxt "lwo-settings-view"
msgid "Port: %(port)s"
msgstr "Link: %(port)s"

msgctxt "lwo-settings-view"
msgid "The automatic setting will randomly choose from the valid port ranges shown below."
msgstr "Setarea automată va alege aleatoriu din intervalele de porturi valide prezentate mai jos."

msgctxt "lwo-settings-view"
msgid "The custom port can be any value inside the valid ranges: %(portRanges)s."
msgstr "Portul personalizat poate avea orice valoare din intervalele valide: %(portRanges)s."

#. Text describing the valid port ranges for a port selector.
#. Available placeholders:
#. %(portRanges)s - will be replaced with a comma-separated list of port ranges
msgctxt "lwo-settings-view"
msgid "Valid ranges: %(portRanges)s"
msgstr "Intervale valabile: %(portRanges)s"

#. Title label in navigation bar
msgctxt "navigation-bar"
msgid "API access"
msgstr "Acces la API"

#. The system notification displayed to the user when the account credit is close to expiry.
#. Available placeholder:
#. %(duration)s - remaining time, e.g. "2 days"
msgctxt "notifications"
msgid "Account credit expires in %(duration)s. Buy more credit."
msgstr "Creditul contului expiră în %(duration)s. Cumpărați mai mult credit."

msgctxt "notifications"
msgid "Account is out of time"
msgstr "Contul a expirat"

msgctxt "notifications"
msgid "App is out of sync. Please quit and restart."
msgstr "Aplicația nu este sincronizată. Vă rugăm să o închideți și să o reporniți."

#. The system notification that notifies the user when a beta update is
#. available.
#. Available placeholders:
#. %(version)s - The version number of the new beta version.
msgctxt "notifications"
msgid "Beta update available. Try out the newest beta version (%(version)s)."
msgstr "Este disponibilă o actualizare beta. Încercați cea mai nouă versiune beta (%(version)s)."

msgctxt "notifications"
msgid "Buy more"
msgstr "Cumpărați mai mult"

msgctxt "notifications"
msgid "Connected"
msgstr "Conectat"

#. The message showed when a server has been connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connected to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connected to %(location)s"
msgstr "Conectat la %(location)s"

msgctxt "notifications"
msgid "Connecting"
msgstr "Conectare"

#. The message showed when a server is being connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connecting to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connecting to %(location)s"
msgstr "Conectarea la %(location)s"

msgctxt "notifications"
msgid "Connection might be unsecured. App lost contact with system service, please troubleshoot."
msgstr "Este posibil ca conexiunea să nu fie securizată. Aplicația a pierdut legătura cu serviciul de sistem; vă rugăm să rezolvați problema."

msgctxt "notifications"
msgid "Could not configure IPv6. Disable it in the app or enable it on your device."
msgstr "Nu s-a putut configura IPv6. Dezactivați-l în aplicație sau activați-l pe dispozitivul dvs."

msgctxt "notifications"
msgid "Disconnected and unsecure"
msgstr "Deconectat și nesigur"

msgctxt "notifications"
msgid "Failed to enable split tunneling."
msgstr "Nu s-a reușit activarea Split tunneling-ului."

msgctxt "notifications"
msgid "Failed to enable split tunneling. Please try reconnecting or disable split tunneling."
msgstr "Nu s-a reușit activarea Split tunneling-ului. Vă rugăm să încercați să vă reconectați sau să dezactivați Split tunneling-ul."

#. Label for the system notification when the app encountered an error
#. and will block network traffic until the error is resolved.
#. Label for the in-app banner when the app encountered an error
msgctxt "notifications"
msgid "Failed to start %(splitTunneling)s. To unblock network traffic, disable split tunneling."
msgstr "Nu s-a putut porni %(splitTunneling)s. Pentru a debloca traficul de rețea, dezactivați funcția „Split tunneling”."

#. Label for notification when IPv4 is not available.
msgctxt "notifications"
msgid "IPv4 is not available, please try changing Device IP version setting."
msgstr "IPv4 nu este disponibil; vă rugăm să încercați să modificați setarea versiunii IP a dispozitivului."

#. Label for notification when IPv6 is not available.
msgctxt "notifications"
msgid "IPv6 is not available, please try changing Device IP version setting."
msgstr "IPv6 nu este disponibil; vă rugăm să încercați să modificați setarea versiunii IP a dispozitivului."

msgctxt "notifications"
msgid "Lockdown mode active, connection blocked"
msgstr "Mod Blocare este activ, conexiunea este blocată"

msgctxt "notifications"
msgid "No servers match your settings, try changing server or other settings."
msgstr "Nu există servere care să corespundă setărilor dvs.; încercați să schimbați serverul sau alte setări."

#. A link in the in-app banner to encourage the user to update the app.
#. The in-app banner is is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Please click here to update now"
msgstr "Vă rugăm să faceți clic aici pentru a actualiza acum"

msgctxt "notifications"
msgid "Reconnecting"
msgstr "Reconectare"

msgctxt "notifications"
msgid "The apps excluded with %(splitTunneling)s might not work properly right now."
msgstr "Este posibil ca aplicațiile excluse prin funcția „%(splitTunneling)s” să nu funcționeze corect în acest moment."

msgctxt "notifications"
msgid "Unable to apply firewall rules."
msgstr "Nu se pot aplica regulile de firewall."

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try temporarily disabling any third-party antivirus or security software."
msgstr "Nu se pot aplica regulile firewall-ului. Încercați să dezactivați temporar orice program antivirus sau de securitate de la terți."

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try updating your kernel."
msgstr "Nu se pot aplica regulile firewall-ului. Încercați să actualizați kernel-ul."

msgctxt "notifications"
msgid "Unable to block all network traffic. Please troubleshoot or send a problem report."
msgstr "Nu se poate bloca întregul trafic de rețea. Vă rugăm să remediați problema sau să trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try temporarily disabling any third-party antivirus or security software or send a problem report."
msgstr "Nu se poate bloca întregul trafic de rețea. Încercați să dezactivați temporar orice program antivirus sau de securitate de la terți sau trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try updating your kernel or send a problem report."
msgstr "Nu se poate bloca întregul trafic de rețea. Încercați să actualizați kernelul sau trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or send a problem report."
msgstr "Nu se poate stabili conexiunea cu driverul de kernel Warren. Încercați să vă reconectați sau trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to resolve host of custom tunnel. Try changing your settings."
msgstr "Nu se poate identifica gazda tunelului personalizat. Încercați să modificați setările."

msgctxt "notifications"
msgid "Unable to set system DNS server. Please send a problem report."
msgstr "Nu se poate configura serverul DNS al sistemului. Vă rugăm să trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please send a problem report."
msgstr "Nu se poate iniția conexiunea prin tunel. Vă rugăm să trimiteți un raport de eroare."

msgctxt "notifications"
msgid "Unable to start tunnel connection. This could be because of conflicts with VMware, please troubleshoot."
msgstr "Nu se poate iniția conexiunea prin tunel. Aceasta s-ar putea datora unor conflicte cu VMware; vă rugăm să remediați problema."

msgctxt "notifications"
msgid "Update available. Install the latest app version to stay up to date"
msgstr "Este disponibilă o actualizare. Instalați cea mai recentă versiune a aplicației pentru a fi la curent cu noutățile"

msgctxt "notifications"
msgid "Upgrade"
msgstr "Actualizare"

msgctxt "notifications"
msgid "Your device is offline. The tunnel will automatically connect once your device is back online."
msgstr "Dispozitivul dvs. este offline. Tunelul se va conecta automat imediat ce dispozitivul dvs. va fi din nou online."

#. The in-app banner which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version."
msgstr "Confidențialitatea dvs. ar putea fi pusă în pericol de această versiune a aplicației care nu mai beneficiază de asistență."

#. The system notification which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version. Please update now."
msgstr "Confidențialitatea dvs. ar putea fi pusă în pericol de această versiune a aplicației care nu mai beneficiază de asistență. Te rugăm să o actualizezi acum."

msgctxt "notifications"
msgid "Automatic renewal charged: 1 month will be added to your Warren time. You can turn auto-renewal off anytime in Account settings."
msgstr "Reînnoirea automată a fost facturată: 1 lună va fi adăugată la timpul dvs. Warren. Puteți dezactiva oricând reînnoirea automată în setările contului."

msgctxt "notifications"
msgid "Automatic renewal failed. Update your payment method or buy credit manually."
msgstr "Reînnoirea automată a eșuat. Actualizați metoda de plată sau cumpărați credit manual."

msgctxt "notifications"
msgid "Automatic renewal has been turned off for this account."
msgstr "Reînnoirea automată a fost dezactivată pentru acest cont."

msgctxt "notifications"
msgid "Unable to block all network traffic. Please troubleshoot or report the problem on our community forum."
msgstr "Nu se poate bloca întregul trafic de rețea. Vă rugăm să remediați problema sau să o raportați pe forumul nostru."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try temporarily disabling any third-party antivirus or security software, or report the problem on our community forum."
msgstr "Nu se poate bloca întregul trafic de rețea. Încercați să dezactivați temporar orice program antivirus sau de securitate de la terți ori raportați problema pe forumul nostru."

msgctxt "notifications"
msgid "Unable to block all network traffic. Try updating your kernel or report the problem on our community forum."
msgstr "Nu se poate bloca întregul trafic de rețea. Încercați să actualizați kernelul sau raportați problema pe forumul nostru."

msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or report the problem on our community forum."
msgstr "Nu se poate stabili conexiunea cu driverul de kernel Warren. Încercați să vă reconectați sau raportați problema pe forumul nostru."

msgctxt "notifications"
msgid "Unable to set system DNS server. Please report the problem on our community forum."
msgstr "Nu se poate configura serverul DNS al sistemului. Vă rugăm să raportați problema pe forumul nostru."

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please report the problem on our community forum."
msgstr "Nu se poate iniția conexiunea prin tunel. Vă rugăm să raportați problema pe forumul nostru."

msgctxt "notifications"
msgid "Your bank asks for a confirmation to renew. Open Warren and buy credit to confirm."
msgstr "Banca dvs. solicită o confirmare pentru reînnoire. Deschideți Warren și cumpărați credit pentru a confirma."

msgctxt "notifications"
msgid "Your network looks unstable: the tunnel reconnected too many times in a row. Reconnect once your connection has settled."
msgstr "Rețeaua dvs. pare instabilă: tunelul s-a reconectat de prea multe ori la rând. Reconectați-vă după ce conexiunea se stabilizează."

#. The 30-day advance notice before an automatic renewal charge.
#. Available placeholder:
#. %(date)s - the renewal date
msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at the monthly rate. You can turn auto-renewal off anytime in Account settings."
msgstr "Timpul dvs. Warren se reînnoiește automat în jurul datei de %(date)s, la tariful lunar. Puteți dezactiva oricând reînnoirea automată în setările contului."

msgctxt "notifications"
msgid "Your Warren time renews in the next days. You can turn auto-renewal off anytime in Account settings."
msgstr "Timpul dvs. Warren se reînnoiește în zilele următoare. Puteți dezactiva oricând reînnoirea automată în setările contului."

msgctxt "port-forwarding-view"
msgid "Mapping failed: %(error)s"
msgstr "Eroare la generarea hărții: %(error)s"

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "Redirecționarea porturilor"

msgctxt "port-forwarding-view"
msgid "Public port: %(port)s"
msgstr "Port public: %(port)s"

msgctxt "port-forwarding-view"
msgid "Renewing in %(countdown)s"
msgstr "Reînnoirea în cadrul programului „%(countdown)s”"

msgctxt "port-forwarding-view"
msgid "Requesting port mapping..."
msgstr "Se solicită redirecționarea porturilor..."

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "Deschide un port public pe serverul de ieșire conectat și îl redirecționează către dispozitivul dvs. Util pentru aplicații peer-to-peer, partajare de fișiere sau servicii găzduite local."

msgctxt "port-forwarding-view"
msgid "Assign a free port"
msgstr "Atribuie un port liber"

msgctxt "port-forwarding-view"
msgid "Choose another exit"
msgstr "Alege alt server de ieșire"

msgctxt "port-forwarding-view"
msgid "disabled"
msgstr "dezactivat"

msgctxt "port-forwarding-view"
msgid "This public port is already in use on this exit. Keep your port by switching exit, let the exit assign a free public port, or type another port above."
msgstr "Acest port public este deja ocupat pe acest server de ieșire. Păstrează-ți portul schimbând serverul de ieșire, lasă serverul să atribuie un port public liber sau scrie mai sus alt port."

#. Cancel button label for voucher redemption.
msgctxt "redeem-voucher-alert"
msgid "Cancel"
msgstr "Anulați"

#. Input field label for voucher code.
msgctxt "redeem-voucher-alert"
msgid "Enter voucher code"
msgstr "Introduceți voucherul promoțional"

#. Button label for redeeming a voucher.
msgctxt "redeem-voucher-alert"
msgid "Redeem voucher"
msgstr "Valorificați voucherul"

msgctxt "redeem-voucher-view"
msgid "An error occurred."
msgstr "A apărut o eroare."

msgctxt "redeem-voucher-view"
msgid "It looks like you’ve entered a public key instead of a voucher code. If you would like to change the active account, please log out first."
msgstr "Se pare că ați introdus o cheie publică în loc de un voucher. Dacă doriți să schimbați contul activ, vă rugăm să vă deconectați mai întâi."

#. Button label for voucher redemption.
msgctxt "redeem-voucher-view"
msgid "Redeem"
msgstr "Valorificați"

msgctxt "redeem-voucher-view"
msgid "Verifying voucher..."
msgstr "Se verifică voucherul..."

msgctxt "redeem-voucher-view"
msgid "Voucher code has already been used."
msgstr "Voucherul promoțional a fost deja utilizat."

msgctxt "redeem-voucher-view"
msgid "Voucher code is invalid."
msgstr "Voucherul nu este valabil."

msgctxt "redeem-voucher-view"
msgid "Voucher was successfully redeemed."
msgstr "Voucherul a fost valorificat cu succes."

msgctxt "redeem-voucher-view"
msgid "Voucher code has expired."
msgstr "Voucherul promoțional a expirat."

#. Title label in navigation bar
msgctxt "select-language-nav"
msgid "Select language"
msgstr "Selectați limba"

#. Title label in navigation bar
msgctxt "select-location-nav"
msgid "Select location"
msgstr "Selectați locația"

#. Message shown when the user has no custom lists.
#. Instructs the user how to create a custom list.
msgctxt "select-location-view"
msgid "Add a custom list by clicking the “+” icon"
msgstr "Adăugați o listă personalizată făcând clic pe pictograma „+”"

msgctxt "select-location-view"
msgid "All locations"
msgstr "Toate locațiile"

#. Message shown in the custom list section when the user has at least one custom list.
#. Instructs the user how to add locations to the custom list.
msgctxt "select-location-view"
msgid "Click “+“ on a location to add it to a list"
msgstr "Dă clic pe „+“ lângă o locație pentru a o adăuga la o listă"

msgctxt "select-location-view"
msgid "Custom lists"
msgstr "Liste personalizate"

msgctxt "select-location-view"
msgid "Disable recents"
msgstr "Dezactivați istoricul"

#. Label for custom lists that don't have any locations added to them yet.
msgctxt "select-location-view"
msgid "Empty"
msgstr "Gol"

msgctxt "select-location-view"
msgid "Enable recents"
msgstr "Activați istoricul"

msgctxt "select-location-view"
msgid "Entry"
msgstr "Intrare"

msgctxt "select-location-view"
msgid "Exit"
msgstr "Ieșire"

msgctxt "select-location-view"
msgid "Filtered:"
msgstr "Filtrat:"

#. Message shown when the user has no recent locations.
msgctxt "select-location-view"
msgid "No recent selection history"
msgstr "Nu există istoric recent al selecțiilor"

#. Label for indicator that shows that obfuscation is being used as a filter.
#. Available placeholders:
#. %(obfuscation)s - type of obfuscation in use
msgctxt "select-location-view"
msgid "Obfuscation: %(obfuscation)s"
msgstr "Ofuscare: %(obfuscation)s"

msgctxt "select-location-view"
msgid "Open %(daita)s settings"
msgstr "Deschideți setările aplicației „%(daita)s”"

msgctxt "select-location-view"
msgid "Providers: %(numberOfProviders)d"
msgstr "Furnizori: %(numberOfProviders)d"

#. Title for section showing recently used locations.
msgctxt "select-location-view"
msgid "Recents"
msgstr "Cele mai recente"

msgctxt "select-location-view"
msgid "Setting: %(settingName)s"
msgstr "Link: %(settingName)s"

#. Text showing how many locations are currently shown out of the total number of locations, e.g. "Showing 5 of 250"
#. Available placeholders:
#. %(visibleRelays)s: The number of relays currently shown
#. %(totalRelays)s: The total number of relays
msgctxt "select-location-view"
msgid "Showing %(visibleRelays)s of %(totalRelays)s"
msgstr "Se afișează %(visibleRelays)s din %(totalRelays)s"

msgctxt "select-location-view"
msgid "The entry server for %(multihop)s is currently overridden by %(daita)s. To select an entry server, please first enable “%(directOnly)s” or disable \"%(daita)s\" in the settings."
msgstr "Serverul de acces pentru %(multihop)s este în prezent suprascris de %(daita)s. Pentru a selecta un server de acces, vă rugăm să activați mai întâi opțiunea „%(directOnly)s” sau să dezactivați opțiunea „%(daita)s” din setări."

msgctxt "settings-import"
msgid "Clear all overrides"
msgstr "Șterge toate suprascrierile"

msgctxt "settings-import"
msgid "Clear all overrides?"
msgstr "Să ștergi toate suprascrierile?"

msgctxt "settings-import"
msgid "Clearing the imported overrides changes the server IPs, in the Select location view, back to default."
msgstr "Ștergerea setărilor de suprascriere importate readuce adresele IP ale serverelor la valorile implicite în vizualizarea „Selectare locație”."

msgctxt "settings-import"
msgid "If you are having issues connecting to VPN servers, please contact support."
msgstr "Dacă întâmpinați probleme la conectarea la serverele VPN, vă rugăm să contactați serviciul de asistență."

msgctxt "settings-import"
msgid "Import file"
msgstr "Importare fișier"

msgctxt "settings-import"
msgid "Import files or text with new IP addresses for the servers in the Select location view."
msgstr "Importați fișiere sau text cu noile adrese IP pentru serverele din vizualizarea „Selectați locația”."

msgctxt "settings-import"
msgid "Import of file %(fileName)s was successful, overrides are now active."
msgstr "Importul fișierului „%(fileName)s” s-a realizat cu succes; modificările sunt acum active."

msgctxt "settings-import"
msgid "Import of file %(fileName)s was unsuccessful, please try again."
msgstr "Importul fișierului „%(fileName)s” nu a reușit; vă rugăm să încercați din nou."

msgctxt "settings-import"
msgid "Import of text was successful, overrides are now active."
msgstr "Importul textului s-a realizat cu succes, modificările sunt acum active."

msgctxt "settings-import"
msgid "Import of text was unsuccessful, please try again."
msgstr "Importul textului nu a reușit; vă rugăm să încercați din nou."

msgctxt "settings-import"
msgid "IMPORT SUCCESSFUL"
msgstr "IMPORTUL S-A EFECTUAT CU SUCCES"

