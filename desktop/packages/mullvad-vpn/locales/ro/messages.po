msgctxt "custom-list-feature"
msgid "Edit name"
msgstr "Editați numele"

msgctxt "custom-list-feature"
msgid "Enter a name for the list"
msgstr "Introduceți un nume pentru listă"

msgctxt "custom-list-feature"
