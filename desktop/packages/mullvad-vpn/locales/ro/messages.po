msgctxt "api-access-methods-view"
msgid "If you are not connected to our VPN, then the Encrypted DNS proxy will use your own non-VPN IP when connecting. The DoH servers are hosted by one of the following providers: Quad9 or Cloudflare."
msgstr "Dacă nu sunteți conectat la VPN-ul nostru, proxy-ul DNS criptat va utiliza adresa IP proprie (fără VPN) la conectare. Serverele DoH sunt găzduite de unul dintre următorii furnizori: Quad9 sau Cloudflare."

msgctxt "api-access-methods-view"
msgid "In use"
msgstr "În uz"

msgctxt "api-access-methods-view"
msgid "Local SOCKS5 server"
msgstr "Server SOCKS5 local"

msgctxt "api-access-methods-view"
msgid "Manage and add custom methods to access the Warren API."
msgstr "Gestionați și adăugați metode personalizate pentru a accesa API-ul Warren."

msgctxt "api-access-methods-view"
msgid "On some networks, where various types of censorship are being used, the API servers might not be directly reachable."
msgstr "În anumite rețele, unde se aplică diverse forme de cenzură, este posibil ca serverele API să nu fie accesibile direct."

msgctxt "api-access-methods-view"
msgid "Please enter a valid IPv4 or IPv6 address."
msgstr "Vă rugăm să introduceți o adresă IPv4 sau IPv6 validă."

msgctxt "api-access-methods-view"
msgid "Please enter a valid localhost port."
msgstr "Vă rugăm să introduceți un port localhost valid."

msgctxt "api-access-methods-view"
msgid "Please enter a valid remote server port."
msgstr "Vă rugăm să introduceți un port valid al serverului la distanță."

msgctxt "api-access-methods-view"
msgid "Please select a name for the access method not already in use."
msgstr "Vă rugăm să alegeți un nume pentru metoda de acces care nu este deja utilizat."

msgctxt "api-access-methods-view"
msgid "Remote Server"
msgstr "Server la distanță"

msgctxt "api-access-methods-view"
msgid "Server"
msgstr "Server"

msgctxt "api-access-methods-view"
msgid "Server details"
msgstr "Detalii despre server"

msgctxt "api-access-methods-view"
msgid "SOCKS5 local"
msgstr "SOCKS5 local"

msgctxt "api-access-methods-view"
msgid "SOCKS5 remote"
msgstr "SOCKS5 la distanță"

msgctxt "api-access-methods-view"
msgid "Testing method..."
msgstr "Metoda de testare..."

msgctxt "api-access-methods-view"
msgid "Testing..."
msgstr "Testare..."

