msgid "%(DAITA)s: not active on this server"
msgstr "%(DAITA)s: nu este activă pe acest server"

msgctxt "connect-view"
msgid "Could not refresh the beta access. Check your connection and try again."
msgstr "Nu s-a putut reîmprospăta accesul beta. Verificați conexiunea și încercați din nou."

#. could not be established.
msgctxt "connect-view"
msgid "Port forwarding: blocked"
msgstr "Redirecționarea porturilor: blocată"

#. public port is already taken on the connected exit.
msgctxt "connect-view"
