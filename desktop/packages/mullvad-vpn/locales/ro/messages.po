msgstr "MTU redus (%(mtu)s)"

#. Button label that re-activates the free beta access.
msgctxt "connect-view"
msgid "Refresh beta access"
msgstr "Reîmprospătați accesul beta"

msgctxt "connect-view"
msgid "This app uses the free Warren beta: no payment needed. Refresh your beta access to continue."
msgstr "Această aplicație folosește versiunea beta gratuită Warren: nu este necesară nicio plată. Reîmprospătați accesul beta pentru a continua."

#. The hostname line displayed below the country on the main screen
#. Available placeholders:
#. %(relay)s - the relay hostname
#. %(entry)s - the entry relay hostname
