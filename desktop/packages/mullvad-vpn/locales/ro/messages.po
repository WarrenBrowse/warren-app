msgctxt "support-view"
msgid "Send anyway"
msgstr "Trimite oricum"

msgctxt "support-view"
msgid "Sending..."
msgstr "Se trimite..."

msgctxt "support-view"
msgid "Sent"
msgstr "Trimis"

