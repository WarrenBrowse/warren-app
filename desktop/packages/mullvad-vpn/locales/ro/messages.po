msgctxt "app-upgrade-view"
msgid "You are using the latest version"
msgstr "Folosiți cea mai recentă versiune"

#. Label displayed when an error occurred due to the installer failing to start
#. and the suggested resolution is to download the update again.
msgctxt "app-upgrade-view"
msgid "Could not open installer, please try again or report the problem on our community forum."
msgstr "Nu s-a putut deschide programul de instalare. Vă rugăm să încercați din nou sau să raportați problema pe forumul nostru."

#. Label displayed when an error occurred due to the download failing
msgctxt "app-upgrade-view"
msgid "Download failed, please check your connection/firewall and try again, or report the problem on our community forum."
msgstr "Descărcarea a eșuat. Vă rugăm să verificați conexiunea sau setările firewall-ului și să încercați din nou ori să raportați problema pe forumul nostru."

#. Label displayed when an error occurred within the installer
msgctxt "app-upgrade-view"
msgid "Installer quit unexpectedly, please try again or report the problem on our community forum."
msgstr "Programul de instalare s-a închis neașteptat. Vă rugăm să încercați din nou sau să raportați problema pe forumul nostru."

#. Button text to report a problem on the community forum
msgctxt "app-upgrade-view"
msgid "Report a problem on the forum"
msgstr "Raportați problema pe forum"

msgctxt "app-upgrade-view"
msgid "This version of Warren is no longer supported. To keep your connection protected, you must update the app to keep using it."
msgstr "Această versiune Warren nu mai este acceptată. Pentru a vă păstra conexiunea protejată, trebuie să actualizați aplicația pentru a o folosi în continuare."

#. Label displayed when an unknown error occurred
msgctxt "app-upgrade-view"
msgid "Unknown error occurred. Please try again or report the problem on our community forum."
msgstr "A apărut o eroare necunoscută. Vă rugăm să încercați din nou sau să raportați problema pe forumul nostru."

#. Title of the screen that forces the user to update.
msgctxt "app-upgrade-view"
msgid "Update required"
msgstr "Actualizare necesară"

#. Label displayed when an error occurred due to the installer failed verification
msgctxt "app-upgrade-view"
msgid "Verification failed, please try again or report the problem on our community forum."
msgstr "Verificarea a eșuat. Vă rugăm să încercați din nou sau să raportați problema pe forumul nostru."

msgctxt "auth-failure"
msgid "Blocking internet: account is out of time"
msgstr "Blocarea accesului la internet: contul a expirat"

msgctxt "auth-failure"
msgid "Too many simultaneous connections on this account. Disconnect another device or try connecting again shortly."
msgstr "Există prea multe conexiuni simultane pe acest cont. Deconectați un alt dispozitiv sau încercați să vă reconectați în scurt timp."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please send a problem report."
msgstr "Nu se poate autentifica contul. Vă rugăm să trimiteți un raport de eroare."

msgctxt "auth-failure"
msgid "You are logged in with an invalid public key. Please log out and try another one."
msgstr "V-ați autentificat cu o cheie publică nevalidă. Vă rugăm să vă deconectați și să încercați cu o altă cheie."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended for a usage policy violation. Contact support if you believe this is a mistake."
msgstr "Blocarea accesului la internet: accesul dvs. a fost suspendat pentru încălcarea regulilor de utilizare. Contactați asistența dacă considerați că este o greșeală."

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended for abuse on a forwarded port. Contact support if you believe this is a mistake."
msgstr "Blocarea accesului la internet: accesul dvs. a fost suspendat pentru abuz pe un port redirecționat. Contactați asistența dacă considerați că este o greșeală."

msgctxt "auth-failure"
msgid "Unable to authenticate account. Please report the problem on our community forum."
msgstr "Nu se poate autentifica contul. Vă rugăm să raportați problema pe forumul nostru."

#. Accessibility label of the beta badge button.
msgctxt "beta-badge"
msgid "About the Warren beta"
msgstr "Despre versiunea beta Warren"

#. Label of the beta badge shown in beta builds.
msgctxt "beta-badge"
msgid "BETA"
msgstr "BETA"

msgctxt "beta-badge"
msgid "Free beta network, limited bandwidth"
msgstr "Rețea beta gratuită, lățime de bandă limitată"

#. Short beta banner line. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "Free beta network, speed capped at %(mbps)d Mbps"
msgstr "Rețea beta gratuită, viteză limitată la %(mbps)d Mbps"

#. Beta info dialog sentence. Available placeholders:
#. %(mbps)d - the bandwidth cap in Mbps
msgctxt "beta-badge"
msgid "It runs on a separate network with bandwidth capped at %(mbps)d Mbps."
msgstr "Funcționează pe o rețea separată, cu lățimea de bandă limitată la %(mbps)d Mbps."

msgctxt "beta-badge"
msgid "It runs on a separate network with limited bandwidth."
msgstr "Funcționează pe o rețea separată, cu lățime de bandă limitată."

#. Link to the community forum in the beta info dialog.
msgctxt "beta-badge"
msgid "Share your feedback on the forum"
msgstr "Împărtășiți-vă părerea pe forum"

#. Paragraph of the beta info dialog clarifying that the beta terms are temporary.
msgctxt "beta-badge"
msgid "These are not the final service conditions: the full-speed network is a separate, paid product."
msgstr "Acestea nu sunt condițiile finale ale serviciului: rețeaua la viteză maximă este un produs plătit separat."

#. First paragraph of the beta info dialog.
msgctxt "beta-badge"
msgid "This app uses the free Warren beta, here to help us validate Warren in real conditions."
msgstr "Această aplicație folosește versiunea beta gratuită Warren, care ne ajută să validăm Warren în condiții reale."

#. Title of the beta info dialog.
msgctxt "beta-badge"
msgid "Warren beta"
msgstr "Versiunea beta Warren"

#. Text displayed when there are no updates for this platform in the app version
msgctxt "changelog-view"
msgid "No updates or changes were made in this release for this platform."
msgstr "În această versiune nu s-au efectuat actualizări sau modificări pentru această platformă."

#. Heading for the view of the changes and updates in the
#. current version compared to the old version.
msgctxt "changelog-view"
msgid "What’s new"
msgstr "Noutăți"

