msgstr "เราไม่สามารถเริ่มกระบวนการชำระเงินได้ โปรดตรวจสอบให้แน่ใจว่า คุณมี Google Play เวอร์ชันล่าสุด "

msgid "We were unable to start the payment process, please try again later."
msgstr "เราไม่สามารถเริ่มกระบวนการชำระเงินได้ โปรดลองอีกครั้งในภายหลัง"

msgid "Weather"
msgstr "สภาพอากาศ"

msgid "Welcome, this device is now called <b>%s</b>."
msgstr "ยินดีต้อนรับ อุปกรณ์นี้มีชื่อว่า <b>%s</b> แล้ว"

msgid "QUIC port"
msgstr "พอร์ต QUIC"

msgid "Yes, log out device"
msgstr "ใช่ นำอุปกรณ์ออกจากระบบ"

msgid "You are about to delete your Warren VPN account."
msgstr "คุณกำลังจะทำการลบบัญชี Warren VPN ของคุณ"

msgid "You can add more time via the account view or website to continue using the VPN."
msgstr "คุณสามารถเพิ่มเวลาเพิ่มเติมได้โดยการดูบัญชีหรือเว็บไซต์เพื่อใช้งาน VPN ต่อไป"

msgid "You can add more time via the account view to continue using the VPN."
msgstr "คุณสามารถเพิ่มเวลาผ่านทางหน้าบัญชีเพื่อใช้งาน VPN ต่อได้"

msgid "You will lose access to this account on all devices."
msgstr "คุณจะสูญเสียการเข้าถึงบัญชีนี้บนทุกอุปกรณ์"

msgid "You will lose your remaining"
msgstr "คุณจะสูญเสียจำนวนวันที่เหลืออยู่"

msgid "\"%s\" was created"
msgstr "\"%s\" ถูกสร้างแล้ว"

msgid "\"%s\" was deleted"
msgstr "\"%s\" ถูกลบแล้ว"

msgid "click here"
msgstr "คลิกที่นี่"

msgid "here"
msgstr "ที่นี่"

msgid "less than one day"
msgstr "น้อยกว่าหนึ่งวัน"

msgid "privacy policy"
msgstr "นโยบายความเป็นส่วนตัว"

msgid "read more here"
msgstr "อ่านเพิ่มเติมที่นี่"

msgid "%d day"
msgid_plural "%d days"
msgstr[0] "%d วัน"

msgid "%d location"
msgid_plural "%d locations"
msgstr[0] "%d ตำแหน่งที่ตั้ง"

msgid "%d month"
msgid_plural "%d months"
msgstr[0] "%d เดือน"

msgid "1 day left on this account"
msgid_plural "%d days left on this account"
msgstr[0] "บัญชีนี้เหลือเวลา %d วัน"

msgid "1 year left on this account"
msgid_plural "%d years left on this account"
msgstr[0] "บัญชีนี้เหลือเวลา %d ปี"

msgid "Account credit expires in a day"
msgid_plural "Account credit expires in %d days"
msgstr[0] "เครดิตของบัญชีจะหมดอายุใน %d วัน"

msgid "Account credit expires in an hour"
msgid_plural "Account credit expires in %d hours"
msgstr[0] "เครดิตของบัญชีจะหมดอายุใน %d ชั่วโมง"

msgid "You will lose your remaining day."
msgid_plural "You will lose your remaining %d days."
msgstr[0] "คุณจะสูญเสียจำนวนวันที่เหลืออีก %d วัน"


msgctxt "port-forwarding-view"
msgid "auto"
msgstr "อัตโนมัติ"

msgctxt "port-forwarding-view"
msgid "Mapping failed: %(error)s"
msgstr "การแมปล้มเหลว: %(error)s"

msgctxt "port-forwarding-view"
msgid "Opens a public port on the connected exit and forwards it to your device. Useful for peer-to-peer applications, file sharing, or self-hosted services."
msgstr "เปิดพอร์ตสาธารณะบนเซิร์ฟเวอร์ทางออกที่เชื่อมต่ออยู่และส่งต่อไปยังอุปกรณ์ของคุณ มีประโยชน์สำหรับแอปพลิเคชันแบบเพียร์ทูเพียร์ การแชร์ไฟล์ หรือบริการที่โฮสต์เอง"

msgctxt "port-forwarding-view"
msgid "Port forwarding"
msgstr "การส่งต่อพอร์ต"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535, or empty for auto."
msgstr "พอร์ตต้องอยู่ระหว่าง 49152 ถึง 65535 หรือเว้นว่างไว้สำหรับอัตโนมัติ"

msgctxt "port-forwarding-view"
msgid "Preferred port"
msgstr "พอร์ตที่ต้องการ"

msgctxt "port-forwarding-view"
msgid "Protocol"
msgstr "โปรโตคอล"

msgctxt "port-forwarding-view"
msgid "Public port: %(port)s"
msgstr "พอร์ตสาธารณะ: %(port)s"

msgctxt "port-forwarding-view"
msgid "Renewing in %(countdown)s"
msgstr "ต่ออายุใน %(countdown)s"

msgctxt "port-forwarding-view"
msgid "Status: active"
msgstr "สถานะ: ใช้งานอยู่"

msgctxt "port-forwarding-view"
msgid "Status: requesting port mapping..."
msgstr "สถานะ: กำลังขอการแมปพอร์ต…"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mapping."
msgstr "สถานะ: กำลังรอการเชื่อมต่ออุโมงค์ที่ใช้งานอยู่เพื่อตั้งค่าการแมปพอร์ต"

msgctxt "port-forwarding-view"
msgid "The server may assign a different port if the preferred one is already taken. Changes apply immediately, no reconnection needed."
msgstr "เซิร์ฟเวอร์อาจกำหนดพอร์ตอื่นหากพอร์ตที่ต้องการถูกใช้งานอยู่แล้ว การเปลี่ยนแปลงจะมีผลทันทีโดยไม่ต้องเชื่อมต่อใหม่"

msgctxt "keys-view"
msgid "Backup keys"
msgstr "สำรองคีย์"

msgctxt "keys-view"
msgid "Daemon rejected the mnemonic. Check spelling, word count, and try again."
msgstr "บริการปฏิเสธวลีกู้คืน ตรวจสอบการสะกดและจำนวนคำ แล้วลองอีกครั้ง"

msgctxt "keys-view"
msgid "Done"
msgstr "เสร็จสิ้น"

msgctxt "keys-view"
msgid "Enter your 12-word (or 24-word) BIP39 mnemonic, separated by spaces."
msgstr "ป้อนวลีกู้คืน BIP39 ขนาด 12 คำ (หรือ 24 คำ) โดยคั่นแต่ละคำด้วยช่องว่าง"

msgctxt "keys-view"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "ไม่สามารถเรียกวลีกู้คืนจากบริการได้"

msgctxt "keys-view"
msgid "I have written it down in a safe place."
msgstr "ฉันได้จดบันทึกไว้ในที่ปลอดภัยแล้ว"

msgctxt "keys-view"
msgid "I understand this will permanently replace my current identity."
msgstr "ฉันเข้าใจว่าการกระทำนี้จะแทนที่ตัวตนปัจจุบันของฉันอย่างถาวร"

msgctxt "keys-view"
msgid "Identity restored. Your new Warren wallet is now active."
msgstr "กู้คืนตัวตนแล้ว กระเป๋าเงิน Warren ใหม่ของคุณเปิดใช้งานแล้ว"

msgctxt "keys-view"
msgid "Keys"
msgstr "คีย์"

msgctxt "keys-view"
msgid "No mnemonic available. Log in or restore an identity first."
msgstr "ไม่มีวลีกู้คืน กรุณาเข้าสู่ระบบหรือกู้คืนตัวตนก่อน"

msgctxt "keys-view"
msgid "Restore from mnemonic"
msgstr "กู้คืนจากวลีกู้คืน"

msgctxt "keys-view"
msgid "Restore identity"
msgstr "กู้คืนตัวตน"

msgctxt "keys-view"
msgid "Restoring..."
msgstr "กำลังกู้คืน..."

msgctxt "keys-view"
msgid "Reveal mnemonic"
msgstr "แสดงวลีกู้คืน"

msgctxt "keys-view"
msgid "WARNING: This will REPLACE your current identity. Any subscription tied to the current identity will be unrecoverable."
msgstr "คำเตือน: การกระทำนี้จะ แทนที่ ตัวตนปัจจุบันของคุณ การสมัครสมาชิกใดๆ ที่ผูกกับตัวตนปัจจุบันจะไม่สามารถกู้คืนได้"

msgctxt "keys-view"
msgid "Write it down on paper. Never store it in a cloud, screenshot, or email."
msgstr "จดลงบนกระดาษ อย่าเก็บไว้ในคลาวด์ ภาพหน้าจอ หรืออีเมลเด็ดขาด"

msgctxt "keys-view"
msgid "Your 12-word mnemonic is the ONLY way to restore your Warren identity on another device. If lost, your subscription is unrecoverable."
msgstr "วลีกู้คืน 12 คำของคุณคือวิธี เดียว ที่จะกู้คืนตัวตน Warren บนอุปกรณ์อื่น หากสูญหาย จะไม่สามารถกู้คืนการสมัครสมาชิกของคุณได้"

msgctxt "keys-view"
msgid "words"
msgstr "คำ"

msgctxt "warren-mnemonic"
msgid "Copied to clipboard"
msgstr "คัดลอกไปยังคลิปบอร์ดแล้ว"

msgctxt "warren-mnemonic"
msgid "Copy to clipboard"
msgstr "คัดลอกไปยังคลิปบอร์ด"

msgctxt "warren-onboarding"
msgid "A VPN experience without compromise on privacy. No logs. No accounts. No tracking. Just bandwidth."
msgstr "ประสบการณ์ VPN ที่ไม่ประนีประนอมเรื่องความเป็นส่วนตัว ไม่มีการเก็บประวัติ ไม่ต้องมีบัญชี ไม่มีการติดตาม มีแค่แบนด์วิดท์"

msgctxt "warren-onboarding"
msgid "All set"
msgstr "พร้อมแล้ว"

msgctxt "warren-onboarding"
msgid "Check again"
msgstr "ตรวจสอบอีกครั้ง"

msgctxt "warren-onboarding"
msgid "Checking... (click to refresh now)"
msgstr "กำลังตรวจสอบ... (คลิกเพื่อรีเฟรชทันที)"

msgctxt "warren-onboarding"
msgid "Configuration complete. Pick a country and connect to Warren."
msgstr "ตั้งค่าเสร็จสมบูรณ์ เลือกประเทศแล้วเชื่อมต่อกับ Warren"

msgctxt "warren-onboarding"
msgid "Continue"
msgstr "ดำเนินการต่อ"

msgctxt "warren-onboarding"
msgid "Could not check subscription status. Please try again."
msgstr "ไม่สามารถตรวจสอบสถานะการสมัครสมาชิกได้ กรุณาลองอีกครั้ง"

msgctxt "warren-onboarding"
msgid "Create my new wallet (recommended)"
msgstr "สร้างกระเป๋าเงินใหม่ของฉัน (แนะนำ)"

msgctxt "warren-onboarding"
msgid "Daemon has no mnemonic yet - log in or restart the app."
msgstr "บริการยังไม่มีวลีกู้คืน กรุณาเข้าสู่ระบบหรือรีสตาร์ตแอป"

msgctxt "warren-onboarding"
msgid "Daemon rejected the mnemonic. Check spelling and word count, then try again."
msgstr "บริการปฏิเสธวลีกู้คืน ตรวจสอบการสะกดและจำนวนคำ แล้วลองอีกครั้ง"

msgctxt "warren-onboarding"
msgid "Failed to retrieve mnemonic from daemon."
msgstr "ไม่สามารถเรียกวลีกู้คืนจากบริการได้"

msgctxt "warren-onboarding"
msgid "Get started"
msgstr "เริ่มต้นใช้งาน"

msgctxt "warren-onboarding"
msgid "I already have a subscription"
msgstr "ฉันมีการสมัครสมาชิกอยู่แล้ว"

msgctxt "warren-onboarding"
msgid "I have written it down in a safe place."
msgstr "ฉันได้จดบันทึกไว้ในที่ปลอดภัยแล้ว"

msgctxt "warren-onboarding"
msgid "Import an existing mnemonic"
msgstr "นำเข้าวลีกู้คืนที่มีอยู่"

msgctxt "warren-onboarding"
msgid "No active subscription found. Please purchase one first."
msgstr "ไม่พบการสมัครสมาชิกที่ใช้งานอยู่ กรุณาซื้อก่อน"

msgctxt "warren-onboarding"
msgid "Paste your 12-word BIP39 mnemonic to restore your existing Warren identity."
msgstr "วางวลีกู้คืน BIP39 ขนาด 12 คำของคุณ เพื่อกู้คืนตัวตน Warren ที่มีอยู่"

msgctxt "warren-onboarding"
msgid "Pick a country and connect"
msgstr "เลือกประเทศแล้วเชื่อมต่อ"

msgctxt "warren-onboarding"
msgid "Pick the defenses you want from day one. You can change all of these later from Settings."
msgstr "เลือกระบบป้องกันที่คุณต้องการตั้งแต่วันแรก คุณสามารถเปลี่ยนทั้งหมดนี้ได้ภายหลังจากการตั้งค่า"

msgctxt "warren-onboarding"
msgid "Privacy preferences"
msgstr "การตั้งค่าความเป็นส่วนตัว"

msgctxt "warren-onboarding"
msgid "Restore wallet"
msgstr "กู้คืนกระเป๋าเงิน"

msgctxt "warren-onboarding"
msgid "Skip wizard (advanced)"
msgstr "ข้ามตัวช่วยตั้งค่า (ขั้นสูง)"

msgctxt "warren-onboarding"
msgid "View plans (opens in your browser)"
msgstr "ดูแพ็กเกจ (เปิดในเบราว์เซอร์ของคุณ)"

msgctxt "warren-onboarding"
msgid "Warren uses a non-custodial wallet (Ed25519 + BIP39). You own the keys; we never see them."
msgstr "Warren ใช้กระเป๋าเงินแบบ non-custodial (Ed25519 + BIP39) คุณเป็นเจ้าของคีย์เอง เราไม่มีวันเห็นมัน"

msgctxt "warren-onboarding"
msgid "Welcome to Warren VPN"
msgstr "ยินดีต้อนรับสู่ Warren VPN"

msgctxt "warren-onboarding"
msgid "Write down these 12 words in order and keep them somewhere safe. They are the only way to restore your subscription if you lose access to this device."
msgstr "จด 12 คำนี้ตามลำดับและเก็บไว้ในที่ปลอดภัย นี่คือวิธีเดียวที่จะกู้คืนการสมัครสมาชิกของคุณ หากคุณสูญเสียการเข้าถึงอุปกรณ์นี้"

msgctxt "warren-onboarding"
msgid "You don't have an active subscription yet. Plans start at a few euros per month - no recurring billing, no account creation, pay as you go."
msgstr "คุณยังไม่มีการสมัครสมาชิกที่ใช้งานอยู่ แพ็กเกจเริ่มต้นเพียงไม่กี่ยูโรต่อเดือน ไม่มีการเรียกเก็บเงินอัตโนมัติ ไม่ต้องสร้างบัญชี จ่ายตามการใช้งาน"

msgctxt "warren-onboarding"
msgid "Your Warren wallet"
msgstr "กระเป๋าเงิน Warren ของคุณ"

msgctxt "warren-onboarding"
msgid "Your subscription"
msgstr "การสมัครสมาชิกของคุณ"

msgctxt "warren-onboarding"
msgid "• Always-on obfuscation (ON by default): HTTP/3 mimicry so the wire blends in."
msgstr "• การพรางการรับส่งข้อมูลแบบเปิดตลอด (เปิดเป็นค่าเริ่มต้น): เลียนแบบ HTTP/3 เพื่อให้ทราฟฟิกกลมกลืนไปกับการใช้งานทั่วไป"

msgctxt "warren-onboarding"
msgid "• DAITA v2 (OFF by default): inject padding to defeat ML traffic analysis. ~5-15% bandwidth."
msgstr "• DAITA v2 (ปิดเป็นค่าเริ่มต้น): เพิ่ม padding เพื่อต้านการวิเคราะห์ทราฟฟิกด้วย ML ใช้แบนด์วิดท์ประมาณ 5-15%"

msgctxt "warren-onboarding"
msgid "• Multi-hop (OFF by default): route through two relays for entry/exit unlinkability."
msgstr "• Multi-hop (ปิดเป็นค่าเริ่มต้น): กำหนดเส้นทางผ่านรีเลย์สองจุด เพื่อไม่ให้เชื่อมโยงจุดเข้าและจุดออกเข้าด้วยกันได้"

msgctxt "account-view"
msgid "Back up my phrase"
msgstr "สำรองวลีของฉัน"

msgctxt "account-view"
msgid "I have backed up my recovery phrase and understand this account will be removed from this device."
msgstr "ฉันได้สำรองวลีกู้คืนของฉันแล้ว และเข้าใจว่าบัญชีนี้จะถูกลบออกจากอุปกรณ์นี้"

msgctxt "account-view"
msgid "If you have not backed up your recovery phrase, your subscription will be lost permanently."
msgstr "หากคุณยังไม่ได้สำรองวลีกู้คืน การสมัครสมาชิกของคุณจะสูญหายอย่างถาวร"

msgctxt "account-view"
msgid "Log out of this account?"
msgstr "ออกจากระบบบัญชีนี้หรือไม่"

msgctxt "account-view"
msgid "Logging out erases this account from this device. There is no email or password to log back in, your recovery phrase is the ONLY way to restore it."
msgstr "การออกจากระบบจะลบบัญชีนี้ออกจากอุปกรณ์นี้ ไม่มีอีเมลหรือรหัสผ่านสำหรับเข้าสู่ระบบอีกครั้ง, วลีกู้คืนของคุณเป็นวิธีเดียวที่จะกู้คืนได้"

msgctxt "login-view"
msgid "Back up your recovery phrase"
msgstr "สำรองวลีกู้คืนของคุณ"

msgctxt "login-view"
msgid "Could not read the new recovery phrase. Try again."
msgstr "ไม่สามารถอ่านวลีกู้คืนใหม่ได้ โปรดลองอีกครั้ง"

msgctxt "login-view"
msgid "Discard"
msgstr "ละทิ้ง"

msgctxt "login-view"
msgid "Discard this new account?"
msgstr "ละทิ้งบัญชีใหม่นี้หรือไม่"

msgctxt "login-view"
msgid "Enter your 12-word recovery phrase, separated by spaces, to restore your account on this device."
msgstr "ป้อนวลีกู้คืน 12 คำของคุณ โดยคั่นด้วยช่องว่าง เพื่อกู้คืนบัญชีของคุณบนอุปกรณ์นี้"

msgctxt "login-view"
msgid "Go back only if you meant to restore an account you already have."
msgstr "ย้อนกลับเฉพาะเมื่อคุณตั้งใจจะกู้คืนบัญชีที่คุณมีอยู่แล้ว"

msgctxt "login-view"
msgid "I already have an account"
msgstr "ฉันมีบัญชีอยู่แล้ว"

msgctxt "login-view"
msgid "I have written down my recovery phrase in a safe place."
msgstr "ฉันได้จดวลีกู้คืนของฉันไว้ในที่ปลอดภัยแล้ว"

msgctxt "login-view"
msgid "Invalid recovery phrase. Check the words and their order, then try again."
msgstr "วลีกู้คืนไม่ถูกต้อง ตรวจสอบคำและลำดับของคำ แล้วลองอีกครั้ง"

msgctxt "login-view"
msgid "Keep it"
msgstr "เก็บไว้"

msgctxt "login-view"
msgid "Restore account"
msgstr "กู้คืนบัญชี"

msgctxt "login-view"
msgid "Restore your account"
msgstr "กู้คืนบัญชีของคุณ"

msgctxt "login-view"
msgid "The account that was just created will be abandoned and its recovery phrase will not be shown again."
msgstr "บัญชีที่เพิ่งสร้างจะถูกละทิ้งและจะไม่แสดงวลีกู้คืนอีก"

msgctxt "login-view"
msgid "Warren uses a non-custodial wallet: your account is a 12-word recovery phrase that only you hold."
msgstr "Warren ใช้กระเป๋าเงินแบบไม่รับฝาก บัญชีของคุณคือวลีกู้คืน 12 คำที่มีเพียงคุณเท่านั้นที่ถือครอง"

msgctxt "login-view"
msgid "Welcome to Warren"
msgstr "ยินดีต้อนรับสู่ Warren"

msgctxt "login-view"
msgid "Write these 12 words down and keep them safe. They are the only way to restore your account if you lose this device."
msgstr "จดคำ 12 คำเหล่านี้และเก็บไว้ในที่ปลอดภัย คำเหล่านี้เป็นวิธีเดียวที่จะกู้คืนบัญชีของคุณหากคุณทำอุปกรณ์นี้หาย"

msgctxt "connect-view"
msgid "I've completed payment"
msgstr "ฉันชำระเงินเสร็จแล้ว"

msgctxt "device-management"
msgid "Session is inactive"
msgstr "เซสชันไม่ได้ใช้งาน"

msgctxt "device-management"
msgid "Your session has ended. To connect again, you will need to log back in."
msgstr "เซสชันของคุณสิ้นสุดลงแล้ว หากต้องการเชื่อมต่ออีกครั้ง คุณจะต้องเข้าสู่ระบบใหม่"

msgctxt "notifications"
msgid "Server identity mismatch detected. The exit node's public key has changed."
msgstr "ตรวจพบข้อมูลประจำตัวเซิร์ฟเวอร์ไม่ตรงกัน คีย์สาธารณะของโหนดทางออกมีการเปลี่ยนแปลง"

msgctxt "vpn-settings-view"
msgid "Automatic failover"
msgstr "การสลับอัตโนมัติเมื่อเกิดข้อผิดพลาด"

msgctxt "vpn-settings-view"
msgid "Automatically switch to another exit server if the current one becomes unreachable."
msgstr "สลับไปยังเซิร์ฟเวอร์ทางออกอื่นโดยอัตโนมัติหากเซิร์ฟเวอร์ปัจจุบันไม่สามารถเข้าถึงได้"

msgctxt "vpn-settings-view"
msgid "This setting takes effect immediately without a daemon restart."
msgstr "การตั้งค่านี้มีผลทันทีโดยไม่ต้องรีสตาร์ทบริการ"

msgctxt "vpn-settings-view"
msgid "URL of the warren-api server. Format http(s)://host:port. Empty = unset (fallback to the default backend). Restart the daemon for the change to take effect."
msgstr "URL ของเซิร์ฟเวอร์ warren-api รูปแบบ http(s)://host:port ว่าง = ไม่ได้ตั้งค่า (กลับไปใช้แบ็กเอนด์เริ่มต้น) รีสตาร์ทบริการเพื่อให้การเปลี่ยนแปลงมีผล"

msgid "OK"
msgstr "ตกลง"

msgctxt "accessibility"
msgid "Copy public key"
msgstr "คัดลอกกุญแจสาธารณะ"

msgctxt "accessibility"
msgid "Hide public key"
msgstr "ซ่อนกุญแจสาธารณะ"

msgctxt "accessibility"
msgid "Show public key"
msgstr "แสดงกุญแจสาธารณะ"

msgctxt "account-view"
msgid "Backup keys"
msgstr "สำรองกุญแจ"

msgctxt "account-view"
msgid "Public key"
msgstr "กุญแจสาธารณะ"

msgctxt "api-access-methods-view"
msgid "The CDN used is Datapacket’s CDN77. The CDN can only observe the proxied TLS traffic, not the contents."
msgstr "CDN ที่ใช้คือ CDN77 ของ Datapacket โดย CDN จะเห็นได้เพียงทราฟฟิก TLS ที่ส่งผ่านเท่านั้น ไม่เห็นเนื้อหา"

msgctxt "api-access-methods-view"
msgid "The app communicates with a Warren API server via %(domainFronting)s."
msgstr "แอปสื่อสารกับเซิร์ฟเวอร์ warren-api ผ่าน %(domainFronting)s"

msgctxt "api-access-methods-view"
msgid "This can be useful when direct access and other methods are blocked by censorship."
msgstr "วิธีนี้มีประโยชน์เมื่อการเข้าถึงโดยตรงและวิธีอื่น ๆ ถูกบล็อกด้วยการเซ็นเซอร์"

msgctxt "api-access-methods-view"
msgid "With the %(domainFronting)s access method, the app reaches the Warren API via a CDN, mixing the traffic with a lot of other internet traffic, making it more difficult to censor."
msgstr "ด้วยวิธีการเข้าถึง %(domainFronting)s แอปจะเข้าถึง Warren API ผ่าน CDN ทำให้ทราฟฟิกผสมกับทราฟฟิกอินเทอร์เน็ตอื่น ๆ จำนวนมาก จึงเซ็นเซอร์ได้ยากขึ้น"

msgctxt "auth-failure"
msgid "You are logged in with an invalid public key. Please log out and try another one."
msgstr "คุณเข้าสู่ระบบด้วยกุญแจสาธารณะที่ไม่ถูกต้อง โปรดออกจากระบบแล้วลองกุญแจอื่น"

msgctxt "connect-view"
msgid "Checking... (click to refresh now)"
msgstr "กำลังตรวจสอบ... (คลิกเพื่อรีเฟรชเดี๋ยวนี้)"

msgctxt "connect-view"
msgid "Here’s your public key. Save it!"
msgstr "นี่คือกุญแจสาธารณะของคุณ บันทึกเก็บไว้!"

msgctxt "connect-view"
msgid "Port forwarding: %(ports)s"
msgstr "การส่งต่อพอร์ต: %(ports)s"

msgctxt "connection-info"
msgid "Multihop (2 hops)"
msgstr "มัลติฮอป (2 ฮอป)"

msgctxt "in-app-notifications"
msgid "EXIT SWITCHED"
msgstr "เปลี่ยนเซิร์ฟเวอร์ทางออกแล้ว"

msgctxt "in-app-notifications"
msgid "Your previous exit became unreachable. Warren routed you through an alternative server automatically."
msgstr "เซิร์ฟเวอร์ทางออกก่อนหน้าของคุณเข้าถึงไม่ได้ Warren ได้กำหนดเส้นทางคุณผ่านเซิร์ฟเวอร์อื่นโดยอัตโนมัติ"

msgctxt "in-app-notifications"
msgid "Your server is being updated. Warren moved you to another server automatically, no action needed."
msgstr "เซิร์ฟเวอร์ของคุณกำลังอัปเดต Warren ได้ย้ายคุณไปยังเซิร์ฟเวอร์อื่นโดยอัตโนมัติ ไม่ต้องดำเนินการใด ๆ"

msgctxt "port-forwarding-view"
msgid "+ Add a port"
msgstr "+ เพิ่มพอร์ต"

msgctxt "port-forwarding-view"
msgid "Each port you add is opened on the exit and forwarded to the same port on your device. Changes apply immediately, no reconnection needed."
msgstr "ทุกพอร์ตที่คุณเพิ่มจะถูกเปิดบนเซิร์ฟเวอร์ทางออกและส่งต่อไปยังพอร์ตเดียวกันบนอุปกรณ์ของคุณ การเปลี่ยนแปลงมีผลทันที ไม่ต้องเชื่อมต่อใหม่"

msgctxt "port-forwarding-view"
msgid "Last port change before a temporary block. Wait a moment before changing it again."
msgstr "นี่คือการเปลี่ยนพอร์ตครั้งสุดท้ายก่อนการบล็อกชั่วคราว โปรดรอสักครู่ก่อนเปลี่ยนอีกครั้ง"

msgctxt "port-forwarding-view"
msgid "Maximum of %(max)d ports reached"
msgstr "ถึงจำนวนพอร์ตสูงสุด %(max)d พอร์ตแล้ว"

msgctxt "port-forwarding-view"
msgid "No port yet. Add one to open it on the exit."
msgstr "ยังไม่มีพอร์ต เพิ่มพอร์ตเพื่อเปิดบนเซิร์ฟเวอร์ทางออก"

msgctxt "port-forwarding-view"
msgid "Port"
msgstr "พอร์ต"

msgctxt "port-forwarding-view"
msgid "Port must be between 49152 and 65535."
msgstr "พอร์ตต้องอยู่ระหว่าง 49152 ถึง 65535"

msgctxt "port-forwarding-view"
msgid "Remove port"
msgstr "ลบพอร์ต"

msgctxt "port-forwarding-view"
msgid "Status: waiting for an active tunnel connection to set up the port mappings."
msgstr "สถานะ: กำลังรอการเชื่อมต่ออุโมงค์ที่ใช้งานอยู่เพื่อตั้งค่าการจับคู่พอร์ต"

msgctxt "port-forwarding-view"
msgid "This port is already in your list."
msgstr "พอร์ตนี้อยู่ในรายการของคุณแล้ว"

msgctxt "port-forwarding-view"
msgid "Too many port changes. You can change ports again in %(countdown)s."
msgstr "เปลี่ยนพอร์ตบ่อยเกินไป คุณจะเปลี่ยนพอร์ตได้อีกครั้งใน %(countdown)s"

msgctxt "port-forwarding-view"
msgid "applying…"
msgstr "กำลังนำไปใช้…"

msgctxt "port-forwarding-view"
msgid "failed"
msgstr "ล้มเหลว"

msgctxt "port-forwarding-view"
msgid "no port available"
msgstr "ไม่มีพอร์ตว่าง"

msgctxt "port-forwarding-view"
msgid "not allowed"
msgstr "ไม่อนุญาต"

msgctxt "port-forwarding-view"
msgid "open: %(port)d"
msgstr "เปิด: %(port)d"

msgctxt "port-forwarding-view"
msgid "pending…"
msgstr "รอดำเนินการ…"

msgctxt "port-forwarding-view"
msgid "port"
msgstr "พอร์ต"

msgctxt "port-forwarding-view"
msgid "port in use"
msgstr "พอร์ตถูกใช้งานอยู่"

msgctxt "port-forwarding-view"
msgid "requesting…"
msgstr "กำลังร้องขอ…"

msgctxt "redeem-voucher-view"
msgid "It looks like you’ve entered a public key instead of a voucher code. If you would like to change the active account, please log out first."
msgstr "ดูเหมือนว่าคุณป้อนกุญแจสาธารณะแทนรหัสคูปอง หากต้องการเปลี่ยนบัญชีที่ใช้งานอยู่ โปรดออกจากระบบก่อน"

msgctxt "settings-view"
msgid "Port forwarding"
msgstr "การส่งต่อพอร์ต"

msgctxt "settings-view"
msgid "Replay onboarding"
msgstr "เล่นการแนะนำเริ่มต้นใหม่"

msgctxt "vpn-settings-view"
msgid "Dropped %(count)s pinned exit key entries."
msgstr "ลบรายการกุญแจทางออกที่ปักหมุดไว้ %(count)s รายการแล้ว"

msgctxt "vpn-settings-view"
msgid "Every Warren exit you previously connected to will be re-pinned on the next connection (Trust On First Use)."
msgstr "เซิร์ฟเวอร์ทางออก Warren ทุกตัวที่คุณเคยเชื่อมต่อมาก่อนจะถูกปักหมุดใหม่ในการเชื่อมต่อครั้งถัดไป (Trust On First Use)"

msgctxt "vpn-settings-view"
msgid "Pin table cleared"
msgstr "ล้างตารางการปักหมุดแล้ว"

msgctxt "vpn-settings-view"
msgid "Reset"
msgstr "รีเซ็ต"

msgctxt "vpn-settings-view"
msgid "Reset all"
msgstr "รีเซ็ตทั้งหมด"

msgctxt "vpn-settings-view"
msgid "Reset failed"
msgstr "รีเซ็ตล้มเหลว"

msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys"
msgstr "รีเซ็ตกุญแจทางออกที่ปักหมุดไว้"

msgctxt "vpn-settings-view"
msgid "Reset pinned exit keys?"
msgstr "รีเซ็ตกุญแจทางออกที่ปักหมุดไว้หรือไม่?"

msgctxt "vpn-settings-view"
msgid "Until the new pins are established the substitution-detection guard is briefly down: an attacker who replaced an exit between resets would not be flagged on the first reconnect."
msgstr "จนกว่าจะมีการปักหมุดใหม่ ระบบป้องกันการตรวจจับการสับเปลี่ยนจะหยุดทำงานชั่วครู่ ผู้โจมตีที่เปลี่ยนเซิร์ฟเวอร์ทางออกในช่วงระหว่างการรีเซ็ตจะไม่ถูกตรวจจับในการเชื่อมต่อใหม่ครั้งแรก"

msgctxt "vpn-settings-view"
msgid "Warren api URL"
msgstr "URL ของ Warren API"

msgctxt "warren-multi-hop-view"
msgid "Entry country"
msgstr "ประเทศทางเข้า"

msgctxt "warren-multi-hop-view"
msgid "Exit country"
msgstr "ประเทศทางออก"

msgctxt "warren-multi-hop-view"
msgid "Expect roughly half the single-hop bandwidth in exchange for unlinkability between the user IP and the destination IP. Off by default; opt-in for privacy."
msgstr "คาดว่าจะได้แบนด์วิดท์ราวครึ่งหนึ่งของแบบฮอปเดียว เพื่อแลกกับการที่ IP ของผู้ใช้และ IP ปลายทางไม่สามารถเชื่อมโยงกันได้ ปิดไว้โดยค่าเริ่มต้น เปิดใช้เองเพื่อความเป็นส่วนตัว"

msgctxt "warren-multi-hop-view"
msgid "Multihop"
msgstr "มัลติฮอป"

msgctxt "warren-multi-hop-view"
msgid "Restart the Warren daemon after changing this setting."
msgstr "รีสตาร์ตบริการ Warren หลังจากเปลี่ยนการตั้งค่านี้"

msgctxt "warren-multi-hop-view"
msgid "Routes your traffic through two Warren relays using HPKE end-to-end encryption. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never your IP. Pattern inspired by Apple Private Relay."
msgstr "กำหนดเส้นทางทราฟฟิกของคุณผ่านรีเลย์ Warren สองตัวโดยใช้การเข้ารหัสแบบ end-to-end ด้วย HPKE รีเลย์ทางเข้าเห็นเฉพาะข้อความที่เข้ารหัสไว้ ส่วนทางออกเห็นเฉพาะข้อมูลที่ถอดรหัสแล้ว ไม่เห็น IP ของคุณ รูปแบบนี้ได้แรงบันดาลใจจาก Apple Private Relay"

msgctxt "warren-multi-hop-view"
msgid "Trade-off: roughly half the single-hop bandwidth. Off by default; opt-in for privacy. Daemon restart required after changing this setting."
msgstr "ข้อแลกเปลี่ยน: แบนด์วิดท์ราวครึ่งหนึ่งของแบบฮอปเดียว ปิดไว้โดยค่าเริ่มต้น เปิดใช้เองเพื่อความเป็นส่วนตัว ต้องรีสตาร์ตบริการหลังจากเปลี่ยนการตั้งค่านี้"

msgctxt "warren-multi-hop-view"
msgid "Warren multi-hop"
msgstr "มัลติฮอป Warren"

msgctxt "warren-multi-hop-view"
msgid "When enabled, traffic is routed through two Warren relays (entry then exit) using HPKE end-to-end encryption between the client and the exit. The entry relay only sees ciphertext; the exit only sees the decrypted payload, never the user IP."
msgstr "เมื่อเปิดใช้งาน ทราฟฟิกจะถูกกำหนดเส้นทางผ่านรีเลย์ Warren สองตัว (ทางเข้าแล้วจึงทางออก) โดยใช้การเข้ารหัสแบบ end-to-end ด้วย HPKE ระหว่างไคลเอนต์และทางออก รีเลย์ทางเข้าเห็นเฉพาะข้อความที่เข้ารหัสไว้ ส่วนทางออกเห็นเฉพาะข้อมูลที่ถอดรหัสแล้ว ไม่เห็น IP ของผู้ใช้"

msgctxt "warren-multi-hop-view"
msgid "auto"
msgstr "อัตโนมัติ"

msgctxt "warren-pubkey-warning"
msgid "Cryptographic mismatch details"
msgstr "รายละเอียดความไม่ตรงกันทางการเข้ารหัส"

msgctxt "warren-pubkey-warning"
msgid "Exit ID"
msgstr "รหัสทางออก"

msgctxt "warren-pubkey-warning"
msgid "Location"
msgstr "ตำแหน่งที่ตั้ง"

msgctxt "warren-pubkey-warning"
msgid "Newly observed key"
msgstr "กุญแจที่พบใหม่"

msgctxt "warren-pubkey-warning"
msgid "Previously pinned key"
msgstr "กุญแจที่ปักหมุดไว้ก่อนหน้า"

msgctxt "warren-pubkey-warning"
msgid "Processing your choice, please wait."
msgstr "กำลังประมวลผลตัวเลือกของคุณ โปรดรอสักครู่"

msgctxt "warren-pubkey-warning"
msgid "Reject (disconnect)"
msgstr "ปฏิเสธ (ตัดการเชื่อมต่อ)"

msgctxt "warren-pubkey-warning"
msgid "Reject and stay disconnected"
msgstr "ปฏิเสธและคงสถานะตัดการเชื่อมต่อ"

msgctxt "warren-pubkey-warning"
msgid "Report to Warren"
msgstr "รายงานไปยัง Warren"

msgctxt "warren-pubkey-warning"
msgid "Server identity changed"
msgstr "อัตลักษณ์ของเซิร์ฟเวอร์เปลี่ยนไป"

msgctxt "warren-pubkey-warning"
msgid "The Warren exit server you previously trusted now presents a different cryptographic identity."
msgstr "เซิร์ฟเวอร์ทางออก Warren ที่คุณเคยเชื่อถือ ตอนนี้แสดงอัตลักษณ์ทางการเข้ารหัสที่แตกต่างออกไป"

msgctxt "warren-pubkey-warning"
msgid "This usually means the operator rotated the key, but it can also indicate that the server has been replaced or compromised. Refuse if you did not expect a change."
msgstr "โดยทั่วไปหมายความว่าผู้ดูแลได้หมุนเปลี่ยนกุญแจ แต่ก็อาจบ่งชี้ว่าเซิร์ฟเวอร์ถูกแทนที่หรือถูกเจาะระบบ ปฏิเสธหากคุณไม่ได้คาดหวังการเปลี่ยนแปลง"

msgctxt "warren-pubkey-warning"
msgid "Trust new key"
msgstr "เชื่อถือกุญแจใหม่"

msgctxt "warren-status-view"
msgid "HTTP/3 mimicry (active)"
msgstr "การเลียนแบบ HTTP/3 (กำลังทำงาน)"

msgctxt "warren-status-view"
msgid "Last"
msgstr "ล่าสุด"

msgctxt "warren-status-view"
msgid "Obfuscation"
msgstr "การพราง"

msgctxt "warren-status-view"
msgid "Reconnects"
msgstr "การเชื่อมต่อใหม่"

msgctxt "warren-status-view"
msgid "inactive"
msgstr "ไม่ทำงาน"

msgctxt "warren-status-view"
msgid "never"
msgstr "ไม่เคย"

msgctxt "forum-login"
msgid "A sign-in to the Warren community forum was requested. Your app will sign a one-time challenge with your wallet key to prove it is you."
msgstr "มีการร้องขอเข้าสู่ระบบฟอรัมชุมชน Warren แอปของคุณจะลงนามคำท้าทายแบบใช้ครั้งเดียวด้วยคีย์กระเป๋าเงินของคุณเพื่อยืนยันว่าเป็นคุณ"

msgctxt "forum-login"
msgid "Approve sign-in"
msgstr "อนุมัติการเข้าสู่ระบบ"

msgctxt "forum-login"
msgid "Cancel"
msgstr "ยกเลิก"

msgctxt "forum-login"
msgid "Forum access requires a Warren subscription. This wallet has never subscribed."
msgstr "การเข้าถึงฟอรัมต้องมีการสมัครสมาชิก Warren กระเป๋าเงินนี้ไม่เคยสมัครสมาชิกมาก่อน"

msgctxt "forum-login"
msgid "No email and no password are used. You appear under an anonymous handle that cannot be linked to your Warren account. Only approve if you started this sign-in."
msgstr "ไม่มีการใช้อีเมลและรหัสผ่าน คุณจะปรากฏภายใต้ชื่อผู้ใช้นิรนามที่ไม่สามารถเชื่อมโยงกับบัญชี Warren ของคุณได้ อนุมัติเฉพาะเมื่อคุณเป็นผู้เริ่มการเข้าสู่ระบบนี้เท่านั้น"

msgctxt "forum-login"
msgid "Sign in to the Warren community forum?"
msgstr "เข้าสู่ระบบฟอรัมชุมชน Warren หรือไม่?"

msgctxt "forum-login"
msgid "Sign-in failed. Please try again in a moment."
msgstr "เข้าสู่ระบบไม่สำเร็จ โปรดลองอีกครั้งในอีกสักครู่"

msgctxt "forum-login"
msgid "Signing, please wait."
msgstr "กำลังลงนาม โปรดรอสักครู่"

msgctxt "support-view"
msgid "Community forum"
msgstr "ฟอรัมชุมชน"

msgctxt "tunnel-control"
msgid "Connecting..."
msgstr "กำลังเชื่อมต่อ..."

msgctxt "tunnel-control"
msgid "Connection established"
msgstr "เชื่อมต่อสำเร็จ"

msgctxt "tunnel-control"
msgid "Encrypting your connection"
msgstr "กำลังเข้ารหัสการเชื่อมต่อของคุณ"

msgctxt "tunnel-control"
msgid "Random location"
msgstr "ตำแหน่งแบบสุ่ม"

msgctxt "tunnel-control"
msgid "You are protected"
msgstr "คุณได้รับการปกป้อง"

msgctxt "tunnel-control"
msgid "You are visible"
msgstr "คุณถูกมองเห็นได้"

msgctxt "tunnel-control"
msgid "Your connection is not encrypted"
msgstr "การเชื่อมต่อของคุณไม่ได้เข้ารหัส"

msgctxt "tunnel-control"
msgid "Disconnecting..."
msgstr "กำลังยกเลิกการเชื่อมต่อ..."

msgctxt "tunnel-control"
msgid "Connection in progress"
msgstr "กำลังเชื่อมต่อ"

msgctxt "forum-attach"
msgid "Attach the logs"
msgstr "แนบบันทึก"

msgctxt "forum-attach"
msgid "Attach your logs to the bug report?"
msgstr "แนบบันทึกของคุณไปกับรายงานข้อบกพร่องหรือไม่?"

msgctxt "forum-attach"
msgid "Attaching the logs failed. Please try again in a moment."
msgstr "แนบบันทึกไม่สำเร็จ โปรดลองอีกครั้งในอีกสักครู่"

msgctxt "forum-attach"
msgid "Cancel"
msgstr "ยกเลิก"

msgctxt "forum-attach"
msgid "Only the author of the bug report can attach logs to it."
msgstr "เฉพาะผู้เขียนรายงานข้อบกพร่องเท่านั้นที่สามารถแนบบันทึกได้"

msgctxt "forum-attach"
msgid "Sending, please wait."
msgstr "กำลังส่ง โปรดรอสักครู่"

msgctxt "forum-attach"
msgid "The log file is too large to attach."
msgstr "ไฟล์บันทึกมีขนาดใหญ่เกินกว่าจะแนบได้"

msgctxt "forum-attach"
msgid "Your Warren account is not ready yet, so the logs cannot be signed. Finish setting up the app, then attach them from the forum page."
msgstr "บัญชี Warren ของคุณยังไม่พร้อม จึงยังลงนามบันทึกไม่ได้ โปรดตั้งค่าแอปให้เสร็จ แล้วแนบจากหน้าฟอรัม"

msgctxt "forum-attach"
msgid "The Warren support service could not accept the report. Nothing is wrong on your side. Try again later, and say so on the forum if it keeps failing."
msgstr "บริการช่วยเหลือของ Warren รับรายงานนี้ไม่ได้ ไม่มีอะไรผิดพลาดที่ฝั่งคุณ โปรดลองใหม่ภายหลัง และแจ้งในฟอรัมหากยังล้มเหลว"

msgctxt "forum-attach"
msgid "The logs are anonymized: wallet addresses and personal data are redacted. They go privately to the Warren support staff and never appear publicly on the forum. You can view exactly what will be sent before approving."
msgstr "บันทึกได้รับการปกปิดตัวตน: ที่อยู่กระเป๋าเงินและข้อมูลส่วนบุคคลถูกซ่อนไว้ ข้อมูลเหล่านี้จะถูกส่งเป็นการส่วนตัวไปยังทีมสนับสนุนของ Warren และจะไม่ปรากฏต่อสาธารณะบนฟอรัม คุณสามารถดูสิ่งที่จะถูกส่งได้อย่างชัดเจนก่อนอนุมัติ"

msgctxt "forum-attach"
msgid "This request has expired. Start again from the forum page."
msgstr "คำขอนี้หมดอายุแล้ว โปรดเริ่มใหม่จากหน้าฟอรัม"

msgctxt "forum-attach"
msgid "View the logs"
msgstr "ดูบันทึก"

msgctxt "forum-attach"
msgid "Your bug report on the Warren forum (topic %(topicId)d) asks to attach the app technical logs to help diagnose the problem."
msgstr "รายงานข้อบกพร่องของคุณบนฟอรัม Warren (หัวข้อ %(topicId)d) ขอให้แนบบันทึกทางเทคนิคของแอปเพื่อช่วยวินิจฉัยปัญหา"

msgctxt "forum-attach"
msgid "Your new bug report being composed on the Warren forum asks to attach the app technical logs to help diagnose the problem."
msgstr "รายงานข้อบกพร่องใหม่ที่คุณกำลังเขียนบนฟอรัม Warren ขอให้แนบบันทึกทางเทคนิคของแอปเพื่อช่วยวินิจฉัยปัญหา"

#. Status line confirming traffic obfuscation is on.
msgctxt "warren-status-view"
msgid "Obfuscation is active."
msgstr "การพรางเปิดใช้งานอยู่"

#. Status line shown if traffic obfuscation is off.
msgctxt "warren-status-view"
msgid "Obfuscation is currently inactive."
msgstr "การพรางปิดใช้งานอยู่ในขณะนี้"

#. Explains what obfuscation does and why it cannot be turned off.
msgctxt "warren-status-view"
msgid "To evade censorship, Warren disguises the tunnel as ordinary web browsing: on the network it looks like standard browser traffic to a regular website (HTTP/3 on port 443). Obfuscation cannot be turned off, as traffic that stands out is traffic that can be blocked."
msgstr "เพื่อหลบเลี่ยงการเซ็นเซอร์ Warren จะปลอมอุโมงค์ให้ดูเหมือนการท่องเว็บทั่วไป โดยบนเครือข่ายจะดูเหมือนการรับส่งข้อมูลปกติของเบราว์เซอร์ไปยังเว็บไซต์ทั่วไป (HTTP/3 บนพอร์ต 443) การพรางไม่สามารถปิดได้ เพราะการรับส่งข้อมูลที่โดดเด่นอาจถูกบล็อก"

msgctxt "wireguard-settings-view"
msgid "%(daita)s adds network noise and makes all packets the same size, so it is much harder to tell which sites you visit or who you communicate with."
msgstr "%(daita)s เพิ่มสัญญาณรบกวนเครือข่ายและทำให้แพ็กเก็ตทั้งหมดมีขนาดเท่ากัน จึงยากขึ้นมากที่จะบอกได้ว่าคุณเข้าชมเว็บไซต์ใดหรือติดต่อกับใคร"

msgctxt "wireguard-settings-view"
msgid "%(daita)s is not active on the current server: this connection is not protected by it. Reconnect or select a different location."
msgstr "%(daita)s ไม่ได้ทำงานบนเซิร์ฟเวอร์ปัจจุบัน การเชื่อมต่อนี้จึงไม่ได้รับการปกป้องจาก %(daita)s เชื่อมต่อใหม่หรือเลือกตำแหน่งอื่น"

msgctxt "wireguard-settings-view"
msgid "Even when encrypted, the data packets entering and leaving your device can be analyzed by AI to reveal your activity."
msgstr "แม้จะเข้ารหัสไว้แล้ว แพ็กเก็ตข้อมูลที่เข้าและออกจากอุปกรณ์ของคุณก็ยังถูก AI วิเคราะห์เพื่อเปิดเผยกิจกรรมของคุณได้"

msgctxt "wireguard-settings-view"
msgid "Note: this increases network traffic and can reduce speed, latency, and battery life. Use with caution on limited plans."
msgstr "หมายเหตุ: ฟีเจอร์นี้เพิ่มปริมาณการรับส่งข้อมูลบนเครือข่าย และอาจลดความเร็ว เพิ่มความหน่วง และลดอายุแบตเตอรี่ โปรดใช้อย่างระมัดระวังกับแพ็กเกจที่จำกัด"

msgctxt "accessibility"
msgid "Forum"
msgstr "ฟอรัม"

msgctxt "accessibility"
msgid "Forum, %(count)s new"
msgstr "ฟอรัม %(count)s รายการใหม่"

msgctxt "account-view"
msgid "Forum name"
msgstr "ชื่อในฟอรัม"

msgctxt "auth-failure"
msgid "Blocking internet: your access has been suspended after repeated abuse reports about a forwarded port. You can contest this at %(url)s"
msgstr "กำลังบล็อกอินเทอร์เน็ต การเข้าถึงของคุณถูกระงับหลังมีรายงานการละเมิดซ้ำ ๆ เกี่ยวกับพอร์ตที่ส่งต่อ คุณสามารถโต้แย้งได้ที่ %(url)s"

msgctxt "forum-activity-view"
msgid "%(actor)s liked your post"
msgstr "%(actor)s ถูกใจโพสต์ของคุณ"

msgctxt "forum-activity-view"
msgid "%(actor)s linked to your post"
msgstr "%(actor)s ลิงก์มาที่โพสต์ของคุณ"

msgctxt "forum-activity-view"
msgid "%(actor)s mentioned you"
msgstr "%(actor)s กล่าวถึงคุณ"

msgctxt "forum-activity-view"
msgid "%(actor)s opened a new topic"
msgstr "%(actor)s เปิดกระทู้ใหม่"

msgctxt "forum-activity-view"
msgid "%(actor)s quoted you"
msgstr "%(actor)s อ้างอิงคุณ"

msgctxt "forum-activity-view"
msgid "%(actor)s replied"
msgstr "%(actor)s ตอบกลับ"

msgctxt "forum-activity-view"
msgid "%(actor)s sent you a message"
msgstr "%(actor)s ส่งข้อความถึงคุณ"

msgctxt "forum-activity-view"
msgid "Could not reach the forum. Check your connection and try again."
msgstr "ติดต่อฟอรัมไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองใหม่อีกครั้ง"

msgctxt "forum-activity-view"
msgid "Forum"
msgstr "ฟอรัม"

msgctxt "forum-activity-view"
msgid "New forum activity"
msgstr "ความเคลื่อนไหวใหม่ในฟอรัม"

msgctxt "forum-activity-view"
msgid "Nothing new on the forum. Come and ask a question, or help someone else out."
msgstr "ยังไม่มีอะไรใหม่ในฟอรัม มาตั้งคำถาม หรือช่วยเหลือคนอื่นดูสิ"

msgctxt "forum-activity-view"
msgid "Open the forum"
msgstr "เปิดฟอรัม"

msgctxt "forum-activity-view"
msgid "Someone"
msgstr "มีคน"

msgctxt "forum-activity-view"
msgid "Try again"
msgstr "ลองใหม่"

msgctxt "forum-activity-view"
msgid "You earned a badge"
msgstr "คุณได้รับตราสัญลักษณ์"

msgctxt "forum-activity-view"
msgid "You post as %(handle)s"
msgstr "คุณโพสต์ในชื่อ %(handle)s"

msgctxt "in-app-notifications"
msgid "WARREN"
msgstr "WARREN"

msgctxt "notifications"
msgid "More than %(count)d new notifications on the forum"
msgstr "มีการแจ้งเตือนใหม่ในฟอรัมมากกว่า %(count)d รายการ"

msgctxt "notifications"
msgid "New notification on the forum"
msgid_plural "%(count)d new notifications on the forum"
msgstr[0] "มีการแจ้งเตือนใหม่ในฟอรัม %(count)d รายการ"

msgctxt "notifications"
msgid "Open"
msgstr "เปิด"

msgctxt "port-forwarding-view"
msgid "A forwarded port is reachable from the internet. If a third party reports abuse coming from it, we close the port and record a strike on your account; three strikes within 90 days revoke access. Details and how to contest: %(url)s"
msgstr "พอร์ตที่ส่งต่อสามารถเข้าถึงได้จากอินเทอร์เน็ต หากบุคคลที่สามรายงานการละเมิดที่มาจากพอร์ตนี้ เราจะปิดพอร์ตและบันทึกการกระทำผิดไว้ในบัญชีของคุณ สามครั้งภายใน 90 วันจะเพิกถอนสิทธิ์การใช้งาน รายละเอียดและวิธีโต้แย้ง: %(url)s"

msgctxt "support-view"
msgid "Terms of use"
msgstr "ข้อกำหนดการใช้งาน"

msgctxt "user-interface-settings-view"
msgid "Forum notifications"
msgstr "การแจ้งเตือนจากฟอรัม"

msgctxt "forum-activity-view"
msgid "The forum was updated"
msgstr "ฟอรัมได้รับการอัปเดตแล้ว"

msgctxt "forum-activity-view"
msgid "Mark all as read"
msgstr "ทำเครื่องหมายว่าอ่านแล้วทั้งหมด"

msgctxt "user-interface-settings-view"
msgid "Be told when someone replies to you on the community forum. Turning this off also hides the forum bell."
msgstr "รับการแจ้งเตือนเมื่อมีคนตอบกลับคุณในฟอรัมชุมชน การปิดจะซ่อนกระดิ่งฟอรัมด้วย"

msgctxt "forum-login"
msgid "This sign-in request has expired. Start again from the browser page."
msgstr "คำขอลงชื่อเข้าใช้นี้หมดอายุแล้ว เริ่มใหม่จากหน้าเบราว์เซอร์"

msgctxt "forum-sign-in-code"
msgid "Sign in to the forum with a code"
msgstr "ลงชื่อเข้าใช้ฟอรัมด้วยรหัส"

msgctxt "forum-sign-in-code"
msgid "When the forum's \"Open the Warren app\" button did nothing"
msgstr "เมื่อปุ่ม \"เปิดแอป Warren\" บนฟอรัมไม่ทำงาน"

msgctxt "forum-sign-in-code"
msgid "On the forum sign-in page, the session code is shown under the button. Type it here to approve that sign-in from this app. The page keeps waiting while you do."
msgstr "ในหน้าลงชื่อเข้าใช้ของฟอรัม รหัสเซสชันจะแสดงอยู่ใต้ปุ่ม พิมพ์รหัสที่นี่เพื่ออนุมัติการลงชื่อเข้าใช้นั้นจากแอปนี้ หน้าเว็บจะรอต่อไประหว่างนั้น"

msgctxt "forum-sign-in-code"
msgid "Sign-in code"
msgstr "รหัสลงชื่อเข้าใช้"

msgctxt "forum-sign-in-code"
msgid "A sign-in code is 32 letters and digits, as shown on the forum page."
msgstr "รหัสลงชื่อเข้าใช้ประกอบด้วยตัวอักษรและตัวเลข 32 ตัว ตามที่แสดงบนหน้าฟอรัม"

msgctxt "forum-sign-in-code"
msgid "Continue"
msgstr "ดำเนินการต่อ"

msgctxt "report-problem"
msgid "%(count)d characters (at least %(min)d)"
msgstr "%(count)d ตัวอักษร (อย่างน้อย %(min)d)"

msgctxt "report-problem"
msgid "Anonymized logs from this app, visible to the support team only."
msgstr "บันทึกแบบไม่ระบุตัวตนจากแอปนี้ มองเห็นได้เฉพาะทีมสนับสนุน"

msgctxt "report-problem"
msgid "Browsing (pages not loading, slow, broken sites)"
msgstr "การท่องเว็บ (หน้าเว็บไม่โหลด ช้า เว็บไซต์เสีย)"

msgctxt "report-problem"
msgid "Connection (cannot connect, drops, no internet)"
msgstr "การเชื่อมต่อ (เชื่อมต่อไม่ได้ หลุด ไม่มีอินเทอร์เน็ต)"

msgctxt "report-problem"
msgid "Every time"
msgstr "ทุกครั้ง"

msgctxt "report-problem"
msgid "Forum access requires a Warren subscription. This wallet has never subscribed: use the help form on the website instead."
msgstr "การเข้าถึงฟอรัมต้องมีการสมัครสมาชิก Warren กระเป๋าเงินนี้ไม่เคยสมัครสมาชิก โปรดใช้แบบฟอร์มขอความช่วยเหลือบนเว็บไซต์แทน"

msgctxt "report-problem"
msgid "How can we make it happen too? (optional)"
msgstr "เราจะทำให้เกิดขึ้นซ้ำได้อย่างไร (ไม่บังคับ)"

msgctxt "report-problem"
msgid "How often does it happen?"
msgstr "เกิดขึ้นบ่อยแค่ไหน"

msgctxt "report-problem"
msgid "Include technical logs"
msgstr "แนบบันทึกทางเทคนิค"

msgctxt "report-problem"
msgid "Installing or updating Warren"
msgstr "การติดตั้งหรืออัปเดต Warren"

msgctxt "report-problem"
msgid "It happened once"
msgstr "เกิดขึ้นครั้งเดียว"

msgctxt "report-problem"
msgid "Open the help form"
msgstr "เปิดแบบฟอร์มขอความช่วยเหลือ"

msgctxt "report-problem"
msgid "Open the topic"
msgstr "เปิดหัวข้อ"

msgctxt "report-problem"
msgid "Posted as %(handle)s."
msgstr "โพสต์ในชื่อ %(handle)s"

msgctxt "report-problem"
msgid "Preparing the report, please wait."
msgstr "กำลังเตรียมรายงาน โปรดรอ"

msgctxt "report-problem"
msgid "Report a problem"
msgstr "รายงานปัญหา"

msgctxt "report-problem"
msgid "Send a description and your logs to the support team"
msgstr "ส่งคำอธิบายและบันทึกของคุณให้ทีมสนับสนุน"

msgctxt "report-problem"
msgid "Send the report"
msgstr "ส่งรายงาน"

msgctxt "report-problem"
msgid "Send without the logs"
msgstr "ส่งโดยไม่มีบันทึก"

msgctxt "report-problem"
msgid "Sending the logs took too long on this connection."
msgstr "การส่งบันทึกใช้เวลานานเกินไปบนการเชื่อมต่อนี้"

msgctxt "report-problem"
msgid "Sending, please wait."
msgstr "กำลังส่ง โปรดรอสักครู่"

msgctxt "report-problem"
msgid "Some fields could not be accepted. Check the description and try again."
msgstr "บางช่องไม่ได้รับการยอมรับ ตรวจสอบคำอธิบายแล้วลองอีกครั้ง"

msgctxt "report-problem"
msgid "Something else"
msgstr "อย่างอื่น"

msgctxt "report-problem"
msgid "Sometimes"
msgstr "บางครั้ง"

msgctxt "report-problem"
msgid "The forum could not take the report right now. Please try again later."
msgstr "ฟอรัมไม่สามารถรับรายงานได้ในขณะนี้ โปรดลองอีกครั้งภายหลัง"

msgctxt "report-problem"
msgid "The logs are too large to send."
msgstr "บันทึกมีขนาดใหญ่เกินกว่าจะส่งได้"

msgctxt "report-problem"
msgid "The logs could not be collected. You can still send the description."
msgstr "ไม่สามารถรวบรวมบันทึกได้ คุณยังส่งคำอธิบายได้"

msgctxt "report-problem"
msgid "The report could not be sent. Check the connection and try again."
msgstr "ไม่สามารถส่งรายงานได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"

msgctxt "report-problem"
msgid "This device's clock is off by more than a minute. Enable automatic date and time, then send again."
msgstr "นาฬิกาของอุปกรณ์นี้คลาดเคลื่อนเกินหนึ่งนาที เปิดวันที่และเวลาอัตโนมัติ แล้วส่งอีกครั้ง"

msgctxt "report-problem"
msgid "Too many reports from this wallet for now. Please try again later."
msgstr "มีรายงานจากกระเป๋าเงินนี้มากเกินไปในตอนนี้ โปรดลองอีกครั้งภายหลัง"

msgctxt "report-problem"
msgid "View the logs"
msgstr "ดูบันทึก"

msgctxt "report-problem"
msgid "Wallet, payment or subscription"
msgstr "กระเป๋าเงิน การชำระเงิน หรือการสมัครสมาชิก"

msgctxt "report-problem"
msgid "What did you do just before? Step by step if you can."
msgstr "คุณทำอะไรก่อนหน้านั้น ทีละขั้นตอนถ้าทำได้"

msgctxt "report-problem"
msgid "What did you see, and what did you expect instead? Copy any error message. Never include your wallet address."
msgstr "คุณเห็นอะไร และคาดหวังอะไรแทน คัดลอกข้อความแสดงข้อผิดพลาดใดๆ อย่าใส่ที่อยู่กระเป๋าเงินของคุณเด็ดขาด"

msgctxt "report-problem"
msgid "What happened?"
msgstr "เกิดอะไรขึ้น"

msgctxt "report-problem"
msgid "Where does the problem happen?"
msgstr "ปัญหาเกิดขึ้นที่ไหน"

msgctxt "report-problem"
msgid "Your description is posted on the community forum under your anonymous forum name. The technical logs, if you include them, go privately to the support team and never appear publicly."
msgstr "คำอธิบายของคุณจะถูกโพสต์บนฟอรัมชุมชนภายใต้ชื่อฟอรัมนิรนามของคุณ บันทึกทางเทคนิค หากคุณแนบมาด้วย จะถูกส่งเป็นการส่วนตัวให้ทีมสนับสนุนเท่านั้นและไม่ปรากฏต่อสาธารณะ"

msgctxt "report-problem"
msgid "Your report is on the forum and your logs reached the support team."
msgstr "รายงานของคุณอยู่บนฟอรัมแล้ว และบันทึกของคุณถึงทีมสนับสนุนแล้ว"

msgctxt "report-problem"
msgid "Your report is on the forum."
msgstr "รายงานของคุณอยู่บนฟอรัมแล้ว"

msgctxt "report-problem"
msgid "Your report is on the forum. The logs could only be delivered in part; the support team may ask for them again."
msgstr "รายงานของคุณอยู่บนฟอรัมแล้ว บันทึกส่งถึงได้เพียงบางส่วน ทีมสนับสนุนอาจขออีกครั้ง"

msgctxt "report-problem"
msgid "Your Warren account is not ready yet, so the report cannot be signed. Finish setting up the app, then send again."
msgstr "บัญชี Warren ของคุณยังไม่พร้อม จึงยังลงนามรายงานไม่ได้ โปรดตั้งค่าแอปให้เสร็จ แล้วส่งอีกครั้ง"
