msgstr "%(application)s %(route)s"

msgctxt "split-tunneling-view"
msgid "Add an app"
msgstr "เพิ่มแอป"

msgctxt "split-tunneling-view"
msgid "All apps are protected by the VPN, except for the rules below."
msgstr "แอปทั้งหมดได้รับการปกป้องโดย VPN ยกเว้นตามกฎด้านล่าง"

msgctxt "split-tunneling-view"
