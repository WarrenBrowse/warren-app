#. Available placeholder:
#. %(locationName)s - The name of the location being added to the list.
msgctxt "custom-list-feature"
msgid "Add %(locationName)s to new list"
msgstr "เพิ่ม %(locationName)s ลงในรายการใหม่"

#. This is a label shown above a list of options.
#. Available placeholder:
#. %(locationType) - Could be either "Country", "City" and "Relay"
msgctxt "custom-list-feature"
msgid "Add %(locationType)s to list"
msgstr "เพิ่ม %(locationType)s ไปยังรายการ"

msgctxt "custom-list-feature"
msgid "City"
msgstr "เมือง"

msgctxt "custom-list-feature"
msgid "Country"
msgstr "ประเทศ"

#. Label for the input where the user can enter the name of a new custom list.
msgctxt "custom-list-feature"
msgid "Create list"
msgstr "สร้างรายการ"

#. Label for the option to delete a custom list in a menu.
msgctxt "custom-list-feature"
msgid "Delete"
msgstr "ลบ"

#. Confirmation message shown when the user tries to delete a custom list.
#. Asks the user if they are sure they want to delete the list.
#. Available placeholder:
#. %(list)s - The name of the custom list that is about to be deleted.
msgctxt "custom-list-feature"
msgid "Do you want to delete the list %(list)s?"
msgstr "คุณต้องการลบรายการ %(list)s หรือไม่"

msgctxt "custom-list-feature"
msgid "Edit list name"
msgstr "แก้ไขชื่อรายการ"

#. Label for the option to edit a custom list in a menu.
msgctxt "custom-list-feature"
msgid "Edit name"
msgstr "แก้ไขชื่อ"

msgctxt "custom-list-feature"
msgid "Enter a name for the list"
msgstr "ป้อนชื่อสำหรับรายการ"

msgctxt "custom-list-feature"
msgid "Enter a new name for the list"
msgstr "ป้อนชื่อใหม่สำหรับรายการ"

msgctxt "custom-list-feature"
msgid "List names must be unique"
msgstr "ชื่อรายการต้องไม่ซ้ำกัน"

msgctxt "custom-list-feature"
msgid "Relay"
msgstr "รีเลย์"

#. Button label for navigating to login.
msgctxt "device-management"
msgid "Go to login"
msgstr "ไปเข้าสู่ระบบ"

msgctxt "device-management"
msgid "Going to login will unblock the Internet on this device."
msgstr "การไปที่ส่วนเข้าสู่ระบบจะปลดบล็อกอินเทอร์เน็ตบนอุปกรณ์เครื่องนี้"

#. Title label in navigation bar for the manage devices view.
#. Title text in the manage devices view
msgctxt "device-management"
msgid "Manage devices"
msgstr "จัดการอุปกรณ์"

msgctxt "device-management"
msgid "Time left: %(timeLeft)s"
msgstr "เหลือเวลา: %(timeLeft)s"

#. Button text to retry fetching devices.
msgctxt "device-management"
msgid "Try again"
msgstr "ลองอีกครั้ง"

#. The message displayed to the user in case of critical error in the GUI
#. Available placeholders:
#. %(email)s - support email
msgctxt "error-boundary-view"
msgid "Something went wrong. Please contact us at %(email)s"
msgstr "เกิดข้อผิดพลาดขึ้น โปรดติดต่อเราที่ %(email)s"

#. Button label on the fatal-error view that reloads the app
#. interface, as an alternative to force-quitting the app.
msgctxt "error-boundary-view"
msgid "Reload the app"
msgstr "โหลดแอปใหม่"

msgctxt "filter-view"
msgid "Owned"
msgstr "เป็นเจ้าของ"

msgctxt "filter-view"
msgid "Rented"
msgstr "เช่า"

msgctxt "in-app-notifications"
msgid "%(duration)s. Buy more credit."
msgstr "%(duration)s ซื้อเครดิตเพิ่ม"

#. Notification subtitle when the app upgrade is ready to install.
#. Available placeholders:
#. - %(suggestedUpgradeVersion)s: Upgrade version to be installed.
msgctxt "in-app-notifications"
msgid "%(suggestedUpgradeVersion)s is ready to be installed."
msgstr "%(suggestedUpgradeVersion)s พร้อมที่จะติดตั้งแล้ว"

msgctxt "in-app-notifications"
msgid "<a>%(lockdownModeSettingName)s</a> is enabled. Please click “Connect“ or disable “%(lockdownModeSettingName)s“ to unblock internet."
msgstr "<a>%(lockdownModeSettingName)s</a> เปิดใช้งานอยู่ โปรดคลิก “เชื่อมต่อ” หรือปิดใช้งาน “%(lockdownModeSettingName)s” เพื่อปลดบล็อกอินเทอร์เน็ต"

msgctxt "in-app-notifications"
msgid "ACCESS REVOKED"
msgstr "การเข้าถึงถูกเพิกถอน"

msgctxt "in-app-notifications"
msgid "ACCOUNT CREDIT EXPIRES SOON"
msgstr "เครดิตในบัญชีจะหมดอายุในเร็ว ๆ นี้"

msgctxt "in-app-notifications"
msgid "APP IS OUT OF SYNC"
msgstr "แอปไม่ได้มีการซิงค์"

msgctxt "in-app-notifications"
msgid "BLOCKING INTERNET"
msgstr "กำลังบล็อกอินเทอร์เน็ต"

#. Notification subtitle when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "Click here to install update."
msgstr "คลิกที่นี่เพื่อติดตั้งการอัปเดต"

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "Click here to retry"
msgstr "คลิกที่นี่เพื่อลองอีกครั้ง"

#. Notification subtitle when the download of the installer failed
#. and the user can try downloading again.
msgctxt "in-app-notifications"
msgid "Click here to retry download"
msgstr "คลิกที่นี่เพื่อลองดาวน์โหลดอีกครั้ง"

msgctxt "in-app-notifications"
msgid "Click here to see what’s new."
msgstr "คลิกที่นี่ เพื่อดูว่ามีอะไรใหม่"

msgctxt "in-app-notifications"
msgid "Connecting is not possible while access is revoked."
msgstr "ไม่สามารถเชื่อมต่อได้ในขณะที่การเข้าถึงถูกเพิกถอน"

#. Label of the voucher code an announcement granted to this account.
msgctxt "in-app-notifications"
msgid "Your code"
msgstr "รหัสของคุณ"

#. Confirmation shown once the voucher code is on the clipboard.
msgctxt "in-app-notifications"
msgid "Copied"
msgstr "คัดลอกแล้ว"

#. Notification subtitle when the installer download failed.
msgctxt "in-app-notifications"
msgid "Could not download installer."
msgstr "ไม่สามารถดาวน์โหลดโปรแกรมติดตั้งได้"

#. Generic notification subtitle when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "Could not upgrade the app."
msgstr "ไม่สามารถอัปเกรดแอปได้"

#. Notification title when app upgrade is verifying the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOAD COMPLETE! VERIFYING..."
msgstr "ดาวน์โหลดเสร็จสมบูรณ์! กำลังตรวจสอบ..."

#. Notification title when the installer download failed.
msgctxt "in-app-notifications"
msgid "DOWNLOAD FAILED"
msgstr "การดาวน์โหลดล้มเหลว"

#. Generic notification title when app upgrade is downloading the installer.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE..."
msgstr "กำลังดาวน์โหลดอัปเดต..."

#. Notification title when the app upgrade is in progress.
#. Available placeholders:
#. - %(appUpgradeDownloadProgressValue)s: The download progress value.
msgctxt "in-app-notifications"
msgid "DOWNLOADING UPDATE... %(appUpgradeDownloadProgressValue)s%%"
msgstr "กำลังดาวน์โหลดอัปเดต... %(appUpgradeDownloadProgressValue)s%%"

#. The in-app banner displayed to the user when the app update is available.
msgctxt "in-app-notifications"
msgid "IMPORTANT"
msgstr "สำคัญ"

#. Notification title when the installer failed.
msgctxt "in-app-notifications"
msgid "INSTALLER FAILED"
msgstr "โปรแกรมติดตั้งล้มเหลว"

msgctxt "in-app-notifications"
msgid "NETWORK TRAFFIC MIGHT BE LEAKING"
msgstr "การรับส่งข้อมูลทางเครือข่ายอาจรั่วไหล"

msgctxt "in-app-notifications"
msgid "NEW VERSION INSTALLED"
msgstr "ติดตั้งเวอร์ชันใหม่แล้ว"

msgctxt "in-app-notifications"
msgid "NOTICE"
msgstr "ประกาศ"

msgctxt "in-app-notifications"
msgid "Please quit and restart the app."
msgstr "โปรดออกและเปิดแอปขึ้นมาใหม่"

#. Notification title when the app upgrade is ready to install.
msgctxt "in-app-notifications"
msgid "READY TO INSTALL UPDATE"
msgstr "พร้อมที่จะติดตั้งการอัปเดต"

#. Accessibility label for the button to retry download of the installer.
msgctxt "in-app-notifications"
msgid "Read the full message"
msgstr "อ่านข้อความทั้งหมด"

msgctxt "in-app-notifications"
msgid "Retry download of the installer"
msgstr "ลองดาวน์โหลดโปรแกรมติดตั้งอีกครั้ง"

#. Accessibility label for the button to retry the installation.
msgctxt "in-app-notifications"
msgid "Retry installation"
msgstr "ลองติดตั้งใหม่อีกครั้ง"

msgctxt "in-app-notifications"
msgid "SERVER MAINTENANCE"
msgstr "การบำรุงรักษาเซิร์ฟเวอร์"

#. Notification subtitle when the installer verification failed.
msgctxt "in-app-notifications"
msgid "The installer could not be verified."
msgstr "ไม่สามารถดำเนินการตรวจสอบโปรแกรมติดตั้งได้"

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not complete successfully."
msgstr "โปรแกรมติดตั้งไม่เสร็จสมบูรณ์"

#. Notification subtitle when the installer failed.
msgctxt "in-app-notifications"
msgid "The installer did not start successfully."
msgstr "โปรแกรมติดตั้งไม่สามารถเริ่มต้นได้สำเร็จ"

msgctxt "in-app-notifications"
msgid "UNSUPPORTED VERSION"
msgstr "เวอร์ชันที่ไม่รองรับ"

#. Generic notification title when the app upgrade failed.
msgctxt "in-app-notifications"
msgid "UPDATE FAILED"
msgstr "การอัปเดตล้มเหลว"

#. Notification title when app upgrade is ready for the user to launch the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! INSTALLER READY!"
msgstr "การตรวจสอบเสร็จสมบูรณ์! โปรแกรมติดตั้งพร้อมแล้ว!"

#. Notification title when app upgrade is launching the installer.
msgctxt "in-app-notifications"
msgid "VERIFICATION COMPLETE! LAUNCHING INSTALLER..."
msgstr "การตรวจสอบเสร็จสมบูรณ์! กำลังเปิดโปรแกรมติดตั้ง..."

#. Notification title when the installer verification failed.
msgctxt "in-app-notifications"
msgid "VERIFICATION FAILED"
msgstr "การตรวจสอบล้มเหลว"

msgctxt "in-app-notifications"
msgid "AUTO-RENEWAL SOON"
msgstr "จะต่ออายุอัตโนมัติเร็ว ๆ นี้"

msgctxt "in-app-notifications"
msgid "MIGRATION POSTPONED, PORT KEPT"
msgstr "เลื่อนการย้ายออกไป คงพอร์ตไว้"

msgctxt "in-app-notifications"
msgid "NO INTERNET CONNECTION"
msgstr "ไม่มีการเชื่อมต่ออินเทอร์เน็ต"

#. Button label opening the community forum to report a problem.
msgctxt "in-app-notifications"
msgid "Report on the forum"
msgstr "รายงานในฟอรัม"

msgctxt "in-app-notifications"
msgid "SERVER NOT FORWARDING TRAFFIC"
msgstr "เซิร์ฟเวอร์ไม่ส่งต่อการรับส่งข้อมูล"

msgctxt "in-app-notifications"
msgid "The server stopped forwarding your traffic. Warren will switch or reconnect automatically."
msgstr "เซิร์ฟเวอร์หยุดส่งต่อการรับส่งข้อมูลของคุณ Warren จะสลับเซิร์ฟเวอร์หรือเชื่อมต่อใหม่โดยอัตโนมัติ"

msgctxt "in-app-notifications"
msgid "This is taking longer than usual. Warren keeps retrying; if it does not connect, report the problem on our community forum."
msgstr "ขั้นตอนนี้ใช้เวลานานกว่าปกติ Warren จะลองใหม่ต่อไป หากยังเชื่อมต่อไม่ได้ โปรดรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "in-app-notifications"
msgid "TROUBLE CONNECTING?"
msgstr "เชื่อมต่อมีปัญหาหรือไม่"

msgctxt "in-app-notifications"
msgid "Your device is offline. Warren will reconnect automatically as soon as the network is back."
msgstr "อุปกรณ์ของคุณออฟไลน์อยู่ Warren จะเชื่อมต่อใหม่โดยอัตโนมัติทันทีที่เครือข่ายกลับมา"

msgctxt "in-app-notifications"
msgid "Your forwarded port is busy on every alternative server, so Warren kept you on the current one. Expect a brief interruption while it updates."
msgstr "พอร์ตที่ส่งต่อของคุณถูกใช้งานอยู่บนเซิร์ฟเวอร์ทางเลือกทุกเครื่อง Warren จึงให้คุณอยู่บนเซิร์ฟเวอร์เดิม อาจมีการหยุดชะงักสั้น ๆ ระหว่างการอัปเดต"

msgctxt "in-app-notifications"
msgid "Your Warren time renews in the next days. You can turn it off anytime in Account settings."
msgstr "เวลาใช้งาน Warren ของคุณจะต่ออายุภายในไม่กี่วันข้างหน้า คุณปิดได้ทุกเมื่อในการตั้งค่าบัญชี"

#. Status text app is trying to connect to the system service.
msgctxt "launch-view"
msgid "Connecting to Warren system service..."
msgstr "กำลังเชื่อมต่อบริการของระบบ Warren..."

#. Button label for opening dialog with troubleshooting details.
msgctxt "launch-view"
msgid "Details"
msgstr "รายละเอียด"

#. List item in troubleshooting modal advising user disable third party antivirus.
msgctxt "launch-view"
msgid "Disabling third party antivirus software"
msgstr "ปิดใช้งานซอฟต์แวร์ป้องกันไวรัสของบริษัทอื่น"

#. Status text shown when app fails to start.
msgctxt "launch-view"
msgid "Failed to start the app, please try again or click “Details” for more info"
msgstr "ไม่สามารถเริ่มแอปได้ โปรดลองอีกครั้งหรือคลิก \"รายละเอียด\" เพื่อดูข้อมูลเพิ่มเติม"

#. Message in launch view when another account on this computer set up Warren, so the daemon refuses this one.
msgctxt "launch-view"
msgid "Only the account that set Warren up, or an administrator, can use it here."
msgstr "เฉพาะบัญชีที่ตั้งค่า Warren หรือผู้ดูแลระบบเท่านั้นที่ใช้งานได้ที่นี่"

#. Message in launch view when Warren was set up on this computer before it recorded an owner, and this account is not the one at the computer's own screen.
msgctxt "launch-view"
msgid "Open Warren from the account signed in at this computer’s own screen to become its owner, or ask an administrator."
msgstr "เปิด Warren จากบัญชีที่ลงชื่อเข้าใช้บนหน้าจอของคอมพิวเตอร์เครื่องนี้เพื่อเป็นเจ้าของ หรือขอให้ผู้ดูแลระบบช่วย"

#. Status text when Warren was set up on this computer before it recorded an owner, and this account may not take it over.
msgctxt "launch-view"
msgid "Warren on this computer has no owner yet"
msgstr "Warren บนคอมพิวเตอร์เครื่องนี้ยังไม่มีเจ้าของ"

#. Status text when another account on this computer set up Warren, so the daemon refuses this one.
msgctxt "launch-view"
msgid "Warren is set up by another account on this computer"
msgstr "Warren ได้รับการตั้งค่าโดยบัญชีอื่นบนคอมพิวเตอร์เครื่องนี้"

#. Message in launch view when the background process permissions have been revoked.
msgctxt "launch-view"
msgid "Permission for the Warren VPN service has been revoked. Please go to System Settings and allow Warren VPN under the “Allow in the Background” setting."
msgstr "สิทธิ์การเข้าถึงบริการ Warren VPN ได้ถูกเพิกถอนแล้ว โปรดเข้าไปยังการตั้งค่าระบบ แล้วให้สิทธิ์อนุญาต Warren VPN ภายใต้การตั้งค่า \"อนุญาตในพื้นหลัง\""

#. List item in troubleshooting modal advising user to reinstall the app.
msgctxt "launch-view"
msgid "Reinstalling the app"
msgstr "การติดตั้งแอปใหม่อีกครั้ง"

#. List item in troubleshooting modal advising user to restart background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process"
msgstr "การเริ่มกระบวนการเบื้องหลัง Warren ใหม่"

#. List item in troubleshooting modal instructing user how to restart the background process.
msgctxt "launch-view"
msgid "Restarting the Warren background process by clicking \"Back\", then \"Try again\""
msgstr "การเริ่มกระบวนการเบื้องหลัง Warren ใหม่โดยคลิก \"ย้อนกลับ\" จากนั้นคลิก \"ลองอีกครั้ง\""

#. List item in troubleshooting modal advising user to restart their computer.
msgctxt "launch-view"
msgid "Restarting your computer"
msgstr "การรีสตาร์ทคอมพิวเตอร์ของคุณ"

#. Status text shown when app is starting.
msgctxt "launch-view"
msgid "Starting up...."
msgstr "เริ่มต้นแล้ว...."

#. Message in troubleshooting modal when the background process failed to start.
msgctxt "launch-view"
msgid "The Warren background process failed to start. The background process is responsible for the security, kill switch, and the VPN tunnel. Please try:"
msgstr "กระบวนการเบื้องหลังของ Warren ไม่สามารถเริ่มต้นได้ กระบวนการเบื้องหลังนี้รับผิดชอบด้านความปลอดภัย สวิตช์ปิดการทำงาน และอุโมงค์ VPN โปรดลอง:"

#. Button label for trying to restart the daemon again.
msgctxt "launch-view"
msgid "Try again"
msgstr "ลองอีกครั้ง"

#. Message in troubleshooting modal pointing the user to the community forum if the steps do not work.
msgctxt "launch-view"
msgid "If these steps do not work, please report the problem on our community forum."
msgstr "หากขั้นตอนเหล่านี้ไม่ได้ผล โปรดรายงานปัญหาในฟอรัมชุมชนของเรา"

#. Button label on the launch view that lifts the failsafe
#. firewall block when the system service cannot be reached,
#. restoring internet access without VPN protection.
msgctxt "launch-view"
msgid "Restore internet without VPN"
msgstr "กู้คืนอินเทอร์เน็ตโดยไม่ใช้ VPN"

#. Message in launch view when the mullvad service cannot be contacted.
msgctxt "launch-view"
msgid "Unable to contact the Warren system service, your connection might be unsecure. Please troubleshoot by clicking the \"Learn more\" button, or report the problem on our community forum."
msgstr "ไม่สามารถติดต่อบริการระบบของ Warren ได้ การเชื่อมต่อของคุณอาจไม่ปลอดภัย โปรดแก้ไขปัญหาโดยคลิกปุ่ม “เรียนรู้เพิ่มเติม” หรือรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "launch-view"
msgid "Warren VPN will restore internet access without VPN protection."
msgstr "Warren VPN จะกู้คืนการเข้าถึงอินเทอร์เน็ตโดยไม่มีการปกป้องจาก VPN"

#. Button label opening the community forum to report a problem.
msgctxt "launch-view"
msgid "Report on the forum"
msgstr "รายงานในฟอรัม"

#. This is used for appending information about a location.
#. E.g. "Gothenburg (Entry)" if Gothenburg has been selected as the entrypoint.
#. Available placeholders:
#. %(location)s - Translated location name
#. %(info)s - Information about the location
msgctxt "locations-feature"
msgid "%(location)s (%(info)s)"
msgstr "%(location)s (%(info)s)"

msgctxt "locations-feature"
msgid "Disabling recents will also clear history."
msgstr "การปิดใช้รายการล่าสุดจะเป็นการล้างประวัติด้วย"

msgctxt "locations-feature"
msgid "Entry"
msgstr "เข้า"

msgctxt "locations-feature"
msgid "Exit"
msgstr "ออก"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
#. Available placeholder:
#. %(lockdownModeSettingName)s - The translation of "Lockdown mode"
msgctxt "login-view"
msgid "<b>%(lockdownModeSettingName)s</b> is enabled. Disable it to unblock your connection."
msgstr "<b>%(lockdownModeSettingName)s</b> ได้เปิดใช้งานแล้ว ปิดใช้งานเพื่อปลดบล็อกการเชื่อมต่อของคุณ"

#. Text in button that allows user to create a new account.
msgctxt "login-view"
msgid "Create a new account"
msgstr "สร้างบัญชีใหม่"

#. This is a warning message shown when the app is blocking the users
#. internet connection while logged out.
msgctxt "login-view"
msgid "Our kill switch is currently blocking your connection."
msgstr "คิลสวิตช์ของเราได้บล็อกการเชื่อมต่อของคุณอยู่ในขณะนี้"

msgctxt "login-view"
msgid "Upgrading..."
msgstr "กำลังอัปเกรด…"

#. Error when a recovery phrase could not be restored for a reason that has nothing to do with its words, such as no connection to Warren.
msgctxt "login-view"
msgid "Warren could not restore your account right now. Check your internet connection and try again."
msgstr "Warren ไม่สามารถกู้คืนบัญชีของคุณได้ในขณะนี้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"

#. Title label in navigation bar
msgctxt "navigation-bar"
msgid "API access"
msgstr "การเข้าถึง API"

msgctxt "network-stats"
msgid "High load"
msgstr "โหลดสูง"

msgctxt "network-stats"
msgid "Live figures appear once %(threshold)d people share an exit, so no one’s traffic can be singled out."
msgstr "ตัวเลขสดจะแสดงเมื่อมี %(threshold)d คนใช้เซิร์ฟเวอร์ทางออกร่วมกัน เพื่อไม่ให้ระบุทราฟฟิกของใครได้"

msgctxt "network-stats"
msgid "Load %(load)s, %(people)s people"
msgstr "โหลด %(load)s, %(people)s คน"

msgctxt "network-stats"
msgid "Load unknown"
msgstr "ไม่ทราบโหลด"

msgctxt "network-stats"
msgid "Low load"
msgstr "โหลดต่ำ"

msgctxt "network-stats"
msgid "Moderate load"
msgstr "โหลดปานกลาง"

msgctxt "network-stats"
msgid "Offline"
msgstr "ออฟไลน์"

msgctxt "network-stats"
msgid "Saturated"
msgstr "อิ่มตัว"

msgctxt "network-stats"
msgid "%(band)s, %(people)s people"
msgstr "%(band)s, %(people)s คน"

#. The system notification displayed to the user when the account credit is close to expiry.
#. Available placeholder:
#. %(duration)s - remaining time, e.g. "2 days"
msgctxt "notifications"
msgid "Account credit expires in %(duration)s. Buy more credit."
msgstr "เครดิตบัญชีจะหมดอายุใน %(duration)s ซื้อเครดิตเพิ่ม"

msgctxt "notifications"
msgid "Account is out of time"
msgstr "บัญชีหมดเวลาแล้ว"

msgctxt "notifications"
msgid "App is out of sync. Please quit and restart."
msgstr "แอปไม่ได้รับการซิงค์ โปรดออกและเปิดแอปใหม่"

#. The system notification that notifies the user when a beta update is
#. available.
#. Available placeholders:
#. %(version)s - The version number of the new beta version.
msgctxt "notifications"
msgid "Beta update available. Try out the newest beta version (%(version)s)."
msgstr "มีการอัปเดตเบต้าให้ใช้งาน ลองใช้เวอร์ชันเบต้าใหม่ล่าสุด (%(version)s)"

msgctxt "notifications"
msgid "Buy more"
msgstr "ซื้อเพิ่ม"

msgctxt "notifications"
msgid "Connected"
msgstr "เชื่อมต่อแล้ว"

#. The message showed when a server has been connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connected to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connected to %(location)s"
msgstr "เชื่อมต่อไปยัง %(location)s แล้ว"

msgctxt "notifications"
msgid "Connecting"
msgstr "กำลังเชื่อมต่อ"

#. The message showed when a server is being connected to.
#. Available placeholder:
#. %(location) - name of the server location we're connecting to (e.g. "se-got-003")
msgctxt "notifications"
msgid "Connecting to %(location)s"
msgstr "กำลังเชื่อมต่อไปยัง %(location)s"

msgctxt "notifications"
msgid "Connection might be unsecured. App lost contact with system service, please troubleshoot."
msgstr "การเชื่อมต่ออาจไม่ปลอดภัย แอปขาดการติดต่อกับบริการของระบบ โปรดแก้ไขปัญหา"

msgctxt "notifications"
msgid "Could not configure IPv6. Disable it in the app or enable it on your device."
msgstr "ไม่สามารถกำหนดค่า IPv6 ได้ โปรดปิดใช้งานรายการนี้ในแอป หรือเปิดใช้งานบนอุปกรณ์ของคุณ"

msgctxt "notifications"
msgid "Disconnected and unsecure"
msgstr "ตัดการเชื่อมต่อและไม่ปลอดภัย"

msgctxt "notifications"
msgid "Failed to enable split tunneling."
msgstr "ล้มเหลวในการเปิดใช้การแยกอุโมงค์"

msgctxt "notifications"
msgid "Failed to enable split tunneling. Please try reconnecting or disable split tunneling."
msgstr "ล้มเหลวในการเปิดใช้การแยกอุโมงค์ โปรดลองเชื่อมต่อใหม่อีกครั้ง หรือปิดใช้งานการแยกอุโมงค์"

#. Label for the system notification when the app encountered an error
#. and will block network traffic until the error is resolved.
#. Label for the in-app banner when the app encountered an error
msgctxt "notifications"
msgid "Failed to start %(splitTunneling)s. To unblock network traffic, disable split tunneling."
msgstr "ไม่สามารถเริ่มต้น %(splitTunneling)s ได้ หากต้องการปลดบล็อกการรับส่งข้อมูลเครือข่าย ให้ปิดใช้งานการแยกอุโมงค์"

#. Label for notification when IPv4 is not available.
msgctxt "notifications"
msgid "IPv4 is not available, please try changing Device IP version setting."
msgstr "IPv4 ไม่พร้อมใช้งาน โปรดลองเปลี่ยนการตั้งค่าเวอร์ชัน IP ของอุปกรณ์"

#. Label for notification when IPv6 is not available.
msgctxt "notifications"
msgid "IPv6 is not available, please try changing Device IP version setting."
msgstr "IPv6 ไม่พร้อมใช้งาน โปรดลองเปลี่ยนการตั้งค่าเวอร์ชัน IP ของอุปกรณ์"

msgctxt "notifications"
msgid "Lockdown mode active, connection blocked"
msgstr "เปิดใช้โหมดล็อกดาวน์ ปิดกั้นการเชื่อมต่อแล้ว"

msgctxt "notifications"
msgid "No servers match your settings, try changing server or other settings."
msgstr "ไม่มีเซิร์ฟเวอร์ที่ตรงกับการตั้งค่าของคุณ โปรดลองเปลี่ยนเซิร์ฟเวอร์ หรือการตั้งค่าอื่นๆ"

msgctxt "notifications"
msgid "Open port forwarding"
msgstr "เปิดการส่งต่อพอร์ต"

#. A link in the in-app banner to encourage the user to update the app.
#. The in-app banner is is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Please click here to update now"
msgstr "โปรดคลิกที่นี่เพื่ออัปเดตทันที"

msgctxt "notifications"
msgid "Port forwarding: public port %(port)d is no longer open"
msgstr "การส่งต่อพอร์ต: พอร์ตสาธารณะ %(port)d ไม่เปิดอีกต่อไป"

msgctxt "notifications"
msgid "Port forwarding: public port %(port)d is open"
msgstr "การส่งต่อพอร์ต: พอร์ตสาธารณะ %(port)d เปิดอยู่"

msgctxt "notifications"
msgid "Reconnecting"
msgstr "กำลังเชื่อมต่อใหม่"

msgctxt "notifications"
msgid "The apps excluded with %(splitTunneling)s might not work properly right now."
msgstr "แอปที่ไม่รวมอยู่ใน %(splitTunneling)s อาจทำงานผิดปกติอยู่ในขณะนี้"

msgctxt "notifications"
msgid "Unable to apply firewall rules."
msgstr "ไม่สามารถใช้งานกฎไฟร์วอลล์ได้"

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try temporarily disabling any third-party antivirus or security software."
msgstr "ไม่สามารถใช้งานกฎไฟร์วอลล์ได้ โปรดลองปิดใช้งานซอฟต์แวร์ป้องกันไวรัส หรือซอฟต์แวร์รักษาความปลอดภัยของบุคคลที่สามชั่วคราว"

msgctxt "notifications"
msgid "Unable to apply firewall rules. Try updating your kernel."
msgstr "ไม่สามารถใช้งานกฎไฟร์วอลล์ได้ โปรดลองอัปเดตเคอร์เนลของคุณ"

msgctxt "notifications"
msgid "Unable to resolve host of custom tunnel. Try changing your settings."
msgstr "ไม่พบโฮสต์ของช่องทางแบบกำหนดเอง กรุณาลองเปลี่ยนการตั้งค่าของคุณ"

msgctxt "notifications"
msgid "Unable to start tunnel connection. This could be because of conflicts with VMware, please troubleshoot."
msgstr "ไม่สามารถเริ่มการเชื่อมต่อช่องทางได้ ซึ่งอาจเป็นเพราะมีการขัดแย้งกับ VMware โปรดแก้ไขปัญหา"

msgctxt "notifications"
msgid "Update available. Install the latest app version to stay up to date"
msgstr "มีอัปเดตพร้อมใช้งาน ติดตั้งแอปเวอร์ชันล่าสุดเพื่อรับข้อมูลการอัปเดตล่าสุด"

msgctxt "notifications"
msgid "Upgrade"
msgstr "อัปเกรด"

msgctxt "notifications"
msgid "Your device is offline. The tunnel will automatically connect once your device is back online."
msgstr "อุปกรณ์ของคุณออฟไลน์อยู่ อุโมงค์จะเชื่อมต่อโดยอัตโนมัติ หลังจากที่อุปกรณ์ของคุณกลับมาออนไลน์"

#. The in-app banner which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version."
msgstr "ความเป็นส่วนตัวของคุณอาจมีความเสี่ยงกับแอปเวอร์ชันที่ไม่รองรับนี้"

#. The system notification which is displayed to the user when the running app becomes unsupported.
msgctxt "notifications"
msgid "Your privacy might be at risk with this unsupported app version. Please update now."
msgstr "ความเป็นส่วนตัวของคุณอาจมีความเสี่ยง ในขณะที่ใช้งานเวอร์ชันแอปที่ไม่ได้รับการสนับสนุนนี้ โปรดอัปเดตตอนนี้เลย"

msgctxt "notifications"
msgid "Automatic renewal charged: 1 month will be added to your Warren time. You can turn auto-renewal off anytime in Account settings."
msgstr "เรียกเก็บเงินการต่ออายุอัตโนมัติแล้ว จะเพิ่มเวลาใช้งาน Warren ให้คุณ 1 เดือน คุณปิดการต่ออายุอัตโนมัติได้ทุกเมื่อในการตั้งค่าบัญชี"

msgctxt "notifications"
msgid "Automatic renewal failed. Update your payment method or buy credit manually."
msgstr "การต่ออายุอัตโนมัติล้มเหลว โปรดอัปเดตวิธีการชำระเงินหรือซื้อเครดิตด้วยตนเอง"

msgctxt "notifications"
msgid "Automatic renewal has been turned off for this account."
msgstr "ปิดการต่ออายุอัตโนมัติสำหรับบัญชีนี้แล้ว"

msgctxt "notifications"
msgid "Unable to block all network traffic. Please troubleshoot or report the problem on our community forum."
msgstr "ไม่สามารถบล็อกการรับส่งข้อมูลทางเครือข่ายทั้งหมดได้ โปรดแก้ไขปัญหาหรือรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Unable to block all network traffic. Try temporarily disabling any third-party antivirus or security software, or report the problem on our community forum."
msgstr "ไม่สามารถบล็อกการรับส่งข้อมูลทางเครือข่ายทั้งหมดได้ โปรดลองปิดใช้งานซอฟต์แวร์ป้องกันไวรัสหรือซอฟต์แวร์รักษาความปลอดภัยของบุคคลที่สามชั่วคราว หรือรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Unable to block all network traffic. Try updating your kernel or report the problem on our community forum."
msgstr "ไม่สามารถบล็อกการรับส่งข้อมูลทางเครือข่ายทั้งหมดได้ โปรดลองอัปเดตเคอร์เนลของคุณ หรือรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Unable to communicate with Warren kernel driver. Try reconnecting or report the problem on our community forum."
msgstr "ไม่สามารถสื่อสารกับไดรเวอร์เคอร์เนลของ Warren ได้ โปรดลองเชื่อมต่อใหม่ หรือรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Unable to set system DNS server. Please report the problem on our community forum."
msgstr "ไม่สามารถตั้งค่าเซิร์ฟเวอร์ DNS ของระบบได้ โปรดรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Unable to start tunnel connection. Please report the problem on our community forum."
msgstr "ไม่สามารถเริ่มการเชื่อมต่ออุโมงค์ได้ โปรดรายงานปัญหาในฟอรัมชุมชนของเรา"

msgctxt "notifications"
msgid "Your bank asks for a confirmation to renew. Open Warren and buy credit to confirm."
msgstr "ธนาคารของคุณขอการยืนยันเพื่อต่ออายุ เปิด Warren แล้วซื้อเครดิตเพื่อยืนยัน"

msgctxt "notifications"
msgid "Your network looks unstable: the tunnel reconnected too many times in a row. Reconnect once your connection has settled."
msgstr "เครือข่ายของคุณดูไม่เสถียร: อุโมงค์เชื่อมต่อใหม่ติดต่อกันหลายครั้งเกินไป โปรดเชื่อมต่อใหม่เมื่อการเชื่อมต่อของคุณนิ่งแล้ว"

#. The 30-day advance notice before an automatic renewal charge.
#. Available placeholder:
#. %(date)s - the renewal date
msgctxt "notifications"
msgid "Your Warren time renews automatically around %(date)s, at the monthly rate. You can turn auto-renewal off anytime in Account settings."
msgstr "เวลาใช้งาน Warren ของคุณจะต่ออายุอัตโนมัติประมาณ %(date)s ในอัตรารายเดือน คุณปิดการต่ออายุอัตโนมัติได้ทุกเมื่อในการตั้งค่าบัญชี"

msgctxt "notifications"
msgid "Your Warren time renews in the next days. You can turn auto-renewal off anytime in Account settings."
msgstr "เวลาใช้งาน Warren ของคุณจะต่ออายุภายในไม่กี่วันข้างหน้า คุณปิดการต่ออายุอัตโนมัติได้ทุกเมื่อในการตั้งค่าบัญชี"

msgctxt "port-forwarding-view"
msgid "A system notification shows the new port number."
msgstr "การแจ้งเตือนของระบบจะแสดงหมายเลขพอร์ตใหม่"

msgctxt "port-forwarding-view"
msgid "Assign a free port"
msgstr "กำหนดพอร์ตที่ว่าง"

msgctxt "port-forwarding-view"
msgid "Choose another exit"
msgstr "เลือกเซิร์ฟเวอร์ทางออกอื่น"

msgctxt "port-forwarding-view"
msgid "Copy port number"
msgstr "คัดลอกหมายเลขพอร์ต"

msgctxt "port-forwarding-view"
msgid "disabled"
msgstr "ปิดใช้งาน"

msgctxt "port-forwarding-view"
msgid "How to set up your torrent client"
msgstr "วิธีตั้งค่าโปรแกรมทอร์เรนต์ของคุณ"

msgctxt "port-forwarding-view"
msgid "Notify me when a public port changes"
msgstr "แจ้งเตือนเมื่อพอร์ตสาธารณะเปลี่ยน"

msgctxt "port-forwarding-view"
msgid "This public port is already in use on this exit. Keep your port by switching exit, let the exit assign a free public port, or type another port above."
msgstr "พอร์ตสาธารณะนี้ถูกใช้งานอยู่แล้วบนเซิร์ฟเวอร์ทางออกนี้ คุณสามารถคงพอร์ตเดิมไว้โดยเปลี่ยนเซิร์ฟเวอร์ทางออก ให้เซิร์ฟเวอร์ทางออกกำหนดพอร์ตสาธารณะที่ว่างให้ หรือพิมพ์พอร์ตอื่นด้านบน"

#. Cancel button label for voucher redemption.
msgctxt "redeem-voucher-alert"
msgid "Cancel"
msgstr "ยกเลิก"

#. Input field label for voucher code.
msgctxt "redeem-voucher-alert"
msgid "Enter voucher code"
msgstr "ป้อนรหัสบัตรกำนัล"

#. Button label for redeeming a voucher.
msgctxt "redeem-voucher-alert"
msgid "Redeem voucher"
msgstr "แลกบัตรกำนัล"

msgctxt "redeem-voucher-view"
msgid "An error occurred."
msgstr "เกิดข้อผิดพลาดขึ้น"

#. Button label for voucher redemption.
msgctxt "redeem-voucher-view"
msgid "Redeem"
msgstr "แลกรับ"

msgctxt "redeem-voucher-view"
msgid "Verifying voucher..."
msgstr "กำลังตรวจสอบบัตรกำนัล..."

msgctxt "redeem-voucher-view"
msgid "Voucher code has already been used."
msgstr "รหัสบัตรกำนัลถูกใช้ไปแล้ว"

msgctxt "redeem-voucher-view"
msgid "Voucher code is invalid."
msgstr "รหัสบัตรกำนัลไม่ถูกต้อง"

msgctxt "redeem-voucher-view"
msgid "Voucher was successfully redeemed."
msgstr "แลกบัตรกำนัลสำเร็จแล้ว"

msgctxt "redeem-voucher-view"
msgid "Voucher code has expired."
msgstr "รหัสบัตรกำนัลหมดอายุแล้ว"

#. Title label in navigation bar
msgctxt "select-language-nav"
msgid "Select language"
msgstr "เลือกภาษา"

#. Title label in navigation bar
msgctxt "select-location-nav"
msgid "Select location"
msgstr "เลือกตำแหน่งที่ตั้ง"

msgctxt "select-location-view"
msgid "All locations"
msgstr "ตำแหน่งที่ตั้งทั้งหมด"

msgctxt "select-location-view"
msgid "Custom lists"
msgstr "รายการกำหนดเอง"

msgctxt "select-location-view"
msgid "Disable recents"
msgstr "ปิดใช้งานล่าสุด"

msgctxt "select-location-view"
msgid "Enable recents"
msgstr "เปิดใช้งานล่าสุด"

msgctxt "select-location-view"
msgid "Entry"
msgstr "เข้า"

msgctxt "select-location-view"
msgid "Exit"
msgstr "ออก"

msgctxt "select-location-view"
msgid "Filtered:"
msgstr "กรอง:"

msgctxt "select-location-view"
msgid "Open %(daita)s settings"
msgstr "เปิดการตั้งค่า %(daita)s"

msgctxt "select-location-view"
