msgstr "Przygotowywanie raportu, proszę czekać."

msgctxt "report-problem"
msgid "Report a problem"
msgstr "Zgłoś problem"

msgctxt "report-problem"
msgid "Send a description and your logs to the support team"
msgstr "Wyślij opis i swoje dzienniki do zespołu wsparcia"

msgctxt "report-problem"
